        "cancel",
        "checkout",
        "commitment",
        "compare",
        "consent",
        "default",
        "financial",
        "irreversible",
        "option",
        "plan",
        "pricing",
        "renewal",
        "tradeoff"
      ],
      "lenses": [
        "choice-comparison-decision-integrity"
      ],
      "minimum_matches": 2
    },
    {
      "rule_id": "mental-model-and-transfer",
      "reason": "Prior knowledge, system concepts, complexity, or independent transfer determine whether guidance becomes durable understanding.",
