        "context",
        "navigation",
        "object state",
        "orientation",
        "project",
        "state change",
        "workspace"
      ],
      "lenses": [
        "context-boundary-identity-orientation"
      ]
    },
    {
      "rule_id": "authorship-and-publication-integrity",
      "reason": "The design creates, transforms, attributes, approves, or publishes content.",
      "terms": [
        "author",
        "authorship",
        "content creation",
        "editorial",
        "generate content",
        "publish",
        "publication",
        "source attribution"
      ],
      "lenses": [
        "authorship-provenance-content-integrity"
      ]
    },
    {
      "rule_id": "perception-salience-and-affordance",
      "reason": "Visual organization, selective attention, action recognition, or state recognition materially affects task success.",
      "terms": [
        "affordance",
        "banner",
        "card",
        "contrast",
        "dense information",
        "discoverability",
        "grouping",
        "scan",
        "signifier",
        "similarity",
        "visual anchor",
        "visual hierarchy"
