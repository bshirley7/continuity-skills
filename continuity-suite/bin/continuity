        transition = goal_sub.add_parser(name)
        transition.add_argument("goal_id")
        if name == "resume":
            transition.add_argument("--authorization-text")
            transition.add_argument("--actor", default="human")
            transition.add_argument("--signing-key", help="SSH private key used to sign the canonical resume receipt")
            transition.add_argument("--schedule")
        elif name == "cancel":
            transition.add_argument("--actor", default="human")
            transition.add_argument("--reason")
        transition.set_defaults(handler=goal_transition, transition=name)
