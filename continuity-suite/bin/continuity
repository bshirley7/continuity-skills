def github_projects_command(args: argparse.Namespace) -> Any:
    root, config = load_context()
    try:
        if args.github_projects_command == "connect":
            return github_projects_lib.connect(
                root,
                config,
                owner_type=args.owner_type,
                owner=args.owner,
                project_number=args.project_number,
                title=args.title,
                visibility=args.visibility,
                settings_value=args.settings,
                hostname=args.hostname,
            )
        if args.github_projects_command == "status":
            return github_projects_lib.connection_status(root, config)
        if args.github_projects_command == "sync":
            return github_projects_lib.sync(root, config, settings_value=args.settings)
        if args.github_projects_command == "bootstrap":
            if args.bootstrap_command == "plan":
                return github_projects_lib.build_bootstrap_plan(
                    root,
                    config,
                    owner_type=args.owner_type,
                    owner=args.owner,
                    title=args.title,
                    visibility=args.visibility,
                    settings_value=args.settings,
                    hostname=args.hostname,
                )
            plan = github_projects_lib.load_bootstrap_plan(root, config, args.plan_hash)
            if args.bootstrap_command == "approve":
                if args.authorization_text != plan["authorization_text"]:
                    raise ContinuityError(
                        "GitHub Projects authorization text must exactly match the prepared bootstrap plan"
                    )
                receipt = {
                    "schema_version": 1,
                    "project_id": config["project_id"],
                    "plan_hash": plan["plan_hash"],
                    "destination": plan["material"]["destination"],
                    "approved_at": iso_now(config),
                    "approved_by": args.approved_by,
                    "authorization_text": args.authorization_text,
                    "nonce": secrets.token_hex(16),
                    "signature_format": "openssh-sshsig-v1" if args.signing_key else "legacy-unsigned",
                }
                if config.get("behavior_configuration_hash") is not None:
                    receipt["behavior_configuration_hash"] = config["behavior_configuration_hash"]
                if config.get("require_signed_approvals", False) and not args.signing_key:
                    raise ContinuityError("This project requires a signed GitHub Projects bootstrap approval")
                target = github_projects_lib.bootstrap_approval_path(root, config, plan["plan_hash"])
                if target.is_file():
                    existing = json_load(target, {})
                    if (
                        existing.get("approved_by") == args.approved_by
                        and existing.get("authorization_text") == args.authorization_text
                        and existing.get("plan_hash") == plan["plan_hash"]
                    ):
                        return existing
                    raise ContinuityError("GitHub Projects bootstrap plan already has a different approval receipt")
                if args.signing_key:
                    sign_receipt_bytes(
                        github_projects_lib.approval_receipt_bytes(receipt),
                        args.signing_key,
                        github_projects_lib.bootstrap_signature_path(root, config, plan["plan_hash"]),
                        namespace="continuity-github-projects-bootstrap",
                        label="GitHub Projects bootstrap approval",
                    )
                    verify_receipt_bytes(
                        root,
                        config,
                        github_projects_lib.approval_receipt_bytes(receipt),
                        github_projects_lib.bootstrap_signature_path(root, config, plan["plan_hash"]),
                        args.approved_by,
                        namespace="continuity-github-projects-bootstrap",
                        label="GitHub Projects bootstrap approval",
                    )
                json_dump(target, receipt)
                return receipt
            if args.bootstrap_command == "apply":
                def verify_bootstrap_signature(payload: bytes, signature: Path, identity: str) -> Any:
                    return verify_receipt_bytes(
                        root,
                        config,
                        payload,
                        signature,
                        identity,
                        namespace="continuity-github-projects-bootstrap",
                        label="GitHub Projects bootstrap approval",
                    )

                approval = github_projects_lib.validate_bootstrap_approval(
                    root,
                    config,
                    plan,
                    verify_signature=verify_bootstrap_signature,
                )
                result = github_projects_lib.apply_bootstrap(root, config, plan)
                application = {
                    **result,
                    "applied_at": iso_now(config),
                    "approved_by": approval["approved_by"],
                    "approval_nonce": approval["nonce"],
                }
                json_dump(
                    github_projects_lib.bootstrap_application_path(root, config, plan["plan_hash"]),
                    application,
                )
                return application
            raise ContinuityError(f"Unknown GitHub Projects bootstrap command {args.bootstrap_command}")
        if args.github_projects_command == "plan":
            return github_projects_lib.build_plan(root, config, args.settings)
        plan = github_projects_lib.load_plan(
            root,
            config,
            args.plan_hash,
            require_fresh=args.github_projects_command in {"approve", "apply"},
        )
        if args.github_projects_command == "approve":
            if args.authorization_text != plan["authorization_text"]:
                raise ContinuityError(
                    "GitHub Projects authorization text must exactly match the prepared export plan"
                )
            receipt = {
                "schema_version": 1,
                "project_id": config["project_id"],
                "plan_hash": plan["plan_hash"],
                "destination": plan["material"]["destination"],
                "approved_at": iso_now(config),
                "approved_by": args.approved_by,
                "authorization_text": args.authorization_text,
                "nonce": secrets.token_hex(16),
                "signature_format": "openssh-sshsig-v1" if args.signing_key else "legacy-unsigned",
            }
            if config.get("behavior_configuration_hash") is not None:
                receipt["behavior_configuration_hash"] = config["behavior_configuration_hash"]
            if config.get("require_signed_approvals", False) and not args.signing_key:
                raise ContinuityError("This project requires a signed GitHub Projects export approval")
            target = github_projects_lib.approval_path(root, config, plan["plan_hash"])
            if target.is_file():
                existing = json_load(target, {})
                if (
                    existing.get("approved_by") == args.approved_by
                    and existing.get("authorization_text") == args.authorization_text
                    and existing.get("plan_hash") == plan["plan_hash"]
                ):
                    return existing
                raise ContinuityError("GitHub Projects export plan already has a different approval receipt")
            if args.signing_key:
                sign_receipt_bytes(
                    github_projects_lib.approval_receipt_bytes(receipt),
                    args.signing_key,
                    github_projects_lib.signature_path(root, config, plan["plan_hash"]),
                    namespace="continuity-github-projects",
                    label="GitHub Projects export approval",
                )
                verify_receipt_bytes(
                    root,
                    config,
                    github_projects_lib.approval_receipt_bytes(receipt),
                    github_projects_lib.signature_path(root, config, plan["plan_hash"]),
                    args.approved_by,
                    namespace="continuity-github-projects",
                    label="GitHub Projects export approval",
                )
            json_dump(target, receipt)
            return receipt
        if args.github_projects_command == "inspect":
            return github_projects_lib.inspect(plan)
        if args.github_projects_command == "apply":
            def verify_tracker_signature(payload: bytes, signature: Path, identity: str) -> Any:
                return verify_receipt_bytes(
                    root,
                    config,
                    payload,
                    signature,
                    identity,
                    namespace="continuity-github-projects",
                    label="GitHub Projects export approval",
                )

            approval = github_projects_lib.validate_approval(
                root,
                config,
                plan,
                verify_signature=verify_tracker_signature,
            )
            result = github_projects_lib.apply(plan)
            application = {
                **result,
                "applied_at": iso_now(config),
                "approved_by": approval["approved_by"],
                "approval_nonce": approval["nonce"],
            }
            application_path = (
                private_path(root, config)
                / "integrations"
                / "github-projects"
                / "applications"
                / f"{plan['plan_hash']}.json"
            )
            json_dump(application_path, application)
            return application
        raise ContinuityError(f"Unknown GitHub Projects command {args.github_projects_command}")
    except github_projects_lib.GitHubProjectsError as exc:
        raise ContinuityError(str(exc)) from exc


def design_command(args: argparse.Namespace) -> Any:
    root, config = load_context()
    installed_catalog = root / ".agents" / "skills" / "continuity-design" / "references" / "catalog.json"
    catalog_path = installed_catalog if installed_catalog.is_file() else CONTROL_ROOT / "skills" / "continuity-design" / "references" / "catalog.json"
    try:
        if args.command == "catalog":
            return design_lib.catalog_summary(config, catalog_path, args.axis)
        if args.command == "draft":
            return design_lib.draft(root, config, catalog_path, Path(args.input).expanduser().resolve())
        if args.command == "visual-atlas":
            return design_lib.visual_atlas(root, config, catalog_path, Path(args.input).expanduser().resolve())
        if args.command == "visual-render":
            return design_lib.visual_render(root, config, Path(args.input).expanduser().resolve())
        if args.command == "probe-prepare":
            return design_lib.probe_prepare(root, config, Path(args.target).expanduser().resolve())
        if args.command == "concept-lab-validate":
            return design_lib.concept_lab_validate(root, config, Path(args.input).expanduser().resolve())
        if args.command == "reference-validate":
            return design_lib.reference_validate(root, config, Path(args.manifest).expanduser().resolve())
        if args.command == "portfolio-validate":
            return design_lib.portfolio_validate(root, config, Path(args.manifest).expanduser().resolve())
        if args.command == "concept-validate":
            return design_lib.concept_validate(root, config, Path(args.manifest).expanduser().resolve())
        if args.command == "improvement-cycle":
            return design_lib.improvement_cycle(root, config, Path(args.manifest).expanduser().resolve())
        if args.command == "feedback-record":
            return design_lib.feedback_record(root, config, args.design_id, Path(args.input).expanduser().resolve())
        if args.command == "slop-check":
            return design_lib.slop_check(root, config, Path(args.target).expanduser().resolve(), Path(args.manifest).expanduser().resolve())
        if args.command == "select":
            return design_lib.select(root, config, args.design_id, [args.direction, *(args.combine or [])], args.actor)
        if args.command == "approve":
            return design_lib.approve(root, config, args.design_id, args.revision, args.approved_by, args.authorization_text)
        if args.command == "show":
            return design_lib.show(root, config, args.design_id)
        if args.command == "artifact-validate":
            return design_lib.validate_artifact(root, config, Path(args.manifest).expanduser().resolve())
        if args.command == "prototype-validate":
            return design_lib.validate_candidate_artifact(root, config, Path(args.manifest).expanduser().resolve())
        raise ContinuityError(f"Unknown design command {args.command}")
    except design_lib.DesignError as exc:
        raise ContinuityError(str(exc)) from exc


def shared_note_command(args: argparse.Namespace) -> Any:
    root, config = load_context()
    try:
        if config.get("require_signed_approvals", False) and getattr(args, "share_command", None) in {"approve", "publish"}:
            verify_approval_trust_anchor(root, config)
        return args.shared_note_handler(root, config, args)
    except shared_notes_lib.SharedNoteError as exc:
        raise ContinuityError(str(exc)) from exc


def output(value: Any, as_json: bool = False) -> None:
    if isinstance(value, str) and not as_json:
        print(value, end="" if value.endswith("\n") else "\n")
    else:
        print(json.dumps(value, indent=2, sort_keys=True))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="continuity", description="Continuity control plane")
    parser.add_argument("--json", action="store_true", help="Emit JSON when supported")
    parser.add_argument("--project-root", help="Configured project root (defaults to upward discovery)")
    top = parser.add_subparsers(dest="domain", required=True)

    note = top.add_parser("note")
    note_sub = note.add_subparsers(dest="command", required=True)
    capture = note_sub.add_parser("capture")
    capture.add_argument("--text")
    capture.add_argument("--file")
    capture.add_argument("--items-file")
    capture.add_argument("--source-type")
    capture.add_argument("--source-ref")
    capture.add_argument("--document-type", choices=sorted(DOCUMENT_TYPES))
    capture.add_argument("--document-id")
    capture.add_argument("--document-version")
    capture.add_argument("--source-authority", choices=sorted(DOCUMENT_SOURCE_AUTHORITIES))
    capture.set_defaults(handler=note_capture)
    triage = note_sub.add_parser("triage")
    triage.add_argument("capture_id")
    triage.add_argument("item_id")
    triage.add_argument("--kind", choices=sorted(NOTE_KINDS))
    triage.add_argument("--action", choices=["route", "defer", "archive", "promote"], default="route")
    triage.add_argument("--review-after")
    triage.add_argument("--perspective", choices=sorted(NOTE_PERSPECTIVES))
    triage.add_argument("--sentiment", choices=sorted(NOTE_SENTIMENTS))
    triage.add_argument("--occurrence-type", choices=sorted(NOTE_OCCURRENCE_TYPES))
    triage.add_argument("--impact", choices=sorted(NOTE_IMPACTS))
    triage.add_argument("--confidence", choices=sorted(NOTE_CONFIDENCE))
    triage.add_argument("--actionability", choices=sorted(NOTE_ACTIONABILITY))
    triage.add_argument("--occurred-at-confidence", choices=sorted(NOTE_OCCURRED_AT_CONFIDENCE))
    triage.add_argument("--stakeholder", action="append")
    triage.add_argument("--theme", action="append")
    triage.add_argument("--pattern-key")
    triage.set_defaults(handler=note_triage)
    notes = note_sub.add_parser("list")
    notes.add_argument("--kind", choices=sorted(NOTE_KINDS))
    notes.set_defaults(handler=note_list)
    queue = note_sub.add_parser("queue")
    queue.add_argument("--queue", choices=["knowledge", "questions", "documentation", "backlog", "planning"])
    queue.add_argument("--status", choices=["eligible", "all"], default="eligible")
    queue.set_defaults(handler=note_queue)
    resolve = note_sub.add_parser("resolve")
    resolve.add_argument("capture_id")
    resolve.add_argument("item_id")
    resolve.add_argument("--resolution", required=True)
    resolve.add_argument("--actor", default="human")
    resolve.set_defaults(handler=note_resolve)
    migrate_links = note_sub.add_parser("migrate-links")
    migrate_links.add_argument("--actor", default="human")
    migrate_links.set_defaults(handler=note_migrate_links)
    migrate_lifecycle = note_sub.add_parser("migrate-lifecycle")
    migrate_lifecycle.add_argument("--actor", default="human")
    migrate_lifecycle.set_defaults(handler=note_migrate_lifecycle)
    related_goals = note_sub.add_parser("related-goals")
    related_goals.add_argument("note_id")
    related_goals.add_argument("--limit", type=int, default=5)
    related_goals.add_argument("--min-score", type=float, default=RELATED_GOAL_DEFAULT_MIN_SCORE)
    related_goals.set_defaults(handler=note_related_goals)
    relate = note_sub.add_parser("relate")
    relate.add_argument("note_id")
    relate.add_argument("--goal-id", required=True)
    relate.add_argument("--disposition", choices=["later", "context-only", "duplicate"], required=True)
    relate.add_argument("--reason", required=True)
    relate.add_argument("--review-after")
    relate.add_argument("--roadmap-id")
    relate.add_argument("--canonical-note-id")
    relate.add_argument("--actor", default="human")
    relate.set_defaults(handler=note_relate)
    patterns = note_sub.add_parser("patterns")
    patterns.add_argument("--min-count", type=int, default=2)
    patterns.set_defaults(handler=note_patterns)
    pattern_review = note_sub.add_parser("pattern-review")
    pattern_review.add_argument("pattern_id")
    pattern_review.add_argument("--disposition", choices=["accepted", "deferred", "dismissed"], required=True)
    pattern_review.add_argument("--actor", default="human")
    pattern_review.add_argument("--evidence", action="append", required=True)
    pattern_review.add_argument("--roadmap-id", action="append")
    pattern_review.add_argument("--review-after")
    pattern_review.add_argument("--min-count", type=int, default=2)
    pattern_review.set_defaults(handler=note_pattern_review)
    share = note_sub.add_parser("share")
    share_sub = share.add_subparsers(dest="share_command", required=True)
    prepare = share_sub.add_parser("prepare")
    prepare.add_argument("note_ids", nargs="+")
    prepare.add_argument("--packet-id")
    prepare.add_argument("--target-project", required=True)
    prepare.add_argument("--sender", required=True)
    prepare.add_argument("--source-pr")
    prepare.add_argument("--roadmap-id", action="append")
    prepare.add_argument("--relation", choices=sorted(roadmap_lib.NOTE_RELATIONS), default="suggests")
    prepare.set_defaults(handler=shared_note_command, shared_note_handler=shared_notes_lib.prepare)
    share_approve = share_sub.add_parser("approve")
    share_approve.add_argument("packet_id")
    share_approve.add_argument("--version", type=int, required=True)
    share_approve.add_argument("--approved-by", required=True)
    share_approve.add_argument("--authorization-text", required=True)
    share_approve.add_argument("--signing-key")
    share_approve.set_defaults(handler=shared_note_command, shared_note_handler=shared_notes_lib.approve)
    publish = share_sub.add_parser("publish")
    publish.add_argument("packet_id")
    publish.add_argument("--dry-run", action="store_true")
    publish.set_defaults(handler=shared_note_command, shared_note_handler=shared_notes_lib.publish)
    import_notes = share_sub.add_parser("import")
    import_notes.set_defaults(handler=shared_note_command, shared_note_handler=shared_notes_lib.import_packets)

    memory = top.add_parser("memory")
    memory_sub = memory.add_subparsers(dest="command", required=True)
    index = memory_sub.add_parser("index")
    index.add_argument("--scope", choices=["trusted", "private", "all"], default="trusted")
    index.set_defaults(handler=memory_index)
    search = memory_sub.add_parser("search")
    search.add_argument("query")
    search.add_argument("--type")
    search.add_argument("--status", choices=sorted(MEMORY_STATUSES))
    search.add_argument("--system")
    search.add_argument("--tag")
    search.add_argument("--source")
    search.add_argument("--since")
    search.add_argument("--scope", choices=["trusted", "private", "all"], default="trusted")
    search.add_argument("--limit", type=int, default=10)
    search.set_defaults(handler=memory_search)
    similar = memory_sub.add_parser("similar")
    similar.add_argument("query")
    similar.add_argument("--scope", choices=["trusted", "private", "all"], default="all")
    similar.add_argument("--limit", type=int, default=10)
    similar.add_argument("--min-score", type=float, default=0.08)
    similar.set_defaults(handler=memory_similar)
    brief = memory_sub.add_parser("brief")
    brief.add_argument("query")
    brief.add_argument("--scope", choices=["trusted", "private", "all"], default="trusted")
    brief.add_argument("--limit", type=int, default=6)
    brief.set_defaults(handler=memory_brief)
    audit = memory_sub.add_parser("audit")
    audit.add_argument("--scope", choices=["trusted", "private", "all"], default="trusted")
    audit.set_defaults(handler=memory_audit)
    verify = memory_sub.add_parser("verify")
    verify.add_argument("memory_id")
    verify.add_argument("--goal-id", required=True)
    verify.add_argument("--commit", required=True)
    verify.add_argument("--mark-current", action="store_true")
    verify.set_defaults(handler=memory_verify)
    promote = memory_sub.add_parser("promote")
    promote.add_argument("note_id")
    promote.add_argument("--goal-id", required=True)
    promote.add_argument("--memory-id")
    promote.add_argument("--title", required=True)
    promote.add_argument("--type", required=True)
    promote.add_argument("--system", required=True)
    promote.add_argument("--summary", required=True)
    promote.add_argument("--tag", action="append")
    promote.add_argument("--confidence", choices=["low", "medium", "high"], default="medium")
    promote.set_defaults(handler=memory_promote)
    supersede = memory_sub.add_parser("supersede")
    supersede.add_argument("memory_id")
    supersede.add_argument("--with", dest="replacement_id", required=True)
    supersede.add_argument("--goal-id", required=True)
    supersede.set_defaults(handler=memory_supersede)

    audit = top.add_parser("audit")
    audit_sub = audit.add_subparsers(dest="command", required=True)
    audit_plan = audit_sub.add_parser("plan")
    audit_plan.add_argument("--input", required=True)
    audit_plan.add_argument("--goal-id")
    audit_plan.set_defaults(handler=product_audit_command)
    audit_start = audit_sub.add_parser("start")
    audit_start.add_argument("audit_id")
    audit_start.add_argument("--actor", default="agent")
    audit_start.add_argument("--worktree")
    audit_start.add_argument("--branch")
    audit_start.set_defaults(handler=product_audit_command)
