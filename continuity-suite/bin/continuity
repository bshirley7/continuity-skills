            "roadmap": "Use the full hybrid roadmap by default. The sidecar stays read-only, local-clone-only, and excluded from every production distribution.",
            "agent_surfaces": "Choose one primary surface and every surface that should receive a project-local Continuity adapter. AGENTS.md remains canonical.",
            "scheduler": "Choose where persistent scheduled actions will be registered. Configuration records intent; registration remains an explicit user action.",
        },
    }


def validate_behavior_settings(root: Path, value: Any) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ContinuityError("Project behavior settings must be a JSON object")
    allowed = {
        "integration_branch",
        "timezone",
        "schedules",
        "max_runtime_minutes",
        "memory_stale_after_days",
        "validation_commands",
        "security_commands",
        "documentation_map",
        "visual_evidence_mode",
        "branch_prefix",
        "project_instructions",
        "planning_patterns",
        "roadmap",
        "agent_surfaces",
        "scheduler",
        "execution_enabled",
    }
    unknown = sorted(set(value) - allowed)
    if unknown:
        raise ContinuityError(f"Unsupported project behavior settings: {unknown}")
    settings = dict(value)
    branch = str(settings.get("integration_branch", ""))
    if git_result(root, "check-ref-format", "--branch", branch).returncode != 0:
        raise ContinuityError("integration_branch is not a valid Git branch name")
    timezone = str(settings.get("timezone", ""))
    try:
        ZoneInfo(timezone)
    except Exception as exc:
        raise ContinuityError(f"Unknown timezone: {timezone}") from exc
    schedules = settings.get("schedules")
    if not isinstance(schedules, dict) or set(schedules) != {"review", "dispatch", "report"}:
        raise ContinuityError("schedules must define exactly review, dispatch, and report")
    for label, scheduled in schedules.items():
        if not isinstance(scheduled, str) or not re.fullmatch(r"(?:[01][0-9]|2[0-3]):[0-5][0-9]", scheduled):
            raise ContinuityError(f"Invalid {label} schedule; use HH:MM in 24-hour time")
    for label, maximum in (("max_runtime_minutes", 360), ("memory_stale_after_days", 3650)):
        number = settings.get(label)
        if isinstance(number, bool) or not isinstance(number, int) or not 1 <= number <= maximum:
            raise ContinuityError(f"{label} must be between 1 and {maximum}")
    for label in ("validation_commands", "security_commands"):
        commands = settings.get(label)
        if not isinstance(commands, list) or any(not isinstance(item, str) or not item.strip() or any(char in item for char in "\n\r\x00") or "```" in item for item in commands):
            raise ContinuityError(f"{label} must be a JSON array of non-empty, single-line strings")
        for command in commands:
            if re.search(r"(?i)(?:token|password|secret|api[_-]?key)\s*=", command) or re.search(r"://[^/\s:@]+:[^/\s@]+@", command):
                raise ContinuityError(f"{label} appears to contain an inline credential; use the project's secret provider")
    documentation_map = settings.get("documentation_map")
    if not isinstance(documentation_map, dict) or not documentation_map:
        raise ContinuityError("documentation_map must be a non-empty JSON object")
    for label, path in documentation_map.items():
        if not isinstance(label, str) or not label.strip() or any(char in label for char in "\n\r\x00") or "```" in label or not isinstance(path, str) or not path.strip() or "```" in path:
            raise ContinuityError("documentation_map keys and paths must be non-empty strings")
        resolved = confined_path(root, path, f"documentation_map.{label}")
        private_root = (root / ".continuity" / "private").resolve()
        if resolved == private_root or resolved.is_relative_to(private_root):
            raise ContinuityError("documentation_map cannot expose private continuity state")
    if settings.get("visual_evidence_mode") not in VISUAL_EVIDENCE_MODES:
        raise ContinuityError(f"visual_evidence_mode must be one of {sorted(VISUAL_EVIDENCE_MODES)}")
    prefix = settings.get("branch_prefix")
    if not isinstance(prefix, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]{0,63}", prefix) or ".." in prefix or prefix.endswith("/"):
        raise ContinuityError("branch_prefix is not a safe Git branch prefix")
    instructions = settings.get("project_instructions")
    if not isinstance(instructions, list) or any(
        not isinstance(item, str)
        or not item.strip()
        or len(item) > 500
        or any(char in item for char in "\n\r\x00")
        or "```" in item
        for item in instructions
    ):
        raise ContinuityError("project_instructions must be a JSON array of non-empty single-line strings up to 500 characters")
    for instruction in instructions:
        if re.search(r"(?i)(?:token|password|secret|api[_-]?key)\s*=", instruction):
            raise ContinuityError("project_instructions cannot contain inline credentials")
        if re.search(r"(?i)(?:allow|permit|enable).{0,40}(?:force[- ]?push|auto[- ]?merge)", instruction) or re.search(
            r"(?i)(?:skip|disable|bypass|omit|ignore).{0,40}(?:approval|audit|security|validation|merge[- ]?safety|human[- ]?review)",
            instruction,
        ):
            raise ContinuityError("project_instructions cannot weaken fixed continuity guardrails")
    planning_patterns = settings.get("planning_patterns")
    if not isinstance(planning_patterns, dict) or set(planning_patterns) != set(DEFAULT_PLANNING_PATTERNS):
        raise ContinuityError("planning_patterns must define exactly evidence_triage, decision_mapping, delivery_slicing, and tracker_provider")
    for key in ("evidence_triage", "decision_mapping", "delivery_slicing"):
        if planning_patterns.get(key) not in PLANNING_PATTERN_MODES:
            raise ContinuityError(f"planning_patterns.{key} must be one of {sorted(PLANNING_PATTERN_MODES)}")
    if planning_patterns.get("tracker_provider") not in TRACKER_PROVIDERS:
        raise ContinuityError(f"planning_patterns.tracker_provider must be one of {sorted(TRACKER_PROVIDERS)}")
    roadmap = settings.get("roadmap")
    if not isinstance(roadmap, dict) or set(roadmap) != set(DEFAULT_ROADMAP_SETTINGS):
        raise ContinuityError(f"roadmap must define exactly {sorted(DEFAULT_ROADMAP_SETTINGS)}")
    if not isinstance(roadmap.get("enabled"), bool):
        raise ContinuityError("roadmap.enabled must be true or false")
    fixed_roadmap = {"ui_mode": "local-read-only", "shared_notes": "explicit-project-inbox", "production_distribution": "forbidden"}
    for key, expected in fixed_roadmap.items():
        if roadmap.get(key) != expected:
            raise ContinuityError(f"roadmap.{key} is a fixed safety boundary and must be {expected}")
    if roadmap.get("agile_mode") not in {"hybrid", "kanban", "milestone"}:
        raise ContinuityError("roadmap.agile_mode is unsupported")
    if roadmap.get("hierarchy") not in {"full", "lightweight"}:
        raise ContinuityError("roadmap.hierarchy is unsupported")
    agent_surfaces = settings.get("agent_surfaces")
    if not isinstance(agent_surfaces, dict) or set(agent_surfaces) != {"primary", "enabled"}:
        raise ContinuityError("agent_surfaces must define exactly primary and enabled")
    primary_surface = agent_surfaces.get("primary")
    enabled_surfaces = agent_surfaces.get("enabled")
    if primary_surface not in AGENT_SURFACES:
        raise ContinuityError(f"agent_surfaces.primary must be one of {sorted(AGENT_SURFACES)}")
    if (
        not isinstance(enabled_surfaces, list)
        or not enabled_surfaces
        or any(item not in AGENT_SURFACES for item in enabled_surfaces)
        or len(enabled_surfaces) != len(set(enabled_surfaces))
        or primary_surface not in enabled_surfaces
    ):
        raise ContinuityError("agent_surfaces.enabled must be a unique non-empty list of supported surfaces containing the primary surface")
    agent_surfaces["enabled"] = sorted(enabled_surfaces)
    scheduler = settings.get("scheduler")
    if not isinstance(scheduler, dict) or set(scheduler) != {"provider"}:
        raise ContinuityError("scheduler must define exactly provider")
    provider = scheduler.get("provider")
    if provider not in SCHEDULER_PROVIDERS:
        raise ContinuityError(f"scheduler.provider must be one of {sorted(SCHEDULER_PROVIDERS)}")
    if provider in {"codex", "claude-code"} and provider not in agent_surfaces["enabled"]:
        raise ContinuityError("scheduler.provider must name an enabled agent surface or use external/none")
    if not isinstance(settings.get("execution_enabled"), bool):
        raise ContinuityError("execution_enabled must be true or false")
    return settings


def interactive_behavior_answers(recommended: dict[str, Any]) -> dict[str, Any]:
    print("Continuity guided configuration", file=sys.stderr)
    print("Press Enter to accept each recommended value. Fixed guardrails cannot be overridden.", file=sys.stderr)

    def text_answer(label: str, default: str) -> str:
        answer = input(f"{label} [{default}]: ").strip()
        return answer or default

    def int_answer(label: str, default: int) -> int:
        answer = input(f"{label} [{default}]: ").strip()
        try:
            return int(answer) if answer else default
        except ValueError as exc:
            raise ContinuityError(f"{label} must be an integer") from exc

    def json_answer(label: str, default: Any) -> Any:
        rendered = json.dumps(default, sort_keys=True)
        answer = input(f"{label} as JSON [{rendered}]: ").strip()
        if not answer:
            return default
        try:
            return json.loads(answer)
        except json.JSONDecodeError as exc:
            raise ContinuityError(f"{label} must be valid JSON") from exc

    schedules = recommended["schedules"]
    answers = {
        "integration_branch": text_answer("Integration branch", recommended["integration_branch"]),
        "timezone": text_answer("IANA timezone", recommended["timezone"]),
        "schedules": {
            "review": text_answer("Daily review time", schedules["review"]),
            "dispatch": text_answer("Default dispatch time", schedules["dispatch"]),
            "report": text_answer("Morning report time", schedules["report"]),
        },
        "max_runtime_minutes": int_answer("Maximum unattended runtime in minutes", recommended["max_runtime_minutes"]),
        "memory_stale_after_days": int_answer("Memory verification age in days", recommended["memory_stale_after_days"]),
        "validation_commands": json_answer("Validation commands", recommended["validation_commands"]),
        "security_commands": json_answer("Security commands", recommended["security_commands"]),
        "documentation_map": json_answer("Documentation map", recommended["documentation_map"]),
        "visual_evidence_mode": text_answer("Visual evidence mode", recommended["visual_evidence_mode"]),
        "branch_prefix": text_answer("Goal branch prefix", recommended["branch_prefix"]),
        "project_instructions": json_answer("Additional project-specific instructions", recommended["project_instructions"]),
        "planning_patterns": json_answer("Planning pattern modes", recommended["planning_patterns"]),
        "roadmap": json_answer("Roadmap behavior", recommended["roadmap"]),
        "agent_surfaces": json_answer("Agent surfaces (primary and enabled)", recommended["agent_surfaces"]),
        "scheduler": json_answer("Persistent scheduler provider", recommended["scheduler"]),
    }
    execution = input("Enable real product-code execution now? [y/N, recommended N]: ").strip().lower()
    answers["execution_enabled"] = execution in {"y", "yes"}
    return answers


def project_configure(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    manifest = load_project_manifest(root)
    recommendations = recommended_behavior_settings(root, config, manifest)
    current = current_behavior_settings(root, config, manifest)
    if args.interactive and args.answers_file:
        raise ContinuityError("Use either --interactive or --answers-file, not both")
    if args.interactive:
        answers = interactive_behavior_answers(recommendations)
    elif args.answers_file:
        answers = json_load(Path(args.answers_file).expanduser().resolve(), {})
        if not isinstance(answers, dict):
            raise ContinuityError("Configuration answers file must contain a JSON object")
    else:
        raise ContinuityError("Choose --interactive or provide --answers-file")
    merged = dict(current)
    if "schedules" in answers:
        if not isinstance(answers["schedules"], dict):
            raise ContinuityError("schedules override must be a JSON object")
        answers = dict(answers)
        answers["schedules"] = {**current.get("schedules", {}), **answers["schedules"]}
    merged.update(answers)
    settings = validate_behavior_settings(root, merged)
    overrides = sorted(key for key, value in settings.items() if value != recommendations.get(key))
    record = {
        "schema_version": BEHAVIOR_SCHEMA_VERSION,
        "assurance_standard_version": ASSURANCE_STANDARD_VERSION,
        "project_id": config.get("project_id"),
        "recommendation_profile": BEHAVIOR_PROFILE,
        "settings": settings,
        "overrides": overrides,
        "fixed_guardrails": FIXED_GUARDRAILS,
    }
    record["configuration_hash"] = behavior_payload_hash(record)
    if args.dry_run:
        return {"changed": record != json_load(root / BEHAVIOR_CONFIG_PATH, {}), "behavior": record}

    before_hash = config.get("behavior_configuration_hash")
    before_config_hash = canonical_hash(config)
    before_manifest_hash = canonical_hash(manifest)
    config.update(
        {
            "integration_branch": settings["integration_branch"],
            "timezone": settings["timezone"],
            "default_start_time": settings["schedules"]["dispatch"],
            "max_runtime_minutes": settings["max_runtime_minutes"],
            "memory_stale_after_days": settings["memory_stale_after_days"],
            "validation_commands": settings["validation_commands"],
            "security_commands": settings["security_commands"],
            "documentation_map": settings["documentation_map"],
            "visual_evidence_mode": settings["visual_evidence_mode"],
            "branch_prefix": settings["branch_prefix"],
            "project_instructions": settings["project_instructions"],
            "planning_patterns": settings["planning_patterns"],
            "roadmap": settings["roadmap"],
            "agent_surfaces": settings["agent_surfaces"],
            "scheduler": settings["scheduler"],
            "roadmap_docs": "docs/project-roadmap",
            "behavior_config_path": BEHAVIOR_CONFIG_PATH,
            "behavior_skill_path": BEHAVIOR_SKILL_PATH,
            "behavior_configuration_hash": record["configuration_hash"],
            "require_remote": True,
            "require_pr": True,
            "require_pr_auth": True,
            "require_execution_artifacts": True,
            "require_isolated_worktree": True,
            "refresh_base_on_preflight": True,
        }
    )
    manifest.update(
        {
            "integration_branch": settings["integration_branch"],
            "timezone": settings["timezone"],
            "schedules": settings["schedules"],
            "roadmap": settings["roadmap"],
            "agent_surfaces": settings["agent_surfaces"],
            "scheduler": settings["scheduler"],
            "max_concurrency": 1,
            "execution_enabled": settings["execution_enabled"],
            "behavior_configuration_hash": record["configuration_hash"],
        }
    )
    behavior_path = confined_path(root, BEHAVIOR_CONFIG_PATH, "behavior_config_path")
    skill_path = confined_path(root, BEHAVIOR_SKILL_PATH, "behavior_skill_path")
    json_dump(behavior_path, record)
    json_dump(root / ".continuity" / "config.json", config)
    json_dump(root / ".continuity" / "project.json", manifest)
    skill_path.parent.mkdir(parents=True, exist_ok=True)
    skill_temp = skill_path.with_suffix(".tmp")
    skill_temp.write_text(render_project_behavior_skill(record), encoding="utf-8")
    skill_temp.replace(skill_path)
    sync_surface_adapters(root, settings)
    changed = (
        before_hash != record["configuration_hash"]
        or before_config_hash != canonical_hash(config)
        or before_manifest_hash != canonical_hash(manifest)
    )
    if changed:
        append_jsonl(
            private_path(root, config) / "configuration-audit.jsonl",
            {
                "at": iso_now(config),
                "actor": args.actor,
                "previous_hash": before_hash,
                "configuration_hash": record["configuration_hash"],
                "changed_fields": sorted(answers),
                "reconciled_configuration": before_config_hash != canonical_hash(config),
                "reconciled_manifest": before_manifest_hash != canonical_hash(manifest),
            },
        )
    validate_project_behavior(root, config)
    return {
        "configured": True,
        "project_id": config.get("project_id"),
        "configuration_hash": record["configuration_hash"],
        "changed": changed,
        "overrides": overrides,
        "execution_enabled": settings["execution_enabled"],
        "agent_surfaces": settings["agent_surfaces"],
        "scheduler": settings["scheduler"],
        "behavior_skill": BEHAVIOR_SKILL_PATH,
    }


def project_doctor(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    manifest = load_project_manifest(root)
    records = discover_projects([root])
    record = next((item for item in records if item.get("path") == str(root)), None)
    if not record:
        raise ContinuityError("Project could not be discovered from its own root")
    record["integration_branch_matches"] = manifest.get("integration_branch") == config.get("integration_branch")
    record["execution_enabled"] = manifest.get("execution_enabled", False)
    record["healthy"] = record["healthy"] and record["integration_branch_matches"]
    if not record["integration_branch_matches"]:
        record["problems"].append("manifest and configuration integration branches differ")
    try:
        behavior = validate_project_behavior(root, config)
        record["behavior_configuration_hash"] = behavior["configuration_hash"]
        record["behavior_skill"] = config.get("behavior_skill_path")
    except ContinuityError as exc:
        record["healthy"] = False
        record["problems"].append(str(exc))
    return record


def git_result(root: Path, *arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(root), *arguments],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )


def execution_preflight(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    failures: list[str] = []
    evidence: list[str] = []
    try:
        manifest = load_project_manifest(root)
        if not manifest.get("continuity_enabled"):
            failures.append("Continuity is disabled")
        if not manifest.get("execution_enabled"):
            failures.append("project product-code execution is disabled")
        if manifest.get("project_id") != config.get("project_id"):
            failures.append("project manifest and configuration IDs differ")
        if manifest.get("integration_branch") != config.get("integration_branch"):
            failures.append("project manifest and configuration integration branches differ")
        evidence.append("project-manifest:present")
    except ContinuityError as exc:
        failures.append(str(exc))
    try:
        _goal, approval = validate_approval(root, config, args.goal_id)
        evidence.append(f"approval:{approval['plan_hash']}")
    except ContinuityError as exc:
        failures.append(str(exc))
    compliance = json_load(directory / "compliance.json", {})
    for stage in ("memory-retrieval", "roadmap-retrieval", "plan-review", "approval"):
        status = compliance.get("stages", {}).get(stage, {}).get("status")
        if status not in {"passed", "not-applicable"}:
            failures.append(f"compliance stage {stage} is {status or 'missing'}")
    inside = git_result(root, "rev-parse", "--is-inside-work-tree")
    if inside.returncode != 0:
        failures.append("repository is not a Git working tree")
    else:
        evidence.append("git-worktree:ok")
    base = config.get("integration_branch")
    if not base:
        failures.append("integration_branch is not configured")
    else:
        if config.get("refresh_base_on_preflight", False):
            fetched = git_result(root, "fetch", "origin", base)
            if fetched.returncode != 0:
                failures.append(f"failed to fetch origin/{base}: {fetched.stderr.strip()}")
            else:
                evidence.append(f"fetched:origin/{base}")
        local = git_result(root, "show-ref", "--verify", f"refs/heads/{base}")
        remote = git_result(root, "show-ref", "--verify", f"refs/remotes/origin/{base}")
        if local.returncode != 0 and remote.returncode != 0:
            failures.append(f"integration branch {base} is unavailable")
        else:
            evidence.append(f"integration-branch:{base}")
    if config.get("require_remote", True):
        remote_url = git_result(root, "remote", "get-url", "origin")
        if remote_url.returncode != 0 or not remote_url.stdout.strip():
            failures.append("origin remote is unavailable")
        else:
            evidence.append("origin:configured")
    if config.get("require_pr_auth", False):
        gh = shutil.which("gh")
        if not gh:
            failures.append("GitHub CLI is required but unavailable")
        else:
            auth = subprocess.run([gh, "auth", "status"], capture_output=True, text=True, timeout=30, check=False)
            if auth.returncode != 0:
                failures.append("GitHub CLI authentication is unavailable")
            else:
                evidence.append("gh-auth:ok")
    if not (root / "AGENTS.md").exists():
        failures.append("AGENTS.md is unavailable")
    else:
        evidence.append("AGENTS.md:present")
    states = dependency_states(root, config, goal)
    blocked = {key: state for key, state in states.items() if state != "completed"}
    if blocked:
        failures.append(f"unmet dependencies: {blocked}")
    stamp = iso_now(config)
    status = "passed" if not failures else "failed"
    compliance.setdefault("stages", {})["execution-preflight"] = {
        "status": status,
        "evidence": evidence + failures,
        "actor": "continuity-cli",
        "updated_at": stamp,
    }
    compliance["updated_at"] = stamp
    json_dump(directory / "compliance.json", compliance)
    report = {"goal_id": args.goal_id, "passed": not failures, "failures": failures, "evidence": evidence}
    json_dump(directory / "preflight.json", report)
    return report


def execution_checkpoint(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, _goal = load_goal(root, config, args.goal_id)
    checkpoint = {
        "at": iso_now(config),
        "phase": args.phase,
        "summary": args.summary,
        "alignment": args.alignment,
        "evidence": args.evidence or [],
    }
    append_jsonl(directory / "checkpoints.jsonl", checkpoint)
    return checkpoint


def goal_start(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    goal, approval = validate_approval(root, config, args.goal_id)
    if goal.get("state") != "queued":
        raise ContinuityError(f"Only a queued goal can be dispatched; current state is {goal.get('state')}")
    directory = goal_dir(root, config, args.goal_id)
    preflight = execution_preflight(argparse.Namespace(goal_id=args.goal_id))
    if not preflight["passed"]:
        raise ContinuityError(f"Execution preflight failed: {preflight['failures']}")
    lock_path = private_path(root, config) / "project.lock.json"
    states = dependency_states(root, config, goal)
    blocked = {key: state for key, state in states.items() if state != "completed"}
    if blocked:
        raise ContinuityError(f"Unmet dependencies: {blocked}")
    stamp = iso_now(config)
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(lock_path, flags, 0o600)
    except FileExistsError as exc:
        lock = json_load(lock_path, {})
        if lock.get("goal_id") == args.goal_id:
            existing = json_load(directory / "dispatch.json")
            if existing:
                return existing
        raise ContinuityError(f"Project is locked by active goal {lock.get('goal_id', 'unknown')}") from exc
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        handle.write(json.dumps({"goal_id": args.goal_id, "acquired_at": stamp}, sort_keys=True) + "\n")
    goal["state"] = "dispatched"
    goal["dispatched_at"] = stamp
    goal["updated_at"] = stamp
    json_dump(directory / "goal.json", goal)
    update_note_work_status(root, config, goal.get("source_note_ids", []), "dispatched", goal_id=goal["goal_id"])
    prompt = {
        "goal_id": goal["goal_id"],
        "project_id": config["project_id"],
        "repository": str(root),
        "integration_branch": config["integration_branch"],
        "base_ref": f"origin/{config['integration_branch']}" if config.get("require_remote", True) else config["integration_branch"],
        "branch_name": f"{config.get('branch_prefix', 'continuity')}/{now(config).date().isoformat()}/{slug(config['project_id'])}-{slug(goal['title'])}",
        "worktree_path": str(root.parent / "worktrees" / f"{slug(config.get('branch_prefix', 'continuity'))}-{slug(goal['goal_id'])}"),
        "plan_path": str((directory / "plan.md").relative_to(root)),
        "goal_path": str((directory / "goal.json").relative_to(root)),
        "approval": approval,
        "approved_plan": (directory / "plan.md").read_text(encoding="utf-8"),
        "approved_plan_hash": approval["plan_hash"],
        "source_note_ids": goal.get("source_note_ids", []),
        "memory_ids": goal.get("memory_ids", []),
        "roadmap_ids": goal.get("roadmap_ids", []),
        "roadmap_impact": goal.get("roadmap_impact", {}),
        "runtime_limit_minutes": goal["runtime_limit_minutes"],
        "required_checks": config.get("validation_commands", []) + goal.get("required_checks", []),
        "required_security_checks": config.get("security_commands", []),
        "documentation_map": config.get("documentation_map", {}),
        "visual_evidence_mode": config.get("visual_evidence_mode", "when-applicable"),
        "project_instructions": config.get("project_instructions", []),
        "behavior_configuration_hash": config.get("behavior_configuration_hash"),
        "behavior_skill_path": config.get("behavior_skill_path", BEHAVIOR_SKILL_PATH),
        "assurance_standard_version": ASSURANCE_STANDARD_VERSION,
        "deadline": (now(config) + dt.timedelta(minutes=goal["runtime_limit_minutes"])).isoformat(timespec="seconds"),
    }
    json_dump(directory / "dispatch.json", prompt)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": "goal.dispatched", "goal_id": goal["goal_id"]})
    return prompt


def goal_gate(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    compliance = json_load(directory / "compliance.json", {})
    if compliance.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Compliance ledger uses a missing or unsupported assurance standard")
    if args.stage not in COMPLIANCE_STAGES:
        raise ContinuityError(f"Unknown compliance stage: {args.stage}")
    if args.status not in COMPLIANCE_STATUSES:
        raise ContinuityError(f"Invalid compliance status: {args.status}")
    if args.status in {"passed", "failed", "not-applicable"} and not args.evidence:
        raise ContinuityError("Non-pending compliance states require evidence")
    if goal.get("state") in TERMINAL_STATES and args.stage != "human-review":
        raise ContinuityError("Only human-review evidence may be added after a goal becomes terminal")
    stamp = iso_now(config)
    compliance.setdefault("stages", {})[args.stage] = {
        "status": args.status,
        "evidence": args.evidence or [],
        "actor": args.actor,
        "updated_at": stamp,
    }
    compliance["updated_at"] = stamp
    json_dump(directory / "compliance.json", compliance)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": "goal.compliance", "goal_id": args.goal_id, "stage": args.stage, "status": args.status})
    return compliance["stages"][args.stage]


def goal_transition(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    transition = args.transition
    current = goal.get("state")
    if transition == "hold":
        if current not in {"awaiting-feedback", "queued"}:
            raise ContinuityError(f"Goal in state {current} cannot be held")
        goal["held_from"] = current
        target = "held"
    elif transition == "resume":
        if current != "held":
            raise ContinuityError(f"Goal in state {current} cannot be resumed")
        target = goal.pop("held_from", None)
        if target not in {"awaiting-feedback", "queued"}:
            raise ContinuityError("Held goal has no valid prior state")
        if target == "queued":
            approval = json_load(directory / "approval.json", {})
            if (
                not isinstance(approval, dict)
                or approval.get("plan_version") != goal.get("plan_version")
                or approval.get("plan_hash") != goal_material_hash(directory, goal)
            ):
                raise ContinuityError("Held goal approval is missing or stale")
    else:
        if current not in {"proposed-plan", "awaiting-feedback", "approved", "queued", "held"}:
            raise ContinuityError("Active execution must be stopped before recording cancellation")
        target = "cancelled"
    stamp = iso_now(config)
    lock_path = private_path(root, config) / "project.lock.json"
    lock = json_load(lock_path)
    if isinstance(lock, dict) and lock.get("goal_id") == args.goal_id:
        raise ContinuityError("Pre-execution transition found an active project lock; use run update after stopping the executor")
    goal["state"] = target
    goal["updated_at"] = stamp
    if transition == "resume" and target == "queued" and not goal.get("scheduled_for"):
        goal["scheduled_for"] = next_default_start(config)
    json_dump(directory / "goal.json", goal)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": f"goal.{transition}", "goal_id": args.goal_id})
    return goal


def goal_feedback(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, _goal = load_goal(root, config, args.goal_id)
    event = {"at": iso_now(config), "author": args.author, "type": "feedback", "text": args.text}
    append_jsonl(directory / "feedback.jsonl", event)
    return event


def goal_list(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    values = []
    for path in sorted((private_path(root, config) / "goals").glob("*/goal.json")):
        goal = json_load(path)
        if args.state and goal.get("state") != args.state:
            continue
        values.append(goal)
    return values


def goal_due(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    current = now(config)
    due = []
    for goal in goal_list(argparse.Namespace(state="queued")):
        scheduled_text = goal.get("scheduled_for")
        if not scheduled_text:
            continue
        try:
            scheduled = dt.datetime.fromisoformat(scheduled_text)
        except (TypeError, ValueError):
            continue
        if scheduled.tzinfo is None:
            scheduled = scheduled.replace(tzinfo=ZoneInfo(config["timezone"]))
        if scheduled <= current:
            states = dependency_states(root, config, goal)
            goal["dependency_states"] = states
            if all(state == "completed" for state in states.values()):
                due.append(goal)
    return due


def record_compliance_stage(
    root: Path,
    config: dict[str, Any],
    directory: Path,
    goal: dict[str, Any],
    stage: str,
    status: str,
    evidence: list[str],
    actor: str,
) -> dict[str, Any]:
    if stage not in COMPLIANCE_STAGES:
        raise ContinuityError(f"Unknown compliance stage: {stage}")
    if status not in COMPLIANCE_STATUSES:
        raise ContinuityError(f"Invalid compliance status: {status}")
    if status in {"passed", "failed", "not-applicable"} and not evidence:
        raise ContinuityError("Non-pending compliance states require evidence")
    if goal.get("state") in TERMINAL_STATES and stage != "human-review":
        raise ContinuityError("Only human-review evidence may be added after a goal becomes terminal")
    stamp = iso_now(config)
    compliance = json_load(directory / "compliance.json", {})
    if compliance.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Compliance ledger uses a missing or unsupported assurance standard")
    compliance.setdefault("stages", {})[stage] = {
        "status": status,
        "evidence": evidence,
        "actor": actor,
        "updated_at": stamp,
    }
    compliance["updated_at"] = stamp
    json_dump(directory / "compliance.json", compliance)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": "goal.compliance", "goal_id": goal["goal_id"], "stage": stage, "status": status})
    return compliance["stages"][stage]


def goal_test_commands(config: dict[str, Any], goal: dict[str, Any] | None = None) -> list[str]:
    commands = list(config.get("validation_commands", []))
    if goal:
        commands.extend(goal.get("required_checks", []))
    seen: set[str] = set()
    ordered: list[str] = []
    for command in commands:
        if command not in seen:
            ordered.append(command)
            seen.add(command)
    return ordered


def test_plan(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    goal: dict[str, Any] | None = None
    if args.goal_id:
        _directory, goal = load_goal(root, config, args.goal_id)
    return {
        "project_id": config["project_id"],
        "goal_id": goal.get("goal_id") if goal else None,
        "generated_at": iso_now(config),
        "assurance_standard_version": ASSURANCE_STANDARD_VERSION,
        "standard_reference": ".agents/continuity/references/testing-and-merge-standard.md",
        "worktree": args.worktree,
        "integration_branch": config.get("integration_branch"),
        "validation_commands": goal_test_commands(config, goal),
        "security_commands": list(config.get("security_commands", [])),
        "evergreen_checks": EVERGREEN_TEST_CHECKS,
        "merge_safety_checks": MERGE_SAFETY_CHECKS,
        "required_evidence": {
            "code_review": "diff review method, changed files or commit, findings, and resolution",
            "validation": "exact command, exit status, relevant output summary, and targeted regression coverage",
            "security_review": "configured scanner results plus evidence-based review of touched trust boundaries",
            "merge_safety": "base refresh, branch state, PR readiness, and unresolved risk",
        },
        "goal_context": {
            "state": goal.get("state") if goal else None,
            "acceptance_criteria": goal.get("acceptance_criteria", []) if goal else [],
            "source_note_ids": goal.get("source_note_ids", []) if goal else [],
            "memory_ids": goal.get("memory_ids", []) if goal else [],
            "roadmap_ids": goal.get("roadmap_ids", []) if goal else [],
        },
    }


def test_record(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    validation_evidence = args.validation_evidence or []
    security_evidence = args.security_evidence or []
    review_evidence = args.code_review_evidence or []
    if args.status == "passed":
        missing = []
        if not review_evidence:
            missing.append("code-review evidence")
        if not validation_evidence:
            missing.append("validation evidence")
        if not security_evidence:
            missing.append("security-review evidence")
        if missing:
            raise ContinuityError(f"Cannot record a passed test report without {', '.join(missing)}")
    stamp = iso_now(config)
    artifacts: list[str] = []
    evidence_root = Path(args.worktree).expanduser().resolve() if args.worktree else root
    for value in args.artifact or []:
        path = Path(value).expanduser().resolve()
        if not path.is_file():
            raise ContinuityError(f"Test artifact does not exist: {value}")
        if not path.is_relative_to(evidence_root):
            raise ContinuityError(f"Test artifact is outside the worktree: {value}")
        if path.is_relative_to(private_path(root, config)):
            raise ContinuityError("Private continuity state cannot be used as test evidence")
        artifacts.append(str(path))
    report = {
        "project_id": config["project_id"],
        "goal_id": args.goal_id,
        "status": args.status,
        "summary": args.summary,
        "actor": args.actor,
        "updated_at": stamp,
        "worktree": args.worktree,
        "branch": args.branch,
        "validation_commands": goal_test_commands(config, goal),
        "security_commands": list(config.get("security_commands", [])),
        "code_review_evidence": review_evidence,
        "validation_evidence": validation_evidence,
        "security_evidence": security_evidence,
        "findings": args.finding or [],
        "artifacts": artifacts,
        "evergreen_checks": EVERGREEN_TEST_CHECKS,
    }
    json_dump(directory / "test-report.json", report)
    append_jsonl(private_path(root, config) / "reports" / "test-reports.jsonl", report)
    if args.update_gates:
        gate_status = "passed" if args.status == "passed" else "failed"
        record_compliance_stage(root, config, directory, goal, "code-review", gate_status, review_evidence + (args.finding or []), args.actor)
        record_compliance_stage(root, config, directory, goal, "validation", gate_status, validation_evidence, args.actor)
        record_compliance_stage(root, config, directory, goal, "security-review", gate_status, security_evidence, args.actor)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": "test.report", "goal_id": args.goal_id, "status": args.status})
    return report


def merge_assess(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    execution = json_load(directory / "execution.json", {})
    branch = args.branch or execution.get("branch")
    base = args.base or config.get("integration_branch")
    pr_url = args.pr_url or execution.get("pr_url")
    worktree = Path(args.worktree or execution.get("worktree") or root).expanduser().resolve()
    failures: list[str] = []
    evidence = list(args.evidence or [])
    if not branch:
        failures.append("goal branch is missing")
    elif branch == base:
        failures.append("goal branch must differ from integration branch")
    if not worktree.is_dir():
        failures.append(f"worktree is unavailable: {worktree}")
    else:
        inside = git_result(worktree, "rev-parse", "--is-inside-work-tree")
        if inside.returncode != 0:
            failures.append("worktree is not a Git repository")
        else:
            current_branch = git_result(worktree, "rev-parse", "--abbrev-ref", "HEAD")
            if current_branch.returncode == 0:
                actual_branch = current_branch.stdout.strip()
                evidence.append(f"worktree-branch:{actual_branch}")
                if branch and actual_branch != branch:
                    failures.append(f"worktree is on {actual_branch}, not {branch}")
            status = git_result(worktree, "status", "--short")
            if status.returncode != 0:
                failures.append("unable to inspect working tree status")
            else:
                dirty_lines = [
                    line for line in status.stdout.splitlines()
                    if ".continuity/private/" not in line and ".agents/continuity/lib/__pycache__/" not in line
                ]
                if dirty_lines:
                    failures.append("working tree has uncommitted changes")
                else:
                    evidence.append("working-tree:clean")
            if base:
                merge_base = git_result(worktree, "merge-base", "HEAD", base)
                if merge_base.returncode != 0:
                    evidence.append(f"merge-base-check:unavailable:{base}")
                else:
                    evidence.append(f"merge-base:{merge_base.stdout.strip()}")
    if config.get("require_pr", True):
        if not pr_url:
            failures.append("PR URL is required")
        elif not re.fullmatch(r"https://github\.com/[^/]+/[^/]+/pull/\d+", str(pr_url)):
            failures.append("PR URL is not a GitHub pull request URL")
    test_report = json_load(directory / "test-report.json", {})
    if not isinstance(test_report, dict) or test_report.get("status") != "passed":
        failures.append("latest test report is not passed")
    else:
        evidence.append(f"test-report:{test_report.get('updated_at')}")
    compliance = json_load(directory / "compliance.json", {})
    for stage in ("code-review", "validation", "security-review"):
        status = compliance.get("stages", {}).get(stage, {}).get("status")
        if status not in {"passed", "not-applicable"}:
            failures.append(f"compliance stage {stage} is {status or 'missing'}")
    computed_status = "failed" if failures else "passed"
    if args.status and args.status != computed_status:
        if args.status == "passed":
            raise ContinuityError(f"Cannot force a passed merge assessment with failures: {failures}")
        computed_status = args.status
    stamp = iso_now(config)
    report = {
        "project_id": config["project_id"],
        "goal_id": args.goal_id,
        "status": computed_status,
        "updated_at": stamp,
        "actor": args.actor,
        "branch": branch,
        "base": base,
        "pr_url": pr_url,
        "worktree": str(worktree),
        "failures": failures,
        "evidence": evidence,
        "human_merge_required": True,
        "auto_merge_allowed": False,
        "force_push_allowed": False,
        "merge_safety_checks": MERGE_SAFETY_CHECKS,
    }
    json_dump(directory / "merge-assessment.json", report)
    append_jsonl(private_path(root, config) / "reports" / "merge-assessments.jsonl", report)
    if args.update_gate:
        gate_status = "passed" if computed_status == "passed" else "failed"
        record_compliance_stage(root, config, directory, goal, "merge-safety", gate_status, evidence + failures, args.actor)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": "merge.assess", "goal_id": args.goal_id, "status": computed_status})
    return report


def merge_record_human(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if not args.evidence:
        raise ContinuityError("Human merge review requires evidence")
    if config.get("require_pr", True) and not re.fullmatch(r"https://github\.com/[^/]+/[^/]+/pull/\d+", args.pr_url):
        raise ContinuityError("A valid GitHub PR URL is required")
    stamp = iso_now(config)
    report = {
        "project_id": config["project_id"],
        "goal_id": args.goal_id,
        "status": "merged" if args.merge_commit else "reviewed",
        "updated_at": stamp,
        "actor": args.actor,
        "pr_url": args.pr_url,
        "merged_by": args.merged_by,
        "merge_commit": args.merge_commit,
        "evidence": args.evidence,
        "human_merge_required": True,
        "auto_merge_used": False,
    }
    json_dump(directory / "human-review.json", report)
    append_jsonl(private_path(root, config) / "reports" / "human-reviews.jsonl", report)
    record_compliance_stage(root, config, directory, goal, "human-review", "passed", args.evidence, args.actor)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": "merge.human-review", "goal_id": args.goal_id, "status": report["status"]})
    return report


def run_update(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if args.state not in {"running", "validating", *TERMINAL_STATES}:
        raise ContinuityError(f"Invalid execution state: {args.state}")
    current = goal.get("state")
    allowed = {
        "dispatched": {"running", "blocked", "cancelled"},
        "running": {"running", "validating", "partially-completed", "blocked", "cancelled"},
        "validating": {"validating", "completed", "partially-completed", "blocked", "cancelled"},
    }
    if args.state not in allowed.get(current, set()):
        raise ContinuityError(f"Illegal execution transition: {current} -> {args.state}")
    dispatch = json_load(directory / "dispatch.json", {})
    if not isinstance(dispatch, dict) or not dispatch.get("deadline"):
        raise ContinuityError("Execution requires a valid dispatch record")
    try:
        deadline = dt.datetime.fromisoformat(dispatch["deadline"])
    except (TypeError, ValueError) as exc:
        raise ContinuityError("Dispatch record has an invalid deadline") from exc
    if deadline.tzinfo is None:
        deadline = deadline.replace(tzinfo=ZoneInfo(config["timezone"]))
    if now(config) > deadline and args.state in {"running", "validating"}:
        raise ContinuityError("Runtime deadline has expired; record a blocked or partial terminal state")
    if args.state == "running" and config.get("require_isolated_worktree", False):
        if not args.worktree:
            raise ContinuityError("An isolated execution worktree is required")
        worktree = Path(args.worktree).expanduser().resolve()
        if worktree == root or not worktree.is_dir():
            raise ContinuityError("Execution worktree must exist and differ from the configured project root")
        common_root = git_result(root, "rev-parse", "--git-common-dir")
        common_worktree = git_result(worktree, "rev-parse", "--git-common-dir")
        if common_worktree.returncode != 0:
            raise ContinuityError("Execution path is not a Git worktree")
        root_common = (root / common_root.stdout.strip()).resolve()
        worktree_common = (worktree / common_worktree.stdout.strip()).resolve()
        if root_common != worktree_common:
            raise ContinuityError("Execution worktree does not belong to the configured repository")
    if args.state == "completed":
        compliance = json_load(directory / "compliance.json", {})
        if compliance.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
            raise ContinuityError("Cannot mark completed under a missing or unsupported assurance standard")
        required = [stage for stage in COMPLIANCE_STAGES if stage != "human-review"]
        incomplete = {
            stage: compliance.get("stages", {}).get(stage, {}).get("status", "missing")
            for stage in required
            if compliance.get("stages", {}).get(stage, {}).get("status") not in {"passed", "not-applicable"}
        }
        if incomplete:
            raise ContinuityError(f"Cannot mark completed; compliance stages incomplete: {incomplete}")
    stamp = iso_now(config)
    manifest = json_load(directory / "execution.json", {})
    artifacts = dict(manifest.get("artifacts", {}))
    evidence_root = Path(args.worktree or manifest.get("worktree") or root).expanduser().resolve()
    for value in args.artifact or []:
        path = Path(value).expanduser().resolve()
        if not path.is_file():
            raise ContinuityError(f"Execution artifact does not exist: {value}")
        if not path.is_relative_to(evidence_root):
            raise ContinuityError(f"Execution artifact is outside the execution worktree: {value}")
        if path.is_relative_to(private_path(root, config)):
            raise ContinuityError("Private continuity state cannot be used as PR evidence")
        artifacts[path.name] = str(path)
    manifest.update(
        {
            "goal_id": args.goal_id,
            "state": args.state,
            "updated_at": stamp,
            "task_id": args.task_id or manifest.get("task_id"),
            "branch": args.branch or manifest.get("branch"),
            "pr_url": args.pr_url or manifest.get("pr_url"),
            "summary": args.summary or manifest.get("summary"),
            "worktree": args.worktree or manifest.get("worktree"),
            "artifacts": artifacts,
        }
    )
    if args.state == "running" and "started_at" not in manifest:
        manifest["started_at"] = stamp
    if args.state in TERMINAL_STATES:
        manifest["completed_at"] = stamp
    if args.state == "completed":
        missing_fields = [key for key in ("started_at", "branch", "summary") if not manifest.get(key)]
        if config.get("require_pr", False):
            pr_url = str(manifest.get("pr_url") or "")
            if not re.fullmatch(r"https://github\.com/[^/]+/[^/]+/pull/\d+", pr_url):
                missing_fields.append("valid GitHub pr_url")
        if config.get("require_execution_artifacts", False):
            required_artifacts = {
                "request-alignment.md",
                "implementation-report.md",
                "validation-and-security.md",
                "memory-impact.md",
                "roadmap-impact.md",
                "evidence.md",
            }
            missing_fields.extend(sorted(required_artifacts - set(artifacts)))
            if not list(iter_jsonl(directory / "checkpoints.jsonl")):
                missing_fields.append("alignment checkpoint")
        if missing_fields:
            raise ContinuityError(f"Cannot mark completed; missing execution evidence: {missing_fields}")
    json_dump(directory / "execution.json", manifest)
    goal["state"] = args.state
    goal["updated_at"] = stamp
    json_dump(directory / "goal.json", goal)
    update_note_work_status(root, config, goal.get("source_note_ids", []), args.state, goal_id=args.goal_id)
    if args.state in TERMINAL_STATES:
        lock_path = private_path(root, config) / "project.lock.json"
        lock = json_load(lock_path)
        if isinstance(lock, dict) and lock.get("goal_id") == args.goal_id:
            lock_path.unlink(missing_ok=True)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": f"run.{args.state}", "goal_id": args.goal_id})
    return manifest


def report_project(args: argparse.Namespace) -> str:
    root, config = load_context()
    goals = goal_list(argparse.Namespace(state=None))
    counts: dict[str, int] = {}
    for goal in goals:
        counts[goal["state"]] = counts.get(goal["state"], 0) + 1
    memory_report = json_load(private_path(root, config) / "reports" / "memory-health.json", {})
    roadmap_report = json_load(private_path(root, config) / "reports" / "roadmap-health.json", {})
    shared_inbox = list(iter_jsonl(private_path(root, config) / "queues" / "shared-notes.jsonl"))
    test_reports = list(iter_jsonl(private_path(root, config) / "reports" / "test-reports.jsonl"))
    merge_reports = list(iter_jsonl(private_path(root, config) / "reports" / "merge-assessments.jsonl"))
    human_reviews = list(iter_jsonl(private_path(root, config) / "reports" / "human-reviews.jsonl"))
    lines = [
        f"# Continuity Report: {config['project_id']}",
        "",
        f"Generated: {iso_now(config)}",
        "",
        "## Configuration",
        "",
        f"- Behavior hash: `{config.get('behavior_configuration_hash', 'legacy-unconfigured')}`",
        f"- Behavior skill: `{config.get('behavior_skill_path', 'legacy-unconfigured')}`",
        "- Health: validated",
        "",
        "## Goals",
        "",
    ]
    if not goals:
        lines.append("No tracked goals.")
    for state, count in sorted(counts.items()):
        lines.append(f"- {state}: {count}")
    lines.extend(["", "## Goal detail", ""])
    for goal in sorted(goals, key=lambda value: value.get("updated_at", ""), reverse=True):
        compliance = json_load(goal_dir(root, config, goal["goal_id"]) / "compliance.json", {})
        pending = [stage for stage, detail in compliance.get("stages", {}).items() if detail.get("status") in {"pending", "failed"}]
        lines.append(f"- **{goal['goal_id']}** — {goal['title']} — `{goal['state']}` — compliance pending: {', '.join(pending) or 'none'}")
    lines.extend(["", "## Project memory", ""])
    if memory_report:
        lines.extend(
            [
                f"- Entries audited: {memory_report.get('entries', 0)}",
                f"- Missing metadata: {len(memory_report.get('missing_frontmatter', []))}",
                f"- Stale entries: {len(memory_report.get('stale', []))}",
                f"- Healthy: {memory_report.get('healthy', False)}",
            ]
        )
    else:
        lines.append("- Memory health has not been audited.")
    lines.extend(["", "## Roadmap and shared context", ""])
    if roadmap_report:
        lines.extend([
            f"- Roadmap entries audited: {roadmap_report.get('entries', 0)}",
            f"- Roadmap healthy: {roadmap_report.get('healthy', False)}",
            f"- Roadmap cycles: {len(roadmap_report.get('cycles', []))}",
            f"- Roadmap stale note links: {len(roadmap_report.get('stale_note_links', []))}",
        ])
    else:
        lines.append("- Roadmap health has not been audited.")
    lines.append(f"- Imported shared-note packets awaiting triage: {len(shared_inbox)}")
    lines.extend(["", "## Testing and merge readiness", ""])
    if test_reports:
        latest_test = test_reports[-1]
        lines.append(f"- Latest test report: `{latest_test.get('status')}` for `{latest_test.get('goal_id')}` — {latest_test.get('summary', '')}")
    else:
        lines.append("- No Continuity test report has been recorded.")
    if merge_reports:
        latest_merge = merge_reports[-1]
        lines.append(f"- Latest merge assessment: `{latest_merge.get('status')}` for `{latest_merge.get('goal_id')}` — PR: {latest_merge.get('pr_url') or 'not recorded'}")
    else:
        lines.append("- No merge-safety assessment has been recorded.")
    lines.append(f"- Human review records: {len(human_reviews)}")
    return "\n".join(lines) + "\n"


def roadmap_command(args: argparse.Namespace) -> Any:
    root, config = load_context()
    try:
        return args.roadmap_handler(root, config, args)
    except roadmap_lib.RoadmapError as exc:
        raise ContinuityError(str(exc)) from exc


def shared_note_command(args: argparse.Namespace) -> Any:
    root, config = load_context()
    try:
        return args.shared_note_handler(root, config, args)
    except shared_notes_lib.SharedNoteError as exc:
        raise ContinuityError(str(exc)) from exc


def output(value: Any, as_json: bool = False) -> None:
    if isinstance(value, str) and not as_json:
        print(value, end="" if value.endswith("\n") else "\n")
    else:
        print(json.dumps(value, indent=2, sort_keys=True))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="continuity", description="Continuity control plane")
    parser.add_argument("--json", action="store_true", help="Emit JSON when supported")
    parser.add_argument("--project-root", help="Configured project root (defaults to upward discovery)")
    top = parser.add_subparsers(dest="domain", required=True)

    note = top.add_parser("note")
    note_sub = note.add_subparsers(dest="command", required=True)
    capture = note_sub.add_parser("capture")
    capture.add_argument("--text")
    capture.add_argument("--file")
    capture.add_argument("--items-file")
    capture.add_argument("--source-type")
    capture.add_argument("--source-ref")
    capture.set_defaults(handler=note_capture)
    triage = note_sub.add_parser("triage")
    triage.add_argument("capture_id")
    triage.add_argument("item_id")
    triage.add_argument("--kind", choices=sorted(NOTE_KINDS))
    triage.add_argument("--action", choices=["route", "defer", "archive", "promote"], default="route")
    triage.add_argument("--review-after")
    triage.set_defaults(handler=note_triage)
    notes = note_sub.add_parser("list")
    notes.add_argument("--kind", choices=sorted(NOTE_KINDS))
    notes.set_defaults(handler=note_list)
    share = note_sub.add_parser("share")
    share_sub = share.add_subparsers(dest="share_command", required=True)
    prepare = share_sub.add_parser("prepare")
    prepare.add_argument("note_ids", nargs="+")
    prepare.add_argument("--packet-id")
    prepare.add_argument("--target-project", required=True)
    prepare.add_argument("--sender", required=True)
    prepare.add_argument("--source-pr")
    prepare.add_argument("--roadmap-id", action="append")
    prepare.add_argument("--relation", choices=sorted(roadmap_lib.NOTE_RELATIONS), default="suggests")
    prepare.set_defaults(handler=shared_note_command, shared_note_handler=shared_notes_lib.prepare)
    share_approve = share_sub.add_parser("approve")
    share_approve.add_argument("packet_id")
    share_approve.add_argument("--version", type=int, required=True)
    share_approve.add_argument("--approved-by", required=True)
    share_approve.add_argument("--authorization-text", required=True)
    share_approve.set_defaults(handler=shared_note_command, shared_note_handler=shared_notes_lib.approve)
    publish = share_sub.add_parser("publish")
    publish.add_argument("packet_id")
    publish.add_argument("--dry-run", action="store_true")
    publish.set_defaults(handler=shared_note_command, shared_note_handler=shared_notes_lib.publish)
    import_notes = share_sub.add_parser("import")
    import_notes.set_defaults(handler=shared_note_command, shared_note_handler=shared_notes_lib.import_packets)

    memory = top.add_parser("memory")
    memory_sub = memory.add_subparsers(dest="command", required=True)
    index = memory_sub.add_parser("index")
    index.add_argument("--scope", choices=["trusted", "private", "all"], default="trusted")
    index.set_defaults(handler=memory_index)
    search = memory_sub.add_parser("search")
    search.add_argument("query")
    search.add_argument("--type")
    search.add_argument("--status", choices=sorted(MEMORY_STATUSES))
    search.add_argument("--system")
    search.add_argument("--tag")
    search.add_argument("--source")
    search.add_argument("--since")
    search.add_argument("--scope", choices=["trusted", "private", "all"], default="trusted")
    search.add_argument("--limit", type=int, default=10)
    search.set_defaults(handler=memory_search)
    brief = memory_sub.add_parser("brief")
    brief.add_argument("query")
    brief.add_argument("--scope", choices=["trusted", "private", "all"], default="trusted")
    brief.add_argument("--limit", type=int, default=6)
    brief.set_defaults(handler=memory_brief)
    audit = memory_sub.add_parser("audit")
    audit.add_argument("--scope", choices=["trusted", "private", "all"], default="trusted")
    audit.set_defaults(handler=memory_audit)
    verify = memory_sub.add_parser("verify")
    verify.add_argument("memory_id")
    verify.add_argument("--goal-id", required=True)
    verify.add_argument("--commit", required=True)
    verify.add_argument("--mark-current", action="store_true")
    verify.set_defaults(handler=memory_verify)
    promote = memory_sub.add_parser("promote")
    promote.add_argument("note_id")
    promote.add_argument("--goal-id", required=True)
    promote.add_argument("--memory-id")
    promote.add_argument("--title", required=True)
    promote.add_argument("--type", required=True)
    promote.add_argument("--system", required=True)
    promote.add_argument("--summary", required=True)
    promote.add_argument("--tag", action="append")
    promote.add_argument("--confidence", choices=["low", "medium", "high"], default="medium")
    promote.set_defaults(handler=memory_promote)
    supersede = memory_sub.add_parser("supersede")
    supersede.add_argument("memory_id")
    supersede.add_argument("--with", dest="replacement_id", required=True)
    supersede.add_argument("--goal-id", required=True)
    supersede.set_defaults(handler=memory_supersede)

    roadmap = top.add_parser("roadmap")
    roadmap_sub = roadmap.add_subparsers(dest="command", required=True)
    roadmap_index = roadmap_sub.add_parser("index")
    roadmap_index.set_defaults(handler=roadmap_command, roadmap_handler=roadmap_lib.command_index)
    roadmap_list = roadmap_sub.add_parser("list")
    roadmap_list.add_argument("--kind", choices=sorted(roadmap_lib.ROADMAP_KINDS))
    roadmap_list.add_argument("--status", choices=sorted(roadmap_lib.ROADMAP_STATUSES))
    roadmap_list.add_argument("--health", choices=sorted(roadmap_lib.ROADMAP_HEALTH))
    roadmap_list.add_argument("--owner")
    roadmap_list.add_argument("--tag")
    roadmap_list.add_argument("--sprint")
    roadmap_list.set_defaults(handler=roadmap_command, roadmap_handler=roadmap_lib.command_list)
    roadmap_show = roadmap_sub.add_parser("show")
    roadmap_show.add_argument("roadmap_id")
    roadmap_show.set_defaults(handler=roadmap_command, roadmap_handler=roadmap_lib.command_show)
    roadmap_brief = roadmap_sub.add_parser("brief")
    roadmap_brief.add_argument("query")
    roadmap_brief.add_argument("--limit", type=int, default=12)
    roadmap_brief.set_defaults(handler=roadmap_command, roadmap_handler=roadmap_lib.command_brief)
    roadmap_audit = roadmap_sub.add_parser("audit")
    roadmap_audit.set_defaults(handler=roadmap_command, roadmap_handler=roadmap_lib.command_audit)
    link_note = roadmap_sub.add_parser("link-note")
    link_note.add_argument("note_id")
    link_note.add_argument("--to", dest="roadmap_id", required=True)
    link_note.add_argument("--relation", choices=sorted(roadmap_lib.NOTE_RELATIONS), required=True)
    link_note.set_defaults(handler=roadmap_command, roadmap_handler=roadmap_lib.command_link_note)
    roadmap_create = roadmap_sub.add_parser("create")
    roadmap_create.add_argument("--entry-file", required=True)
    roadmap_create.add_argument("--goal-id", required=True)
    roadmap_create.set_defaults(handler=roadmap_command, roadmap_handler=roadmap_lib.command_create)
    roadmap_revise = roadmap_sub.add_parser("revise")
    roadmap_revise.add_argument("roadmap_id")
    roadmap_revise.add_argument("--entry-file", required=True)
    roadmap_revise.add_argument("--goal-id", required=True)
    roadmap_revise.set_defaults(handler=roadmap_command, roadmap_handler=roadmap_lib.command_revise)
    roadmap_export = roadmap_sub.add_parser("export")
    roadmap_export.add_argument("--scope", choices=["committed"], default="committed")
    roadmap_export.add_argument("--output")
    roadmap_export.set_defaults(handler=roadmap_command, roadmap_handler=roadmap_lib.command_export)
    roadmap_serve = roadmap_sub.add_parser("serve")
    roadmap_serve.add_argument("--open", action="store_true")
    roadmap_serve.add_argument("--port", type=int, default=0)
    roadmap_serve.set_defaults(handler=roadmap_command, roadmap_handler=roadmap_lib.command_serve)
    production_audit = roadmap_sub.add_parser("production-audit")
    production_audit.add_argument("--artifact", required=True)
    production_audit.set_defaults(handler=roadmap_command, roadmap_handler=roadmap_lib.production_audit)

    goal = top.add_parser("goal")
    goal_sub = goal.add_subparsers(dest="command", required=True)
    create = goal_sub.add_parser("create")
    create.add_argument("--goal-file", required=True)
    create.set_defaults(handler=goal_create)
    revise = goal_sub.add_parser("revise")
    revise.add_argument("goal_id")
    revise.add_argument("--goal-file", required=True)
    revise.add_argument("--author", required=True)
    revise.add_argument("--summary", required=True)
    revise.set_defaults(handler=goal_revise)
    approve = goal_sub.add_parser("approve")
    approve.add_argument("goal_id")
    approve.add_argument("--version", required=True, type=int)
    approve.add_argument("--approved-by", required=True)
    approve.add_argument("--authorization-text", required=True)
    approve.add_argument("--schedule")
    approve.set_defaults(handler=goal_approve)
    start = goal_sub.add_parser("start")
    start.add_argument("goal_id")
    start.set_defaults(handler=goal_start)
    for name in ("hold", "cancel", "resume"):
        transition = goal_sub.add_parser(name)
        transition.add_argument("goal_id")
        transition.set_defaults(handler=goal_transition, transition=name)
    feedback = goal_sub.add_parser("feedback")
    feedback.add_argument("goal_id")
    feedback.add_argument("--author", default="user")
    feedback.add_argument("--text", required=True)
    feedback.set_defaults(handler=goal_feedback)
    goals = goal_sub.add_parser("list")
    goals.add_argument("--state", choices=sorted(GOAL_STATES))
    goals.set_defaults(handler=goal_list)
    due = goal_sub.add_parser("due")
    due.set_defaults(handler=goal_due)
    gate = goal_sub.add_parser("gate")
    gate.add_argument("goal_id")
    gate.add_argument("stage", choices=COMPLIANCE_STAGES)
    gate.add_argument("--status", choices=sorted(COMPLIANCE_STATUSES), required=True)
    gate.add_argument("--evidence", action="append")
    gate.add_argument("--actor", default="agent")
    gate.set_defaults(handler=goal_gate)

    run = top.add_parser("run")
    run_sub = run.add_subparsers(dest="command", required=True)
    update = run_sub.add_parser("update")
    update.add_argument("goal_id")
    update.add_argument("--state", required=True, choices=["running", "validating", *sorted(TERMINAL_STATES)])
    update.add_argument("--task-id")
    update.add_argument("--branch")
    update.add_argument("--pr-url")
    update.add_argument("--summary")
    update.add_argument("--worktree")
    update.add_argument("--artifact", action="append")
    update.set_defaults(handler=run_update)

    test = top.add_parser("test")
    test_sub = test.add_subparsers(dest="command", required=True)
    test_plan_command = test_sub.add_parser("plan")
    test_plan_command.add_argument("goal_id", nargs="?")
    test_plan_command.add_argument("--worktree")
    test_plan_command.set_defaults(handler=test_plan)
    test_record_command = test_sub.add_parser("record")
    test_record_command.add_argument("goal_id")
    test_record_command.add_argument("--status", choices=["passed", "failed"], required=True)
    test_record_command.add_argument("--summary", required=True)
    test_record_command.add_argument("--actor", default="agent")
    test_record_command.add_argument("--worktree")
    test_record_command.add_argument("--branch")
    test_record_command.add_argument("--code-review-evidence", action="append")
    test_record_command.add_argument("--validation-evidence", action="append")
    test_record_command.add_argument("--security-evidence", action="append")
    test_record_command.add_argument("--finding", action="append")
    test_record_command.add_argument("--artifact", action="append")
    test_record_command.add_argument("--update-gates", action="store_true")
    test_record_command.set_defaults(handler=test_record)

    merge = top.add_parser("merge")
    merge_sub = merge.add_subparsers(dest="command", required=True)
    merge_assess_command = merge_sub.add_parser("assess")
    merge_assess_command.add_argument("goal_id")
    merge_assess_command.add_argument("--branch")
    merge_assess_command.add_argument("--base")
    merge_assess_command.add_argument("--pr-url")
    merge_assess_command.add_argument("--worktree")
    merge_assess_command.add_argument("--evidence", action="append")
    merge_assess_command.add_argument("--status", choices=["passed", "failed"])
    merge_assess_command.add_argument("--actor", default="agent")
    merge_assess_command.add_argument("--update-gate", action="store_true")
    merge_assess_command.set_defaults(handler=merge_assess)
    human_merge = merge_sub.add_parser("record-human")
    human_merge.add_argument("goal_id")
    human_merge.add_argument("--pr-url", required=True)
    human_merge.add_argument("--merged-by", required=True)
    human_merge.add_argument("--merge-commit")
    human_merge.add_argument("--evidence", action="append", required=True)
    human_merge.add_argument("--actor", default="human")
    human_merge.set_defaults(handler=merge_record_human)

    execution = top.add_parser("execution")
    execution_sub = execution.add_subparsers(dest="command", required=True)
    preflight = execution_sub.add_parser("preflight")
    preflight.add_argument("goal_id")
    preflight.set_defaults(handler=execution_preflight)
    checkpoint = execution_sub.add_parser("checkpoint")
    checkpoint.add_argument("goal_id")
    checkpoint.add_argument("--phase", required=True)
    checkpoint.add_argument("--summary", required=True)
    checkpoint.add_argument("--alignment", required=True)
    checkpoint.add_argument("--evidence", action="append")
    checkpoint.set_defaults(handler=execution_checkpoint)

    report = top.add_parser("report")
    report_sub = report.add_subparsers(dest="command", required=True)
    project = report_sub.add_parser("project")
    project.set_defaults(handler=report_project)

    project_admin = top.add_parser("project")
    project_admin_sub = project_admin.add_subparsers(dest="command", required=True)
    recommendations = project_admin_sub.add_parser("recommendations")
    recommendations.set_defaults(handler=project_recommendations)
    configure = project_admin_sub.add_parser("configure")
    configure.add_argument("--interactive", action="store_true")
    configure.add_argument("--answers-file")
    configure.add_argument("--actor", default="user")
    configure.add_argument("--dry-run", action="store_true")
    configure.set_defaults(handler=project_configure)
    doctor = project_admin_sub.add_parser("doctor")
    doctor.set_defaults(handler=project_doctor)

    portfolio = top.add_parser("portfolio")
    portfolio_sub = portfolio.add_subparsers(dest="command", required=True)
    for name, due_only, discover_only in (("discover", False, True), ("queue", False, False), ("due", True, False)):
        portfolio_command = portfolio_sub.add_parser(name)
        portfolio_command.add_argument("--root", action="append", help="Workspace root to scan; repeat for multiple roots")
        portfolio_command.set_defaults(handler=portfolio_goals, due=due_only, discover=discover_only)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.project_root:
        os.environ["CONTINUITY_PROJECT_ROOT"] = str(Path(args.project_root).expanduser().resolve())
    try:
        value = args.handler(args)
        output(value, args.json)
        return 0
    except ContinuityError as exc:
        print(f"continuity: {exc}", file=sys.stderr)
        return 2
    except sqlite3.OperationalError as exc:
        print(f"continuity: SQLite search failed: {exc}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
