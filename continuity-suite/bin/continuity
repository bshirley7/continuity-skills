def resume_receipt_bytes(record: dict[str, Any]) -> bytes:
    return (runtime_lib.canonical_json(resume_receipt_payload(record)) + "\n").encode()


def record_signed_resume_authorization(
    root: Path,
    config: dict[str, Any],
    directory: Path,
    goal: dict[str, Any],
    prior_state: str,
    actor: str,
    authorization_text: str,
    signing_key: str | None,
) -> dict[str, Any]:
    receipt = {
        "schema_version": 1,
        "project_id": config["project_id"],
        "goal_id": goal["goal_id"],
        "plan_version": goal["plan_version"],
        "plan_hash": goal_material_hash(directory, goal),
        "execution_attempt": int(goal.get("execution_attempt", 1)),
        "prior_state": prior_state,
        "scope": "in-scope",
        "authorized_at": iso_now(config),
        "authorized_by": actor,
        "authorization_text": authorization_text,
        "nonce": secrets.token_hex(16),
        "signature_format": "openssh-sshsig-v1" if signing_key else "legacy-unsigned",
    }
    signature_path = directory / "resume-authorization.sig"
    if config.get("require_signed_approvals", False) and not signing_key:
        raise ContinuityError("This project requires a signed human resume authorization")
    if signing_key:
        sign_receipt_bytes(
            resume_receipt_bytes(receipt),
            signing_key,
            signature_path,
            namespace="continuity-resume",
            label="resume authorization",
        )
        verify_receipt_bytes(
            root,
            config,
            resume_receipt_bytes(receipt),
            signature_path,
            actor,
            namespace="continuity-resume",
            label="resume authorization",
        )
    json_dump(directory / "resume-authorization.json", receipt)
    return receipt


def archive_execution_attempt(directory: Path, goal: dict[str, Any], reason: str, actor: str) -> Path | None:
    evidence_files = (
        "goal.json",
        "plan.md",
        "approval.json",
        "compliance.json",
        "dispatch.json",
        "execution.json",
        "preflight.json",
        "machine-test-run.json",
        "test-report.json",
        "product-audit.json",
        "merge-assessment.json",
        "human-review.json",
        "human-review.sig",
        "resume-authorization.json",
        "resume-authorization.sig",
        "checkpoints.jsonl",
    )
    existing = [name for name in evidence_files if (directory / name).exists()]
    if not existing:
        return None
    attempt = int(goal.get("execution_attempt", 1))
    target = directory / "attempts" / f"attempt-{attempt}"
    if target.exists():
        raise ContinuityError(f"Execution attempt archive already exists: {target}")
    target.mkdir(parents=True)
    for name in existing:
        shutil.copy2(directory / name, target / name)
    json_dump(
        target / "archive.json",
        {"attempt": attempt, "reason": reason, "actor": actor, "archived_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")},
    )
    return target


def reset_execution_evidence(
    directory: Path,
    goal: dict[str, Any],
    config: dict[str, Any],
    reason: str,
    actor: str,
    *,
    increment_attempt: bool = True,
) -> None:
    archive_execution_attempt(directory, goal, reason, actor)
    stamp = iso_now(config)
    compliance = json_load(directory / "compliance.json", {})
    for stage in DOWNSTREAM_COMPLIANCE_STAGES:
        compliance.setdefault("stages", {})[stage] = {
            "status": "pending",
            "evidence": [reason],
            "actor": actor,
            "updated_at": stamp,
        }
    compliance["updated_at"] = stamp
    json_dump(directory / "compliance.json", compliance)
    for name in (
        "dispatch.json",
        "preflight.json",
        "machine-test-run.json",
        "test-report.json",
        "product-audit.json",
        "merge-assessment.json",
        "human-review.json",
        "human-review.sig",
        "resume-authorization.json",
        "resume-authorization.sig",
        "checkpoints.jsonl",
    ):
        (directory / name).unlink(missing_ok=True)
    current_attempt = int(goal.get("execution_attempt", 1))
    next_attempt = current_attempt + 1 if increment_attempt else current_attempt
    json_dump(
        directory / "execution.json",
        {
            "goal_id": goal["goal_id"],
            "state": "rework-queued",
            "execution_attempt": next_attempt,
            "updated_at": stamp,
        },
    )
    if increment_attempt:
        goal["execution_attempt"] = next_attempt


def goal_revise(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if goal.get("state") not in {"awaiting-feedback", "queued", "held", *REWORK_STATES, *LEGACY_GOAL_STATES}:
        raise ContinuityError(f"Goal in state {goal.get('state')} cannot be revised")
    if goal.get("state") == "held" and goal.get("held_from") not in {"awaiting-feedback", "queued"}:
        raise ContinuityError("Only a pre-execution held goal can be revised")
    previous_source_note_ids = list(goal.get("source_note_ids", []))
    payload = json_load(Path(args.goal_file).expanduser())
    if not isinstance(payload, dict):
        raise ContinuityError("Revision file must be a JSON object")
    goal.setdefault("design_ids", [])
    goal.setdefault("authorization_mode", "separate-approval")
    goal.setdefault("risk_level", "routine")
    goal.setdefault("restricted_side_effects", [])
    allowed = {
        "title",
        "priority",
        "depends_on",
        "source_note_ids",
        "note_dispositions",
        "memory_ids",
        "design_ids",
        "roadmap_ids",
        "roadmap_impact",
        "scope",
        "exclusions",
        "acceptance_criteria",
        "documentation_updates",
        "required_checks",
        "risk_level",
        "restricted_side_effects",
        "runtime_limit_minutes",
        "triage_brief",
        "decision_map",
        "delivery_slices",
    }
    for key, value in payload.items():
        if key in allowed:
            goal[key] = value
    if "source_note_ids" in payload and "note_dispositions" not in payload:
        goal["note_dispositions"] = None
    for key in ("depends_on", "source_note_ids", "memory_ids", "design_ids", "roadmap_ids", "exclusions", "acceptance_criteria", "documentation_updates", "required_checks", "restricted_side_effects"):
        value = goal.get(key)
        if not isinstance(value, list) or not all(isinstance(item, str) and item.strip() for item in value):
            raise ContinuityError(f"Goal field {key} must be an array of non-empty strings")
    if not goal.get("acceptance_criteria"):
        raise ContinuityError("Goal requires acceptance_criteria")
    if not isinstance(goal.get("title"), str) or not goal["title"].strip() or not isinstance(goal.get("scope"), str) or not goal["scope"].strip():
        raise ContinuityError("Revised title and scope must be non-empty strings")
    if not isinstance(goal.get("runtime_limit_minutes"), int) or goal["runtime_limit_minutes"] < 1:
        raise ContinuityError("runtime_limit_minutes must be an integer of at least 1")
    if goal["runtime_limit_minutes"] > int(config.get("max_runtime_minutes", 360)):
        raise ContinuityError("runtime_limit_minutes exceeds the configured project maximum")
    if goal.get("risk_level") not in {"routine", "elevated", "consequential"}:
        raise ContinuityError("risk_level must be routine, elevated, or consequential")
    goal["authorization_mode"] = "separate-approval"
    goal["triage_brief"] = validate_triage_brief(goal.get("triage_brief"))
    goal["decision_map"] = validate_decision_map(goal.get("decision_map"))
    goal["delivery_slices"] = validate_delivery_slices(goal.get("delivery_slices"))
    goal["note_dispositions"] = validate_note_dispositions(
        goal.get("note_dispositions"),
        goal.get("source_note_ids", []),
        goal["delivery_slices"],
        goal.get("roadmap_ids", []),
    )
    for item in goal["note_dispositions"]:
        if item.get("review_after") and parse_recorded_time(item["review_after"], config["timezone"]) is None:
            raise ContinuityError(f"Note disposition {item['note_id']} has an invalid review_after")
    validate_note_disposition_targets(root, config, goal["note_dispositions"])
    goal["roadmap_impact"] = validate_roadmap_impact(goal.get("roadmap_impact"), goal.get("roadmap_ids", []))
    validate_goal_roadmap_targets(root, config, goal.get("roadmap_ids", []), goal["roadmap_impact"])
    goal["roadmap_fingerprint"] = roadmap_fingerprint(root, config, goal.get("roadmap_ids", []))
    goal["source_capture_refs"] = source_capture_refs_for_notes(root, config, goal.get("source_note_ids", []))
    try:
        goal["design_refs"] = design_lib.bind_approved(root, config, goal.get("design_ids", []))
    except design_lib.DesignError as exc:
        raise ContinuityError(str(exc)) from exc
    plan = payload.get("plan_markdown")
    if plan is not None:
        if not isinstance(plan, str) or not plan.strip():
            raise ContinuityError("plan_markdown must be a non-empty string")
    revision_root = directory / "revisions" / f"v{goal['plan_version']}"
    revision_root.mkdir(parents=True, exist_ok=False)
    shutil.copy2(directory / "plan.md", revision_root / "plan.md")
    json_dump(revision_root / "goal.json", json_load(directory / "goal.json", {}))
    if (directory / "approval.json").exists():
        shutil.copy2(directory / "approval.json", revision_root / "approval.json")
    if goal.get("state") in REWORK_STATES and goal.get("state") != "changes-requested":
        reset_execution_evidence(directory, goal, config, f"Execution evidence invalidated by plan revision: {args.summary}", args.author)
    plan_source = plan if plan is not None else (directory / "plan.md").read_text(encoding="utf-8")
    (directory / "plan.md").write_text(with_planning_artifacts(plan_source, goal), encoding="utf-8")
    goal["plan_version"] += 1
    goal["state"] = "awaiting-feedback"
    goal.pop("held_from", None)
    goal.pop("scheduled_for", None)
    goal.pop("dispatched_at", None)
    goal["updated_at"] = iso_now(config)
    goal["plan_hash"] = goal_material_hash(directory, goal)
    json_dump(directory / "goal.json", goal)
    (directory / "approval.json").unlink(missing_ok=True)
    compliance = json_load(directory / "compliance.json", {})
    compliance.setdefault("stages", {})["approval"] = {
        "status": "pending",
        "evidence": [f"Approval invalidated by revision v{goal['plan_version']}"],
        "updated_at": goal["updated_at"],
    }
    compliance["stages"]["plan-review"] = {"status": "pending", "evidence": [], "updated_at": goal["updated_at"]}
    compliance["stages"]["roadmap-retrieval"] = {
        "status": "passed" if goal.get("roadmap_ids") else "not-applicable",
        "evidence": goal.get("roadmap_ids") or ["Goal has no roadmap context"],
        "updated_at": goal["updated_at"],
    }
    compliance["updated_at"] = goal["updated_at"]
    json_dump(directory / "compliance.json", compliance)
    removed_note_ids = set(previous_source_note_ids) - set(goal.get("source_note_ids", []))
    if removed_note_ids:
        update_note_goal_links(
            root,
            config,
            removed_note_ids,
            goal["goal_id"],
            None,
            remove=True,
            stamp=goal["updated_at"],
        )
    update_note_goal_links(
        root,
        config,
        goal.get("source_note_ids", []),
        goal["goal_id"],
        "awaiting-feedback",
        dispositions=goal["note_dispositions"],
        plan_version=goal["plan_version"],
        stamp=goal["updated_at"],
    )
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": goal["updated_at"],
            "event": "goal.revised",
            "goal_id": goal["goal_id"],
            "plan_version": goal["plan_version"],
            "actor": args.author,
            "summary": args.summary,
        },
    )
    append_jsonl(directory / "feedback.jsonl", {"at": goal["updated_at"], "author": args.author, "type": "revision", "text": args.summary})
    return goal


def goal_approve(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if goal.get("state") != "awaiting-feedback":
        raise ContinuityError(f"Only an awaiting-feedback goal can be approved; current state is {goal.get('state')}")
    if int(args.version) != goal["plan_version"]:
        raise ContinuityError(f"Requested v{args.version}; current plan is v{goal['plan_version']}")
    validate_goal_planning_artifacts(goal, require_resolved=True)
    validate_planning_artifact_parity(directory, goal)
    if goal.get("roadmap_fingerprint") != roadmap_fingerprint(root, config, goal.get("roadmap_ids", [])):
        raise ContinuityError("Roadmap context changed after planning; revise the goal before approval")
    compliance = json_load(directory / "compliance.json", {})
    if compliance.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Goal compliance ledger uses a missing or unsupported assurance standard")
    for stage in ("memory-retrieval", "roadmap-retrieval", "plan-review"):
        state = compliance.get("stages", {}).get(stage, {}).get("status")
        if state not in {"passed", "not-applicable"}:
            raise ContinuityError(f"Compliance stage {stage} must pass before approval")
    expected_authorization = re.compile(
        rf"\b{re.escape(goal['goal_id'])}\b.*\bplan\s+v{goal['plan_version']}\b",
        re.IGNORECASE,
    )
    if not expected_authorization.search(args.authorization_text):
        raise ContinuityError("Authorization text must explicitly name the goal ID and plan version")
    plan_hash = goal_material_hash(directory, goal)
    scheduled_for = parse_schedule(args.schedule, config) if args.schedule else next_default_start(config)
    stamp = iso_now(config)
    approval = {
        "schema_version": SCHEMA_VERSION,
        "project_id": config["project_id"],
        "goal_id": goal["goal_id"],
        "plan_version": goal["plan_version"],
        "plan_hash": plan_hash,
        "behavior_configuration_hash": config.get("behavior_configuration_hash"),
        "approved_at": stamp,
        "approved_by": args.approved_by,
        "authorization_text": args.authorization_text,
        "authorization_source": "explicit-receipt",
        "nonce": secrets.token_hex(16),
        "signature_format": "openssh-sshsig-v1" if args.signing_key else "legacy-unsigned",
    }
    if not approval["behavior_configuration_hash"]:
        approval.pop("behavior_configuration_hash")
    if config.get("require_signed_approvals", False) and not args.signing_key:
        raise ContinuityError("This project requires --signing-key for an SSH-signed approval receipt")
    try:
        runtime_lib.validate_schema_file(approval, CONTROL_ROOT / "schemas" / "approval-receipt.schema.json", "approval receipt")
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    if args.signing_key:
        sign_approval_receipt(approval, args.signing_key, directory / "approval.sig")
        verify_approval_signature(root, config, directory, approval)
    json_dump(directory / "approval.json", approval)
    compliance["stages"]["approval"] = {
        "status": "passed",
        "evidence": [approval["authorization_text"], plan_hash],
        "updated_at": stamp,
    }
    compliance["updated_at"] = stamp
    json_dump(directory / "compliance.json", compliance)
    goal["plan_hash"] = plan_hash
    goal["state"] = "queued"
    goal["scheduled_for"] = scheduled_for
    goal["updated_at"] = stamp
    json_dump(directory / "goal.json", goal)
    update_note_goal_links(root, config, goal.get("source_note_ids", []), goal["goal_id"], "queued")
    append_jsonl(directory / "feedback.jsonl", {"at": stamp, "author": args.approved_by, "type": "approval", "text": approval["authorization_text"]})
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": stamp,
            "event": "goal.approved",
            "goal_id": goal["goal_id"],
            "plan_version": goal["plan_version"],
            "scheduled_for": goal["scheduled_for"],
        },
    )
    return {"goal": goal, "approval": approval}


def validate_conversation_scope(goal: dict[str, Any]) -> None:
    if goal.get("risk_level") != "routine":
        raise ContinuityError("Elevated or consequential goals require separate action-specific approval")
    if goal.get("restricted_side_effects"):
        raise ContinuityError("Goals with restricted side effects require separate action-specific approval")


def record_conversation_approval(
    root: Path,
    config: dict[str, Any],
    directory: Path,
    goal: dict[str, Any],
    source: str,
    authority_hash: str,
    required_stages: tuple[str, ...],
) -> tuple[dict[str, Any], str]:
    """Record a bounded interactive approval without asking the user to restate or sign it."""
    validate_conversation_scope(goal)
    validate_goal_planning_artifacts(goal, require_resolved=True)
    validate_planning_artifact_parity(directory, goal)
    if goal.get("roadmap_fingerprint") != roadmap_fingerprint(root, config, goal.get("roadmap_ids", [])):
        raise ContinuityError("Roadmap context changed after planning; revise the goal before proceeding")
    compliance = json_load(directory / "compliance.json", {})
    if compliance.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Goal compliance ledger uses a missing or unsupported assurance standard")
    for stage in required_stages:
        state = compliance.get("stages", {}).get(stage, {}).get("status")
        if state not in {"passed", "not-applicable"}:
            raise ContinuityError(f"Compliance stage {stage} must pass before proceeding")
    plan_hash = goal_material_hash(directory, goal)
    stamp = iso_now(config)
    approval = {
        "schema_version": SCHEMA_VERSION,
        "project_id": config["project_id"],
        "goal_id": goal["goal_id"],
        "plan_version": goal["plan_version"],
        "plan_hash": plan_hash,
        "behavior_configuration_hash": config.get("behavior_configuration_hash"),
        "approved_at": stamp,
        "approved_by": "interactive-user",
        "authorization_text": (
            f"Conversation {source} bound to {goal['goal_id']} plan "
            f"v{goal['plan_version']} ({authority_hash})"
        ),
        "authorization_source": source,
        "nonce": secrets.token_hex(16),
        "signature_format": "legacy-unsigned",
    }
    if not approval["behavior_configuration_hash"]:
        approval.pop("behavior_configuration_hash")
    try:
        runtime_lib.validate_schema_file(
            approval,
            CONTROL_ROOT / "schemas" / "approval-receipt.schema.json",
            "approval receipt",
        )
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    json_dump(directory / "approval.json", approval)
    compliance["stages"]["approval"] = {
        "status": "passed",
        "evidence": [f"interactive conversation: {source}", authority_hash, plan_hash],
        "updated_at": stamp,
    }
    compliance["updated_at"] = stamp
    json_dump(directory / "compliance.json", compliance)
    goal["plan_hash"] = plan_hash
    goal["state"] = "queued"
    goal["scheduled_for"] = stamp
    goal["updated_at"] = stamp
    json_dump(directory / "goal.json", goal)
    update_note_goal_links(root, config, goal.get("source_note_ids", []), goal["goal_id"], "queued")
    append_jsonl(
        directory / "feedback.jsonl",
        {
            "at": stamp,
            "author": "interactive-user",
            "type": f"{source}-authorization",
            "text": approval["authorization_text"],
        },
    )
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": stamp,
            "event": "goal.conversation-approved",
            "goal_id": goal["goal_id"],
            "plan_version": goal["plan_version"],
            "authorization_source": source,
            "authority_hash": authority_hash,
        },
    )
    return approval, plan_hash


def goal_activate(args: argparse.Namespace) -> dict[str, Any]:
    """Bind one explicit /goal request to a routine interactive implementation run."""
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if goal.get("state") != "awaiting-feedback":
        raise ContinuityError(f"Only an awaiting-feedback goal can be activated; current state is {goal.get('state')}")
    if goal.get("authorization_mode") != "goal-request":
        raise ContinuityError("Fast activation requires authorization_mode goal-request")
    validate_conversation_scope(goal)
    source_note_ids = goal.get("source_note_ids", [])
    if not source_note_ids:
        raise ContinuityError("Fast activation requires the /goal request to be captured and triaged")
    actionable_current_goal = False
    request_material: list[dict[str, str]] = []
    dispositions = {item.get("note_id"): item for item in goal.get("note_dispositions", [])}
    for note_id in source_note_ids:
        _capture_path, _capture, item = find_note_item(root, config, note_id)
        request_material.append(
            {
                "note_id": note_id,
                "text_sha256": hashlib.sha256(str(item.get("text", "")).encode()).hexdigest(),
            }
        )
        if item.get("routing_status") not in {"route", "promote", "defer", "archive"}:
            raise ContinuityError(f"Fast activation requires triage before planning: {note_id}")
        disposition = dispositions.get(note_id, {})
        if (
            disposition.get("disposition") == "current-goal"
            and item.get("kind") in {"documentation-candidate", "backlog-candidate", "execution-candidate", "explicit-instruction"}
            and item.get("routing_status") in {"route", "promote"}
        ):
            actionable_current_goal = True
    if not actionable_current_goal:
        raise ContinuityError("Fast activation requires a triaged actionable current-goal note")
    request_hash = canonical_hash({"source_notes": request_material})
    approval, plan_hash = record_conversation_approval(
        root,
        config,
        directory,
        goal,
        "goal-request",
        request_hash,
        ("capture-triage", "memory-retrieval", "roadmap-retrieval", "plan-review"),
    )
    dispatch = goal_start(argparse.Namespace(goal_id=goal["goal_id"], fast_interactive=True))
    return {
        "goal": json_load(directory / "goal.json", {}),
        "approval": approval,
        "dispatch": dispatch,
        "authorization_envelope": {
            "mode": "interactive-goal-request",
            "request_hash": request_hash,
            "plan_hash": plan_hash,
            "renew_only_for": [
                "material scope expansion",
                "elevated or consequential risk",
                "restricted external side effect",
                "destructive or irreversible action",
            ],
        },
    }


def goal_proceed(args: argparse.Namespace) -> dict[str, Any]:
    """Treat the current user's proceed instruction as one bounded interactive authorization."""
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if goal.get("state") != "awaiting-feedback":
        raise ContinuityError(f"Only an awaiting-feedback plan can proceed; current state is {goal.get('state')}")
    authority_hash = goal_material_hash(directory, goal)
    approval, plan_hash = record_conversation_approval(
        root,
        config,
        directory,
        goal,
        "plan-proceed",
        authority_hash,
        ("memory-retrieval", "roadmap-retrieval", "plan-review"),
    )
    dispatch = goal_start(argparse.Namespace(goal_id=goal["goal_id"], fast_interactive=True))
    return {
        "goal": json_load(directory / "goal.json", {}),
        "approval": approval,
        "dispatch": dispatch,
        "authorization_envelope": {
            "mode": "interactive-plan-proceed",
            "plan_hash": plan_hash,
            "renew_only_for": [
                "material scope expansion",
                "elevated or consequential risk",
                "restricted external side effect",
                "destructive or irreversible action",
            ],
        },
    }


def requested_workspace_roots(values: Iterable[str] = ()) -> list[Path]:
    raw = [value for value in values if value]
    if not raw:
        raw = [value for value in os.environ.get("CONTINUITY_WORKSPACE_ROOTS", "").split(os.pathsep) if value]
    if not raw:
        raw = [str(Path.cwd())]
    roots: list[Path] = []
    for value in raw:
        root = Path(value).expanduser().resolve()
        if not root.is_dir() or root == Path("/"):
            raise ContinuityError(f"Unsafe or missing workspace root: {root}")
        if root not in roots:
            roots.append(root)
    return roots


def scheduler_registration_path(root: Path, config: dict[str, Any]) -> Path:
    return private_path(root, config) / "scheduler-registration.json"


def scheduler_runs_path(root: Path, config: dict[str, Any]) -> Path:
    return private_path(root, config) / "scheduler-runs.jsonl"


def scheduler_due_actions_path(root: Path, config: dict[str, Any]) -> Path:
    return private_path(root, config) / "scheduler-due-actions.json"


def scheduler_project_lock_path(root: Path, config: dict[str, Any]) -> Path:
    return private_path(root, config) / "scheduler-state.lock"


def registration_workspace_roots(registration: dict[str, Any]) -> list[Path]:
    roots = registration.get("workspace_roots", [])
    if not isinstance(roots, list) or not roots or any(not isinstance(item, str) or not item.strip() for item in roots):
        raise ContinuityError("Scheduler registration has invalid workspace roots")
    return requested_workspace_roots(roots)


def portfolio_control_dir(registration: dict[str, Any]) -> Path:
    roots = registration_workspace_roots(registration)
    task_id = validate_task_id(str(registration.get("supervisor_task_id", "")), "supervisor task ID")
    return portfolio_control_dir_for(roots, task_id)


def portfolio_control_dir_for(roots: list[Path], task_id: str) -> Path:
    identity = canonical_hash({"task_id": task_id, "roots": sorted(str(root) for root in roots)})[:16]
    return sorted(roots, key=str)[0] / ".continuity-portfolio" / identity


def scheduler_liveness_limit(config: dict[str, Any]) -> dt.timedelta:
    scheduler = normalize_scheduler(config.get("scheduler"))
    return dt.timedelta(minutes=max(scheduler["stale_after_minutes"], scheduler["sweep_minutes"] * 3))


def load_due_actions(root: Path, config: dict[str, Any]) -> dict[str, dict[str, Any]]:
    value = json_load(scheduler_due_actions_path(root, config), {})
    if not isinstance(value, dict):
        raise ContinuityError("Scheduler due-action ledger is invalid")
    return {str(key): item for key, item in value.items() if isinstance(item, dict)}


def prune_due_actions(root: Path, config: dict[str, Any], current: dt.datetime) -> dict[str, dict[str, Any]]:
    actions = load_due_actions(root, config)
    retained: dict[str, dict[str, Any]] = {}
    for key, item in actions.items():
        expires = parse_recorded_time(item.get("expires_at"), config["timezone"])
        if item.get("consumed_at") or expires is None or expires <= current:
            continue
        retained[key] = item
    if retained != actions:
        json_dump(scheduler_due_actions_path(root, config), retained)
    return retained


def portfolio_runtime_inventory(
    projects: Iterable[dict[str, Any]],
    current: dt.datetime,
    supervisor_task_id: str,
    workspace_roots: list[Path],
    locked_project_root: Path | None = None,
) -> tuple[int, int, int, dict[str, tuple[Path, dict[str, Any], dict[str, Any]]]]:
    active = 0
    reserved = 0
    caps: list[int] = []
    claims: dict[str, tuple[Path, dict[str, Any], dict[str, Any]]] = {}
    for project in projects:
        if not project.get("healthy"):
            continue
        root = Path(project["path"]).resolve()
        config = json_load(root / ".continuity" / "config.json", {})
        if not isinstance(config, dict):
            continue
        registration = json_load(scheduler_registration_path(root, config), {})
        if not isinstance(registration, dict) or registration.get("supervisor_task_id") != supervisor_task_id:
            continue
        try:
            registered_roots = registration_workspace_roots(registration)
        except ContinuityError:
            continue
        if sorted(registered_roots, key=str) != sorted(workspace_roots, key=str):
            continue
        caps.append(normalize_scheduler(config.get("scheduler"))["portfolio_max_concurrency"])
        active += sum(
            1 for run in scheduler_run_snapshots(root, config).values()
            if run.get("status") in SCHEDULER_ACTIVE_STATES
        )
        if locked_project_root is not None and root == locked_project_root:
            with exclusive_file_lock(scheduler_project_lock_path(root, config)):
                for token, claim in prune_due_actions(root, config, current).items():
                    reserved += 1
                    claims[token] = (root, config, claim)
        else:
            with exclusive_file_lock(project_state_lock_path(root)):
                with exclusive_file_lock(scheduler_project_lock_path(root, config)):
                    for token, claim in prune_due_actions(root, config, current).items():
                        reserved += 1
                        claims[token] = (root, config, claim)
    return active, reserved, min(caps) if caps else 0, claims


def issue_due_claim(
    root: Path,
    config: dict[str, Any],
    due: dict[str, Any],
    supervisor_task_id: str,
    sweep_id: str,
    current: dt.datetime,
) -> str:
    with exclusive_file_lock(scheduler_project_lock_path(root, config)):
        claims = prune_due_actions(root, config, current)
        for token, claim in claims.items():
            if claim.get("idempotency_key") == due["idempotency_key"]:
                return token
        scheduler = normalize_scheduler(config.get("scheduler"))
        token = f"claim-{secrets.token_hex(16)}"
        claims[token] = {
            "schema_version": 1,
            "claim_token": token,
            "project_id": config["project_id"],
            "action": due["action"],
            "idempotency_key": due["idempotency_key"],
            "scheduled_at": due["scheduled_at"],
            "due_goal_ids": due.get("due_goal_ids", []),
            "issued_at": current.astimezone(ZoneInfo(config["timezone"])).isoformat(timespec="seconds"),
            "expires_at": (
                current.astimezone(ZoneInfo(config["timezone"]))
                + dt.timedelta(minutes=max(30, scheduler["sweep_minutes"] * 2))
            ).isoformat(timespec="seconds"),
            "supervisor_task_id": supervisor_task_id,
            "sweep_id": sweep_id,
            "behavior_configuration_hash": config.get("behavior_configuration_hash"),
        }
        json_dump(scheduler_due_actions_path(root, config), claims)
        return token


def parse_recorded_time(value: Any, timezone: str) -> dt.datetime | None:
    if not isinstance(value, str):
        return None
    try:
        parsed = dt.datetime.fromisoformat(value)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=ZoneInfo(timezone))
    return parsed


def scheduler_run_snapshots(root: Path, config: dict[str, Any]) -> dict[str, dict[str, Any]]:
    snapshots: dict[str, dict[str, Any]] = {}
    for event in iter_jsonl(scheduler_runs_path(root, config)):
        run_id = event.get("run_id")
        if not isinstance(run_id, str):
            continue
        current = dict(snapshots.get(run_id, {}))
        current.update(event)
        current["last_event_at"] = event.get("at")
        snapshots[run_id] = current
    return snapshots


def scheduler_registration_status_for(root: Path, config: dict[str, Any]) -> dict[str, Any]:
    scheduler = normalize_scheduler(config.get("scheduler"))
    provider = scheduler["provider"]
    registration = json_load(scheduler_registration_path(root, config), {})
    state = "not-requested" if provider == "none" else "requires-user-registration"
    problems: list[str] = []
    if provider != "none" and isinstance(registration, dict) and registration:
        if registration.get("provider") != provider:
            problems.append("registered provider does not match project configuration")
        if registration.get("behavior_configuration_hash") != config.get("behavior_configuration_hash"):
            problems.append("registration is stale for the current behavior configuration")
        task_id = registration.get("supervisor_task_id")
        if not isinstance(task_id, str) or not task_id.strip():
            problems.append("supervisor task ID is missing")
        else:
            try:
                validate_task_id(task_id, "supervisor task ID")
            except ContinuityError:
                problems.append("supervisor task ID is invalid")
        roots = registration.get("workspace_roots")
        if not isinstance(roots, list) or not roots:
            problems.append("workspace roots are missing")
        elif any(not isinstance(item, str) or not item.strip() for item in roots):
            problems.append("workspace roots must be non-empty paths")
        elif any(not Path(item).expanduser().resolve().is_dir() or Path(item).expanduser().resolve() == Path("/") for item in roots):
            problems.append("a registered workspace root is missing or unsafe")
        heartbeat_at = parse_recorded_time(registration.get("last_heartbeat_at"), config["timezone"])
        if heartbeat_at is None:
            problems.append("supervisor heartbeat is missing")
        elif now(config) - heartbeat_at > scheduler_liveness_limit(config):
            problems.append("supervisor heartbeat is stale")
        if not problems:
            state = "registered"
        else:
            state = "stale"
    snapshots = scheduler_run_snapshots(root, config)
    active = [run for run in snapshots.values() if run.get("status") in SCHEDULER_ACTIVE_STATES]
    stale_after = dt.timedelta(minutes=scheduler["stale_after_minutes"])
    current = now(config)
    stale_runs = [
        run["run_id"]
        for run in active
        if (stamp := parse_recorded_time(run.get("last_event_at"), config["timezone"])) is not None
        and current - stamp > stale_after
    ]
    return {
        "state": state,
        "provider": provider,
        "registered_at": registration.get("registered_at") if isinstance(registration, dict) else None,
        "last_heartbeat_at": registration.get("last_heartbeat_at") if isinstance(registration, dict) else None,
        "last_sweep_id": registration.get("last_sweep_id") if isinstance(registration, dict) else None,
        "supervisor_task_id": registration.get("supervisor_task_id") if isinstance(registration, dict) else None,
        "workspace_roots": registration.get("workspace_roots", []) if isinstance(registration, dict) else [],
        "active_runs": len(active),
        "stale_runs": stale_runs,
        "problems": problems,
        "policy": {key: value for key, value in scheduler.items() if key != "provider"},
    }


def action_calendar_allows(action: str, local_now: dt.datetime, business_days: list[int]) -> bool:
    if action == "report":
        return local_now.weekday() in business_days
    return (local_now + dt.timedelta(days=1)).weekday() in business_days


def latest_run_for_key(root: Path, config: dict[str, Any], idempotency_key: str) -> tuple[dict[str, Any] | None, int]:
    matching = [run for run in scheduler_run_snapshots(root, config).values() if run.get("idempotency_key") == idempotency_key]
    if not matching:
        return None, 0
    matching.sort(key=lambda value: value.get("last_event_at", ""))
    return matching[-1], max(int(run.get("attempt", 1)) for run in matching)


def due_action_for_project(root: Path, config: dict[str, Any], manifest: dict[str, Any], action: str, current: dt.datetime) -> dict[str, Any] | None:
    scheduler = normalize_scheduler(config.get("scheduler", manifest.get("scheduler")))
    local_now = current.astimezone(ZoneInfo(config["timezone"]))
    business_days = scheduler["business_days"]
    if not action_calendar_allows(action, local_now, business_days):
        return None
    scheduled_text = manifest.get("schedules", {}).get(action)
    if not isinstance(scheduled_text, str):
        return None
    hour, minute = (int(part) for part in scheduled_text.split(":"))
    scheduled_at = local_now.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if local_now < scheduled_at:
        return None
    if action == "dispatch" and not manifest.get("execution_enabled"):
        return None
    idempotency_key = f"{manifest['project_id']}:{action}:{scheduled_at.date().isoformat()}"
    latest, attempts = latest_run_for_key(root, config, idempotency_key)
    stale_after = dt.timedelta(minutes=scheduler["stale_after_minutes"])
    retry_backoff = dt.timedelta(minutes=scheduler["retry_backoff_minutes"])
    status = "due"
    if latest:
        latest_at = parse_recorded_time(latest.get("last_event_at"), config["timezone"])
        if latest.get("status") == "succeeded":
            return None
        if latest.get("status") in SCHEDULER_ACTIVE_STATES:
            if latest_at is None or local_now - latest_at <= stale_after:
                return None
            status = "recovery-required"
        elif attempts > scheduler["retry_limit"]:
            return None
        elif latest_at is not None and local_now - latest_at < retry_backoff:
            return None
        else:
            status = "retry"
    due_goals: list[str] = []
    if action == "dispatch":
        review_key = f"{manifest['project_id']}:review:{scheduled_at.date().isoformat()}"
        latest_review, _review_attempts = latest_run_for_key(root, config, review_key)
        if not latest_review or latest_review.get("status") != "succeeded":
            return {
                "project_id": manifest["project_id"],
                "path": str(root),
                "action": action,
                "status": "waiting-for-review",
                "scheduled_at": scheduled_at.isoformat(timespec="minutes"),
                "idempotency_key": idempotency_key,
                "attempt": attempts + 1,
                "due_goal_ids": [],
                "portfolio_max_concurrency": scheduler["portfolio_max_concurrency"],
                "autonomy_envelope": "approved-code",
                "blocked_by": review_key,
            }
        previous = os.environ.get("CONTINUITY_PROJECT_ROOT")
        os.environ["CONTINUITY_PROJECT_ROOT"] = str(root)
        try:
            due_goals = [goal["goal_id"] for goal in goal_due(argparse.Namespace())]
        finally:
            if previous is None:
                os.environ.pop("CONTINUITY_PROJECT_ROOT", None)
            else:
                os.environ["CONTINUITY_PROJECT_ROOT"] = previous
        if not due_goals:
            return None
    return {
        "project_id": manifest["project_id"],
        "path": str(root),
        "action": action,
        "status": status,
        "scheduled_at": scheduled_at.isoformat(timespec="minutes"),
        "idempotency_key": idempotency_key,
        "attempt": attempts + 1,
        "due_goal_ids": due_goals,
        "portfolio_max_concurrency": scheduler["portfolio_max_concurrency"],
        "autonomy_envelope": "approved-code" if manifest.get("execution_enabled") else "analysis-only",
    }


def discover_projects(workspace_roots: Iterable[Path], *, allow_duplicate_ids: bool = False) -> list[dict[str, Any]]:
    discovered: dict[str, dict[str, Any]] = {}
    pruned = {".git", ".agents", ".continuity", "node_modules", ".venv", "venv", "dist", "build", "target", "vendor", "__pycache__"}
    for workspace_root in workspace_roots:
        for current, directories, _files in os.walk(workspace_root, followlinks=False):
            current_path = Path(current).resolve()
            if not current_path.is_relative_to(workspace_root):
                directories[:] = []
                continue
            manifest_path = current_path / ".continuity" / "project.json"
            if manifest_path.is_file() and manifest_path.resolve().is_relative_to(current_path):
                try:
                    manifest = load_project_manifest(current_path)
                    config = json_load(current_path / ".continuity" / "config.json", {})
                    problems = []
                    if not manifest.get("continuity_enabled"):
                        problems.append("continuity is disabled")
                    if not isinstance(config, dict) or config.get("schema_version") != SCHEMA_VERSION:
                        problems.append("configuration is missing or invalid")
                    elif config.get("project_id") != manifest.get("project_id"):
                        problems.append("manifest and configuration project IDs differ")
                    if not (current_path / "AGENTS.md").is_file():
                        problems.append("AGENTS.md is missing")
                    if not (current_path / ".agents" / "continuity" / "bin" / "continuity").is_file():
                        problems.append("project-local continuity CLI is missing")
                    installed_skills = current_path / ".agents" / "skills"
                    missing_skills = [
                        name for name in (
                            "continuity-capture",
                            "continuity-triage",
                            "continuity-memory",
                            "continuity-roadmap",
                            "continuity-share",
                            "continuity-plan",
                            "continuity-dispatch",
                            "continuity-execute",
                            "continuity-test",
                            "continuity-merge",
                            "continuity-report",
                        )
                        if not (installed_skills / name / "SKILL.md").is_file()
                    ]
                    if missing_skills:
                        problems.append(f"missing skills: {missing_skills}")
                    project_id = str(manifest.get("project_id", ""))
                    if not project_id:
                        problems.append("project_id is missing")
                        project_id = str(current_path)
                    record = {
                        "project_id": project_id,
                        "path": str(current_path),
                        "manifest": manifest,
                        "healthy": not problems,
                        "problems": problems,
                    }
                    discovery_key = str(current_path) if allow_duplicate_ids else project_id
                    if not allow_duplicate_ids and project_id in discovered and discovered[project_id]["path"] != record["path"]:
                        discovered[project_id]["healthy"] = False
                        discovered[project_id]["problems"].append(f"duplicate project ID at {record['path']}")
                    else:
                        discovered[discovery_key] = record
                except (ContinuityError, json.JSONDecodeError) as exc:
                    discovered[str(current_path)] = {
                        "project_id": None,
                        "path": str(current_path),
                        "healthy": False,
                        "problems": [str(exc)],
                    }
                directories[:] = []
                continue
            directories[:] = [name for name in directories if name not in pruned and not name.startswith(".")]
    return sorted(discovered.values(), key=lambda item: (str(item.get("project_id")), item["path"]))


def dependency_states(root: Path, config: dict[str, Any], goal: dict[str, Any]) -> dict[str, str]:
    states: dict[str, str] = {}
    for dependency in goal.get("depends_on", []):
        try:
            dependency_root = root
            dependency_config = config
            dependency_goal_id = dependency
            if ":" in dependency:
                project_id, dependency_goal_id = dependency.split(":", 1)
                project = next(
                    (item for item in discover_projects(requested_workspace_roots()) if item.get("project_id") == project_id and item.get("healthy")),
                    None,
                )
                if not project:
                    raise ContinuityError(f"Unknown dependency project {project_id}")
                dependency_root = Path(project["path"]).expanduser().resolve()
                dependency_config = json_load(dependency_root / ".continuity" / "config.json", {})
            _directory, dep = load_goal(dependency_root, dependency_config, dependency_goal_id)
            states[dependency] = dep.get("state", "unknown")
        except ContinuityError:
            states[dependency] = "missing"
    return states


def portfolio_goals(args: argparse.Namespace) -> list[dict[str, Any]]:
    workspace_roots = requested_workspace_roots(args.root or [])
    os.environ["CONTINUITY_WORKSPACE_ROOTS"] = os.pathsep.join(str(root) for root in workspace_roots)
    projects = discover_projects(workspace_roots)
    if args.discover:
        return projects
    results: list[dict[str, Any]] = []
    for project in projects:
        if not project.get("healthy"):
            results.append(project)
            continue
        project_root = Path(project["path"]).expanduser().resolve()
        manifest = project["manifest"]
        config = json_load(project_root / ".continuity" / "config.json", {})
        if args.due and not manifest.get("execution_enabled"):
            continue
        if args.due:
            previous = os.environ.get("CONTINUITY_PROJECT_ROOT")
            os.environ["CONTINUITY_PROJECT_ROOT"] = str(project_root)
            try:
                goals = goal_due(argparse.Namespace())
            finally:
                if previous is None:
                    os.environ.pop("CONTINUITY_PROJECT_ROOT", None)
                else:
                    os.environ["CONTINUITY_PROJECT_ROOT"] = previous
        else:
            goals = []
            for path in sorted((private_path(project_root, config) / "goals").glob("*/goal.json")):
                goal = json_load(path, {})
                if isinstance(goal, dict):
                    goals.append(goal)
        if not goals:
            results.append(
                {
                    "project_id": project.get("project_id"),
                    "path": str(project_root),
                    "integration_branch": manifest.get("integration_branch"),
                    "execution_enabled": manifest.get("execution_enabled", False),
                    "project_lock": json_load(private_path(project_root, config) / "project.lock.json"),
                    "goal_count": 0,
                    "goals": [],
                    "state": "no-goals",
                }
            )
            continue
        for goal in goals:
            results.append(
                {
                    "project_id": project.get("project_id"),
                    "path": str(project_root),
                    "integration_branch": manifest.get("integration_branch"),
                    "execution_enabled": manifest.get("execution_enabled", False),
                    "project_lock": json_load(private_path(project_root, config) / "project.lock.json"),
                    "goal_count": len(goals),
                    **goal,
                }
            )
    return results


def project_cli_json(project_root: Path, *arguments: str, timeout: int = 360) -> dict[str, Any]:
    cli = project_root / ".agents" / "continuity" / "bin" / "continuity"
    if not cli.is_file():
        raise ContinuityError(f"Project-local Continuity CLI is missing: {cli}")
    command = [sys.executable, str(cli), "--project-root", str(project_root), "--json", *arguments]
    try:
        result = runtime_lib.run_process_tree(command, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise ContinuityError(f"Project command failed for {project_root}: {exc}") from exc
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise ContinuityError(f"Project command failed for {project_root}: {detail}")
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise ContinuityError(f"Project command returned invalid JSON for {project_root}") from exc
    if not isinstance(payload, dict):
        raise ContinuityError(f"Project command returned an invalid record for {project_root}")
    return payload


def source_installer_json(
    source: Path,
    project_root: Path,
    project_id: str,
    integration_branch: str,
    *,
    dry_run: bool,
    overwrite_managed: bool,
    skip_github_auth: bool,
) -> dict[str, Any]:
    installer = source / "installer" / "install.py"
    if not installer.is_file():
        raise ContinuityError(f"Release installer is missing: {installer}")
    command = [
        sys.executable,
        str(installer),
        "--project-root",
        str(project_root),
        "--project-id",
        project_id,
        "--integration-branch",
        integration_branch,
        "--ignore-user-defaults",
    ]
    if dry_run:
        command.append("--dry-run")
    if overwrite_managed:
        command.append("--overwrite-managed")
    if skip_github_auth:
        command.append("--skip-github-auth")
    try:
        result = runtime_lib.run_process_tree(command, capture_output=True, text=True, timeout=930, check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise ContinuityError(f"Release installer failed for {project_root}: {exc}") from exc
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise ContinuityError(f"Release installer failed for {project_root}: {detail}")
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise ContinuityError(f"Release installer returned invalid JSON for {project_root}") from exc
    if not isinstance(payload, dict):
        raise ContinuityError(f"Release installer returned an invalid record for {project_root}")
    return payload


def portfolio_update(args: argparse.Namespace) -> dict[str, Any]:
    if args.version:
        args.version = validate_release_version(args.version)
    workspace_roots = requested_workspace_roots(args.root or [])
    projects = discover_projects(workspace_roots, allow_duplicate_ids=True)
    requested_ids = set(args.project_id or [])
    discovered_ids = {str(project.get("project_id")) for project in projects if project.get("project_id")}
    missing_ids = sorted(requested_ids - discovered_ids)
    if missing_ids:
        raise ContinuityError(f"Requested projects were not discovered: {missing_ids}")
    if requested_ids:
        projects = [project for project in projects if project.get("project_id") in requested_ids]

    source: Path | None = None
    if not args.version:
        source = Path(args.source).expanduser().resolve() if args.source else CONTROL_ROOT.resolve()
        source_release_status(source)

    results: list[dict[str, Any]] = []
    for project in projects:
        project_root = Path(project["path"]).expanduser().resolve()
        record: dict[str, Any] = {
            "project_id": project.get("project_id"),
            "path": str(project_root),
            "apply": bool(args.apply),
        }
        local_cli = project_root / ".agents" / "continuity" / "bin" / "continuity"
        if local_cli.is_file():
            try:
                before_doctor = project_cli_json(project_root, "project", "doctor")
            except ContinuityError as exc:
                results.append({**record, "status": "blocked", "problems": [str(exc)]})
                continue
            record["before"] = {
                "healthy": bool(before_doctor.get("healthy")),
                "suite_version": before_doctor.get("suite_installation", {}).get("version"),
                "problems": list(before_doctor.get("problems", [])),
            }
        else:
            record["before"] = {
                "healthy": False,
                "suite_version": None,
                "problems": list(project.get("problems", [])),
                "legacy_bootstrap_required": True,
            }
            if source is None:
                results.append(
                    {
                        **record,
                        "status": "blocked",
                        "problems": ["Legacy bootstrap requires --source or the default controller release"],
                    }
                )
                continue

        try:
            if local_cli.is_file():
                update_arguments = ["suite", "update"]
                if source is not None:
                    update_arguments.extend(["--source", str(source)])
                elif args.version:
                    update_arguments.extend(["--version", args.version])
                if not args.apply:
                    update_arguments.append("--dry-run")
                if args.overwrite_managed:
                    update_arguments.append("--overwrite-managed")
                if args.skip_github_auth:
                    update_arguments.append("--skip-github-auth")
                update = project_cli_json(project_root, *update_arguments, timeout=930)
            else:
                manifest = project.get("manifest", {})
                project_id = str(project.get("project_id") or "")
                integration_branch = str(manifest.get("integration_branch") or "")
                if not project_id or not integration_branch:
                    raise ContinuityError("Legacy bootstrap requires valid project and integration-branch records")
                installer_payload = source_installer_json(
                    source,
                    project_root,
                    project_id,
                    integration_branch,
                    dry_run=not args.apply,
                    overwrite_managed=args.overwrite_managed,
                    skip_github_auth=args.skip_github_auth,
                )
                update = {
                    "updated": bool(args.apply),
                    "dry_run": not args.apply,
                    "from_version": None,
                    "to_version": installer_payload.get("suite_version"),
                    "legacy_bootstrap": True,
                    "installer": installer_payload,
                }
        except ContinuityError as exc:
            results.append({**record, "status": "failed", "problems": [str(exc)]})
            continue
        record["update"] = update
        if not args.apply:
            results.append({**record, "status": "planned", "healthy": True})
            continue

        snapshot = update.get("installer", {}).get("upgrade_snapshot")
        try:
            after_doctor = project_cli_json(project_root, "project", "doctor")
        except ContinuityError as exc:
            after_doctor = {"healthy": False, "problems": [str(exc)]}
        lifecycle_problems = [
            problem
            for problem in after_doctor.get("problems", [])
            if "missing or invalid lifecycle timestamp" in str(problem)
        ]
        if lifecycle_problems:
            try:
                record["lifecycle_migration"] = project_cli_json(
                    project_root,
                    "note",
                    "migrate-lifecycle",
                    "--actor",
                    "portfolio-update",
                )
                after_doctor = project_cli_json(project_root, "project", "doctor")
            except ContinuityError as exc:
                after_doctor = {
                    "healthy": False,
                    "problems": [*after_doctor.get("problems", []), str(exc)],
                }
        record["after"] = {
            "healthy": bool(after_doctor.get("healthy")),
            "suite_version": after_doctor.get("suite_installation", {}).get("version"),
        }
        if after_doctor.get("healthy"):
            results.append({**record, "status": "updated", "healthy": True})
            continue

        rollback_problems = list(after_doctor.get("problems", []))
        if not isinstance(snapshot, str) or not snapshot:
            rollback_problems.append("update did not return a rollback snapshot")
            results.append({**record, "status": "failed", "healthy": False, "problems": rollback_problems})
            continue
        try:
            rollback = project_cli_json(project_root, "suite", "rollback", "--snapshot", snapshot)
            restored_doctor = project_cli_json(project_root, "project", "doctor")
            results.append(
                {
                    **record,
                    "status": "rolled-back",
                    "healthy": bool(restored_doctor.get("healthy")),
                    "problems": rollback_problems,
                    "rollback": rollback,
                }
            )
        except ContinuityError as exc:
            rollback_problems.append(str(exc))
            results.append({**record, "status": "rollback-failed", "healthy": False, "problems": rollback_problems})

    counts = {
        status: sum(1 for result in results if result.get("status") == status)
        for status in ("planned", "updated", "blocked", "failed", "rolled-back", "rollback-failed")
    }
    unsuccessful = counts["blocked"] + counts["failed"] + counts["rolled-back"] + counts["rollback-failed"]
    return {
        "schema_version": 1,
        "apply": bool(args.apply),
        "source": str(source) if source is not None else None,
        "version": args.version,
        "workspace_roots": [str(root) for root in workspace_roots],
        "status": "completed" if not unsuccessful else "partial",
        "counts": counts,
        "projects": results,
    }


def portfolio_sanitized_report(args: argparse.Namespace) -> dict[str, Any]:
    roots = requested_workspace_roots(args.root or [])
    projects = discover_projects(roots)
    records: list[dict[str, Any]] = []
    for project in projects:
        project_root = Path(project["path"])
        try:
            root, config = load_context(project_root, validate_behavior=False)
            goals = []
            for path in sorted((private_path(root, config) / "goals").glob("*/goal.json")):
                goal = json_load(path, {})
                if isinstance(goal, dict):
                    goals.append(goal)
            goal_counts: dict[str, int] = {}
            for goal in goals:
                state = str(goal.get("state", "unknown"))
                goal_counts[state] = goal_counts.get(state, 0) + 1
            previous_project_root = os.environ.get("CONTINUITY_PROJECT_ROOT")
            os.environ["CONTINUITY_PROJECT_ROOT"] = str(root)
            try:
                morning = morning_decision_report(root, config)
            finally:
                if previous_project_root is None:
                    os.environ.pop("CONTINUITY_PROJECT_ROOT", None)
                else:
                    os.environ["CONTINUITY_PROJECT_ROOT"] = previous_project_root
            records.append(
                {
                    "project_id": config["project_id"],
                    "healthy": bool(project.get("healthy")),
                    "goal_state_counts": goal_counts,
                    "note_stage_counts": morning.get("note_lifecycle", {}).get("stage_counts", {}),
                    "queue_counts": morning.get("queue_counts", {}),
                    "decisions_required": len(morning.get("decisions_needed", [])),
                    "blocked_or_at_risk": len(morning.get("blocked_or_at_risk", [])),
                    "risk_types": sorted({str(item.get("type") or item.get("state") or "goal") for item in morning.get("blocked_or_at_risk", [])}),
                    "product_audit_status": morning.get("product_audit_health", {}).get("status"),
                    "product_audits_due": len(morning.get("product_audit_health", {}).get("due", [])),
                    "product_audit_baseline_required": bool(
                        morning.get("product_audit_health", {}).get("baseline_required")
                    ),
                    "scheduler_state": morning.get("scheduler", {}).get("state"),
                    "no_action_required": bool(morning.get("no_action_required")),
                }
            )
        except (ContinuityError, OSError, json.JSONDecodeError) as exc:
            records.append({"project_id": project.get("project_id", "unknown"), "healthy": False, "error_class": type(exc).__name__, "decisions_required": 0, "blocked_or_at_risk": 1})
    report = {
        "schema_version": 1,
        "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
        "sanitization_policy": "continuity-portfolio-allowlist-v1",
        "projects": sorted(records, key=lambda item: item["project_id"]),
        "totals": {
            "projects": len(records),
            "healthy": sum(1 for item in records if item.get("healthy")),
            "decisions_required": sum(int(item.get("decisions_required", 0)) for item in records),
            "blocked_or_at_risk": sum(int(item.get("blocked_or_at_risk", 0)) for item in records),
        },
    }
    try:
        runtime_lib.validate_schema_file(report, CONTROL_ROOT / "schemas" / "portfolio-report.schema.json", "sanitized portfolio report")
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    return report


def portfolio_actions(args: argparse.Namespace) -> list[dict[str, Any]]:
    workspace_roots = requested_workspace_roots(args.root or [])
    os.environ["CONTINUITY_WORKSPACE_ROOTS"] = os.pathsep.join(str(root) for root in workspace_roots)
    if args.at:
        if os.environ.get("CONTINUITY_ALLOW_TIME_OVERRIDE") != "1":
            raise ContinuityError("--at is restricted to explicit test or inspection environments")
        try:
            current = dt.datetime.fromisoformat(args.at)
        except ValueError as exc:
            raise ContinuityError("--at must be an ISO 8601 datetime") from exc
        if current.tzinfo is None:
            raise ContinuityError("--at must include a timezone offset")
    else:
        current = dt.datetime.now(dt.timezone.utc)
    sweep_id = args.sweep_id or f"sweep-{secrets.token_hex(8)}"
    validate_identifier(sweep_id, "supervisor sweep ID")
    supervisor_task_id = args.supervisor_task_id
    if supervisor_task_id:
        validate_task_id(supervisor_task_id, "supervisor task ID")
    actions = [args.action] if args.action else ["review", "dispatch", "report"]
    results: list[dict[str, Any]] = []
    projects = discover_projects(workspace_roots)
    for project in projects:
        if not project.get("healthy"):
            results.append({**project, "action": "health", "status": "blocked"})
            continue
        root = Path(project["path"]).resolve()
        manifest = project["manifest"]
        config = json_load(root / ".continuity" / "config.json", {})
        provider = normalize_scheduler(config.get("scheduler"))["provider"]
        if provider != "none":
            if not supervisor_task_id:
                results.append(
                    {
                        "project_id": project["project_id"],
                        "path": str(root),
                        "action": "registration",
                        "status": "blocked",
                        "reason": "supervisor task ID is required for a live sweep",
                    }
                )
                continue
            try:
                with exclusive_file_lock(project_state_lock_path(root)):
                    scheduler_supervisor_heartbeat(
                        root, config, supervisor_task_id, sweep_id, workspace_roots
                    )
            except ContinuityError as exc:
                results.append(
                    {
                        "project_id": project["project_id"],
                        "path": str(root),
                        "action": "registration",
                        "status": "blocked",
                        "reason": str(exc),
                    }
                )
                continue
        registration = scheduler_registration_status_for(root, config)
        if registration["state"] not in {"registered", "not-requested"}:
            results.append(
                {
                    "project_id": project["project_id"],
                    "path": str(root),
                    "action": "registration",
                    "status": "blocked",
                    "scheduler": registration,
                }
            )
            continue
        for action in actions:
            due = due_action_for_project(root, config, manifest, action, current)
            if due:
                due["scheduler"] = registration
                if provider == "none" and due.get("status") in {"due", "retry"}:
                    due["status"] = "manual-only"
                results.append(due)
    runnable = [item for item in results if item.get("status") in {"due", "retry"}]
    if runnable:
        if not supervisor_task_id:
            raise ContinuityError("A supervisor task ID is required to reserve runnable actions")
        control = portfolio_control_dir_for(workspace_roots, supervisor_task_id)
        with exclusive_file_lock(control / "portfolio.lock"):
            active, reserved, capacity, existing_claims = portfolio_runtime_inventory(
                projects, current, supervisor_task_id, workspace_roots
            )
            available = max(0, capacity - active - reserved)
            runnable.sort(key=lambda item: (item.get("scheduled_at", ""), item.get("project_id", ""), item.get("action", "")))
            for item in runnable:
                existing = next(
                    (
                        token for token, (_root, _config, claim) in existing_claims.items()
                        if claim.get("idempotency_key") == item["idempotency_key"]
                    ),
                    None,
                )
                if existing:
                    item["claim_token"] = existing
                    item["reservation_state"] = "existing"
                elif available > 0:
                    root = Path(item["path"]).resolve()
                    config = json_load(root / ".continuity" / "config.json", {})
                    with exclusive_file_lock(project_state_lock_path(root)):
                        item["claim_token"] = issue_due_claim(
                            root, config, item, supervisor_task_id, sweep_id, current
                        )
                    item["reservation_state"] = "reserved"
                    available -= 1
                else:
                    item["status"] = "capacity-deferred"
                item["portfolio_active_runs"] = active
                item["portfolio_reserved_actions"] = reserved
                item["portfolio_available_slots"] = available
    return results


def detected_validation_commands(root: Path) -> list[str]:
    package_path = root / "package.json"
    if not package_path.exists():
        return []
    package = json_load(package_path, {})
    scripts = package.get("scripts", {}) if isinstance(package, dict) else {}
    if not isinstance(scripts, dict):
        return []
    runner = "pnpm" if (root / "pnpm-lock.yaml").exists() else "npm run"
    detected: list[str] = []
    for name in ("typecheck", "test", "build"):
        if name not in scripts:
            continue
        detected.append(f"{runner} {name}" if runner == "pnpm" else f"{runner} {name}")
    return detected


def current_behavior_settings(root: Path, config: dict[str, Any], manifest: dict[str, Any]) -> dict[str, Any]:
    existing_path = confined_path(root, config.get("behavior_config_path", BEHAVIOR_CONFIG_PATH), "behavior_config_path")
    existing = json_load(existing_path, {})
    if isinstance(existing, dict) and isinstance(existing.get("settings"), dict):
        settings = dict(existing["settings"])
        settings.setdefault("product_audit_stale_after_days", config.get("product_audit_stale_after_days", 30))
        settings.setdefault("planning_patterns", dict(DEFAULT_PLANNING_PATTERNS))
        settings.setdefault("roadmap", dict(DEFAULT_ROADMAP_SETTINGS))
        settings.setdefault("agent_surfaces", dict(DEFAULT_AGENT_SURFACES))
        if settings.get("github_required_checks") is None:
            settings["github_required_checks"] = config.get("github_required_checks", [])
        if settings.get("github_required_reviewers") is None:
            settings["github_required_reviewers"] = config.get("github_required_reviewers", 1)
        if settings.get("github_cli_merge_enabled") is None:
            settings["github_cli_merge_enabled"] = bool(config.get("github_cli_merge_enabled", False))
        settings["scheduler"] = normalize_scheduler(settings.get("scheduler"))
        documentation_map = dict(settings.get("documentation_map", {}))
        documentation_map.setdefault("project-roadmap", "docs/project-roadmap/INDEX.md")
        settings["documentation_map"] = documentation_map
        return settings
    schedules = manifest.get("schedules", {}) if isinstance(manifest.get("schedules"), dict) else {}
    return {
        "integration_branch": config.get("integration_branch", manifest.get("integration_branch", "main")),
        "timezone": config.get("timezone", manifest.get("timezone", "America/Chicago")),
        "schedules": {
            "review": schedules.get("review", "20:00"),
            "dispatch": schedules.get("dispatch", config.get("default_start_time", "22:00")),
            "report": schedules.get("report", "07:00"),
        },
        "max_runtime_minutes": config.get("max_runtime_minutes", 360),
        "memory_stale_after_days": config.get("memory_stale_after_days", 90),
        "product_audit_stale_after_days": config.get("product_audit_stale_after_days", 30),
        "validation_commands": config.get("validation_commands", []),
        "security_commands": config.get("security_commands", []),
        "github_required_checks": config.get("github_required_checks", []),
        "github_required_reviewers": config.get("github_required_reviewers", 1),
        "github_cli_merge_enabled": bool(config.get("github_cli_merge_enabled", False)),
        "documentation_map": {**config.get("documentation_map", {"project-memory": "docs/project-memory/INDEX.md"}), "project-roadmap": "docs/project-roadmap/INDEX.md"},
        "visual_evidence_mode": config.get("visual_evidence_mode", "when-applicable"),
        "branch_prefix": config.get("branch_prefix", "continuity"),
        "project_instructions": config.get("project_instructions", []),
        "planning_patterns": config.get("planning_patterns", dict(DEFAULT_PLANNING_PATTERNS)),
        "roadmap": config.get("roadmap", dict(DEFAULT_ROADMAP_SETTINGS)),
        "agent_surfaces": config.get("agent_surfaces", manifest.get("agent_surfaces", dict(DEFAULT_AGENT_SURFACES))),
        "scheduler": normalize_scheduler(config.get("scheduler", manifest.get("scheduler"))),
        "execution_enabled": bool(manifest.get("execution_enabled", False)),
    }


def recommended_behavior_settings(root: Path, config: dict[str, Any], manifest: dict[str, Any]) -> dict[str, Any]:
    current = current_behavior_settings(root, config, manifest)
    detected = detected_validation_commands(root)
    return {
        "integration_branch": current["integration_branch"],
        "timezone": current["timezone"],
        "schedules": current["schedules"],
        "max_runtime_minutes": current["max_runtime_minutes"],
        "memory_stale_after_days": current["memory_stale_after_days"],
        "product_audit_stale_after_days": current["product_audit_stale_after_days"],
        "validation_commands": detected or current.get("validation_commands", []),
        "security_commands": current.get("security_commands", []),
        "github_required_checks": current.get("github_required_checks", []),
        "github_required_reviewers": current.get("github_required_reviewers", 1),
        "github_cli_merge_enabled": False,
        "documentation_map": current.get("documentation_map", {"project-memory": "docs/project-memory/INDEX.md"}),
        "visual_evidence_mode": "when-applicable",
        "branch_prefix": "continuity",
        "project_instructions": current.get("project_instructions", []),
        "planning_patterns": current.get("planning_patterns", dict(DEFAULT_PLANNING_PATTERNS)),
        "roadmap": current.get("roadmap", dict(DEFAULT_ROADMAP_SETTINGS)),
        "agent_surfaces": current.get("agent_surfaces", dict(DEFAULT_AGENT_SURFACES)),
        "scheduler": current.get("scheduler", dict(DEFAULT_SCHEDULER)),
        "execution_enabled": False,
    }


