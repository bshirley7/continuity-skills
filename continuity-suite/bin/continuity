        },
    }


def validate_behavior_settings(root: Path, value: Any) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise ContinuityError("Project behavior settings must be a JSON object")
    allowed = {
        "integration_branch",
        "timezone",
        "schedules",
        "max_runtime_minutes",
        "memory_stale_after_days",
        "product_audit_stale_after_days",
        "validation_commands",
        "security_commands",
        "github_required_checks",
        "github_required_reviewers",
        "github_cli_merge_enabled",
        "documentation_map",
        "visual_evidence_mode",
        "branch_prefix",
        "project_instructions",
        "planning_patterns",
        "roadmap",
        "agent_surfaces",
        "scheduler",
        "execution_enabled",
    }
    unknown = sorted(set(value) - allowed)
    if unknown:
        raise ContinuityError(f"Unsupported project behavior settings: {unknown}")
    settings = dict(value)
    settings.setdefault("github_cli_merge_enabled", False)
    branch = validate_git_branch(root, settings.get("integration_branch"), "integration_branch")
    timezone = str(settings.get("timezone", ""))
    try:
        ZoneInfo(timezone)
    except Exception as exc:
        raise ContinuityError(f"Unknown timezone: {timezone}") from exc
    schedules = settings.get("schedules")
    if not isinstance(schedules, dict) or set(schedules) != {"review", "dispatch", "report"}:
        raise ContinuityError("schedules must define exactly review, dispatch, and report")
    for label, scheduled in schedules.items():
        if not isinstance(scheduled, str) or not re.fullmatch(r"(?:[01][0-9]|2[0-3]):[0-5][0-9]", scheduled):
            raise ContinuityError(f"Invalid {label} schedule; use HH:MM in 24-hour time")
    for label, maximum in (("max_runtime_minutes", 360), ("memory_stale_after_days", 3650), ("product_audit_stale_after_days", 3650)):
        number = settings.get(label)
        if isinstance(number, bool) or not isinstance(number, int) or not 1 <= number <= maximum:
            raise ContinuityError(f"{label} must be between 1 and {maximum}")
    for label in ("validation_commands", "security_commands"):
        commands = settings.get(label)
        if not isinstance(commands, list) or any(not isinstance(item, str) or not item.strip() or any(char in item for char in "\n\r\x00") or "```" in item for item in commands):
            raise ContinuityError(f"{label} must be a JSON array of non-empty, single-line strings")
        for command in commands:
            if re.search(r"(?i)(?:token|password|secret|api[_-]?key)\s*=", command) or re.search(r"://[^/\s:@]+:[^/\s@]+@", command):
                raise ContinuityError(f"{label} appears to contain an inline credential; use the project's secret provider")
            command_argv(command)
    checks = settings.get("github_required_checks")
    if not isinstance(checks, list) or any(not isinstance(item, str) or not item.strip() or any(char in item for char in "\n\r\x00") for item in checks) or len(checks) != len(set(checks)):
        raise ContinuityError("github_required_checks must be a unique array of non-empty single-line names")
    reviewers = settings.get("github_required_reviewers")
    if isinstance(reviewers, bool) or not isinstance(reviewers, int) or not 0 <= reviewers <= 20:
        raise ContinuityError("github_required_reviewers must be between 0 and 20")
    if not isinstance(settings.get("github_cli_merge_enabled"), bool):
        raise ContinuityError("github_cli_merge_enabled must be true or false")
    documentation_map = settings.get("documentation_map")
    if not isinstance(documentation_map, dict) or not documentation_map:
        raise ContinuityError("documentation_map must be a non-empty JSON object")
    for label, path in documentation_map.items():
        if not isinstance(label, str) or not label.strip() or any(char in label for char in "\n\r\x00") or "```" in label or not isinstance(path, str) or not path.strip() or "```" in path:
            raise ContinuityError("documentation_map keys and paths must be non-empty strings")
        resolved = confined_path(root, path, f"documentation_map.{label}")
        private_root = (root / ".continuity" / "private").resolve()
        if resolved == private_root or resolved.is_relative_to(private_root):
            raise ContinuityError("documentation_map cannot expose private continuity state")
    if settings.get("visual_evidence_mode") not in VISUAL_EVIDENCE_MODES:
        raise ContinuityError(f"visual_evidence_mode must be one of {sorted(VISUAL_EVIDENCE_MODES)}")
    prefix = settings.get("branch_prefix")
    if not isinstance(prefix, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]{0,63}", prefix) or ".." in prefix or prefix.endswith("/"):
        raise ContinuityError("branch_prefix is not a safe Git branch prefix")
    instructions = settings.get("project_instructions")
    if not isinstance(instructions, list) or any(
        not isinstance(item, str)
        or not item.strip()
        or len(item) > 500
        or any(char in item for char in "\n\r\x00")
        or "```" in item
        for item in instructions
    ):
        raise ContinuityError("project_instructions must be a JSON array of non-empty single-line strings up to 500 characters")
    for instruction in instructions:
        if re.search(r"(?i)(?:token|password|secret|api[_-]?key)\s*=", instruction):
            raise ContinuityError("project_instructions cannot contain inline credentials")
        if re.search(r"(?i)(?:allow|permit|enable).{0,40}(?:force[- ]?push|auto[- ]?merge)", instruction) or re.search(
            r"(?i)(?:skip|disable|bypass|omit|ignore).{0,40}(?:approval|audit|security|validation|merge[- ]?safety|human[- ]?review)",
            instruction,
        ):
            raise ContinuityError("project_instructions cannot weaken fixed continuity guardrails")
    planning_patterns = settings.get("planning_patterns")
    if not isinstance(planning_patterns, dict) or set(planning_patterns) != set(DEFAULT_PLANNING_PATTERNS):
        raise ContinuityError("planning_patterns must define exactly evidence_triage, decision_mapping, delivery_slicing, and tracker_provider")
    for key in ("evidence_triage", "decision_mapping", "delivery_slicing"):
        if planning_patterns.get(key) not in PLANNING_PATTERN_MODES:
            raise ContinuityError(f"planning_patterns.{key} must be one of {sorted(PLANNING_PATTERN_MODES)}")
    if planning_patterns.get("tracker_provider") not in TRACKER_PROVIDERS:
        raise ContinuityError(f"planning_patterns.tracker_provider must be one of {sorted(TRACKER_PROVIDERS)}")
    roadmap = settings.get("roadmap")
    if not isinstance(roadmap, dict) or set(roadmap) != set(DEFAULT_ROADMAP_SETTINGS):
        raise ContinuityError(f"roadmap must define exactly {sorted(DEFAULT_ROADMAP_SETTINGS)}")
    if not isinstance(roadmap.get("enabled"), bool):
        raise ContinuityError("roadmap.enabled must be true or false")
    fixed_roadmap = {"ui_mode": "local-read-only", "shared_notes": "explicit-project-inbox", "production_distribution": "forbidden"}
    for key, expected in fixed_roadmap.items():
        if roadmap.get(key) != expected:
            raise ContinuityError(f"roadmap.{key} is a fixed safety boundary and must be {expected}")
    if roadmap.get("agile_mode") not in {"hybrid", "kanban", "milestone"}:
        raise ContinuityError("roadmap.agile_mode is unsupported")
    if roadmap.get("hierarchy") not in {"full", "lightweight"}:
        raise ContinuityError("roadmap.hierarchy is unsupported")
    agent_surfaces = settings.get("agent_surfaces")
    if not isinstance(agent_surfaces, dict) or set(agent_surfaces) != {"primary", "enabled"}:
        raise ContinuityError("agent_surfaces must define exactly primary and enabled")
    primary_surface = agent_surfaces.get("primary")
    enabled_surfaces = agent_surfaces.get("enabled")
    if primary_surface not in AGENT_SURFACES:
        raise ContinuityError(f"agent_surfaces.primary must be one of {sorted(AGENT_SURFACES)}")
    if (
        not isinstance(enabled_surfaces, list)
        or not enabled_surfaces
        or any(item not in AGENT_SURFACES for item in enabled_surfaces)
        or len(enabled_surfaces) != len(set(enabled_surfaces))
        or primary_surface not in enabled_surfaces
    ):
        raise ContinuityError("agent_surfaces.enabled must be a unique non-empty list of supported surfaces containing the primary surface")
    agent_surfaces["enabled"] = sorted(enabled_surfaces)
    scheduler = settings.get("scheduler")
    if not isinstance(scheduler, dict) or set(scheduler) != set(DEFAULT_SCHEDULER):
        raise ContinuityError(f"scheduler must define exactly {sorted(DEFAULT_SCHEDULER)}")
    provider = scheduler.get("provider")
    if provider not in SCHEDULER_PROVIDERS:
        raise ContinuityError(f"scheduler.provider must be one of {sorted(SCHEDULER_PROVIDERS)}")
    if provider in {"codex", "claude-code"} and provider not in agent_surfaces["enabled"]:
        raise ContinuityError("scheduler.provider must name an enabled agent surface or use external/none")
    business_days = scheduler.get("business_days")
    if (
        not isinstance(business_days, list)
        or not business_days
        or any(isinstance(day, bool) or not isinstance(day, int) or day < 0 or day > 6 for day in business_days)
        or len(business_days) != len(set(business_days))
    ):
        raise ContinuityError("scheduler.business_days must be a unique non-empty list of weekday numbers 0-6")
    scheduler["business_days"] = sorted(business_days)
    scheduler_limits = {
        "sweep_minutes": (5, 60),
        "retry_limit": (0, 5),
        "retry_backoff_minutes": (1, 240),
        "stale_after_minutes": (10, 720),
        "portfolio_max_concurrency": (1, 16),
    }
    for label, (minimum, maximum) in scheduler_limits.items():
        number = scheduler.get(label)
        if isinstance(number, bool) or not isinstance(number, int) or not minimum <= number <= maximum:
            raise ContinuityError(f"scheduler.{label} must be between {minimum} and {maximum}")
    if not isinstance(settings.get("execution_enabled"), bool):
        raise ContinuityError("execution_enabled must be true or false")
    return settings


def interactive_behavior_answers(recommended: dict[str, Any]) -> dict[str, Any]:
    print("Continuity guided configuration", file=sys.stderr)
    print("Press Enter to accept each recommended value. Fixed guardrails cannot be overridden.", file=sys.stderr)

    def text_answer(label: str, default: str) -> str:
        answer = input(f"{label} [{default}]: ").strip()
        return answer or default

    def int_answer(label: str, default: int) -> int:
        answer = input(f"{label} [{default}]: ").strip()
        try:
            return int(answer) if answer else default
        except ValueError as exc:
            raise ContinuityError(f"{label} must be an integer") from exc

    def json_answer(label: str, default: Any) -> Any:
        rendered = json.dumps(default, sort_keys=True)
        answer = input(f"{label} as JSON [{rendered}]: ").strip()
        if not answer:
            return default
        try:
            return json.loads(answer)
        except json.JSONDecodeError as exc:
            raise ContinuityError(f"{label} must be valid JSON") from exc

    def bool_answer(label: str, default: bool) -> bool:
        rendered = "Y/n" if default else "y/N"
        answer = input(f"{label} [{rendered}]: ").strip().lower()
        if not answer:
            return default
        if answer in {"y", "yes"}:
            return True
        if answer in {"n", "no"}:
            return False
        raise ContinuityError(f"{label} must be yes or no")

    schedules = recommended["schedules"]
    answers = {
        "integration_branch": text_answer("Integration branch", recommended["integration_branch"]),
        "timezone": text_answer("IANA timezone", recommended["timezone"]),
        "schedules": {
            "review": text_answer("Daily review time", schedules["review"]),
            "dispatch": text_answer("Default dispatch time", schedules["dispatch"]),
            "report": text_answer("Morning report time", schedules["report"]),
        },
        "max_runtime_minutes": int_answer("Maximum unattended runtime in minutes", recommended["max_runtime_minutes"]),
        "memory_stale_after_days": int_answer("Memory verification age in days", recommended["memory_stale_after_days"]),
        "product_audit_stale_after_days": int_answer("Product audit refresh age in days", recommended["product_audit_stale_after_days"]),
        "validation_commands": json_answer("Validation commands", recommended["validation_commands"]),
        "security_commands": json_answer("Security commands", recommended["security_commands"]),
        "github_required_checks": json_answer("Required GitHub check names", recommended["github_required_checks"]),
        "github_required_reviewers": int_answer("Required approving GitHub reviewers", recommended["github_required_reviewers"]),
        "github_cli_merge_enabled": bool_answer("Enable exact human-authorized GitHub CLI merges", recommended["github_cli_merge_enabled"]),
        "documentation_map": json_answer("Documentation map", recommended["documentation_map"]),
        "visual_evidence_mode": text_answer("Visual evidence mode", recommended["visual_evidence_mode"]),
        "branch_prefix": text_answer("Goal branch prefix", recommended["branch_prefix"]),
        "project_instructions": json_answer("Additional project-specific instructions", recommended["project_instructions"]),
        "planning_patterns": json_answer("Planning pattern modes", recommended["planning_patterns"]),
        "roadmap": json_answer("Roadmap behavior", recommended["roadmap"]),
        "agent_surfaces": json_answer("Agent surfaces (primary and enabled)", recommended["agent_surfaces"]),
        "scheduler": json_answer("Persistent scheduler provider", recommended["scheduler"]),
    }
    execution = input("Enable real product-code execution now? [y/N, recommended N]: ").strip().lower()
    answers["execution_enabled"] = execution in {"y", "yes"}
    return answers


def project_configure(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    manifest = load_project_manifest(root)
    recommendations = recommended_behavior_settings(root, config, manifest)
    current = current_behavior_settings(root, config, manifest)
    if args.interactive and args.answers_file:
        raise ContinuityError("Use either --interactive or --answers-file, not both")
    if args.interactive:
        answers = interactive_behavior_answers(recommendations)
    elif args.answers_file:
        answers = json_load(Path(args.answers_file).expanduser().resolve(), {})
        if not isinstance(answers, dict):
            raise ContinuityError("Configuration answers file must contain a JSON object")
    else:
        raise ContinuityError("Choose --interactive or provide --answers-file")
    merged = dict(current)
    if "schedules" in answers:
        if not isinstance(answers["schedules"], dict):
            raise ContinuityError("schedules override must be a JSON object")
        answers = dict(answers)
        answers["schedules"] = {**current.get("schedules", {}), **answers["schedules"]}
    if "scheduler" in answers:
        if not isinstance(answers["scheduler"], dict):
            raise ContinuityError("scheduler override must be a JSON object")
        answers = dict(answers)
        answers["scheduler"] = {**normalize_scheduler(current.get("scheduler")), **answers["scheduler"]}
    merged.update(answers)
    settings = validate_behavior_settings(root, merged)
    overrides = sorted(key for key, value in settings.items() if value != recommendations.get(key))
    record = {
        "schema_version": BEHAVIOR_SCHEMA_VERSION,
        "assurance_standard_version": ASSURANCE_STANDARD_VERSION,
        "project_id": config.get("project_id"),
        "recommendation_profile": BEHAVIOR_PROFILE,
        "settings": settings,
        "overrides": overrides,
        "fixed_guardrails": FIXED_GUARDRAILS,
    }
    record["configuration_hash"] = behavior_payload_hash(record)
    if args.dry_run:
        return {"changed": record != json_load(root / BEHAVIOR_CONFIG_PATH, {}), "behavior": record}

    before_hash = config.get("behavior_configuration_hash")
    before_config_hash = canonical_hash(config)
    before_manifest_hash = canonical_hash(manifest)
    config.update(
        {
            "integration_branch": settings["integration_branch"],
            "timezone": settings["timezone"],
            "default_start_time": settings["schedules"]["dispatch"],
            "max_runtime_minutes": settings["max_runtime_minutes"],
            "memory_stale_after_days": settings["memory_stale_after_days"],
            "product_audit_stale_after_days": settings["product_audit_stale_after_days"],
            "validation_commands": settings["validation_commands"],
            "security_commands": settings["security_commands"],
            "github_required_checks": settings["github_required_checks"],
            "github_required_reviewers": settings["github_required_reviewers"],
            "github_cli_merge_enabled": settings["github_cli_merge_enabled"],
            "documentation_map": settings["documentation_map"],
            "visual_evidence_mode": settings["visual_evidence_mode"],
            "branch_prefix": settings["branch_prefix"],
            "project_instructions": settings["project_instructions"],
            "planning_patterns": settings["planning_patterns"],
            "roadmap": settings["roadmap"],
            "agent_surfaces": settings["agent_surfaces"],
            "scheduler": settings["scheduler"],
            "roadmap_docs": "docs/project-roadmap",
            "behavior_config_path": BEHAVIOR_CONFIG_PATH,
            "behavior_skill_path": BEHAVIOR_SKILL_PATH,
            "behavior_configuration_hash": record["configuration_hash"],
            "require_remote": True,
            "require_pr": True,
            "require_pr_auth": True,
            "require_execution_artifacts": True,
            "require_isolated_worktree": True,
            "refresh_base_on_preflight": True,
        }
    )
    manifest.update(
        {
            "integration_branch": settings["integration_branch"],
            "timezone": settings["timezone"],
            "schedules": settings["schedules"],
            "roadmap": settings["roadmap"],
            "agent_surfaces": settings["agent_surfaces"],
            "scheduler": settings["scheduler"],
            "max_concurrency": 1,
            "execution_enabled": settings["execution_enabled"],
            "behavior_configuration_hash": record["configuration_hash"],
        }
    )
    behavior_path = confined_path(root, BEHAVIOR_CONFIG_PATH, "behavior_config_path")
    skill_path = confined_path(root, BEHAVIOR_SKILL_PATH, "behavior_skill_path")
    json_dump(behavior_path, record)
    json_dump(root / ".continuity" / "config.json", config)
    json_dump(root / ".continuity" / "project.json", manifest)
    skill_path.parent.mkdir(parents=True, exist_ok=True)
    skill_temp = skill_path.with_suffix(".tmp")
    skill_temp.write_text(render_project_behavior_skill(record), encoding="utf-8")
    skill_temp.replace(skill_path)
    sync_surface_adapters(root, settings)
    changed = (
        before_hash != record["configuration_hash"]
        or before_config_hash != canonical_hash(config)
        or before_manifest_hash != canonical_hash(manifest)
    )
    if changed:
        append_jsonl(
            private_path(root, config) / "configuration-audit.jsonl",
            {
                "at": iso_now(config),
                "actor": args.actor,
                "previous_hash": before_hash,
                "configuration_hash": record["configuration_hash"],
                "changed_fields": sorted(answers),
                "reconciled_configuration": before_config_hash != canonical_hash(config),
                "reconciled_manifest": before_manifest_hash != canonical_hash(manifest),
            },
        )
    validate_project_behavior(root, config)
    return {
        "configured": True,
        "project_id": config.get("project_id"),
        "configuration_hash": record["configuration_hash"],
        "changed": changed,
        "overrides": overrides,
        "execution_enabled": settings["execution_enabled"],
        "agent_surfaces": settings["agent_surfaces"],
        "scheduler": settings["scheduler"],
        "behavior_skill": BEHAVIOR_SKILL_PATH,
    }


def note_lifecycle_audit(root: Path, config: dict[str, Any]) -> dict[str, Any]:
    notes: dict[str, dict[str, Any]] = {}
    problems: list[str] = []
    for capture_path in sorted((private_path(root, config) / "captures").glob("**/*.json")):
        capture = json_load(capture_path, {})
        if not isinstance(capture, dict):
            continue
        if capture.get("document_type") is not None:
            capture_id = str(capture.get("capture_id") or capture_path.stem)
            required_document_fields = {
                "document_id",
                "document_type",
                "document_revision",
                "source_authority",
                "source_ref",
                "source_hash",
                "raw_snapshot_ref",
                "document_memory_id",
            }
            missing = sorted(required_document_fields - set(capture))
            if missing:
                problems.append(f"document capture {capture_id} is missing {', '.join(missing)}")
            if capture.get("document_type") not in DOCUMENT_TYPES:
                problems.append(f"document capture {capture_id} has invalid document_type")
            if capture.get("source_authority") not in DOCUMENT_SOURCE_AUTHORITIES:
                problems.append(f"document capture {capture_id} has invalid source_authority")
            snapshot_ref = capture.get("raw_snapshot_ref")
            if isinstance(snapshot_ref, str):
                try:
                    snapshot = confined_path(root, snapshot_ref, "raw_snapshot_ref")
                except ContinuityError as exc:
                    problems.append(f"document capture {capture_id} has unsafe snapshot: {exc}")
                else:
                    if not snapshot.is_file() or not snapshot.is_relative_to(private_path(root, config)):
                        problems.append(f"document capture {capture_id} snapshot is missing")
                    elif hashlib.sha256(snapshot.read_bytes()).hexdigest() != capture.get("source_hash"):
                        problems.append(f"document capture {capture_id} snapshot hash does not match source_hash")
            previous_capture_id = capture.get("previous_capture_id")
            if previous_capture_id:
                try:
                    previous = json_load(find_capture(root, config, str(previous_capture_id)), {})
                except ContinuityError as exc:
                    problems.append(f"document capture {capture_id} has invalid previous capture: {exc}")
                else:
                    if previous.get("document_id") != capture.get("document_id"):
                        problems.append(f"document capture {capture_id} previous capture uses another document_id")
                    try:
                        contiguous = int(previous.get("document_revision", 0)) + 1 == int(capture.get("document_revision", 0))
                    except (TypeError, ValueError):
                        contiguous = False
                    if not contiguous:
                        problems.append(f"document capture {capture_id} revision sequence is not contiguous")
        for item in capture.get("items", []):
            if not isinstance(item, dict) or not item.get("item_id"):
                continue
            note_id = str(item["item_id"])
            notes[note_id] = item
            if capture.get("document_type") is not None:
                try:
                    document_source_anchor(item, 1)
                except ContinuityError as exc:
                    problems.append(f"document note {note_id} has invalid source anchor: {exc}")
                if item.get("revision_status") not in DOCUMENT_REVISION_STATUSES:
                    problems.append(f"document note {note_id} has invalid revision_status")
            created = parse_recorded_time(item.get("created_at"), config["timezone"])
            updated = parse_recorded_time(item.get("updated_at"), config["timezone"])
            if created is None or updated is None:
                problems.append(f"note {note_id} has a missing or invalid lifecycle timestamp")
            elif updated < created:
                problems.append(f"note {note_id} updated_at precedes created_at")
            links = item.get("goal_links", {})
            if isinstance(links, dict):
                for goal_id, link in links.items():
                    if not isinstance(link, dict):
                        problems.append(f"note {note_id} has malformed goal link {goal_id}")
                        continue
                    for key in ("decided_at", "updated_at"):
                        if link.get(key) and parse_recorded_time(link.get(key), config["timezone"]) is None:
                            problems.append(f"note {note_id} goal link {goal_id} has invalid {key}")
    legacy_disposition_goal_ids: list[str] = []
    for goal_path in sorted((private_path(root, config) / "goals").glob("*/goal.json")):
        goal = json_load(goal_path, {})
        if not isinstance(goal, dict) or not goal.get("goal_id"):
            continue
        goal_id = str(goal["goal_id"])
        source_note_ids = [str(value) for value in goal.get("source_note_ids", [])]
        if source_note_ids and "note_dispositions" not in goal:
            legacy_disposition_goal_ids.append(goal_id)
        try:
            dispositions = validate_note_dispositions(
                goal.get("note_dispositions"),
                source_note_ids,
                goal.get("delivery_slices", []),
                goal.get("roadmap_ids", []),
            )
        except ContinuityError as exc:
            problems.append(f"goal {goal_id} has invalid note dispositions: {exc}")
            continue
        for disposition in dispositions:
            note_id = str(disposition["note_id"])
            note = notes.get(note_id)
            if note is None:
                problems.append(f"goal {goal_id} references missing note {note_id}")
                continue
            link = note.get("goal_links", {}).get(goal_id) if isinstance(note.get("goal_links"), dict) else None
            if not isinstance(link, dict) or link.get("state") == "unlinked":
                problems.append(f"goal {goal_id} note {note_id} lacks a current lifecycle link")
            elif note_link_disposition(link) != disposition["disposition"]:
                problems.append(f"goal {goal_id} note {note_id} disposition disagrees with its lifecycle link")
        if "source_capture_refs" in goal:
            try:
                expected_refs = source_capture_refs_for_notes(root, config, source_note_ids)
            except ContinuityError as exc:
                problems.append(f"goal {goal_id} source document binding is invalid: {exc}")
            else:
                if goal.get("source_capture_refs") != expected_refs:
                    problems.append(f"goal {goal_id} source document binding is stale")
    return {
        "legacy_disposition_goal_ids": sorted(legacy_disposition_goal_ids),
        "problems": sorted(set(problems)),
    }


def suite_installation_status(root: Path) -> dict[str, Any]:
    path = root / ".continuity" / "install-manifest.json"
    if not path.is_file():
        return {"installed": False, "healthy": False, "version": None, "problems": ["installed release manifest is missing"], "drift": []}
    manifest = json_load(path, {})
    problems: list[str] = []
    try:
        runtime_lib.validate_schema_file(manifest, CONTROL_ROOT / "schemas" / "install-manifest.schema.json", "install manifest")
    except (runtime_lib.RuntimeIntegrityError, OSError, json.JSONDecodeError) as exc:
        problems.append(str(exc))
    drift: list[dict[str, str]] = []
    for relative, expected in manifest.get("installed_files", {}).items():
        try:
            target = confined_path(root, relative, "installed file")
        except ContinuityError as exc:
            problems.append(str(exc))
            continue
        if not target.is_file():
            drift.append({"path": relative, "state": "missing"})
        elif runtime_lib.sha256_file(target) != expected:
            drift.append({"path": relative, "state": "modified"})
    if drift:
        problems.append(f"suite-managed file drift: {[item['path'] for item in drift]}")
    return {
        "installed": True,
        "healthy": not problems,
        "version": manifest.get("version"),
        "canonical_repository": manifest.get("canonical_repository"),
        "installed_at": manifest.get("installed_at"),
        "problems": problems,
        "drift": drift,
    }


def suite_status(args: argparse.Namespace) -> dict[str, Any]:
    root, _config = load_context(validate_behavior=False)
    return suite_installation_status(root)


def safe_extract_tar(archive: tarfile.TarFile, destination: Path, label: str) -> dict[str, int]:
    """Extract only a bounded, portable tree of regular files and directories."""
    destination = destination.resolve()
    members: list[tuple[tarfile.TarInfo, str]] = []
    seen: set[str] = set()
    file_names: set[str] = set()
    total_bytes = 0
    for member in archive:
        raw = member.name
        candidate = raw.rstrip("/") if member.isdir() else raw
        try:
            normalized = runtime_lib.validate_portable_relative_path(candidate, label=f"{label} member")
        except runtime_lib.RuntimeIntegrityError as exc:
            raise ContinuityError(str(exc)) from exc
        if normalized in seen:
            raise ContinuityError(f"{label} contains a duplicate path: {normalized}")
        if not member.isfile() and not member.isdir():
            raise ContinuityError(f"{label} contains a non-regular archive member: {normalized}")
        seen.add(normalized)
        if member.isfile():
            file_names.add(normalized)
            if member.size < 0:
                raise ContinuityError(f"{label} contains an invalid file size: {normalized}")
            total_bytes += member.size
        members.append((member, normalized))
        if len(members) > MAX_ARCHIVE_FILES or total_bytes > MAX_ARCHIVE_BYTES:
            raise ContinuityError(
                f"{label} exceeds extraction limits ({len(members)} members, {total_bytes} bytes)"
            )
    collisions = runtime_lib.casefold_path_collisions([name for _member, name in members])
    if collisions:
        raise ContinuityError(f"{label} contains case-insensitive path collisions: {collisions}")
    for _member, name in members:
        parts = name.split("/")
        for depth in range(1, len(parts)):
            parent = "/".join(parts[:depth])
            if parent in file_names:
                raise ContinuityError(f"{label} uses a file as an archive directory: {parent}")
    for member, normalized in members:
        target = (destination / normalized).resolve()
        if not target.is_relative_to(destination):
            raise ContinuityError(f"{label} path escapes its extraction directory: {normalized}")
        if member.isdir():
            target.mkdir(parents=True, exist_ok=True)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        source = archive.extractfile(member)
        if source is None:
            raise ContinuityError(f"{label} file cannot be read: {normalized}")
        with source, target.open("xb") as output:
            shutil.copyfileobj(source, output, length=1024 * 1024)
        if os.name != "nt":
            target.chmod(member.mode & 0o777)
    return {"members": len(members), "bytes": total_bytes}


def release_source_from_github(version: str | None, destination: Path) -> Path:
    gh = shutil.which("gh")
    if not gh:
        raise ContinuityError("GitHub CLI is required for release updates")
    command = [gh, "release", "download"]
    if version:
        command.append(validate_release_version(version))
    command.extend(["--repo", CANONICAL_REPOSITORY_SLUG, "--pattern", "continuity-*.tar.gz", "--dir", str(destination)])
    result = subprocess.run(command, capture_output=True, text=True, timeout=180, check=False)
    if result.returncode != 0:
        raise ContinuityError(f"Unable to download Continuity release: {result.stderr.strip() or result.stdout.strip()}")
    archives = sorted(destination.glob("continuity-*.tar.gz"))
    if len(archives) != 1:
        raise ContinuityError("Release download did not produce exactly one Continuity archive")
    verified = subprocess.run(
        [gh, "attestation", "verify", str(archives[0]), "--repo", CANONICAL_REPOSITORY_SLUG],
        capture_output=True,
        text=True,
        timeout=180,
        check=False,
    )
    if verified.returncode != 0:
        raise ContinuityError(f"Release artifact attestation failed: {verified.stderr.strip() or verified.stdout.strip()}")
    extracted = destination / "release"
    extracted.mkdir()
    try:
        with tarfile.open(archives[0], "r:gz") as archive:
            safe_extract_tar(archive, extracted, "Release archive")
    except (tarfile.TarError, OSError, EOFError) as exc:
        raise ContinuityError(f"Release archive is unreadable: {exc}") from exc
    candidates = [path.parent for path in extracted.rglob("release-manifest.json")]
    if len(candidates) != 1:
        raise ContinuityError("Release archive does not contain one suite root")
    return candidates[0]


def source_release_status(source: Path) -> dict[str, Any]:
    manifest_path = source / "release-manifest.json"
    if not manifest_path.is_file():
        raise ContinuityError(f"Release source is missing release-manifest.json: {source}")
    manifest = json_load(manifest_path, {})
    try:
        runtime_lib.validate_schema_file(manifest, source / "schemas" / "release-manifest.schema.json", "release manifest")
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    if manifest.get("canonical_repository") != CANONICAL_REPOSITORY:
        raise ContinuityError("Release source uses an unsupported canonical repository")
    version_path = source / "VERSION"
    if not version_path.is_file() or version_path.read_text(encoding="utf-8").strip() != manifest.get("version"):
        raise ContinuityError("Release source VERSION does not match its manifest")
    failures = []
    for relative, expected in manifest.get("files", {}).items():
        try:
            runtime_lib.validate_portable_relative_path(relative, label="Release manifest path")
        except runtime_lib.RuntimeIntegrityError as exc:
            raise ContinuityError(str(exc)) from exc
        path = confined_path(source, relative, "release file")
        if not path.is_file() or runtime_lib.sha256_release_file(path) != expected:
            failures.append(relative)
    if failures:
        raise ContinuityError(f"Release source integrity failed: {failures}")
    return manifest


def suite_update(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    current = suite_installation_status(root)
    if args.check:
        if args.source:
            available = source_release_status(Path(args.source).expanduser().resolve())
            return {"current": current, "available_version": available.get("version"), "update_available": current.get("version") != available.get("version"), "source": str(Path(args.source).expanduser().resolve())}
        gh = shutil.which("gh")
        if not gh:
            raise ContinuityError("GitHub CLI is required to check releases")
        command = [gh, "release", "view", validate_release_version(args.version)] if args.version else [gh, "release", "view", "--repo", CANONICAL_REPOSITORY_SLUG]
        if args.version:
            command.extend(["--repo", CANONICAL_REPOSITORY_SLUG])
        command.extend(["--json", "tagName,publishedAt,url"])
        result = subprocess.run(command, capture_output=True, text=True, timeout=60, check=False)
        if result.returncode != 0:
            raise ContinuityError(f"Unable to check Continuity releases: {result.stderr.strip() or result.stdout.strip()}")
        available = json.loads(result.stdout)
        available_version = str(available.get("tagName", "")).removeprefix("v")
        return {"current": current, "available": available, "available_version": available_version, "update_available": current.get("version") != available_version}
    temporary: tempfile.TemporaryDirectory[str] | None = None
    try:
        if args.source:
            source = Path(args.source).expanduser().resolve()
        else:
            temporary = tempfile.TemporaryDirectory(prefix="continuity-release-")
            source = release_source_from_github(args.version, Path(temporary.name))
        release = source_release_status(source)
        installer = source / "installer" / "install.py"
        command = [
            sys.executable,
            str(installer),
            "--project-root",
            str(root),
            "--project-id",
            config["project_id"],
            "--integration-branch",
            config["integration_branch"],
            "--ignore-user-defaults",
        ]
        if args.dry_run:
            command.append("--dry-run")
        if args.overwrite_managed:
            command.append("--overwrite-managed")
        if args.skip_github_auth:
            command.append("--skip-github-auth")
        result = subprocess.run(command, capture_output=True, text=True, timeout=930, check=False)
        if result.returncode != 0:
            raise ContinuityError(f"Continuity update failed: {result.stderr.strip() or result.stdout.strip()}")
        payload = json.loads(result.stdout)
        return {"updated": not args.dry_run, "dry_run": args.dry_run, "from_version": current.get("version"), "to_version": release.get("version"), "installer": payload}
    finally:
        if temporary is not None:
            temporary.cleanup()


def suite_rollback(args: argparse.Namespace) -> dict[str, Any]:
    root, _config = load_context(validate_behavior=False)
    installer = CONTROL_ROOT / "installer" / "install.py"
    if not installer.is_file():
        raise ContinuityError("Installed rollback helper is missing")
    result = subprocess.run(
        [sys.executable, str(installer), "--project-root", str(root), "--rollback-snapshot", args.snapshot],
        capture_output=True,
        text=True,
        timeout=180,
        check=False,
    )
    if result.returncode != 0:
        raise ContinuityError(f"Continuity rollback failed: {result.stderr.strip() or result.stdout.strip()}")
    return json.loads(result.stdout)


def suite_drift_export(args: argparse.Namespace) -> dict[str, Any]:
    root, _config = load_context(validate_behavior=False)
    status = suite_installation_status(root)
    output_path = Path(args.output).expanduser().resolve()
    runtime_lib.atomic_write_json(output_path, {"project_id": json_load(root / ".continuity" / "config.json", {}).get("project_id"), "generated_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"), "version": status.get("version"), "drift": status.get("drift", [])})
    return {"output": str(output_path), "drift_count": len(status.get("drift", []))}


def state_backup_sources(root: Path, config: dict[str, Any]) -> list[Path]:
    candidates = [private_path(root, config), root / ".continuity-portfolio"]
    return [path for path in candidates if path.exists()]


def project_state_lock_path(root: Path) -> Path:
    return root / ".continuity" / "state.lock"


def project_quiescence(root: Path, config: dict[str, Any]) -> dict[str, Any]:
    active_goals = []
    for path in sorted((private_path(root, config) / "goals").glob("*/goal.json")):
        goal = json_load(path, {})
        if isinstance(goal, dict) and goal.get("state") in {"dispatched", "running", "validating"}:
            active_goals.append(goal.get("goal_id"))
    active_runs = [
        run["run_id"]
        for run in scheduler_run_snapshots(root, config).values()
        if run.get("status") in SCHEDULER_ACTIVE_STATES
    ]
    project_lock = json_load(private_path(root, config) / "project.lock.json", {})
    return {
        "quiescent": not active_goals and not active_runs and not project_lock,
        "active_goals": active_goals,
        "active_scheduler_runs": active_runs,
        "project_lock": project_lock or None,
    }


def require_project_quiescence(root: Path, config: dict[str, Any], operation: str) -> dict[str, Any]:
    status = project_quiescence(root, config)
    if not status["quiescent"]:
        raise ContinuityError(f"{operation} requires quiescent project state: {status}")
    return status


def _remove_empty_parents(path: Path, stop: Path) -> None:
    current = path
    resolved_stop = stop.resolve()
    while current.exists() and current.resolve() != resolved_stop:
        try:
            current.rmdir()
        except OSError:
            return
        current = current.parent


def suite_uninstall(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    require_project_quiescence(root, config, "Continuity uninstall")
    status = suite_installation_status(root)
    if not status.get("installed"):
        raise ContinuityError("Continuity is not installed in this project")
    if status.get("drift") and not args.overwrite_managed:
        raise ContinuityError("Suite-managed file drift blocks uninstall; review the drift or pass --overwrite-managed after explicit approval")
    behavior = json_load(confined_path(root, config.get("behavior_config_path", BEHAVIOR_CONFIG_PATH), "behavior_config_path"), {})
    settings = behavior.get("settings") if isinstance(behavior, dict) else None
    if not isinstance(settings, dict):
        raise ContinuityError("Project behavior settings are unavailable; repair configuration before uninstalling")
    adapter_problems = surface_adapter_problems(root, settings)
    if adapter_problems and not args.overwrite_managed:
        raise ContinuityError(f"Modified or stale agent adapters block uninstall: {adapter_problems}")
    install_manifest = json_load(root / ".continuity" / "install-manifest.json", {})
    managed_files = sorted(install_manifest.get("installed_files", {}), reverse=True)
    skill_names = continuity_skill_names(root)
    generated = {
        ".agents/skills/continuity-local",
        ".cursor/rules/continuity.mdc",
        *(f".claude/commands/{name}.md" for name in skill_names),
        *(f".cursor/commands/{name}.md" for name in skill_names),
        *(f".claude/skills/{name}" for name in skill_names),
        *(f".windsurf/skills/{name}" for name in skill_names),
    }
    plan = {
        "project": str(root),
        "apply": bool(args.apply),
        "managed_files": len(managed_files),
        "generated_paths": sorted(generated),
        "preserved": [
            ".continuity/config.json",
            ".continuity/project-behavior.json",
            ".continuity/private (except python-interpreter.txt)",
            ".continuity/shared-notes",
            "docs/project-memory",
            "docs/project-roadmap",
            "user-owned skills and files",
        ],
    }
    if not args.apply:
        return plan

    remove_owned_reference_adapters(root, root / ".claude")
    remove_owned_reference_adapters(root, root / ".windsurf")
    for relative in sorted(generated, key=lambda value: (len(Path(value).parts), value), reverse=True):
        target = confined_path(root, relative, "generated uninstall path")
        if target.is_dir() and not target.is_symlink():
            shutil.rmtree(target)
        elif target.exists() or target.is_symlink():
            target.unlink()
    for relative in managed_files:
        target = confined_path(root, relative, "managed uninstall file")
        if target.is_file() or target.is_symlink():
            target.unlink()
    remove_owned_skill_adapters(root / ".agents" / "skills")
    control_root = root / ".agents" / "continuity"
    if control_root.is_dir() and not control_root.is_symlink():
        shutil.rmtree(control_root)
    for adapter_root in (
        root / ".agents" / "references",
        root / ".claude" / "commands",
        root / ".claude" / "references",
        root / ".cursor" / "commands",
        root / ".cursor" / "rules",
        root / ".windsurf" / "references",
    ):
        if adapter_root.is_dir():
            for lock_file in adapter_root.rglob(".continuity-write.lock"):
                lock_file.unlink(missing_ok=True)

    agents_path = root / "AGENTS.md"
    if agents_path.is_file():
        runtime_lib.atomic_write_text(
            agents_path,
            replace_managed_block(agents_path.read_text(encoding="utf-8"), "<!-- continuity:start -->", "<!-- continuity:end -->", None),
            mode=0o644,
        )
    ignore_path = root / ".gitignore"
    if ignore_path.is_file():
        runtime_lib.atomic_write_text(
            ignore_path,
            replace_managed_block(ignore_path.read_text(encoding="utf-8"), "# continuity:start", "# continuity:end", None),
            mode=0o644,
        )
    claude_path = root / "CLAUDE.md"
    if claude_path.is_file():
        updated = replace_managed_block(claude_path.read_text(encoding="utf-8"), "<!-- continuity:claude:start -->", "<!-- continuity:claude:end -->", None)
        if updated.strip():
            runtime_lib.atomic_write_text(claude_path, updated, mode=0o644)
        else:
            claude_path.unlink()

    project_manifest_path = root / ".continuity" / "project.json"
    project_manifest = json_load(project_manifest_path, {})
    project_manifest["continuity_enabled"] = False
    project_manifest["execution_enabled"] = False
    json_dump(project_manifest_path, project_manifest)
    (root / ".continuity" / "install-manifest.json").unlink(missing_ok=True)
    (private_path(root, config) / "python-interpreter.txt").unlink(missing_ok=True)
    for base in (root / ".agents", root / ".claude", root / ".cursor", root / ".windsurf"):
        if base.exists():
            for directory in sorted((path for path in base.rglob("*") if path.is_dir()), key=lambda path: len(path.parts), reverse=True):
                _remove_empty_parents(directory, base)
    return {**plan, "uninstalled": True, "continuity_enabled": False, "execution_enabled": False}


def default_backup_path(root: Path, config: dict[str, Any]) -> Path:
    stamp = now(config).strftime("%Y%m%dT%H%M%S%z")
    directory = Path.home() / ".continuity" / "backups"
    candidate = directory / f"{config['project_id']}-{stamp}.tar.gz.age"
    if candidate.exists():
        candidate = directory / f"{config['project_id']}-{stamp}-{secrets.token_hex(4)}.tar.gz.age"
    return candidate


def create_state_backup(
    root: Path,
    config: dict[str, Any],
    recipient: str,
    output_path: Path,
    signer: str,
    signing_key: str,
    verify_identity: str | None = None,
) -> dict[str, Any]:
    age = shutil.which("age")
    if not age:
        raise ContinuityError("age is required for encrypted Continuity backups")
    if output_path.exists():
        raise ContinuityError(f"Backup output already exists; choose a new path: {output_path}")
    sources = state_backup_sources(root, config)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    staged_output = output_path.parent / f".{output_path.name}.{secrets.token_hex(8)}.tmp"
    inventory: dict[str, str] = {}
    verification = None
    try:
        with runtime_lib.secure_temporary_directory(prefix="continuity-backup-") as directory:
            archive_path = directory / "state.tar.gz"
            with tarfile.open(archive_path, "w:gz") as archive:
                for source in sources:
                    for path in sorted(source.rglob("*")):
                        if not path.is_file() or path.is_symlink() or path.name in {".state.lock", "portfolio.lock"}:
                            continue
                        relative = runtime_lib.project_relative_posix(path, root)
                        try:
                            runtime_lib.validate_portable_relative_path(relative, label="Backup source path")
                        except runtime_lib.RuntimeIntegrityError as exc:
                            raise ContinuityError(str(exc)) from exc
                        inventory[relative] = runtime_lib.sha256_file(path)
                        archive.add(path, arcname=f"payload/{relative}", recursive=False)
                manifest = {
                    "schema_version": 1,
                    "project_id": config["project_id"],
                    "created_at": iso_now(config),
                    "files": inventory,
                    "format": "continuity-age-tar-v1",
                    "signed_by": signer,
                    "signature_format": "openssh-sshsig-v1",
                }
                try:
                    runtime_lib.validate_schema_file(manifest, CONTROL_ROOT / "schemas" / "backup-manifest.schema.json", "backup manifest")
                except runtime_lib.RuntimeIntegrityError as exc:
                    raise ContinuityError(str(exc)) from exc
                manifest_path = directory / "backup-manifest.json"
                runtime_lib.atomic_write_json(manifest_path, manifest)
                ssh_keygen = shutil.which("ssh-keygen")
                if not ssh_keygen:
                    raise ContinuityError("ssh-keygen is required to sign backup inventories")
                signed = subprocess.run(
                    [ssh_keygen, "-Y", "sign", "-f", str(Path(signing_key).expanduser().resolve()), "-n", "continuity-backup", str(manifest_path)],
                    capture_output=True,
                    text=True,
                    timeout=60,
                    check=False,
                )
                signature_path = manifest_path.with_suffix(manifest_path.suffix + ".sig")
                if signed.returncode != 0 or not signature_path.is_file():
                    raise ContinuityError(f"Backup inventory signing failed: {signed.stderr.strip() or signed.stdout.strip()}")
                archive.add(manifest_path, arcname="backup-manifest.json", recursive=False)
                archive.add(signature_path, arcname="backup-manifest.json.sig", recursive=False)
            result = subprocess.run(
                [age, "-r", recipient, "-o", str(staged_output), str(archive_path)],
                capture_output=True,
                text=True,
                timeout=180,
                check=False,
            )
            if result.returncode != 0 or not staged_output.is_file():
                raise ContinuityError(f"Encrypted backup failed: {result.stderr.strip() or result.stdout.strip()}")
        if verify_identity:
            with runtime_lib.secure_temporary_directory(prefix="continuity-backup-verify-") as verify_directory:
                verified = decrypt_and_verify_state_archive(root, config, staged_output, verify_identity, verify_directory)
                verification = {
                    "verified": True,
                    "files": len(verified["manifest"].get("files", {})),
                    "manifest_created_at": verified["manifest"].get("created_at"),
                }
        elif config.get("require_verified_backups", False):
            raise ContinuityError("Production backup policy requires --verify-identity for immediate restore verification")
        runtime_lib.replace_staged_file(staged_output, output_path)
    except Exception:
        staged_output.unlink(missing_ok=True)
        raise
    return {"project_id": config["project_id"], "archive": str(output_path), "archive_sha256": runtime_lib.sha256_file(output_path), "files": len(inventory), "encrypted": True, "recipient": recipient, "signed_by": signer, "verification": verification}


def decrypt_and_verify_state_archive(root: Path, config: dict[str, Any], archive: Path, identity: str, destination: Path) -> dict[str, Any]:
    age = shutil.which("age")
    if not age:
        raise ContinuityError("age is required for encrypted Continuity backups")
    if not archive.is_file():
        raise ContinuityError(f"Backup archive is unavailable: {archive}")
    decrypted = destination / "state.tar.gz"
    result = subprocess.run(
        [age, "-d", "-i", str(Path(identity).expanduser().resolve()), "-o", str(decrypted), str(archive)],
        capture_output=True,
        text=True,
        timeout=180,
        check=False,
    )
    if result.returncode != 0:
        raise ContinuityError(f"Backup decryption failed: {result.stderr.strip() or result.stdout.strip()}")
    extracted = destination / "extracted"
    extracted.mkdir()
    try:
        with tarfile.open(decrypted, "r:gz") as tar:
            safe_extract_tar(tar, extracted, "Backup archive")
    except (tarfile.TarError, OSError, EOFError) as exc:
        raise ContinuityError(f"Backup archive is unreadable: {exc}") from exc
    try:
        manifest = json_load(extracted / "backup-manifest.json", {})
    except (OSError, json.JSONDecodeError) as exc:
        raise ContinuityError(f"Backup manifest is unreadable: {exc}") from exc
    try:
        runtime_lib.validate_schema_file(manifest, CONTROL_ROOT / "schemas" / "backup-manifest.schema.json", "backup manifest")
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    if manifest.get("project_id") != config["project_id"] or manifest.get("format") != "continuity-age-tar-v1":
        raise ContinuityError("Backup belongs to another project or uses an unsupported format")
    verify_approval_trust_anchor(root, config)
    allowed = approval_allowed_signers_path(root, config)
    signature = extracted / "backup-manifest.json.sig"
    ssh_keygen = shutil.which("ssh-keygen")
    if not ssh_keygen or not allowed.is_file() or not signature.is_file():
        raise ContinuityError("Backup inventory signature cannot be verified")
    verified_signature = subprocess.run(
        [ssh_keygen, "-Y", "verify", "-f", str(allowed), "-I", str(manifest.get("signed_by", "")), "-n", "continuity-backup", "-s", str(signature)],
        input=(json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode(),
        capture_output=True,
        timeout=60,
        check=False,
    )
    if verified_signature.returncode != 0:
        raise ContinuityError("Backup inventory SSH signature is invalid or untrusted")
    failures = []
    expected_paths = set(manifest.get("files", {}))
    for relative, expected in manifest.get("files", {}).items():
        try:
            runtime_lib.validate_portable_relative_path(relative, label="Backup manifest path")
        except runtime_lib.RuntimeIntegrityError:
            failures.append(f"unsafe:{relative}")
            continue
        source = confined_path(extracted / "payload", relative, "backup payload")
        if not source.is_file() or runtime_lib.sha256_file(source) != expected:
            failures.append(relative)
    payload_root = extracted / "payload"
    actual_paths = {
        runtime_lib.project_relative_posix(path, payload_root)
        for path in payload_root.rglob("*")
        if path.is_file()
    } if payload_root.is_dir() else set()
    unexpected = sorted(actual_paths - expected_paths)
    if unexpected:
        failures.extend(f"unexpected:{path}" for path in unexpected)
    if failures:
        raise ContinuityError(f"Backup payload integrity failed: {failures}")
    return {"manifest": manifest, "payload": extracted / "payload"}


def _remove_restore_path(path: Path) -> None:
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path)
    elif path.exists() or path.is_symlink():
        path.unlink()


def recover_interrupted_restore(root: Path, config: dict[str, Any]) -> dict[str, Any]:
    transaction_root = root / ".continuity-restore"
    journal_path = transaction_root / "transaction.json"
    if not transaction_root.exists():
        return {"recovered": False, "transaction": None}
    if not journal_path.is_file():
        shutil.rmtree(transaction_root)
        return {"recovered": False, "transaction": None, "abandoned_staging_removed": True}
    journal = json_load(journal_path, {})
    if not isinstance(journal, dict) or journal.get("schema_version") != 1:
        raise ContinuityError("Interrupted restore journal is invalid; refusing automatic recovery")
    entries = journal.get("replacements")
    allowed = {
        runtime_lib.project_relative_posix(private_path(root, config), root),
        ".continuity-portfolio",
    }
    if not isinstance(entries, list) or not entries:
        raise ContinuityError("Interrupted restore journal has no recovery entries")
    paths = [entry.get("path") for entry in entries if isinstance(entry, dict)]
    if len(paths) != len(entries) or len(set(paths)) != len(paths) or not set(paths).issubset(allowed):
        raise ContinuityError("Interrupted restore journal contains unsupported paths")
    for entry in reversed(entries):
        relative = str(entry["path"])
        target = confined_path(root, relative, "restore recovery target")
        previous = confined_path(transaction_root / "previous", relative, "restore recovery previous state")
        staged = confined_path(transaction_root / "staged", relative, "restore recovery staged state")
        original_present = entry.get("original_present") is True
        if original_present:
            if previous.exists():
                _remove_restore_path(target)
                runtime_lib.replace_staged_file(previous, target)
            elif staged.exists():
                if not target.exists():
                    raise ContinuityError(f"Interrupted restore cannot recover missing original state: {relative}")
            else:
                raise ContinuityError(f"Interrupted restore lost its rollback copy: {relative}")
        else:
            _remove_restore_path(target)
    shutil.rmtree(transaction_root)
    return {"recovered": True, "transaction": journal.get("transaction_id"), "entries": len(entries)}


def apply_verified_restore(root: Path, config: dict[str, Any], payload: Path) -> dict[str, Any]:
    prior_recovery = recover_interrupted_restore(root, config)
    transaction_root = root / ".continuity-restore"
    transaction_root.mkdir(parents=True)
    acl = runtime_lib.windows_acl_profile(transaction_root)
    if not acl["healthy"]:
        shutil.rmtree(transaction_root)
        raise ContinuityError(
            f"Restore staging is writable by broad Windows principals: {acl['broad_write_principals']}"
        )
    replacements = [private_path(root, config).relative_to(root), Path(".continuity-portfolio")]
    entries: list[dict[str, Any]] = []
    for relative in replacements:
        target = root / relative
        source = payload / relative
        staged = transaction_root / "staged" / relative
        if source.exists():
            staged.parent.mkdir(parents=True, exist_ok=True)
            shutil.copytree(source, staged)
        entries.append(
            {
                "path": relative.as_posix(),
                "original_present": target.exists(),
                "restored_present": source.exists(),
            }
        )
    journal = {
        "schema_version": 1,
        "transaction_id": f"restore-{secrets.token_hex(8)}",
        "created_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
        "replacements": entries,
    }
    runtime_lib.atomic_write_json(transaction_root / "transaction.json", journal)
    try:
        for entry in entries:
            relative = Path(str(entry["path"]))
            target = root / relative
            previous = transaction_root / "previous" / relative
            staged = transaction_root / "staged" / relative
            if target.exists():
                previous.parent.mkdir(parents=True, exist_ok=True)
                runtime_lib.replace_staged_file(target, previous)
            if staged.exists():
                target.parent.mkdir(parents=True, exist_ok=True)
                runtime_lib.replace_staged_file(staged, target)
        (transaction_root / "transaction.json").unlink()
        shutil.rmtree(transaction_root)
    except BaseException:
        recover_interrupted_restore(root, config)
        raise
    return {"transaction_id": journal["transaction_id"], "entries": len(entries), "prior_recovery": prior_recovery}


def state_recover_restore(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    return recover_interrupted_restore(root, config)


def state_backup(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    restore_recovery = recover_interrupted_restore(root, config)
    quiescence = require_project_quiescence(root, config, "State backup")
    output_path = Path(args.output).expanduser().resolve() if args.output else default_backup_path(root, config)
    result = create_state_backup(root, config, args.recipient, output_path, args.signer, args.signing_key, args.verify_identity)
    result["quiescence"] = quiescence
    result["restore_recovery"] = restore_recovery
    return result


def state_verify(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    with runtime_lib.secure_temporary_directory(prefix="continuity-verify-") as temporary:
        verified = decrypt_and_verify_state_archive(root, config, Path(args.archive).expanduser().resolve(), args.identity, temporary)
        return {"verified": True, "project_id": config["project_id"], "archive": str(Path(args.archive).expanduser().resolve()), "files": len(verified["manifest"].get("files", {})), "created_at": verified["manifest"].get("created_at")}


def state_restore(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    restore_recovery = recover_interrupted_restore(root, config)
    quiescence = require_project_quiescence(root, config, "State restore")
    archive = Path(args.archive).expanduser().resolve()
    with runtime_lib.secure_temporary_directory(prefix="continuity-restore-") as temporary:
        verified = decrypt_and_verify_state_archive(root, config, archive, args.identity, temporary)
        checkpoint_verification = None
        if config.get("require_audit_checkpoints", False):
            checkpoint_verification = verify_audit_checkpoint_against(root, config, verified["payload"])
        if args.dry_run:
            return {"restored": False, "dry_run": True, "project_id": config["project_id"], "files": len(verified["manifest"].get("files", {})), "archive": str(archive), "restore_recovery": restore_recovery, "audit_checkpoint": checkpoint_verification}
        safety = create_state_backup(root, config, args.recipient, default_backup_path(root, config), args.signer, args.signing_key, args.identity)
        transaction = apply_verified_restore(root, config, verified["payload"])
        return {"restored": True, "project_id": config["project_id"], "files": len(verified["manifest"].get("files", {})), "archive": str(archive), "safety_backup": safety["archive"], "quiescence": quiescence, "transaction": transaction, "restore_recovery": restore_recovery, "audit_checkpoint": checkpoint_verification}


def audit_checkpoint_path(root: Path, config: dict[str, Any], requested: str | None = None) -> Path:
    configured = requested or config.get("audit_checkpoint_path")
    if configured:
        path = Path(str(configured).replace("{project_id}", config["project_id"])).expanduser().resolve()
    else:
        path = (Path.home() / ".continuity" / "audit-checkpoints" / f"{config['project_id']}.json").resolve()
    if path.is_relative_to(root):
        raise ContinuityError("Audit checkpoints must be stored outside the project repository")
    return path


def audit_checkpoint_ledgers(root: Path, config: dict[str, Any]) -> list[dict[str, Any]]:
    paths = list(private_path(root, config).rglob("*.jsonl"))
    portfolio = root / ".continuity-portfolio"
    if portfolio.exists():
        paths.extend(portfolio.rglob("*.jsonl"))
    ledgers = []
    for path in sorted(set(item.resolve() for item in paths)):
        status = runtime_lib.verify_jsonl_records(path)
        ledgers.append(
            {
                "path": runtime_lib.project_relative_posix(path, root),
                "records": status["records"],
                "head_hash": status["head_hash"],
            }
        )
    return ledgers


def audit_checkpoint_bytes(record: dict[str, Any]) -> bytes:
    payload = {key: record[key] for key in ("schema_version", "project_id", "created_at", "created_by", "ledgers", "nonce")}
    return (runtime_lib.canonical_json(payload) + "\n").encode()


def state_checkpoint_create(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    require_project_quiescence(root, config, "Audit checkpoint")
    output_path = audit_checkpoint_path(root, config, args.output)
    record = {
        "schema_version": 1,
        "project_id": config["project_id"],
        "created_at": iso_now(config),
        "created_by": args.signer,
        "ledgers": audit_checkpoint_ledgers(root, config),
        "nonce": secrets.token_hex(16),
        "signature_format": "openssh-sshsig-v1",
    }
    signature = output_path.with_suffix(output_path.suffix + ".sig")
    sign_receipt_bytes(
        audit_checkpoint_bytes(record),
        args.signing_key,
        signature,
        namespace="continuity-audit-checkpoint",
        label="audit checkpoint",
    )
    verify_receipt_bytes(
        root,
        config,
        audit_checkpoint_bytes(record),
        signature,
        args.signer,
        namespace="continuity-audit-checkpoint",
        label="audit checkpoint",
    )
    runtime_lib.atomic_write_json(output_path, record)
    return {**record, "path": str(output_path), "signature": str(signature), "verified": True}


def verify_audit_checkpoint_against(
    root: Path,
    config: dict[str, Any],
    ledger_root: Path,
    requested: str | None = None,
) -> dict[str, Any]:
    path = audit_checkpoint_path(root, config, requested)
    record = json_load(path, {})
    if not isinstance(record, dict) or record.get("project_id") != config["project_id"]:
        raise ContinuityError(f"Valid external audit checkpoint is unavailable: {path}")
    verify_receipt_bytes(
        root,
        config,
        audit_checkpoint_bytes(record),
        path.with_suffix(path.suffix + ".sig"),
        str(record.get("created_by", "")),
        namespace="continuity-audit-checkpoint",
        label="audit checkpoint",
    )
    failures = []
    for checkpoint in record.get("ledgers", []):
        relative = str(checkpoint.get("path", ""))
        ledger = confined_path(ledger_root, relative, "audit checkpoint ledger")
        try:
            current = runtime_lib.verify_jsonl_records(ledger)
            anchored = runtime_lib.jsonl_chain_hash_at(ledger, int(checkpoint.get("records", -1)))
        except (runtime_lib.RuntimeIntegrityError, ValueError) as exc:
            failures.append(f"{relative}: {exc}")
            continue
        if anchored != checkpoint.get("head_hash"):
            failures.append(f"{relative}: ledger no longer extends the signed checkpoint")
        elif int(current["records"]) < int(checkpoint.get("records", 0)):
            failures.append(f"{relative}: ledger was truncated")
    if failures:
        raise ContinuityError(f"Audit checkpoint verification failed: {failures}")
    return {"verified": True, "path": str(path), "created_at": record.get("created_at"), "created_by": record.get("created_by"), "ledgers": len(record.get("ledgers", []))}


def verify_audit_checkpoint(root: Path, config: dict[str, Any], requested: str | None = None) -> dict[str, Any]:
    return verify_audit_checkpoint_against(root, config, root, requested)


def state_checkpoint_verify(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    return verify_audit_checkpoint(root, config, args.checkpoint)


def project_doctor(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    manifest = load_project_manifest(root)
    records = discover_projects([root])
    record = next((item for item in records if item.get("path") == str(root)), None)
    if not record:
        raise ContinuityError("Project could not be discovered from its own root")
    record["integration_branch_matches"] = manifest.get("integration_branch") == config.get("integration_branch")
    record["execution_enabled"] = manifest.get("execution_enabled", False)
    record["healthy"] = record["healthy"] and record["integration_branch_matches"]
    if not record["integration_branch_matches"]:
        record["problems"].append("manifest and configuration integration branches differ")
    try:
        behavior = validate_project_behavior(root, config)
        record["behavior_configuration_hash"] = behavior["configuration_hash"]
        record["behavior_skill"] = config.get("behavior_skill_path")
    except ContinuityError as exc:
        record["healthy"] = False
        record["problems"].append(str(exc))
    scheduler_health = scheduler_registration_status_for(root, config)
    record["scheduler"] = scheduler_health
    if scheduler_health["state"] in {"requires-user-registration", "stale"}:
        record["healthy"] = False
        record["problems"].append(f"scheduler is {scheduler_health['state']}")
    if scheduler_health["stale_runs"]:
        record["healthy"] = False
        record["problems"].append(f"scheduler has stale runs: {scheduler_health['stale_runs']}")
    legacy_goal_ids = []
    for goal_path in sorted((private_path(root, config) / "goals").glob("*/goal.json")):
        goal = json_load(goal_path, {})
        if isinstance(goal, dict) and goal.get("state") in LEGACY_GOAL_STATES:
            legacy_goal_ids.append(str(goal.get("goal_id") or goal_path.parent.name))
    record["legacy_goal_ids"] = legacy_goal_ids
    if legacy_goal_ids:
        record["healthy"] = False
        record["problems"].append(
            f"legacy goal states require explicit goal revise migration: {legacy_goal_ids}"
        )
    legacy_note_ids = legacy_note_link_ids(root, config)
    record["legacy_note_ids"] = legacy_note_ids
    if legacy_note_ids:
        record["healthy"] = False
        record["problems"].append(
            f"legacy note links require explicit note migrate-links migration: {legacy_note_ids}"
        )
    lifecycle = note_lifecycle_audit(root, config)
    record["legacy_note_disposition_goal_ids"] = lifecycle["legacy_disposition_goal_ids"]
    record["note_lifecycle_problems"] = lifecycle["problems"]
    if lifecycle["legacy_disposition_goal_ids"]:
        record["healthy"] = False
        record["problems"].append(
            "legacy goals require explicit note dispositions through goal revise: "
            f"{lifecycle['legacy_disposition_goal_ids']}"
        )
    if lifecycle["problems"]:
        record["healthy"] = False
        record["problems"].append(f"note lifecycle audit failed: {lifecycle['problems']}")
    installation = suite_installation_status(root)
    record["suite_installation"] = installation
    if not installation["healthy"]:
        record["healthy"] = False
        record["problems"].extend(installation["problems"])
    collection_checks = {"enabled": config.get("collections", []), "missing_skills": [], "unexpected_collection_skills": []}
    try:
        definitions = [json_load(path, {}) for path in sorted((CONTROL_ROOT / "collections").glob("*.json"))]
        by_collection = {item.get("collection_id"): set(item.get("skills", [])) for item in definitions}
        enabled = set(config.get("collections", []))
        expected = set().union(*(by_collection.get(item, set()) for item in enabled)) if enabled else set()
        all_collection_skills = set().union(*by_collection.values()) if by_collection else set()
        installed = {
            path.name
            for path in (root / ".agents" / "skills").iterdir()
            if (path.name == "goal" or path.name.startswith("continuity")) and path.is_dir()
        }
        collection_checks["missing_skills"] = sorted(expected - installed)
        collection_checks["unexpected_collection_skills"] = sorted((installed & all_collection_skills) - expected)
        if collection_checks["missing_skills"] or collection_checks["unexpected_collection_skills"]:
            record["healthy"] = False
            record["problems"].append(f"collection skill mismatch: {collection_checks}")
    except (OSError, json.JSONDecodeError) as exc:
        record["healthy"] = False
        record["problems"].append(f"collection definitions are invalid: {exc}")
    record["collections"] = collection_checks
    if "design" in set(config.get("collections", [])):
        installed_catalog = root / ".agents" / "skills" / "continuity-design" / "references" / "catalog.json"
        try:
            catalog = design_lib.load_catalog(installed_catalog)
            record["design_catalog"] = {"healthy": True, "catalog_version": catalog["catalog_version"], "packs": [{"pack_id": item["pack_id"], "version": item["version"]} for item in catalog["packs"]]}
            approved_path = root / ".continuity" / "design.json"
            if approved_path.exists():
                approved = json_load(approved_path, {})
                runtime_lib.validate_schema_file(approved, CONTROL_ROOT / "schemas" / "design-record.schema.json", "approved design")
                document = root / str(approved.get("document_path", ""))
                if not document.is_file() or hashlib.sha256(document.read_bytes()).hexdigest() != approved.get("design_hash"):
                    raise ContinuityError("approved design document does not match .continuity/design.json")
                record["design_catalog"]["approved_design"] = {"design_id": approved["design_id"], "revision": approved["revision"], "design_hash": approved["design_hash"]}
        except (design_lib.DesignError, runtime_lib.RuntimeIntegrityError, OSError, json.JSONDecodeError, ContinuityError) as exc:
            record["healthy"] = False
            record["design_catalog"] = {"healthy": False, "problem": str(exc)}
            record["problems"].append(f"design catalog or approved design is invalid: {exc}")
    schema_checks: list[dict[str, Any]] = []
    for value, schema_name, label in (
        (config, "project-config.schema.json", "project config"),
        (manifest, "project-manifest.schema.json", "project manifest"),
    ):
        try:
            runtime_lib.validate_schema_file(value, CONTROL_ROOT / "schemas" / schema_name, label)
            schema_checks.append({"record": label, "healthy": True})
        except (runtime_lib.RuntimeIntegrityError, OSError, json.JSONDecodeError) as exc:
            schema_checks.append({"record": label, "healthy": False, "problem": str(exc)})
            record["healthy"] = False
            record["problems"].append(str(exc))
    record["schema_checks"] = schema_checks
    ledger_checks: list[dict[str, Any]] = []
    for path in sorted(private_path(root, config).rglob("*.jsonl")):
        try:
            ledger_checks.append(runtime_lib.verify_jsonl_records(path))
        except runtime_lib.RuntimeIntegrityError as exc:
            ledger_checks.append({"path": str(path), "healthy": False, "problem": str(exc)})
            record["healthy"] = False
            record["problems"].append(str(exc))
    record["ledger_integrity"] = ledger_checks
    approver_path = approval_allowed_signers_path(root, config)
    approvers = []
    if approver_path.exists():
        approvers = [line.split(maxsplit=1)[0] for line in approver_path.read_text(encoding="utf-8").splitlines() if line.strip() and not line.lstrip().startswith("#")]
    record["trusted_approvers"] = approvers
    if manifest.get("execution_enabled") and config.get("require_signed_approvals", False) and not approvers:
        record["healthy"] = False
        record["problems"].append("execution is enabled but no trusted SSH approver is configured")
    if manifest.get("execution_enabled") and config.get("require_signed_approvals", False) and approvers:
        try:
            record["approval_trust_anchor"] = verify_approval_trust_anchor(root, config)
        except ContinuityError as exc:
            record["healthy"] = False
            record["approval_trust_anchor"] = {"verified": False, "problem": str(exc)}
            record["problems"].append(str(exc))
    if manifest.get("execution_enabled") and config.get("require_audit_checkpoints", False):
        try:
            record["audit_checkpoint"] = verify_audit_checkpoint(root, config)
        except ContinuityError as exc:
            record["healthy"] = False
            record["audit_checkpoint"] = {"verified": False, "problem": str(exc)}
            record["problems"].append(str(exc))
    if manifest.get("execution_enabled") and config.get("require_pr", True) and not config.get("github_required_checks"):
        record["healthy"] = False
        record["problems"].append("execution is enabled but no required GitHub checks are configured")
    if config.get("planning_patterns", {}).get("tracker_provider") == "github":
        try:
            _settings_path, settings = github_projects_lib.load_settings(
                root,
                config,
                ".continuity/github-projects.json",
            )
            connection = github_projects_lib.load_connection(root, config)
            assert connection is not None
            destination = connection["destination"]
            if (
                destination["owner_type"] != settings["owner_type"]
                or destination["owner"].casefold() != str(settings["owner"]).casefold()
                or destination["project_number"] != settings["project_number"]
            ):
                raise github_projects_lib.GitHubProjectsError(
                    "GitHub Projects settings and durable connection target different Projects"
                )
            record["roadmap_connection"] = {
                "provider": "github-projects",
                "connected": True,
                "connection_id": connection["connection_id"],
                "authenticated_user": connection["authenticated_user"],
                "destination": destination,
                "capabilities": connection["capabilities"],
                "sync_policy": connection["sync_policy"],
                "live_check": "run roadmap github-projects status",
            }
        except github_projects_lib.GitHubProjectsError as exc:
            record["healthy"] = False
            record["roadmap_connection"] = {"provider": "github-projects", "connected": False, "problem": str(exc)}
            record["problems"].append(f"GitHub Projects connection is invalid: {exc}")
    record["platform"] = {"name": sys.platform, "supported": sys.platform.startswith(("darwin", "linux", "win32"))}
    record["filesystem"] = runtime_lib.project_filesystem_profile(root)
    restore_transaction_root = root / ".continuity-restore"
    record["restore_transaction"] = {
        "pending": restore_transaction_root.exists(),
        "journal": (restore_transaction_root / "transaction.json").is_file(),
    }
    if record["restore_transaction"]["pending"]:
        record["healthy"] = False
        record["problems"].append(
            "an interrupted state restore requires `state recover-restore` before normal operation"
        )
    sensitive_path = private_path(root, config)
    try:
        record["private_acl"] = runtime_lib.windows_acl_profile(sensitive_path)
    except runtime_lib.RuntimeIntegrityError as exc:
        record["private_acl"] = {"applicable": os.name == "nt", "healthy": False, "problem": str(exc)}
    if not record["private_acl"]["healthy"]:
        record["healthy"] = False
        broad = record["private_acl"].get("broad_write_principals", [])
        if broad:
            record["problems"].append(
                f"private state is writable by broad Windows principals: {broad}"
            )
        else:
            record["problems"].append(
                record["private_acl"].get("problem", "private-state ACL inspection failed")
            )
    interpreter_record = private_path(root, config) / "python-interpreter.txt"
    configured_interpreter = interpreter_record.read_text(encoding="utf-8").strip() if interpreter_record.is_file() else None
    dependencies = {
        "python": {
            "path": sys.executable,
            "version": platform.python_version(),
            "configured_path": configured_interpreter,
            "configured_path_exists": bool(configured_interpreter and Path(configured_interpreter).is_file()),
        },
        "git": {"path": shutil.which("git"), "required": True},
        "gh": {"path": shutil.which("gh"), "required": bool(manifest.get("execution_enabled") and config.get("require_pr", True))},
        "age": {"path": shutil.which("age"), "required": bool(manifest.get("execution_enabled") and config.get("require_verified_backups", False))},
        "age_keygen": {"path": shutil.which("age-keygen"), "required": False},
        "ssh_keygen": {"path": shutil.which("ssh-keygen"), "required": bool(manifest.get("execution_enabled") and config.get("require_signed_approvals", False))},
    }
    record["dependencies"] = dependencies
    if not record["platform"]["supported"]:
        record["healthy"] = False
        record["problems"].append(f"unsupported platform for file locking: {sys.platform}")
    if not record["filesystem"]["supported"]:
        record["healthy"] = False
        record["problems"].append(record["filesystem"]["problem"])
    if configured_interpreter and not dependencies["python"]["configured_path_exists"]:
        record["healthy"] = False
        record["problems"].append("the installer-bound Python interpreter is unavailable; reinstall Continuity with the intended Python environment")
    for name, dependency in dependencies.items():
        if name != "python" and dependency["required"] and not dependency["path"]:
            record["healthy"] = False
            record["problems"].append(f"required executable is unavailable: {name.replace('_', '-')}")
    return record


def scheduler_register(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    scheduler = normalize_scheduler(config.get("scheduler"))
    if scheduler["provider"] == "none":
        raise ContinuityError("Choose a scheduler provider before recording registration")
    workspace_roots = requested_workspace_roots(args.root or [])
    registered_at = iso_now(config)
    record = {
        "schema_version": 1,
        "provider": scheduler["provider"],
        "registered_at": registered_at,
        "last_heartbeat_at": registered_at,
        "last_sweep_id": None,
        "registered_by": args.actor,
        "supervisor_task_id": validate_task_id(args.task_id, "supervisor task ID"),
        "workspace_roots": [str(path) for path in workspace_roots],
        "behavior_configuration_hash": config.get("behavior_configuration_hash"),
        "sweep_minutes": scheduler["sweep_minutes"],
        "supervisor_prompt": ".agents/continuity/automation/portfolio-supervisor.md",
    }
    json_dump(scheduler_registration_path(root, config), record)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": record["registered_at"], "event": "scheduler.registered", "actor": args.actor, "task_id": args.task_id})
    return scheduler_registration_status_for(root, config)


def scheduler_supervisor_heartbeat(
    root: Path,
    config: dict[str, Any],
    task_id: str,
    sweep_id: str,
    workspace_roots: list[Path],
) -> dict[str, Any]:
    task_id = validate_task_id(task_id, "supervisor task ID")
    sweep_id = validate_identifier(sweep_id, "supervisor sweep ID")
    path = scheduler_registration_path(root, config)
    with exclusive_file_lock(scheduler_project_lock_path(root, config)):
        registration = json_load(path, {})
        if not isinstance(registration, dict) or not registration:
            raise ContinuityError("Scheduler registration is missing")
        if registration.get("provider") != normalize_scheduler(config.get("scheduler"))["provider"]:
            raise ContinuityError("Scheduler registration provider does not match configuration")
        if registration.get("behavior_configuration_hash") != config.get("behavior_configuration_hash"):
            raise ContinuityError("Scheduler registration is stale for the current behavior configuration")
        if registration.get("supervisor_task_id") != task_id:
            raise ContinuityError("Supervisor task ID does not match the registered task")
        registered_roots = registration_workspace_roots(registration)
        if sorted(registered_roots, key=str) != sorted(workspace_roots, key=str):
            raise ContinuityError("Supervisor workspace roots do not match the registered root set")
        stamp = iso_now(config)
        registration["last_heartbeat_at"] = stamp
        registration["last_sweep_id"] = sweep_id
        json_dump(path, registration)
        append_jsonl(
            private_path(root, config) / "events.jsonl",
            {"at": stamp, "event": "scheduler.supervisor-heartbeat", "task_id": task_id, "sweep_id": sweep_id},
        )
    return registration


def scheduler_unregister(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    path = scheduler_registration_path(root, config)
    existed = path.exists()
    path.unlink(missing_ok=True)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": iso_now(config), "event": "scheduler.unregistered", "actor": args.actor})
    return {"unregistered": existed, **scheduler_registration_status_for(root, config)}


def scheduler_status(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    status = scheduler_registration_status_for(root, config)
    snapshots = list(scheduler_run_snapshots(root, config).values())
    snapshots.sort(key=lambda value: value.get("last_event_at", ""), reverse=True)
    status["recent_runs"] = snapshots[: args.limit]
    return status


def scheduler_lease_ref(config: dict[str, Any]) -> str:
    return f"refs/continuity/leases/{validate_identifier(config['project_id'], 'project ID')}"


def git_with_input(root: Path, input_value: str, *arguments: str) -> str:
    result = subprocess.run(
        ["git", "-C", str(root), *arguments],
        input=input_value.encode("utf-8"),
        capture_output=True,
        timeout=60,
        check=False,
    )
    stdout = result.stdout.decode("utf-8", errors="replace")
    stderr = result.stderr.decode("utf-8", errors="replace")
    if result.returncode != 0:
        raise ContinuityError(stderr.strip() or stdout.strip() or f"git {' '.join(arguments)} failed")
    return stdout.strip()


def remote_lease_record(root: Path, config: dict[str, Any], remote: str) -> tuple[str | None, dict[str, Any] | None]:
    remote = validate_git_remote_name(remote)
    reference = scheduler_lease_ref(config)
    listed = git_result(root, "ls-remote", remote, reference)
    if listed.returncode != 0:
        raise ContinuityError(f"Unable to inspect remote Continuity lease: {listed.stderr.strip()}")
    if not listed.stdout.strip():
        return None, None
    commit = validate_git_object_id(listed.stdout.split()[0], "remote lease commit")
    fetched = git_result(root, "fetch", "--quiet", remote, reference)
    if fetched.returncode != 0:
        raise ContinuityError(f"Unable to fetch remote Continuity lease: {fetched.stderr.strip()}")
    shown = git_result(root, "show", "--end-of-options", f"{commit}:lease.json")
    if shown.returncode != 0:
        detail = shown.stderr.strip() or shown.stdout.strip() or "git show returned no diagnostic"
        raise ContinuityError(f"Remote Continuity lease record is unreadable: {detail}")
    try:
        record = json.loads(shown.stdout)
    except json.JSONDecodeError as exc:
        raise ContinuityError("Remote Continuity lease record is invalid JSON") from exc
    try:
        runtime_lib.validate_schema_file(record, CONTROL_ROOT / "schemas" / "remote-lease.schema.json", "remote execution lease")
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    parent_result = git_result(root, "show", "--no-patch", "--format=%P", commit)
    if parent_result.returncode != 0:
        raise ContinuityError(f"Unable to inspect remote Continuity lease ancestry: {parent_result.stderr.strip()}")
    parents = [validate_git_object_id(parent, "remote lease parent") for parent in parent_result.stdout.strip().split()]
    if len(parents) > 1:
        raise ContinuityError("Remote Continuity lease history cannot contain merge commits")
    expected_previous = parents[0] if parents else None
    if record.get("previous_lease_commit") != expected_previous:
        raise ContinuityError("Remote Continuity lease ancestry does not match its replay-protection record")
    return commit, record


def create_remote_lease_commit(root: Path, record: dict[str, Any], parent: str | None) -> str:
    blob = git_with_input(root, runtime_lib.canonical_json(record) + "\n", "hash-object", "-w", "--stdin")
    tree = git_with_input(root, f"100644 blob {blob}\tlease.json\n", "mktree")
    command = ["commit-tree", tree, "-m", f"Continuity lease {record['status']} for {record['project_id']}"]
    if parent:
        command.extend(["-p", parent])
    return git_with_input(root, "", *command)


def remote_lease_times(record: dict[str, Any], config: dict[str, Any]) -> tuple[dt.datetime, dt.datetime]:
    acquired = parse_recorded_time(record.get("acquired_at"), config["timezone"])
    expires = parse_recorded_time(record.get("expires_at"), config["timezone"])
    if acquired is None or expires is None or expires <= acquired:
        raise ContinuityError("Remote Continuity lease has invalid acquisition or expiration timestamps")
    return acquired, expires


def remote_lease_is_protected(record: dict[str, Any], config: dict[str, Any]) -> bool:
    if record.get("status") != "active":
        return False
    acquired, expires = remote_lease_times(record, config)
    current = now(config)
    skew = dt.timedelta(minutes=REMOTE_LEASE_CLOCK_SKEW_MINUTES)
    if acquired > current + skew:
        raise ContinuityError(
            f"Remote Continuity lease acquisition is more than {REMOTE_LEASE_CLOCK_SKEW_MINUTES} minutes in the future; check workstation clocks"
        )
    return expires + skew > current


def remote_lease_ttl(args: argparse.Namespace, config: dict[str, Any]) -> int:
    ttl = args.ttl_minutes or normalize_scheduler(config.get("scheduler"))["stale_after_minutes"]
    if not isinstance(ttl, int) or not 1 <= ttl <= REMOTE_LEASE_MAX_TTL_MINUTES:
        raise ContinuityError(
            f"Remote lease TTL must be between 1 and {REMOTE_LEASE_MAX_TTL_MINUTES} minutes"
        )
    return ttl


def scheduler_lease_status(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    commit, record = remote_lease_record(root, config, args.remote)
    if not record:
        return {"state": "available", "project_id": config["project_id"], "remote": args.remote, "ref": scheduler_lease_ref(config)}
    protected = remote_lease_is_protected(record, config)
    return {
        "state": "active" if protected else "available",
        "project_id": config["project_id"],
        "remote": args.remote,
        "ref": scheduler_lease_ref(config),
        "commit": commit,
        "lease": record,
        "clock_skew_grace_minutes": REMOTE_LEASE_CLOCK_SKEW_MINUTES,
    }


def scheduler_lease_acquire(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    _directory, goal = load_goal(root, config, args.goal_id)
    expected_attempt = str(int(goal.get("execution_attempt", 1)))
    if args.attempt_id and str(args.attempt_id) != expected_attempt:
        raise ContinuityError(f"Remote lease attempt must match goal execution attempt {expected_attempt}")
    owner_fingerprint = canonical_hash({"owner": args.owner})[:24]
    current_commit, current = remote_lease_record(root, config, args.remote)
    if current and remote_lease_is_protected(current, config):
        if (
            current.get("goal_id") == args.goal_id
            and str(current.get("attempt_id")) == expected_attempt
            and current.get("owner_fingerprint") == owner_fingerprint
        ):
            local = {**current, "remote": args.remote, "lease_commit": current_commit}
            json_dump(private_path(root, config) / "remote-lease.json", local)
            append_jsonl(
                private_path(root, config) / "events.jsonl",
                {
                    "at": iso_now(config),
                    "event": "scheduler.lease-reconciled",
                    "goal_id": args.goal_id,
                    "attempt_id": expected_attempt,
                    "lease_commit": current_commit,
                },
            )
            return local
        raise ContinuityError(f"Project already has an active remote lease through {current['expires_at']}")
    acquired = now(config)
    ttl = remote_lease_ttl(args, config)
    record = {
        "schema_version": 1,
        "project_id": config["project_id"],
        "goal_id": args.goal_id,
        "attempt_id": expected_attempt,
        "owner_fingerprint": owner_fingerprint,
        "status": "active",
        "acquired_at": acquired.isoformat(timespec="seconds"),
        "expires_at": (acquired + dt.timedelta(minutes=ttl)).isoformat(timespec="seconds"),
        "previous_lease_commit": current_commit,
    }
    try:
        runtime_lib.validate_schema_file(record, CONTROL_ROOT / "schemas" / "remote-lease.schema.json", "remote execution lease")
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    commit = create_remote_lease_commit(root, record, current_commit)
    pushed = git_result(root, "push", args.remote, f"{commit}:{scheduler_lease_ref(config)}")
    if pushed.returncode != 0:
        raise ContinuityError("Remote lease acquisition lost a concurrent race or was rejected; no work may start")
    local = {**record, "remote": args.remote, "lease_commit": commit}
    json_dump(private_path(root, config) / "remote-lease.json", local)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": record["acquired_at"], "event": "scheduler.lease-acquired", "goal_id": args.goal_id, "attempt_id": record["attempt_id"], "lease_commit": commit})
    return local


def scheduler_lease_renew(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    local_path = private_path(root, config) / "remote-lease.json"
    local = json_load(local_path, {})
    if not isinstance(local, dict) or local.get("status") != "active":
        raise ContinuityError("No active local remote lease is available to renew")
    if local.get("goal_id") != args.goal_id or str(local.get("attempt_id")) != str(args.attempt_id):
        raise ContinuityError("Refusing to renew a lease for another goal execution attempt")
    _acquired, local_expiry = remote_lease_times(local, config)
    if local_expiry <= now(config):
        raise ContinuityError("An expired remote lease cannot be renewed; acquire a new lease after clock-skew grace")
    remote = local.get("remote", "origin")
    current_commit, current = remote_lease_record(root, config, remote)
    if (
        current
        and current.get("status") == "active"
        and current_commit != local.get("lease_commit")
        and current.get("previous_lease_commit") == local.get("lease_commit")
        and current.get("goal_id") == args.goal_id
        and str(current.get("attempt_id")) == str(args.attempt_id)
        and current.get("owner_fingerprint") == local.get("owner_fingerprint")
    ):
        reconciled = {**current, "remote": remote, "lease_commit": current_commit}
        json_dump(local_path, reconciled)
        append_jsonl(
            private_path(root, config) / "events.jsonl",
            {
                "at": iso_now(config),
                "event": "scheduler.lease-reconciled",
                "goal_id": args.goal_id,
                "attempt_id": str(args.attempt_id),
                "lease_commit": current_commit,
            },
        )
        return reconciled
    if not current or current_commit != local.get("lease_commit") or current.get("status") != "active":
        raise ContinuityError("Remote lease changed since acquisition; refusing to renew a stale or replayed receipt")
    if current.get("goal_id") != args.goal_id or str(current.get("attempt_id")) != str(args.attempt_id):
        raise ContinuityError("Remote lease does not match the goal execution attempt")
    stamp = iso_now(config)
    ttl = remote_lease_ttl(args, config)
    renewed = {
        **current,
        "renewed_at": stamp,
        "expires_at": (now(config) + dt.timedelta(minutes=ttl)).isoformat(timespec="seconds"),
        "previous_lease_commit": current_commit,
    }
    try:
        runtime_lib.validate_schema_file(renewed, CONTROL_ROOT / "schemas" / "remote-lease.schema.json", "remote execution lease")
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    commit = create_remote_lease_commit(root, renewed, current_commit)
    pushed = git_result(root, "push", remote, f"{commit}:{scheduler_lease_ref(config)}")
    if pushed.returncode != 0:
        raise ContinuityError("Remote lease renewal lost a concurrent race or was rejected")
    local = {**renewed, "remote": remote, "lease_commit": commit}
    json_dump(local_path, local)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {"at": stamp, "event": "scheduler.lease-renewed", "goal_id": args.goal_id, "attempt_id": str(args.attempt_id), "lease_commit": commit},
    )
    return local


def bind_remote_lease_to_run(
    root: Path,
    config: dict[str, Any],
    local: dict[str, Any],
    *,
    run_id: str,
    task_id: str,
    idempotency_key: str,
) -> dict[str, Any]:
    remote = local.get("remote", "origin")
    current_commit, current = remote_lease_record(root, config, remote)
    if not current or current.get("status") != "active":
        raise ContinuityError("Remote lease changed before scheduler binding; no run may start")
    existing_binding = {
        "bound_run_id": current.get("bound_run_id"),
        "bound_task_id": current.get("bound_task_id"),
        "bound_idempotency_key": current.get("bound_idempotency_key"),
    }
    requested_binding = {
        "bound_run_id": run_id,
        "bound_task_id": task_id,
        "bound_idempotency_key": idempotency_key,
    }
    if current_commit != local.get("lease_commit") and not (
        current.get("previous_lease_commit") == local.get("lease_commit")
        and current.get("goal_id") == local.get("goal_id")
        and str(current.get("attempt_id")) == str(local.get("attempt_id"))
        and current.get("owner_fingerprint") == local.get("owner_fingerprint")
        and existing_binding == requested_binding
    ):
        raise ContinuityError("Remote lease changed before scheduler binding; no run may start")
    if any(existing_binding.values()) and existing_binding != requested_binding:
        raise ContinuityError("Remote lease is already bound to another scheduler run")
    if existing_binding == requested_binding:
        reconciled = {**current, "remote": remote, "lease_commit": current_commit}
        json_dump(private_path(root, config) / "remote-lease.json", reconciled)
        return reconciled
    bound = {**current, **requested_binding, "previous_lease_commit": current_commit}
    try:
        runtime_lib.validate_schema_file(bound, CONTROL_ROOT / "schemas" / "remote-lease.schema.json", "remote execution lease")
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    commit = create_remote_lease_commit(root, bound, current_commit)
    pushed = git_result(root, "push", remote, f"{commit}:{scheduler_lease_ref(config)}")
    if pushed.returncode != 0:
        raise ContinuityError("Remote lease binding lost a concurrent race or was rejected; no run may start")
    local = {**bound, "remote": remote, "lease_commit": commit}
    json_dump(private_path(root, config) / "remote-lease.json", local)
    return local


def validate_active_remote_lease(
    root: Path,
    config: dict[str, Any],
    goal_id: str,
    attempt_id: str,
    *,
    require_run_id: str | None = None,
    require_task_id: str | None = None,
) -> dict[str, Any]:
    lease = json_load(private_path(root, config) / "remote-lease.json", {})
    if not isinstance(lease, dict) or not lease or lease.get("status") != "active":
        raise ContinuityError("Execution requires an active, unexpired remote project lease")
    _acquired, expiry = remote_lease_times(lease, config)
    if expiry <= now(config):
        raise ContinuityError("Execution requires an active, unexpired remote project lease")
    if lease.get("goal_id") != goal_id or str(lease.get("attempt_id")) != str(attempt_id):
        raise ContinuityError("Remote lease does not match the goal execution attempt")
    if require_run_id is not None and lease.get("bound_run_id") != require_run_id:
        raise ContinuityError("Remote lease is not bound to this scheduler run")
    if require_task_id is not None and lease.get("bound_task_id") != require_task_id:
        raise ContinuityError("Remote lease is not bound to this scheduler task")
    remote_commit, remote_record = remote_lease_record(root, config, lease.get("remote", "origin"))
    if remote_commit != lease.get("lease_commit") or not remote_record or remote_record.get("status") != "active":
        raise ContinuityError("Remote project lease no longer matches the local acquisition receipt")
    if remote_record.get("goal_id") != goal_id or str(remote_record.get("attempt_id")) != str(attempt_id):
        raise ContinuityError("Remote lease record does not match the goal execution attempt")
    for key in ("bound_run_id", "bound_task_id", "bound_idempotency_key"):
        if remote_record.get(key) != lease.get(key):
            raise ContinuityError("Remote lease binding no longer matches the local acquisition receipt")
    return lease


def release_active_remote_lease(
    root: Path,
    config: dict[str, Any],
    *,
    reason: str,
    expected_goal_id: str,
    expected_attempt_id: str,
    expected_run_id: str | None = None,
    expected_task_id: str | None = None,
) -> dict[str, Any] | None:
    local_path = private_path(root, config) / "remote-lease.json"
    local = json_load(local_path, {})
    if not isinstance(local, dict) or local.get("status") != "active":
        return None
    if local.get("goal_id") != expected_goal_id or str(local.get("attempt_id")) != str(expected_attempt_id):
        raise ContinuityError("Refusing to release a lease for another goal execution attempt")
    if expected_run_id is not None and local.get("bound_run_id") != expected_run_id:
        raise ContinuityError("Refusing to release a lease bound to another scheduler run")
    if expected_task_id is not None and local.get("bound_task_id") != expected_task_id:
        raise ContinuityError("Refusing to release a lease bound to another scheduler task")
    remote = local.get("remote", "origin")
    current_commit, current = remote_lease_record(root, config, remote)
    if (
        current
        and current.get("status") == "released"
        and current.get("previous_lease_commit") == local.get("lease_commit")
        and current.get("goal_id") == expected_goal_id
        and str(current.get("attempt_id")) == str(expected_attempt_id)
        and (expected_run_id is None or current.get("bound_run_id") == expected_run_id)
        and (expected_task_id is None or current.get("bound_task_id") == expected_task_id)
    ):
        reconciled = {**current, "remote": remote, "lease_commit": current_commit}
        json_dump(local_path, reconciled)
        append_jsonl(
            private_path(root, config) / "events.jsonl",
            {
                "at": iso_now(config),
                "event": "scheduler.lease-reconciled",
                "goal_id": expected_goal_id,
                "lease_commit": current_commit,
            },
        )
        return reconciled
    if not current or current_commit != local.get("lease_commit"):
        raise ContinuityError("Remote lease changed since acquisition; refusing to release another operator's lease")
    stamp = iso_now(config)
    record = {
        **current,
        "status": "released",
        "released_at": stamp,
        "release_reason": reason,
        "previous_lease_commit": current_commit,
    }
    try:
        runtime_lib.validate_schema_file(record, CONTROL_ROOT / "schemas" / "remote-lease.schema.json", "remote execution lease")
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    commit = create_remote_lease_commit(root, record, current_commit)
    pushed = git_result(root, "push", remote, f"{commit}:{scheduler_lease_ref(config)}")
    if pushed.returncode != 0:
        raise ContinuityError("Remote lease release was rejected; inspect lease status before more work")
    local.update({"status": "released", "released_at": stamp, "release_reason": reason, "lease_commit": commit})
    json_dump(local_path, local)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": "scheduler.lease-released", "goal_id": local.get("goal_id"), "lease_commit": commit, "reason": reason})
    return local


def scheduler_lease_release(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    released = release_active_remote_lease(
        root,
        config,
        reason=args.reason,
        expected_goal_id=args.goal_id,
        expected_attempt_id=args.attempt_id,
    )
    if not released:
        raise ContinuityError("No active local remote lease is available to release")
    return released


def scheduler_adapter_render(args: argparse.Namespace, provider: str) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    manifest = load_project_manifest(root)
    scheduler = normalize_scheduler(config.get("scheduler"))
    if scheduler["provider"] != provider:
        raise ContinuityError(f"{provider} adapter rendering requires scheduler.provider={provider}")
    roots = requested_workspace_roots(args.root or [])
    entrypoint = root / ".agents" / "continuity" / "bin" / "continuity"
    launcher_argv = [str(entrypoint)]
    if os.name == "nt":
        interpreter_record = private_path(root, config) / "python-interpreter.txt"
        configured_interpreter = (
            interpreter_record.read_text(encoding="utf-8").strip()
            if interpreter_record.is_file()
            else ""
        )
        if not configured_interpreter or not Path(configured_interpreter).is_file():
            raise ContinuityError(
                "Scheduler adapter rendering requires the installer-bound Python interpreter; reinstall Continuity"
            )
        launcher_argv = [str(Path(configured_interpreter).resolve()), str(entrypoint)]
    supervisor_argv = [
        *launcher_argv,
        "--json",
        "portfolio",
        "actions",
        *(argument for path in roots for argument in ("--root", str(path))),
        "--supervisor-task-id",
        "__CONTINUITY_SUPERVISOR_TASK_ID__",
        "--sweep-id",
        "__CONTINUITY_SWEEP_ID__",
    ]
    registration_argv = [
        *launcher_argv,
        "--project-root",
        str(root),
        "scheduler",
        "register",
        "--task-id",
        "__CONTINUITY_PROVIDER_TASK_ID__",
        *(argument for path in roots for argument in ("--root", str(path))),
    ]
    literal_placeholders = {
        "supervisor_task_id": "__CONTINUITY_SUPERVISOR_TASK_ID__",
        "sweep_id": "__CONTINUITY_SWEEP_ID__",
        "provider_task_id": "__CONTINUITY_PROVIDER_TASK_ID__",
        "markdown_escaping_forbidden": True,
    }
    prompt = (
        "Use the installed Continuity portfolio supervisor contract for portfolio actions. Invoke the exact supervisor_argv JSON array below "
        "as a direct process with shell=false after replacing only the task and sweep placeholder values. Treat every underscore in those "
        "placeholder values as literal data: never add Markdown bold markers or backslash escapes. Start one project task only for returned "
        "due or retry claims, pass every claim field unchanged, heartbeat active runs, record run-finish, and never cross approval or merge "
        "boundaries.\n\nsupervisor_argv:\n"
        + json.dumps(supervisor_argv, ensure_ascii=False, indent=2)
    )
    definition = {
        "schema_version": 1,
        "provider": provider,
        "title": f"Continuity {provider} supervisor: {config['project_id']}",
        "schedule": {"type": "interval", "minutes": scheduler["sweep_minutes"], "timezone": config["timezone"], "business_days": scheduler["business_days"]},
        "workspace_roots": [str(path) for path in roots],
        "prompt": prompt,
        "literal_placeholders": literal_placeholders,
        "launcher": launcher_argv[0],
        "supervisor_argv": supervisor_argv,
        "registration_argv": registration_argv,
        "shell_required": False,
        "cwd_independent": True,
        "project_schedules": manifest["schedules"],
        "registration_command": render_direct_command(registration_argv),
        "human_action_required": (
            "Create or update the Codex automation with the exact prompt from this definition and leave it paused. Replace only the "
            "supervisor-task placeholder value with the returned task ID. Inspect the provider's raw saved prompt before registration: the "
            "sweep placeholder must equal literal_placeholders.sweep_id exactly once, with no Markdown markers or backslashes. Then run "
            "registration_command with the returned task ID."
            if provider == "codex"
            else "Create or update a Claude Desktop local scheduled task with the exact prompt from this definition and leave it paused. "
            "Replace only the supervisor-task placeholder value with the returned task ID. Inspect the provider's raw saved prompt before "
            "registration: the sweep placeholder must equal literal_placeholders.sweep_id exactly once, with no Markdown markers or "
            "backslashes. Then run registration_command with the returned task ID. Do not substitute a cloud routine for local private "
            "project state."
        ),
    }
    try:
        schema_name = "codex-automation.schema.json" if provider == "codex" else "claude-code-automation.schema.json"
        runtime_lib.validate_schema_file(definition, CONTROL_ROOT / "schemas" / schema_name, f"{provider} automation definition")
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    return definition


def scheduler_adapter_codex_render(args: argparse.Namespace) -> dict[str, Any]:
    return scheduler_adapter_render(args, "codex")


def scheduler_adapter_claude_code_render(args: argparse.Namespace) -> dict[str, Any]:
    return scheduler_adapter_render(args, "claude-code")


def render_direct_command(argv: list[str]) -> str:
    if os.name == "nt":
        return "& " + " ".join("'" + argument.replace("'", "''") + "'" for argument in argv)
    return shlex.join(argv)


def scheduler_adapter_verify(args: argparse.Namespace, provider: str) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    registration = scheduler_registration_status_for(root, config)
    events = list(iter_jsonl(private_path(root, config) / "events.jsonl"))
    sweep_ids = {
        event.get("sweep_id")
        for event in events
        if event.get("event") == "scheduler.supervisor-heartbeat" and event.get("sweep_id")
    }
    snapshots = scheduler_run_snapshots(root, config)
    no_op_runs = [
        run for run in snapshots.values()
        if run.get("action") in {"review", "report"} and run.get("status") == "succeeded" and not run.get("goal_id")
    ]
    probe_events = list(iter_jsonl(private_path(root, config) / "reports" / f"{provider}-adapter-conformance.jsonl"))
    latest_probes: dict[str, dict[str, Any]] = {}
    for event in probe_events:
        probe = event.get("probe")
        if probe in CODEX_CONFORMANCE_PROBES:
            latest_probes[str(probe)] = event
    problems = []
    if normalize_scheduler(config.get("scheduler"))["provider"] != provider:
        problems.append(f"scheduler provider is not {provider}")
    if registration["state"] != "registered":
        problems.append(f"scheduler registration is {registration['state']}")
    if len(sweep_ids) < 2:
        problems.append("fewer than two distinct supervisor sweeps were observed")
    if not no_op_runs:
        problems.append("no successful claimed review or report no-op run was observed")
    for probe in sorted(CODEX_CONFORMANCE_PROBES):
        observation = latest_probes.get(probe)
        if not observation:
            problems.append(f"missing observed conformance probe: {probe}")
        elif observation.get("status") != "passed":
            problems.append(f"conformance probe did not pass: {probe}")
        elif observation.get("behavior_configuration_hash") != config.get("behavior_configuration_hash"):
            problems.append(f"conformance probe is stale for project behavior: {probe}")
        elif config.get("require_signed_approvals", False):
            try:
                verify_receipt_bytes(
                    root,
                    config,
                    conformance_probe_bytes(observation),
                    confined_path(root, str(observation.get("signature_path", "")), "conformance signature"),
                    str(observation.get("observed_by", "")),
                    namespace="continuity-adapter-probe",
                    label="adapter conformance probe",
                )
            except ContinuityError as exc:
                problems.append(f"conformance probe signature is invalid for {probe}: {exc}")
    return {
        "provider": provider,
        "healthy": not problems,
        "problems": problems,
        "registration": registration,
        "observed_sweeps": len(sweep_ids),
        "observed_no_op_runs": len(no_op_runs),
        "required_probes": sorted(CODEX_CONFORMANCE_PROBES),
        "observed_probes": latest_probes,
    }


def scheduler_adapter_codex_verify(args: argparse.Namespace) -> dict[str, Any]:
    return scheduler_adapter_verify(args, "codex")


def scheduler_adapter_claude_code_verify(args: argparse.Namespace) -> dict[str, Any]:
    return scheduler_adapter_verify(args, "claude-code")


def conformance_probe_bytes(record: dict[str, Any]) -> bytes:
    keys = (
        "schema_version",
        "provider",
        "probe",
        "status",
        "observed_at",
        "observed_by",
        "evidence",
        "artifact_sha256",
        "behavior_configuration_hash",
        "nonce",
    )
    return (runtime_lib.canonical_json({key: record[key] for key in keys if key in record}) + "\n").encode()


def scheduler_adapter_record_probe(args: argparse.Namespace, provider: str) -> dict[str, Any]:
    root, config = load_context(validate_behavior=False)
    if normalize_scheduler(config.get("scheduler"))["provider"] != provider:
        raise ContinuityError(f"{provider} conformance evidence requires scheduler.provider={provider}")
    if not args.evidence:
        raise ContinuityError("Conformance probes require concrete evidence")
    if not re.fullmatch(r"[0-9a-f]{64}", args.artifact_sha256):
        raise ContinuityError("Conformance probes require a lowercase SHA-256 artifact hash")
    if config.get("require_signed_approvals", False) and not args.signing_key:
        raise ContinuityError("Production conformance probes require a trusted SSH signature")
    record = {
        "schema_version": 1,
        "provider": provider,
        "probe": args.probe,
        "status": args.status,
        "observed_at": iso_now(config),
        "observed_by": args.actor,
        "evidence": args.evidence,
        "artifact_sha256": args.artifact_sha256,
        "behavior_configuration_hash": config.get("behavior_configuration_hash"),
        "nonce": secrets.token_hex(16),
        "signature_format": "openssh-sshsig-v1" if args.signing_key else "legacy-unsigned",
    }
    if args.signing_key:
        signature = private_path(root, config) / "reports" / "conformance-signatures" / f"{args.probe}-{secrets.token_hex(8)}.sig"
        sign_receipt_bytes(
            conformance_probe_bytes(record),
            args.signing_key,
            signature,
            namespace="continuity-adapter-probe",
            label="adapter conformance probe",
        )
        verify_receipt_bytes(
            root,
            config,
            conformance_probe_bytes(record),
            signature,
            args.actor,
            namespace="continuity-adapter-probe",
            label="adapter conformance probe",
        )
        record["signature_path"] = runtime_lib.project_relative_posix(signature, root)
    append_jsonl(private_path(root, config) / "reports" / f"{provider}-adapter-conformance.jsonl", record)
    return record


def scheduler_adapter_codex_record_probe(args: argparse.Namespace) -> dict[str, Any]:
    return scheduler_adapter_record_probe(args, "codex")


def scheduler_adapter_claude_code_record_probe(args: argparse.Namespace) -> dict[str, Any]:
    return scheduler_adapter_record_probe(args, "claude-code")


def scheduler_run_start(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    registration = scheduler_registration_status_for(root, config)
    if registration["state"] != "registered":
        raise ContinuityError(f"Scheduler registration is {registration['state']}")
    raw_registration = json_load(scheduler_registration_path(root, config), {})
    workspace_roots = registration_workspace_roots(raw_registration)
    control = portfolio_control_dir(raw_registration)
    task_id = validate_task_id(args.task_id, "scheduled task ID")
    dispatch_lease: dict[str, Any] | None = None
    if config.get("require_remote_lease", False) and args.action == "dispatch":
        if not args.goal_id:
            raise ContinuityError("Scheduled dispatch requires a goal ID")
        _directory, dispatch_goal = load_goal(root, config, args.goal_id)
        dispatch_lease = validate_active_remote_lease(
            root,
            config,
            args.goal_id,
            str(int(dispatch_goal.get("execution_attempt", 1))),
        )
    current = now(config)
    with exclusive_file_lock(control / "portfolio.lock"):
        projects = discover_projects(workspace_roots)
        active, _reserved, capacity, _claims = portfolio_runtime_inventory(
            projects,
            current,
            str(raw_registration["supervisor_task_id"]),
            workspace_roots,
            locked_project_root=root,
        )
        if active >= capacity:
            raise ContinuityError("Portfolio concurrency capacity is exhausted")
        with exclusive_file_lock(scheduler_project_lock_path(root, config)):
            claims = prune_due_actions(root, config, current)
            claim = claims.get(args.claim_token)
            if not claim:
                raise ContinuityError("A current one-time due-action claim is required")
            if claim.get("project_id") != config["project_id"]:
                raise ContinuityError("Due-action claim belongs to another project")
            if claim.get("behavior_configuration_hash") != config.get("behavior_configuration_hash"):
                raise ContinuityError("Due-action claim is stale for the current project behavior")
            if claim.get("supervisor_task_id") != raw_registration.get("supervisor_task_id"):
                raise ContinuityError("Due-action claim belongs to another supervisor")
            if claim.get("action") != args.action or claim.get("idempotency_key") != args.idempotency_key:
                raise ContinuityError("Due-action claim does not match the requested action")
            if args.action == "dispatch":
                if not args.goal_id or args.goal_id not in claim.get("due_goal_ids", []):
                    raise ContinuityError("Dispatch goal is not authorized by the due-action claim")
            elif args.goal_id:
                raise ContinuityError(f"{args.action} runs cannot claim a goal")
            latest, attempts = latest_run_for_key(root, config, args.idempotency_key)
            scheduler = normalize_scheduler(config.get("scheduler"))
            if latest:
                latest_at = parse_recorded_time(latest.get("last_event_at"), config["timezone"])
                if latest.get("status") == "succeeded":
                    raise ContinuityError("This scheduled action already succeeded")
                if latest.get("status") in SCHEDULER_ACTIVE_STATES and latest_at is not None and current - latest_at <= dt.timedelta(minutes=scheduler["stale_after_minutes"]):
                    raise ContinuityError(f"Scheduled action is already active as {latest['run_id']}")
                if attempts > scheduler["retry_limit"]:
                    raise ContinuityError("Scheduled action exhausted its retry allowance")
                if latest_at is not None and latest.get("status") in SCHEDULER_FINAL_STATES and current - latest_at < dt.timedelta(minutes=scheduler["retry_backoff_minutes"]):
                    raise ContinuityError("Scheduled action is still in retry backoff")
            attempt = attempts + 1
            run_id = "run-" + hashlib.sha256(
                f"{config['project_id']}\0{args.idempotency_key}\0{args.claim_token}\0{attempt}".encode()
            ).hexdigest()[:16]
            if dispatch_lease is not None:
                dispatch_lease = bind_remote_lease_to_run(
                    root,
                    config,
                    dispatch_lease,
                    run_id=run_id,
                    task_id=task_id,
                    idempotency_key=args.idempotency_key,
                )
            event = {
                "schema_version": 1,
                "run_id": run_id,
                "project_id": config["project_id"],
                "action": args.action,
                "status": "started",
                "at": iso_now(config),
                "idempotency_key": args.idempotency_key,
                "attempt": attempt,
                "task_id": task_id,
                "goal_id": args.goal_id,
                "summary": args.summary or "Scheduled action started.",
                "claim_hash": hashlib.sha256(args.claim_token.encode()).hexdigest(),
                "sweep_id": claim.get("sweep_id"),
            }
            if dispatch_lease is not None:
                event.update(
                    {
                        "lease_attempt_id": dispatch_lease["attempt_id"],
                        "lease_commit": dispatch_lease["lease_commit"],
                        "lease_owner_fingerprint": dispatch_lease["owner_fingerprint"],
                    }
                )
            append_jsonl(scheduler_runs_path(root, config), event)
            claims.pop(args.claim_token, None)
            json_dump(scheduler_due_actions_path(root, config), claims)
    return event


def scheduler_run_event(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    snapshots = scheduler_run_snapshots(root, config)
    run = snapshots.get(args.run_id)
    if not run:
        raise ContinuityError(f"Unknown scheduler run: {args.run_id}")
    if run.get("status") not in SCHEDULER_ACTIVE_STATES:
        raise ContinuityError(f"Scheduler run is already final: {run.get('status')}")
    status = "heartbeat" if args.command == "heartbeat" else args.status
    if status == "succeeded" and run.get("action") == "dispatch":
        goal_id = run.get("goal_id")
        if not isinstance(goal_id, str):
            raise ContinuityError("A successful dispatch run must identify its goal")
        _directory, goal = load_goal(root, config, goal_id)
        if goal.get("state") not in {"review-ready", "completed"}:
            raise ContinuityError("A dispatch run cannot succeed before its goal reaches review-ready")
    event = {
        "schema_version": 1,
        "run_id": args.run_id,
        "project_id": config["project_id"],
        "action": run["action"],
        "status": status,
        "at": iso_now(config),
        "idempotency_key": run["idempotency_key"],
        "attempt": run["attempt"],
        "task_id": run.get("task_id"),
        "goal_id": run.get("goal_id"),
        "summary": args.summary,
    }
    released: dict[str, Any] | None = None
    if args.command == "finish" and config.get("require_remote_lease", False) and run.get("action") == "dispatch":
        goal_id = run.get("goal_id")
        attempt_id = run.get("lease_attempt_id")
        if not isinstance(goal_id, str) or attempt_id is None:
            raise ContinuityError("Dispatch run is missing its lease ownership binding")
        released = release_active_remote_lease(
            root,
            config,
            reason=f"scheduled run {args.status}",
            expected_goal_id=goal_id,
            expected_attempt_id=str(attempt_id),
            expected_run_id=args.run_id,
            expected_task_id=str(run.get("task_id")),
        )
        if released:
            event["remote_lease_released"] = released.get("lease_commit")
    append_jsonl(scheduler_runs_path(root, config), event)
    return event


def scheduler_recover(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    scheduler = normalize_scheduler(config.get("scheduler"))
    current = now(config)
    recovered: list[dict[str, Any]] = []
    for run in scheduler_run_snapshots(root, config).values():
        if args.run_id and run.get("run_id") != args.run_id:
            continue
        if run.get("status") not in SCHEDULER_ACTIVE_STATES:
            continue
        last_event = parse_recorded_time(run.get("last_event_at"), config["timezone"])
        if last_event is None or current - last_event <= dt.timedelta(minutes=scheduler["stale_after_minutes"]):
            continue
        goal_id = run.get("goal_id")
        goal_context: tuple[Path, dict[str, Any], dict[str, Any]] | None = None
        if isinstance(goal_id, str):
            directory, goal = load_goal(root, config, goal_id)
            execution = json_load(directory / "execution.json", {})
            if goal.get("state") in {"dispatched", "running", "validating"}:
                execution_task = execution.get("task_id") if isinstance(execution, dict) else None
                if execution_task and execution_task != run.get("task_id"):
                    raise ContinuityError("Refusing stale recovery because the execution task ID does not match")
                goal_context = (directory, goal, execution if isinstance(execution, dict) else {})
        released_lease: dict[str, Any] | None = None
        if config.get("require_remote_lease", False) and run.get("action") == "dispatch":
            attempt_id = run.get("lease_attempt_id")
            if not isinstance(goal_id, str) or attempt_id is None:
                raise ContinuityError("Stale dispatch run is missing its lease ownership binding")
            released_lease = release_active_remote_lease(
                root,
                config,
                reason=f"stale scheduled run {run['run_id']}",
                expected_goal_id=goal_id,
                expected_attempt_id=str(attempt_id),
                expected_run_id=str(run["run_id"]),
                expected_task_id=str(run.get("task_id")),
            )
        event = {
            "schema_version": 1,
            "run_id": run["run_id"],
            "project_id": config["project_id"],
            "action": run["action"],
            "status": "stale",
            "at": iso_now(config),
            "idempotency_key": run["idempotency_key"],
            "attempt": run["attempt"],
            "task_id": run.get("task_id"),
            "goal_id": run.get("goal_id"),
            "summary": args.summary,
            "recovered_by": args.actor,
        }
        if released_lease:
            event["remote_lease_released"] = released_lease.get("lease_commit")
        append_jsonl(scheduler_runs_path(root, config), event)
        if goal_context is not None:
            directory, goal, execution = goal_context
            stamp = iso_now(config)
            goal["state"] = "blocked"
            goal["updated_at"] = stamp
            json_dump(directory / "goal.json", goal)
            execution.update({"goal_id": goal_id, "state": "blocked", "updated_at": stamp, "summary": args.summary})
            json_dump(directory / "execution.json", execution)
            update_note_goal_links(root, config, goal.get("source_note_ids", []), goal_id, "blocked")
            lock_path = private_path(root, config) / "project.lock.json"
            lock = json_load(lock_path, {})
            if isinstance(lock, dict) and lock.get("goal_id") == goal_id:
                lock_path.unlink(missing_ok=True)
            event["goal_recovery"] = "blocked-and-lock-released"
        recovered.append(event)
    if args.run_id and not recovered:
        raise ContinuityError("Requested run is not stale or does not exist")
    return recovered


def git_result(root: Path, *arguments: str) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["git", "-C", str(root), *arguments],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    result.stderr = runtime_lib.redact_sensitive_text(result.stderr)
    return result


def execution_preflight(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    fast_interactive = bool(getattr(args, "fast_interactive", False))
    failures: list[str] = []
    evidence: list[str] = []
    try:
        manifest = load_project_manifest(root)
        if not manifest.get("continuity_enabled"):
            failures.append("Continuity is disabled")
        if not manifest.get("execution_enabled"):
            if fast_interactive:
                evidence.append("interactive-goal-request:execution-authorized; unattended-execution-disabled")
            else:
                failures.append("project product-code execution is disabled")
        if manifest.get("project_id") != config.get("project_id"):
            failures.append("project manifest and configuration IDs differ")
        if manifest.get("integration_branch") != config.get("integration_branch"):
            failures.append("project manifest and configuration integration branches differ")
        evidence.append("project-manifest:present")
    except ContinuityError as exc:
        failures.append(str(exc))
    try:
        _goal, approval = validate_approval(root, config, args.goal_id)
        evidence.append(f"approval:{approval['plan_hash']}")
    except ContinuityError as exc:
        failures.append(str(exc))
    if config.get("require_audit_checkpoints", False) and not fast_interactive:
        try:
            checkpoint = verify_audit_checkpoint(root, config)
            evidence.append(f"audit-checkpoint:{checkpoint['created_at']}")
        except ContinuityError as exc:
            failures.append(str(exc))
    compliance = json_load(directory / "compliance.json", {})
    for stage in ("memory-retrieval", "roadmap-retrieval", "plan-review", "approval"):
        status = compliance.get("stages", {}).get(stage, {}).get("status")
        if status not in {"passed", "not-applicable"}:
            failures.append(f"compliance stage {stage} is {status or 'missing'}")
    inside = git_result(root, "rev-parse", "--is-inside-work-tree")
    if inside.returncode != 0:
        failures.append("repository is not a Git working tree")
    else:
        evidence.append("git-worktree:ok")
    base = config.get("integration_branch")
    if not base:
        failures.append("integration_branch is not configured")
    else:
        if config.get("refresh_base_on_preflight", False):
            fetched = git_result(root, "fetch", "origin", base)
            if fetched.returncode != 0:
                message = f"failed to fetch origin/{base}: {fetched.stderr.strip()}"
                if fast_interactive:
                    evidence.append(f"advisory:{message}")
                else:
                    failures.append(message)
            else:
                evidence.append(f"fetched:origin/{base}")
        local = git_result(root, "show-ref", "--verify", f"refs/heads/{base}")
        remote = git_result(root, "show-ref", "--verify", f"refs/remotes/origin/{base}")
        if local.returncode != 0 and remote.returncode != 0:
            failures.append(f"integration branch {base} is unavailable")
        else:
            evidence.append(f"integration-branch:{base}")
    if config.get("require_remote", True):
        remote_url = git_result(root, "remote", "get-url", "origin")
        if remote_url.returncode != 0 or not remote_url.stdout.strip():
            failures.append("origin remote is unavailable")
        else:
            evidence.append("origin:configured")
    if config.get("require_pr_auth", False) and not fast_interactive:
        try:
            repository = github_repository_from_remote(root)
            authenticated_login = github_authenticated_login(root, repository)
        except ContinuityError as exc:
            failures.append(str(exc))
        else:
            evidence.append(f"gh-auth:{repository['host']}:{authenticated_login}")
    if not (root / "AGENTS.md").exists():
        failures.append("AGENTS.md is unavailable")
    else:
        evidence.append("AGENTS.md:present")
    states = dependency_states(root, config, goal)
    blocked = {key: state for key, state in states.items() if state != "completed"}
    if blocked:
        failures.append(f"unmet dependencies: {blocked}")
    stamp = iso_now(config)
    status = "passed" if not failures else "failed"
    compliance.setdefault("stages", {})["execution-preflight"] = {
        "status": status,
        "evidence": evidence + failures,
        "actor": "continuity-cli",
        "updated_at": stamp,
    }
    compliance["updated_at"] = stamp
    json_dump(directory / "compliance.json", compliance)
    report = {
        "goal_id": args.goal_id,
        "mode": "interactive-fast" if fast_interactive else "standard",
        "passed": not failures,
        "failures": failures,
        "evidence": evidence,
    }
    json_dump(directory / "preflight.json", report)
    return report


def execution_checkpoint(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, _goal = load_goal(root, config, args.goal_id)
    checkpoint = {
        "at": iso_now(config),
        "phase": args.phase,
        "summary": args.summary,
        "alignment": args.alignment,
        "evidence": args.evidence or [],
    }
    append_jsonl(directory / "checkpoints.jsonl", checkpoint)
    return checkpoint


def goal_start(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    goal, approval = validate_approval(root, config, args.goal_id)
    fast_interactive = bool(getattr(args, "fast_interactive", False))
    if goal.get("state") != "queued":
        raise ContinuityError(f"Only a queued goal can be dispatched; current state is {goal.get('state')}")
    active_lease = None
    if config.get("require_remote_lease", False) and not fast_interactive:
        active_lease = validate_active_remote_lease(
            root,
            config,
            args.goal_id,
            str(int(goal.get("execution_attempt", 1))),
        )
    directory = goal_dir(root, config, args.goal_id)
    preflight = execution_preflight(argparse.Namespace(goal_id=args.goal_id, fast_interactive=fast_interactive))
    if not preflight["passed"]:
        raise ContinuityError(f"Execution preflight failed: {preflight['failures']}")
    lock_path = private_path(root, config) / "project.lock.json"
    states = dependency_states(root, config, goal)
    blocked = {key: state for key, state in states.items() if state != "completed"}
    if blocked:
        raise ContinuityError(f"Unmet dependencies: {blocked}")
    stamp = iso_now(config)
    goal.setdefault("execution_attempt", 1)
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(lock_path, flags, 0o600)
    except FileExistsError as exc:
        lock = json_load(lock_path, {})
        if lock.get("goal_id") == args.goal_id:
            existing = json_load(directory / "dispatch.json")
            if existing:
                return existing
        raise ContinuityError(f"Project is locked by active goal {lock.get('goal_id', 'unknown')}") from exc
    with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
        handle.write(json.dumps({"goal_id": args.goal_id, "acquired_at": stamp}, sort_keys=True) + "\n")
    goal["state"] = "dispatched"
    goal["dispatched_at"] = stamp
    goal["updated_at"] = stamp
    json_dump(directory / "goal.json", goal)
    update_note_goal_links(root, config, goal.get("source_note_ids", []), goal["goal_id"], "dispatched")
    prompt = {
        "goal_id": goal["goal_id"],
        "project_id": config["project_id"],
        "repository": str(root),
        "integration_branch": config["integration_branch"],
        "base_ref": f"origin/{config['integration_branch']}" if config.get("require_remote", True) else config["integration_branch"],
        "branch_name": f"{config.get('branch_prefix', 'continuity')}/{now(config).date().isoformat()}/{slug(config['project_id'])}-{slug(goal['title'])}",
        "worktree_path": str(root.parent / "worktrees" / f"{slug(config.get('branch_prefix', 'continuity'))}-{slug(goal['goal_id'])}"),
        "plan_path": runtime_lib.project_relative_posix(directory / "plan.md", root),
        "goal_path": runtime_lib.project_relative_posix(directory / "goal.json", root),
        "approval": approval,
        "approved_plan": (directory / "plan.md").read_text(encoding="utf-8"),
        "approved_plan_hash": approval["plan_hash"],
        "source_note_ids": goal.get("source_note_ids", []),
        "memory_ids": goal.get("memory_ids", []),
        "roadmap_ids": goal.get("roadmap_ids", []),
        "roadmap_impact": goal.get("roadmap_impact", {}),
        "runtime_limit_minutes": goal["runtime_limit_minutes"],
        "execution_attempt": goal["execution_attempt"],
        "required_checks": config.get("validation_commands", []) + goal.get("required_checks", []),
        "required_security_checks": config.get("security_commands", []),
        "documentation_map": config.get("documentation_map", {}),
        "visual_evidence_mode": config.get("visual_evidence_mode", "when-applicable"),
        "project_instructions": config.get("project_instructions", []),
        "behavior_configuration_hash": config.get("behavior_configuration_hash"),
        "behavior_skill_path": config.get("behavior_skill_path", BEHAVIOR_SKILL_PATH),
        "assurance_standard_version": ASSURANCE_STANDARD_VERSION,
        "execution_mode": "interactive-fast" if fast_interactive else "standard",
        "remote_lease": {
            key: active_lease.get(key)
            for key in ("goal_id", "attempt_id", "owner_fingerprint", "lease_commit", "bound_run_id", "bound_task_id")
            if active_lease is not None and active_lease.get(key) is not None
        },
        "deadline": (now(config) + dt.timedelta(minutes=goal["runtime_limit_minutes"])).isoformat(timespec="seconds"),
    }
    json_dump(directory / "dispatch.json", prompt)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {"at": stamp, "event": "goal.dispatched", "goal_id": goal["goal_id"], "plan_version": goal["plan_version"]},
    )
    return prompt


def goal_gate(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    compliance = json_load(directory / "compliance.json", {})
    if compliance.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Compliance ledger uses a missing or unsupported assurance standard")
    if args.stage not in COMPLIANCE_STAGES:
        raise ContinuityError(f"Unknown compliance stage: {args.stage}")
    if args.status not in COMPLIANCE_STATUSES:
        raise ContinuityError(f"Invalid compliance status: {args.status}")
    if args.status in {"passed", "failed", "not-applicable"} and not args.evidence:
        raise ContinuityError("Non-pending compliance states require evidence")
    if args.stage == "product-conformance" and args.status == "passed":
        raise ContinuityError(
            "Pass product-conformance only through `continuity audit record --update-gate`; "
            "use not-applicable with evidence for a genuinely non-product goal"
        )
    if goal.get("state") in TERMINAL_STATES and args.stage != "human-review":
        raise ContinuityError("Only human-review evidence may be added after a goal becomes terminal")
    stamp = iso_now(config)
    compliance.setdefault("stages", {})[args.stage] = {
        "status": args.status,
        "evidence": args.evidence or [],
        "actor": args.actor,
        "updated_at": stamp,
    }
    compliance["updated_at"] = stamp
    json_dump(directory / "compliance.json", compliance)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": stamp,
            "event": "goal.compliance",
            "goal_id": args.goal_id,
            "plan_version": goal.get("plan_version"),
            "stage": args.stage,
            "status": args.status,
        },
    )
    return compliance["stages"][args.stage]


def goal_transition(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    transition = args.transition
    current = goal.get("state")
    if transition == "hold":
        if current not in {"awaiting-feedback", "queued"}:
            raise ContinuityError(f"Goal in state {current} cannot be held")
        goal["held_from"] = current
        target = "held"
    elif transition == "resume":
        if current == "held":
            target = goal.pop("held_from", None)
            if target not in {"awaiting-feedback", "queued"}:
                raise ContinuityError("Held goal has no valid prior state")
        elif current in REWORK_STATES:
            if not args.authorization_text:
                raise ContinuityError("Resuming execution requires explicit human authorization")
            expected = re.compile(
                rf"\b{re.escape(goal['goal_id'])}\b.*\bplan\s+v{goal['plan_version']}\b",
                re.IGNORECASE,
            )
            if not expected.search(args.authorization_text):
                raise ContinuityError("Resume authorization must name the goal ID and approved plan version")
            _approved_goal, _approval = validate_approval(root, config, args.goal_id)
            signing_key = getattr(args, "signing_key", None)
            if config.get("require_signed_approvals", False):
                if not signing_key:
                    raise ContinuityError("This project requires a signed human resume authorization")
                if not Path(signing_key).expanduser().resolve().is_file():
                    raise ContinuityError("Resume authorization signing key is unavailable")
                verify_approval_trust_anchor(root, config)
            if current != "changes-requested":
                reset_execution_evidence(
                    directory,
                    goal,
                    config,
                    f"Execution attempt reopened from {current}: {args.authorization_text}",
                    args.actor,
                )
                goal["updated_at"] = iso_now(config)
                json_dump(directory / "goal.json", goal)
            resume_receipt = record_signed_resume_authorization(
                root,
                config,
                directory,
                goal,
                current,
                args.actor,
                args.authorization_text,
                signing_key,
            )
            preflight = execution_preflight(argparse.Namespace(goal_id=args.goal_id))
            if not preflight["passed"]:
                raise ContinuityError(f"Cannot resume; execution preflight failed: {preflight['failures']}")
            target = "queued"
            goal["scheduled_for"] = parse_schedule(args.schedule, config) if args.schedule else next_default_start(config)
            append_jsonl(
                directory / "feedback.jsonl",
                {
                    "at": iso_now(config),
                    "author": args.actor,
                    "type": "resume-authorization",
                    "text": args.authorization_text,
                    "receipt_hash": canonical_hash(resume_receipt_payload(resume_receipt)),
                },
            )
        else:
            raise ContinuityError(f"Goal in state {current} cannot be resumed")
        if target == "queued":
            approval = json_load(directory / "approval.json", {})
            if (
                not isinstance(approval, dict)
                or approval.get("plan_version") != goal.get("plan_version")
                or approval.get("plan_hash") != goal_material_hash(directory, goal)
            ):
                raise ContinuityError("Held goal approval is missing or stale")
    else:
        if current not in {"proposed-plan", "awaiting-feedback", "approved", "queued", "held", "review-ready", *REWORK_STATES}:
            raise ContinuityError("Active execution must be stopped before recording cancellation")
        if current == "review-ready" and not getattr(args, "reason", None):
            raise ContinuityError("Cancelling review-ready work requires --reason")
        target = "cancelled"
    stamp = iso_now(config)
    lock_path = private_path(root, config) / "project.lock.json"
    lock = json_load(lock_path)
    if isinstance(lock, dict) and lock.get("goal_id") == args.goal_id:
        raise ContinuityError("Pre-execution transition found an active project lock; use run update after stopping the executor")
    goal["state"] = target
    goal["updated_at"] = stamp
    if transition == "resume" and target == "queued" and not goal.get("scheduled_for"):
        goal["scheduled_for"] = next_default_start(config)
    json_dump(directory / "goal.json", goal)
    update_note_goal_links(root, config, goal.get("source_note_ids", []), args.goal_id, target)
    if transition == "cancel" and current == "review-ready":
        actor = getattr(args, "actor", "human")
        reason = str(args.reason)
        capture = capture_goal_feedback(root, config, args.goal_id, "closed", [reason], actor)
        review = {
            "project_id": config["project_id"],
            "goal_id": args.goal_id,
            "status": "closed",
            "updated_at": stamp,
            "actor": actor,
            "merged_by": actor,
            "pr_url": None,
            "merge_commit": None,
            "evidence": [reason],
            "review_evidence_current": False,
            "stale_evidence": ["review-ready goal cancelled without current delivery disposition evidence"],
            "feedback_capture_id": capture["capture_id"],
            "human_merge_required": True,
            "auto_merge_used": False,
        }
        json_dump(directory / "human-review.json", review)
        record_compliance_stage(root, config, directory, goal, "human-review", "passed", [reason], actor)
        append_jsonl(private_path(root, config) / "reports" / "human-reviews.jsonl", review)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {"at": stamp, "event": f"goal.{transition}", "goal_id": args.goal_id, "plan_version": goal.get("plan_version")},
    )
    return goal


def goal_feedback(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, _goal = load_goal(root, config, args.goal_id)
    event = {"at": iso_now(config), "author": args.author, "type": "feedback", "text": args.text}
    append_jsonl(directory / "feedback.jsonl", event)
    capture = capture_goal_feedback(
        root,
        config,
        args.goal_id,
        "feedback",
        [args.text],
        args.author,
        args.sentiment,
        args.perspective,
    )
    return {**event, "capture_id": capture["capture_id"], "note_ids": [item["item_id"] for item in capture["items"]]}


def capture_goal_feedback(
    root: Path,
    config: dict[str, Any],
    goal_id: str,
    disposition: str,
    evidence: list[str],
    actor: str,
    sentiment: str = "unknown",
    perspective: str = "unknown",
) -> dict[str, Any]:
    stamp = iso_now(config)
    _directory, linked_goal = load_goal(root, config, goal_id)
    link_state = {
        "merged": "completed",
        "changes-requested": "changes-requested",
        "closed": "cancelled",
    }.get(disposition, str(linked_goal.get("state", "review-ready")))
    text = "\n".join(value.strip() for value in evidence if value.strip()) or f"Human disposition: {disposition}"
    item_id = stable_id("note", goal_id, disposition, stamp, text)
    occurrence_type = "success" if disposition in {"approved", "merged"} else "feedback"
    capture_id = stable_id("capture", config["project_id"], goal_id, disposition, stamp)
    item = {
        "item_id": item_id,
        "kind": "context",
        "text": text,
        "created_at": stamp,
        "updated_at": stamp,
        "occurred_at": stamp,
        "perspective": perspective,
        "sentiment": sentiment,
        "occurrence_type": occurrence_type,
        "impact": "unknown",
        "confidence": "high",
        "actionability": "plan" if disposition == "changes-requested" else "context",
        "stakeholders": [actor],
        "themes": ["human-review", disposition],
        "routing_status": "captured",
        "routing_work_status": "open",
        "work_status": NOTE_GOAL_STATUS_MAP.get(link_state, "open"),
        "related_goal_ids": [goal_id],
        "goal_links": {goal_id: {"state": link_state, "updated_at": stamp}},
        "execution_authorized": False,
    }
    capture = {
        "schema_version": SCHEMA_VERSION,
        "capture_id": capture_id,
        "captured_at": stamp,
        "project_id": config["project_id"],
        "repository": str(root),
        "source_type": "goal-feedback",
        "source_ref": f"goal:{goal_id}:{disposition}",
        "source_timestamp": stamp,
        "dedupe_key": canonical_hash({"goal_id": goal_id, "disposition": disposition, "at": stamp, "text": text}),
        "execution_authorized": False,
        "items": [item],
    }
    target = private_path(root, config) / "captures" / stamp[:10] / f"{capture_id}.json"
    json_dump(target, capture)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {"at": stamp, "event": "goal.feedback-captured", "goal_id": goal_id, "disposition": disposition, "capture_id": capture_id},
    )
    return capture


def goal_list(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    values = []
    for path in sorted((private_path(root, config) / "goals").glob("*/goal.json")):
        goal = json_load(path)
        if args.state and goal.get("state") != args.state:
            continue
        values.append(goal)
    return values


def goal_due(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    current = now(config)
    due = []
    for goal in goal_list(argparse.Namespace(state="queued")):
        scheduled_text = goal.get("scheduled_for")
        if not scheduled_text:
            continue
        try:
            scheduled = dt.datetime.fromisoformat(scheduled_text)
        except (TypeError, ValueError):
            continue
        if scheduled.tzinfo is None:
            scheduled = scheduled.replace(tzinfo=ZoneInfo(config["timezone"]))
        if scheduled <= current:
            states = dependency_states(root, config, goal)
            goal["dependency_states"] = states
            if all(state == "completed" for state in states.values()):
                due.append(goal)
    return due


def workflow_action(
    disposition: str,
    skill: str,
    command: str,
    *,
    human_required: bool = False,
    requirements: list[str] | None = None,
) -> dict[str, Any]:
    return {
        "disposition": disposition,
        "skill": skill,
        "command": command,
        "human_required": human_required,
        "requirements": requirements or [],
    }


def blocked_workflow_action(action: dict[str, Any], failures: Iterable[str]) -> dict[str, Any]:
    return {**action, "blocked_by": list(failures)}


def structured_contains_identifier(value: Any, identifier: str) -> bool:
    if isinstance(value, dict):
        return any(structured_contains_identifier(item, identifier) for item in value.values())
    if isinstance(value, list):
        return any(structured_contains_identifier(item, identifier) for item in value)
    return isinstance(value, str) and value == identifier


def workflow_handoff_envelope(
    *,
    stage: str,
    subject_ids: dict[str, Any],
    inputs_used: list[str],
    outputs_created: list[str],
    decisions: list[dict[str, Any]],
    evidence: dict[str, Any],
    blockers: list[str],
    next_skill: str | None,
    allowed_actions: list[dict[str, Any]],
    execution_authorized: bool,
    blocked_actions: list[dict[str, Any]] | None = None,
    human_requirements: list[str] | None = None,
) -> dict[str, Any]:
    required_human_actions = human_requirements or [
        str(action.get("disposition"))
        for action in allowed_actions
        if action.get("human_required")
    ]
    return {
        "schema_version": 1,
        "stage": stage,
        "subject_ids": subject_ids,
        "inputs_used": inputs_used,
        "outputs_created": outputs_created,
        "decisions": decisions,
        "evidence": evidence,
        "blockers": blockers,
        "authorization": {
            "execution_authorized": execution_authorized,
            "human_required": bool(required_human_actions),
        },
        "next_skill": next_skill,
        "allowed_actions": allowed_actions,
        "blocked_actions": blocked_actions or [],
        "human_requirements": required_human_actions,
    }


def note_planning_disposition(item: dict[str, Any]) -> str:
    links = item.get("goal_links", {})
    if not isinstance(links, dict):
        return "not-considered"
    live_links = [
        link
        for link in links.values()
        if isinstance(link, dict) and link.get("state") != "unlinked"
    ]
    if any(
        note_link_disposition(link) == "current-goal" and link.get("state") not in {"completed", "cancelled"}
        for link in live_links
    ):
        return "current-goal"
    dispositions = [note_link_disposition(link) for link in live_links]
    for value in ("later", "current-goal", "context-only", "duplicate"):
        if value in dispositions:
            return value
    return "not-considered"


def goal_stage_entered_at(root: Path, config: dict[str, Any], goal: dict[str, Any], workflow: dict[str, Any]) -> str | None:
    directory = goal_dir(root, config, str(goal["goal_id"]))
    execution = json_load(directory / "execution.json", {})
    test_report = json_load(directory / "test-report.json", {})
    merge_report = json_load(directory / "merge-assessment.json", {})
    human_review = json_load(directory / "human-review.json", {})
    stage = workflow.get("current_stage")
    candidates = {
        "plan-review": [goal.get("updated_at"), goal.get("created_at")],
        "held": [goal.get("updated_at")],
        "dispatch-ready": [goal.get("updated_at")],
        "execution-start": [goal.get("dispatched_at"), goal.get("updated_at")],
        "implementation": [execution.get("started_at"), execution.get("updated_at")],
        "quality-gates": [test_report.get("updated_at"), execution.get("updated_at")],
        "merge-safety": [merge_report.get("updated_at"), test_report.get("updated_at")],
        "review-ready-transition": [merge_report.get("updated_at"), test_report.get("updated_at")],
        "human-review": [execution.get("review_ready_at"), goal.get("updated_at")],
        "human-remediation": [human_review.get("updated_at"), goal.get("updated_at")],
        "completed": [goal.get("completed_at"), human_review.get("updated_at"), goal.get("updated_at")],
        "cancelled": [human_review.get("updated_at"), goal.get("updated_at")],
    }.get(str(stage), [goal.get("updated_at"), goal.get("created_at")])
    valid = [str(value) for value in candidates if value]
    return valid[0] if valid else None


def note_goal_tracks(root: Path, config: dict[str, Any], item: dict[str, Any]) -> list[dict[str, Any]]:
    tracks: list[dict[str, Any]] = []
    links = item.get("goal_links", {})
    if not isinstance(links, dict):
        return tracks
    for goal_id, link in sorted(links.items()):
        if not isinstance(link, dict) or link.get("state") == "unlinked":
            continue
        goal = json_load(goal_dir(root, config, str(goal_id)) / "goal.json", {})
        if not isinstance(goal, dict) or not goal.get("goal_id"):
            tracks.append(
                {
                    "goal_id": goal_id,
                    "goal_state": link.get("state"),
                    "current_stage": "missing-goal",
                    "stage_entered_at": link.get("updated_at"),
                    "disposition": note_link_disposition(link),
                    "reason": link.get("reason"),
                    "plan_version": link.get("plan_version"),
                    "decided_at": link.get("decided_at"),
                    "updated_at": link.get("updated_at"),
                    "blockers": ["linked goal record is missing"],
                    "next_skill": "continuity-report",
                }
            )
            continue
        workflow = workflow_status_for_goal(root, config, goal)
        tracks.append(
            {
                "goal_id": goal_id,
                "goal_state": goal.get("state"),
                "current_stage": workflow.get("current_stage"),
                "stage_entered_at": goal_stage_entered_at(root, config, goal, workflow),
                "disposition": note_link_disposition(link),
                "reason": link.get("reason"),
                "plan_version": link.get("plan_version") or goal.get("plan_version"),
                "decided_at": link.get("decided_at"),
                "updated_at": link.get("updated_at"),
                "review_after": link.get("review_after"),
                "roadmap_id": link.get("roadmap_id"),
                "canonical_note_id": link.get("canonical_note_id"),
                "delivery_slice_ids": list(link.get("delivery_slice_ids", [])),
                "blockers": workflow.get("blockers", []),
                "next_skill": workflow.get("next_skill"),
                "allowed_actions": workflow.get("allowed_actions", []),
            }
        )
    return tracks


def note_timeline(
    root: Path,
    config: dict[str, Any],
    capture: dict[str, Any],
    item: dict[str, Any],
    goal_tracks: list[dict[str, Any]],
    *,
    events: Iterable[dict[str, Any]] | None = None,
) -> list[dict[str, Any]]:
    note_id = str(item["item_id"])
    capture_id = str(capture["capture_id"])
    by_goal = {str(track["goal_id"]): track for track in goal_tracks}
    timeline: list[dict[str, Any]] = []
    event_records = events if events is not None else iter_jsonl(private_path(root, config) / "events.jsonl")
    for event in event_records:
        event_name = str(event.get("event", ""))
        goal_id = str(event.get("goal_id")) if event.get("goal_id") else None
        track = by_goal.get(goal_id or "", {})
        is_note_link_event = event_name in {"note.goal-link", "note.related"}
        is_goal_lifecycle_event = bool(goal_id and goal_id in by_goal and not is_note_link_event)
        if is_goal_lifecycle_event:
            if track.get("disposition") != "current-goal":
                continue
            event_at = parse_recorded_time(event.get("at"), config["timezone"])
            decided_at = parse_recorded_time(track.get("decided_at"), config["timezone"])
            if event_at is None or (decided_at is not None and event_at < decided_at):
                continue
            event_plan_version = event.get("plan_version")
            track_plan_version = track.get("plan_version")
            if event_plan_version is not None and track_plan_version is not None and event_plan_version != track_plan_version:
                continue
        relevant = (
            (event.get("item_id") == note_id)
            or (event_name == "capture.created" and event.get("capture_id") == capture_id)
            or (is_goal_lifecycle_event and goal_id in by_goal if goal_id else False)
            or (
                event_name == "note.goal-link"
                and any(isinstance(value, dict) and value.get("item_id") == note_id for value in event.get("items", []))
            )
        )
        if not relevant or not event.get("at"):
            continue
        stage = None
        linked_item: dict[str, Any] = {}
        status = event.get("status") or event.get("state") or event.get("work_status")
        if event_name == "capture.created":
            stage = "triage-needed"
        elif event_name == "note.related":
            stage = {
                "later": "planned-later",
                "context-only": "context-only",
                "duplicate": "duplicate",
                "current-goal": "plan-review",
            }.get(str(event.get("disposition")), "planning-disposition")
        elif event_name.startswith("note.") and event_name not in {"note.goal-link", "note.goal-links-migrated"}:
            stage = "note-resolved" if event_name == "note.resolved" else "triage-routed"
        elif event_name == "note.goal-link":
            linked_item = next(
                (
                    value
                    for value in event.get("items", [])
                    if isinstance(value, dict) and value.get("item_id") == note_id
                ),
                {},
            )
            stage = {
                "later": "planned-later",
                "context-only": "context-only",
                "duplicate": "duplicate",
                "current-goal": "plan-review",
                None: "plan-review",
            }.get(linked_item.get("disposition"), "plan-review")
        elif event_name in {"note.goal-links-migrated", "goal.created", "goal.revised"}:
            stage = "plan-review"
        elif event_name in {"goal.approved", "goal.resume"}:
            stage = "dispatch-ready"
        elif event_name == "goal.dispatched":
            stage = "execution-start"
        elif event_name == "run.running":
            stage = "implementation"
        elif event_name == "run.validating":
            stage = "quality-gates"
        elif event_name == "test.report":
            stage = "merge-safety" if status == "passed" else "quality-gates"
        elif event_name == "merge.assess":
            stage = "review-ready-transition" if status == "passed" else "merge-safety"
        elif event_name == "run.review-ready":
            stage = "human-review"
        elif event_name in {"run.blocked", "run.partially-completed"}:
            stage = "human-remediation"
        elif event_name in {"run.cancelled", "goal.cancel"}:
            stage = "cancelled"
        elif event_name == "merge.human-review":
            stage = {
                "merged": "completed",
                "closed": "cancelled",
                "changes-requested": "human-remediation",
                "approved": "human-review",
            }.get(str(status), "human-review")
        if not stage:
            continue
        timeline.append(
            {
                "at": event["at"],
                "stage": stage,
                "event": event_name,
                "goal_id": goal_id,
                "plan_version": event.get("plan_version") or linked_item.get("plan_version") or track.get("plan_version"),
                "disposition": event.get("disposition") or linked_item.get("disposition") or track.get("disposition"),
                "actor": event.get("actor"),
                "status": status,
            }
        )
    timeline.sort(key=lambda value: (str(value["at"]), str(value["event"]), str(value.get("goal_id") or "")))
    return timeline


def note_workflow_status(
    root: Path,
    config: dict[str, Any],
    capture: dict[str, Any],
    item: dict[str, Any],
    *,
    candidate_goals: Iterable[dict[str, Any]] | None = None,
    include_timeline: bool = True,
) -> dict[str, Any]:
    capture_id = str(capture["capture_id"])
    note_id = str(item["item_id"])
    routing_status = str(item.get("routing_status", "captured"))
    work_status = str(item.get("work_status", "open"))
    queue = item.get("queue")
    if routing_status in {"route", "defer", "promote"}:
        queue = route_for_kind(str(item.get("kind")))
    prefix = '.agents/continuity/bin/continuity --project-root "$PWD"'
    actions: list[dict[str, Any]] = []
    blockers: list[str] = []
    outputs = [f"capture:{capture_id}", f"note:{note_id}"]
    stage = "capture-review"
    next_skill: str | None = "continuity-triage"

    links = item.get("goal_links", {})
    planning_disposition = note_planning_disposition(item)
    goal_tracks = note_goal_tracks(root, config, item)
    active_goal_tracks = [
        track
        for track in goal_tracks
        if track.get("disposition") == "current-goal" and track.get("goal_state") not in {"completed", "cancelled"}
    ]
    relationship_candidates = (
        []
        if planning_disposition == "current-goal"
        else [
            candidate
            for candidate in related_goal_candidates(
                root,
                config,
                item,
                limit=10,
                min_score=RELATED_GOAL_DEFAULT_MIN_SCORE,
                goals=candidate_goals,
            )
            if not candidate.get("already_linked")
        ][:5]
    )

    if active_goal_tracks and work_status not in {"completed", "cancelled", "archived", "not-applicable"}:
        goal_stages = sorted({str(value["current_stage"]) for value in active_goal_tracks if value.get("current_stage")})
        stage = goal_stages[0] if len(goal_stages) == 1 else "multi-goal"
        goal_next_skills = sorted({value["next_skill"] for value in active_goal_tracks if value.get("next_skill")})
        next_skill = goal_next_skills[0] if len(goal_next_skills) == 1 else "continuity-report"
        blockers.extend(
            f"{value['goal_id']}: {blocker}"
            for value in active_goal_tracks
            for blocker in value.get("blockers", [])
        )
        actions.extend(action for value in active_goal_tracks for action in value.get("allowed_actions", []))
    elif work_status == "completed":
        stage = "completed"
        next_skill = "continuity-report"
    elif work_status == "cancelled":
        stage = "cancelled"
        next_skill = "continuity-report"
    elif planning_disposition == "later":
        due = [value for value in goal_tracks if value.get("disposition") == "later" and note_later_is_due(value, now(config))]
        if due and queue:
            stage = f"{queue}-ready"
        else:
            stage = "planned-later"
            next_skill = "continuity-report"
            anchors = [
                value.get("review_after") or (f"roadmap:{value['roadmap_id']}" if value.get("roadmap_id") else None)
                for value in goal_tracks
                if value.get("disposition") == "later"
            ]
            blockers.append(f"later work is held until {', '.join(str(value) for value in anchors if value)}")
    elif planning_disposition == "context-only":
        stage = "context-only"
        next_skill = "continuity-memory" if queue in {"knowledge", "documentation"} else "continuity-report"
    elif planning_disposition == "duplicate":
        stage = "duplicate"
        next_skill = "continuity-report"
    elif routing_status == "captured":
        actions.append(
            workflow_action(
                "triage",
                "continuity-triage",
                f"{prefix} note triage {capture_id} {note_id} --kind <kind> --action <route|defer|archive|promote>",
            )
        )
    elif routing_status == "archive" or work_status in {"archived", "not-applicable"}:
        stage = "archived"
        next_skill = "continuity-report"
    elif routing_status == "defer" and work_status == "deferred":
        review_after = parse_recorded_time(item.get("review_after"), config["timezone"])
        if review_after is not None and review_after > now(config):
            stage = "deferred"
            next_skill = "continuity-report"
            blockers.append(f"deferred until {item.get('review_after')}")
        else:
            stage = f"{queue}-ready"
    else:
        stage = f"{queue}-ready" if queue else "triage-review"

    if not actions and not blockers and stage.endswith("-ready") and queue:
        next_skill = {
            "knowledge": "continuity-memory",
            "documentation": "continuity-memory",
            "questions": "continuity-triage",
            "backlog": "continuity-plan",
            "planning": "continuity-plan",
        }[str(queue)]
        actions.append(
            workflow_action(
                f"review-{queue}",
                next_skill,
                f"{prefix} note queue --queue {queue}",
            )
        )
    if relationship_candidates and not any(action.get("disposition") == "inspect-related-goals" for action in actions):
        actions.append(
            workflow_action(
                "inspect-related-goals",
                "continuity-triage",
                f"{prefix} note related-goals {note_id}",
            )
        )

    timeline = note_timeline(root, config, capture, item, goal_tracks) if include_timeline else []
    matching_stage_events = [value for value in timeline if value.get("stage") == stage]
    track_stage_times = [
        str(value["stage_entered_at"])
        for value in active_goal_tracks
        if value.get("current_stage") == stage and value.get("stage_entered_at")
    ]
    stage_entered_at = track_stage_times[-1] if track_stage_times else (
        str(matching_stage_events[-1]["at"]) if matching_stage_events else str(item.get("updated_at") or capture.get("captured_at"))
    )
    lifecycle = {
        "summary_status": work_status,
        "current_stage": stage,
        "stage_entered_at": stage_entered_at,
        "routing": {"status": routing_status, "queue": queue, "review_after": item.get("review_after")},
        "planning_disposition": planning_disposition,
        "goal_tracks": goal_tracks,
        "relationship_candidates": relationship_candidates,
        "timeline": timeline,
    }
    evidence = {
        "kind": item.get("kind"),
        "routing_status": routing_status,
        "queue": queue,
        "work_status": work_status,
        "occurred_at": item.get("occurred_at"),
        "occurred_at_confidence": item.get("occurred_at_confidence", "unknown"),
        "goal_links": links if isinstance(links, dict) else {},
        "goal_tracks": goal_tracks,
        "lifecycle": lifecycle,
    }
    decisions = [
        {"type": "classification", "value": item.get("kind")},
        {"type": "routing", "value": routing_status, "queue": queue},
    ]
    handoff = workflow_handoff_envelope(
        stage=stage,
        subject_ids={"capture_id": capture_id, "note_id": note_id},
        inputs_used=[f"capture:{capture_id}"],
        outputs_created=outputs,
        decisions=decisions,
        evidence=evidence,
        blockers=blockers,
        next_skill=next_skill,
        allowed_actions=actions,
        execution_authorized=False,
    )
    return {
        "note_id": note_id,
        "capture_id": capture_id,
        "current_stage": stage,
        "next_skill": next_skill,
        "blockers": blockers,
        "allowed_actions": actions,
        "lifecycle": lifecycle,
        "execution_authorized": False,
        "handoff": handoff,
    }


def capture_workflow_status(root: Path, config: dict[str, Any], capture: dict[str, Any]) -> dict[str, Any]:
    items = [
        note_workflow_status(root, config, capture, {**item, "work_status": derived_note_work_status(item, now(config))})
        for item in capture.get("items", [])
        if isinstance(item, dict)
    ]
    next_skills = sorted({item["next_skill"] for item in items if item.get("next_skill")})
    has_capture_review = any(item["current_stage"] == "capture-review" for item in items)
    next_skill = "continuity-triage" if has_capture_review else (next_skills[0] if len(next_skills) == 1 else "continuity-report")
    blockers = [f"{item['note_id']}: {blocker}" for item in items for blocker in item.get("blockers", [])]
    actions = [action for item in items for action in item.get("allowed_actions", [])]
    capture_id = str(capture["capture_id"])
    stage = "capture-review" if has_capture_review else "capture-routed"
    document_evidence = {
        key: capture.get(key)
        for key in (
            "document_id",
            "document_type",
            "document_title",
            "document_version",
            "document_revision",
            "source_authority",
            "source_ref",
            "source_hash",
            "raw_snapshot_ref",
            "previous_capture_id",
            "document_memory_id",
            "revision_counts",
        )
        if capture.get(key) is not None
    }
    subject_ids: dict[str, Any] = {"capture_id": capture_id, "note_ids": [item["note_id"] for item in items]}
    if capture.get("document_id"):
        subject_ids["document_id"] = capture["document_id"]
    handoff = workflow_handoff_envelope(
        stage=stage,
        subject_ids=subject_ids,
        inputs_used=[f"capture:{capture_id}", *([f"source-hash:{capture['source_hash']}"] if capture.get("source_hash") else [])],
        outputs_created=[f"note:{item['note_id']}" for item in items],
        decisions=[{"type": "item-routing", "note_id": item["note_id"], "stage": item["current_stage"]} for item in items],
        evidence={"captured_at": capture.get("captured_at"), "item_count": len(items), "item_handoffs": items, **document_evidence},
        blockers=blockers,
        next_skill=next_skill,
        allowed_actions=actions,
        execution_authorized=False,
    )
    return {
        "capture_id": capture_id,
        "current_stage": stage,
        "next_skill": next_skill,
        "next_skills": next_skills,
        "blockers": blockers,
        "items": items,
        **document_evidence,
        "execution_authorized": False,
        "handoff": handoff,
    }


def workflow_status_for_goal(root: Path, config: dict[str, Any], goal: dict[str, Any]) -> dict[str, Any]:
    goal_id = goal["goal_id"]
    directory = goal_dir(root, config, goal_id)
    state = str(goal.get("state"))
    compliance = json_load(directory / "compliance.json", {})
    stages = compliance.get("stages", {}) if isinstance(compliance, dict) else {}
    failed = sorted(stage for stage, detail in stages.items() if detail.get("status") == "failed")
    pending = sorted(stage for stage, detail in stages.items() if detail.get("status") == "pending")
    completed = sorted(stage for stage, detail in stages.items() if detail.get("status") in {"passed", "not-applicable"})
    test_report = json_load(directory / "test-report.json", {})
    merge_report = json_load(directory / "merge-assessment.json", {})
    execution = json_load(directory / "execution.json", {})
    actions: list[dict[str, Any]] = []
    blocked_actions: list[dict[str, Any]] = []
    blockers: list[str] = []
    current_stage = state
    next_skill: str | None = None
    prefix = '.agents/continuity/bin/continuity --project-root "$PWD"'
    if state in LEGACY_GOAL_STATES:
        blockers.append(f"legacy goal state requires explicit migration: {state}")
        current_stage = "legacy-state"
        next_skill = "continuity-plan"
        actions.append(workflow_action("revise", "continuity-plan", f"{prefix} goal revise {goal_id} --goal-file <revision.json> --author <human> --summary <reason>", human_required=True))
    elif state == "awaiting-feedback":
        current_stage = "plan-review"
        fast_eligible = (
            goal.get("authorization_mode") == "goal-request"
            and goal.get("risk_level") == "routine"
            and not goal.get("restricted_side_effects")
        )
        proceed_eligible = goal.get("risk_level") == "routine" and not goal.get("restricted_side_effects")
        next_skill = "goal" if proceed_eligible else "continuity-dispatch"
        if fast_eligible:
            actions.append(
                workflow_action(
                    "activate",
                    "goal",
                    f"{prefix} goal activate {goal_id}",
                    requirements=["submitted /goal request", "decision-complete aligned plan", "routine interactive scope"],
                )
            )
        elif proceed_eligible:
            actions.append(
                workflow_action(
                    "proceed",
                    "goal",
                    f"{prefix} goal proceed {goal_id}",
                    requirements=["current user said proceed", "decision-complete aligned plan", "routine interactive scope"],
                )
            )
        else:
            actions.extend(
                [
                    workflow_action("approve", "continuity-dispatch", f'{prefix} goal approve {goal_id} --version {goal["plan_version"]} --approved-by <human> --authorization-text "Approve {goal_id} plan v{goal["plan_version"]}"' + (" --signing-key <ssh-private-key>" if config.get("require_signed_approvals", False) else ""), human_required=True, requirements=["decision-complete plan", "trusted SSH approver" if config.get("require_signed_approvals", False) else "recorded human identity"]),
                    workflow_action("revise", "continuity-plan", f"{prefix} goal revise {goal_id} --goal-file <revision.json> --author <human> --summary <reason>", human_required=True),
                    workflow_action("hold", "continuity-dispatch", f"{prefix} goal hold {goal_id}", human_required=True),
                    workflow_action("cancel", "continuity-dispatch", f"{prefix} goal cancel {goal_id}", human_required=True),
                ]
            )
    elif state == "held":
        current_stage = "held"
        next_skill = "continuity-dispatch"
        actions.extend(
            [
                workflow_action("resume", "continuity-dispatch", f"{prefix} goal resume {goal_id}", human_required=True),
                workflow_action("cancel", "continuity-dispatch", f"{prefix} goal cancel {goal_id}", human_required=True),
            ]
        )
    elif state == "queued":
        current_stage = "dispatch-ready"
        next_skill = "continuity-dispatch"
        start_action = workflow_action(
            "start-now",
            "continuity-dispatch",
            f"{prefix} goal start {goal_id}",
            human_required=True,
            requirements=["preflight passes", *( ["active remote goal-attempt lease"] if config.get("require_remote_lease", False) else [])],
        )
        if config.get("require_remote_lease", False):
            try:
                validate_active_remote_lease(root, config, goal_id, str(int(goal.get("execution_attempt", 1))))
            except ContinuityError as exc:
                blockers.append(str(exc))
                blocked_actions.append(blocked_workflow_action(start_action, [str(exc)]))
            else:
                actions.append(start_action)
        else:
            actions.append(start_action)
        actions.extend(
            [
                workflow_action("hold", "continuity-dispatch", f"{prefix} goal hold {goal_id}", human_required=True),
                workflow_action("cancel", "continuity-dispatch", f"{prefix} goal cancel {goal_id}", human_required=True),
            ]
        )
    elif state == "dispatched":
        current_stage = "execution-start"
        next_skill = "continuity-execute"
        actions.append(workflow_action("begin-execution", "continuity-execute", f"{prefix} run update {goal_id} --state running --worktree <worktree> --branch <branch>", requirements=["isolated worktree", "matching dispatch"] ))
    elif state == "running":
        current_stage = "implementation"
        next_skill = "continuity-execute"
        actions.append(workflow_action("continue", "continuity-execute", f"{prefix} execution checkpoint {goal_id} --phase <phase> --summary <summary> --alignment <alignment>"))
        actions.append(workflow_action("validate", "continuity-test", f"{prefix} run update {goal_id} --state validating"))
    elif state == "validating":
        if test_report.get("status") != "passed":
            current_stage = "quality-gates"
            next_skill = "continuity-test"
            actions.append(workflow_action("run-tests", "continuity-test", f"{prefix} test run {goal_id} --worktree <worktree> --branch <branch>"))
        elif (test_failures := current_test_evidence_failures(root, config, directory, goal)):
            current_stage = "quality-gates"
            next_skill = "continuity-test"
            blockers.extend(test_failures)
            actions.append(workflow_action("rerun-tests", "continuity-test", f"{prefix} test run {goal_id} --worktree <worktree> --branch <branch>"))
        elif stages.get("product-conformance", {}).get("status") not in {"passed", "not-applicable"}:
            current_stage = "product-conformance"
            next_skill = "continuity-product-audit"
            product_status = stages.get("product-conformance", {}).get("status", "missing")
            if product_status == "failed":
                blockers.append("product-conformance has current-goal mismatches")
            actions.extend(
                [
                    workflow_action(
                        "plan-product-audit",
                        "continuity-product-audit",
                        f"{prefix} audit plan --input <audit-input.json> --goal-id {goal_id}",
                        requirements=["candidate profile", "current approved sources", "representative journeys"],
                    ),
                    workflow_action(
                        "mark-not-applicable",
                        "continuity-product-audit",
                        f"{prefix} goal gate {goal_id} product-conformance --status not-applicable --evidence <reason>",
                        requirements=["goal has no user-observable product or documentation conformance impact"],
                    ),
                ]
            )
        elif (audit_failures := current_product_audit_evidence_failures(root, config, directory, goal)):
            current_stage = "product-conformance"
            next_skill = "continuity-product-audit"
            blockers.extend(audit_failures)
            actions.append(
                workflow_action(
                    "rerun-product-audit",
                    "continuity-product-audit",
                    f"{prefix} audit plan --input <audit-input.json> --goal-id {goal_id}",
                    requirements=["audit current source fingerprint"],
                )
            )
        elif merge_report.get("status") != "passed":
            current_stage = "merge-safety"
            next_skill = "continuity-merge"
            actions.append(workflow_action("assess-merge", "continuity-merge", f"{prefix} merge assess {goal_id} --worktree <worktree> --branch <branch> --pr-url <pr-url> --update-gate"))
        elif (review_failures := current_review_evidence_failures(root, config, directory, goal)):
            current_stage = "merge-safety"
            next_skill = "continuity-merge"
            blockers.extend(review_failures)
            actions.append(workflow_action("reassess-merge", "continuity-merge", f"{prefix} merge assess {goal_id} --worktree <worktree> --branch <branch> --pr-url <pr-url> --update-gate"))
        else:
            current_stage = "review-ready-transition"
            next_skill = "continuity-execute"
            actions.append(workflow_action("mark-review-ready", "continuity-execute", f"{prefix} run update {goal_id} --state review-ready --summary <summary> --pr-url <pr-url> --artifact <artifact>"))
    elif state == "review-ready":
        current_stage = "human-review"
        next_skill = "continuity-merge"
        common = f'{prefix} merge record-human {goal_id} --pr-url <pr-url> --merged-by <human> --evidence <evidence>' + (" --signing-key <ssh-private-key>" if config.get("require_signed_approvals", False) else "")
        disposition_actions = {
            "approved": workflow_action("approved", "continuity-merge", f"{common} --disposition approved", human_required=True),
            "changes-requested": workflow_action("changes-requested", "continuity-merge", f"{common} --disposition changes-requested", human_required=True),
            "merged": workflow_action("merged", "continuity-merge", f"{common} --disposition merged --merge-commit <sha>", human_required=True),
            "closed": workflow_action("closed", "continuity-merge", f"{common} --disposition closed", human_required=True),
        }
        stale_evidence = current_review_evidence_failures(root, config, directory, goal)
        actions.extend([disposition_actions["changes-requested"], disposition_actions["closed"]])
        if stale_evidence:
            blockers.extend(stale_evidence)
            blocked_actions.extend(
                blocked_workflow_action(disposition_actions[disposition], stale_evidence)
                for disposition in ("approved", "merged")
            )
        else:
            actions.extend([disposition_actions["approved"], disposition_actions["merged"]])
            if config.get("github_cli_merge_enabled", False):
                assessed_pr = merge_report.get("pr_url") or "<pr-url>"
                assessed_head = merge_report.get("head_sha") or "<full-head-sha>"
                actions.append(
                    workflow_action(
                        "execute-cli-merge",
                        "continuity-merge",
                        f'{prefix} merge execute {goal_id} --pr-url {assessed_pr} --head-sha {assessed_head} --merge-method <merge-method> --authorized-by <human> --authorization-text "Merge {goal_id} PR {assessed_pr} at {assessed_head} using <merge-method>"'
                        + (" --signing-key <ssh-private-key>" if config.get("require_signed_approvals", False) else ""),
                        human_required=True,
                        requirements=["exact interactive human authorization", "authenticated GitHub identity", "current checks and reviewer threshold"],
                    )
                )
    elif state in REWORK_STATES:
        current_stage = "human-remediation"
        next_skill = "continuity-dispatch"
        resume_action = workflow_action("resume-in-scope", "continuity-dispatch", f'{prefix} goal resume {goal_id} --authorization-text "Resume {goal_id} under approved plan v{goal["plan_version"]}" --actor <human>' + (" --signing-key <ssh-private-key>" if config.get("require_signed_approvals", False) else ""), human_required=True, requirements=["scope unchanged", "signed human authorization" if config.get("require_signed_approvals", False) else "recorded human authorization", "preflight passes"])
        try:
            validate_approval(root, config, goal_id)
        except ContinuityError as exc:
            blockers.append(str(exc))
            blocked_actions.append(blocked_workflow_action(resume_action, [str(exc)]))
        else:
            actions.append(resume_action)
        actions.extend(
            [
                workflow_action("revise-scope", "continuity-plan", f"{prefix} goal revise {goal_id} --goal-file <revision.json> --author <human> --summary <reason>", human_required=True),
                workflow_action("cancel", "continuity-dispatch", f"{prefix} goal cancel {goal_id}", human_required=True),
            ]
        )
    elif state == "completed":
        current_stage = "completed"
        next_skill = "continuity-report"
    elif state == "cancelled":
        current_stage = "cancelled"
        next_skill = "continuity-report"
    if failed:
        blockers.extend(f"failed compliance stage: {stage}" for stage in failed)
    prior_attempts = []
    for attempt_path in sorted((directory / "attempts").glob("attempt-*")):
        archive = json_load(attempt_path / "archive.json", {})
        prior_attempts.append(
            {
                "attempt": archive.get("attempt"),
                "reason": archive.get("reason"),
                "actor": archive.get("actor"),
                "archived_at": archive.get("archived_at"),
                "path": runtime_lib.project_relative_posix(attempt_path, root),
            }
        )
    evidence = {
        "plan_hash": goal.get("plan_hash"),
        "source_capture_refs": goal.get("source_capture_refs", []),
        "test_status": test_report.get("status") if isinstance(test_report, dict) else None,
        "test_evidence_hash": test_report.get("machine_evidence_hash") if isinstance(test_report, dict) else None,
        "product_audit": json_load(directory / "product-audit.json", {}),
        "merge_status": merge_report.get("status") if isinstance(merge_report, dict) else None,
        "pr_url": execution.get("pr_url") if isinstance(execution, dict) else None,
        "prior_attempts": prior_attempts,
    }
    handoff = workflow_handoff_envelope(
        stage=current_stage,
        subject_ids={"goal_id": goal_id},
        inputs_used=[
            *[f"note:{value}" for value in goal.get("source_note_ids", [])],
            *[f"capture:{value['capture_id']}@{value['source_hash']}" for value in goal.get("source_capture_refs", [])],
            *[f"memory:{value}" for value in goal.get("memory_ids", [])],
            *[f"roadmap:{value}" for value in goal.get("roadmap_ids", [])],
        ],
        outputs_created=[f"goal:{goal_id}", f"plan-hash:{goal.get('plan_hash')}"],
        decisions=[{"type": "goal-state", "value": state}],
        evidence=evidence,
        blockers=blockers,
        next_skill=next_skill,
        allowed_actions=actions,
        execution_authorized=state in {"dispatched", "running", "validating"},
        blocked_actions=blocked_actions,
    )
    return {
        "goal_id": goal_id,
        "title": goal.get("title"),
        "state": state,
        "current_stage": current_stage,
        "next_skill": next_skill,
        "blockers": blockers,
        "allowed_actions": actions,
        "blocked_actions": blocked_actions,
        "human_requirements": [action["disposition"] for action in actions if action["human_required"]],
        "completed_prerequisites": completed,
        "pending_compliance": pending,
        "failed_compliance": failed,
        "execution_attempt": int(goal.get("execution_attempt", 1)),
        "evidence": evidence,
        "handoff": handoff,
    }


def workflow_status(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    goals = goal_list(argparse.Namespace(state=None))
    if args.design_id:
        try:
            status = design_lib.workflow(root, config, args.design_id)
        except design_lib.DesignError as exc:
            raise ContinuityError(str(exc)) from exc
        return {"schema_version": 1, "project_id": config["project_id"], "generated_at": iso_now(config), "design": status}
    if args.audit_id:
        try:
            audit = product_audit_lib.workflow(root, config, args.audit_id)
        except product_audit_lib.ProductAuditError as exc:
            raise ContinuityError(str(exc)) from exc
        prefix = '.agents/continuity/bin/continuity --project-root "$PWD"'
        commands = {
            "start-audit": f"{prefix} audit start {args.audit_id} --worktree <worktree> --branch <branch>",
            "record-audit": f"{prefix} audit record {args.audit_id} --result-file <audit-result.json> --worktree <worktree> --branch <branch> --artifact <product-conformance.md> --update-gate",
            "capture-findings": f"{prefix} audit capture-findings {args.audit_id}",
            "triage-captured-findings": f"{prefix} workflow status",
            "compare-audits": f"{prefix} audit compare {args.audit_id} --against <prior-audit-id>",
            "report-audit": f"{prefix} audit show {args.audit_id}",
        }
        actions = [
            workflow_action(name, audit["next_skill"], commands[name])
            for name in audit["allowed_actions"]
        ]
        handoff = workflow_handoff_envelope(
            stage=f"product-audit-{audit['status']}",
            subject_ids={"audit_id": args.audit_id, "goal_id": audit.get("goal_id")},
            inputs_used=[f"audit:{args.audit_id}"],
            outputs_created=[f"result-hash:{audit['result_hash']}"] if audit.get("result_hash") else [],
            decisions=[{"type": "product-audit-status", "value": audit["status"]}],
            evidence={"finding_counts": audit["finding_counts"], "findings_capture": audit["findings_capture"]},
            blockers=[],
            next_skill=audit["next_skill"],
            allowed_actions=actions,
            execution_authorized=False,
        )
        return {
            "schema_version": 1,
            "project_id": config["project_id"],
            "generated_at": iso_now(config),
            "audit": {**audit, "allowed_actions": actions, "handoff": handoff},
        }
    if args.goal_id:
        matches = [goal for goal in goals if goal.get("goal_id") == args.goal_id]
        if len(matches) != 1:
            raise ContinuityError(f"Unknown goal {args.goal_id}")
        return {
            "schema_version": 1,
            "project_id": config["project_id"],
            "generated_at": iso_now(config),
            "goal": workflow_status_for_goal(root, config, matches[0]),
        }
    if args.capture_id:
        capture = json_load(find_capture(root, config, args.capture_id), {})
        return {
            "schema_version": 1,
            "project_id": config["project_id"],
            "generated_at": iso_now(config),
            "capture": capture_workflow_status(root, config, capture),
        }
    if args.note_id:
        _path, capture, item = find_note_item(root, config, args.note_id)
        return {
            "schema_version": 1,
            "project_id": config["project_id"],
            "generated_at": iso_now(config),
            "note": note_workflow_status(root, config, capture, item),
        }
    if args.memory_id:
        document_match = find_document_memory_capture(root, config, args.memory_id)
        if document_match is not None:
            capture_path, capture = document_match
            history = document_capture_history(root, config, str(capture["document_id"]))
            latest_revision = max(int(item.get("document_revision", 0)) for _path, item in history)
            is_current = int(capture.get("document_revision", 0)) == latest_revision
            scope = "trusted" if capture.get("source_authority") == "project-intent" else "private"
            blockers = [] if is_current else ["a newer source document revision exists"]
            next_skill = "continuity-plan" if is_current else "continuity-capture"
            prefix = '.agents/continuity/bin/continuity --project-root "$PWD"'
            actions = [
                workflow_action(
                    "retrieve-source-document",
                    "continuity-memory",
                    f'{prefix} memory search "{args.memory_id}" --scope {scope}',
                )
            ]
            evidence = {
                "path": f"{runtime_lib.project_relative_posix(capture_path, root)}#document",
                "title": capture.get("document_title"),
                "entry_type": f"source-document:{capture.get('document_type')}",
                "scope": scope,
                "status": "current" if is_current else "historical",
                "authority": capture.get("source_authority"),
                "capture_id": capture.get("capture_id"),
                "document_id": capture.get("document_id"),
                "document_revision": capture.get("document_revision"),
                "source_ref": capture.get("source_ref"),
                "source_hash": capture.get("source_hash"),
                "previous_capture_id": capture.get("previous_capture_id"),
            }
            handoff = workflow_handoff_envelope(
                stage="memory-current" if is_current else "memory-review",
                subject_ids={
                    "memory_id": args.memory_id,
                    "capture_id": capture.get("capture_id"),
                    "document_id": capture.get("document_id"),
                },
                inputs_used=[f"capture:{capture.get('capture_id')}", f"source-hash:{capture.get('source_hash')}"],
                outputs_created=[f"memory:{args.memory_id}"],
                decisions=[{"type": "document-memory-status", "value": evidence["status"]}],
                evidence=evidence,
                blockers=blockers,
                next_skill=next_skill,
                allowed_actions=actions,
                execution_authorized=False,
            )
            return {
                "schema_version": 1,
                "project_id": config["project_id"],
                "generated_at": iso_now(config),
                "memory": {
                    "memory_id": args.memory_id,
                    "current_stage": handoff["stage"],
                    "next_skill": next_skill,
                    "blockers": blockers,
                    "allowed_actions": actions,
                    "handoff": handoff,
                },
            }
        path = find_memory_entry(root, config, args.memory_id)
        metadata, _body, heading = parse_markdown(path)
        status = str(metadata.get("status", "proposed"))
        blockers = []
        next_skill = "continuity-plan"
        if status in {"proposed", "disputed", "superseded", "historical"}:
            next_skill = "continuity-memory"
            blockers.append(f"memory status is {status}; verify current applicability before planning")
        verified_at = parse_recorded_time(metadata.get("last_verified_at"), config["timezone"])
        stale_after = dt.timedelta(days=int(config.get("memory_stale_after_days", 90)))
        if verified_at is None:
            next_skill = "continuity-memory"
            blockers.append("memory verification time is missing or invalid")
        elif now(config) - verified_at > stale_after:
            next_skill = "continuity-memory"
            blockers.append(f"memory verification is older than {stale_after.days} days")
        prefix = '.agents/continuity/bin/continuity --project-root "$PWD"'
        actions = [
            workflow_action(
                "retrieve-memory",
                "continuity-memory",
                f'{prefix} memory search "{args.memory_id}" --scope trusted',
            )
        ]
        evidence = {
            "path": runtime_lib.project_relative_posix(path, root),
            "title": metadata.get("title") or heading,
            "status": status,
            "confidence": metadata.get("confidence"),
            "last_verified_at": metadata.get("last_verified_at"),
            "verified_against": metadata.get("verified_against"),
            "sources": metadata.get("sources", []),
            "unresolved_gaps": metadata.get("unresolved_gaps", []),
        }
        handoff = workflow_handoff_envelope(
            stage="memory-current" if status == "current" else "memory-review",
            subject_ids={"memory_id": args.memory_id},
            inputs_used=[str(value) for value in metadata.get("sources", [])],
            outputs_created=[f"memory:{args.memory_id}"],
            decisions=[{"type": "memory-status", "value": status}],
            evidence=evidence,
            blockers=blockers,
            next_skill=next_skill,
            allowed_actions=actions,
            execution_authorized=False,
        )
        return {
            "schema_version": 1,
            "project_id": config["project_id"],
            "generated_at": iso_now(config),
            "memory": {"memory_id": args.memory_id, "current_stage": handoff["stage"], "next_skill": next_skill, "blockers": blockers, "allowed_actions": actions, "handoff": handoff},
        }
    if args.roadmap_id:
        matches = [entry for entry in roadmap_lib.entries(root, config) if entry.get("roadmap_id") == args.roadmap_id]
        if len(matches) != 1:
            raise ContinuityError(f"Expected one roadmap entry {args.roadmap_id}; found {len(matches)}")
        entry = matches[0]
        audit = roadmap_lib.audit(root, config, persist=False)
        blockers = []
        for issue_type, issues in audit.items():
            if not isinstance(issues, list):
                continue
            for issue in issues:
                if structured_contains_identifier(issue, args.roadmap_id):
                    blockers.append(f"{issue_type}: {json.dumps(issue, sort_keys=True)}")
        next_skill = "continuity-roadmap" if blockers else "continuity-plan"
        prefix = '.agents/continuity/bin/continuity --project-root "$PWD"'
        actions = [workflow_action("retrieve-roadmap", "continuity-roadmap", f'{prefix} roadmap brief "{args.roadmap_id}"')]
        evidence = {
            "path": entry.get("path"),
            "title": entry.get("title"),
            "kind": entry.get("kind"),
            "status": entry.get("status"),
            "health": entry.get("health"),
            "parent_ids": entry.get("parent_ids", []),
            "depends_on": entry.get("depends_on", []),
            "memory_ids": entry.get("memory_ids", []),
        }
        handoff = workflow_handoff_envelope(
            stage="roadmap-review" if blockers else "roadmap-current",
            subject_ids={"roadmap_id": args.roadmap_id},
            inputs_used=[f"memory:{value}" for value in entry.get("memory_ids", [])],
            outputs_created=[f"roadmap:{args.roadmap_id}"],
            decisions=[{"type": "roadmap-state", "status": entry.get("status"), "health": entry.get("health")}],
            evidence=evidence,
            blockers=blockers,
            next_skill=next_skill,
            allowed_actions=actions,
            execution_authorized=False,
        )
        return {
            "schema_version": 1,
            "project_id": config["project_id"],
            "generated_at": iso_now(config),
            "roadmap": {"roadmap_id": args.roadmap_id, "current_stage": handoff["stage"], "next_skill": next_skill, "blockers": blockers, "allowed_actions": actions, "handoff": handoff},
        }
    if args.packet_id:
        packet = shared_notes_lib.status(root, config, args.packet_id)
        prefix = '.agents/continuity/bin/continuity --project-root "$PWD"'
        actions: list[dict[str, Any]] = []
        blocked_actions: list[dict[str, Any]] = []
        human_requirements: list[str] = []
        next_skill = "continuity-share"
        if packet["state"] == "prepared":
            actions.append(
                workflow_action(
                    "approve-packet",
                    "continuity-share",
                    f'{prefix} note share approve {packet["packet_id"]} --version {packet["version"]} --approved-by <human> --authorization-text "Approve {packet["packet_id"]} version {packet["version"]} for {packet["target_project_id"]}"' + (" --signing-key <ssh-private-key>" if config.get("require_signed_approvals", False) else ""),
                    human_required=True,
                )
            )
        elif packet["state"] == "approved":
            actions.append(workflow_action("publish-packet", "continuity-share", f"{prefix} note share publish {packet['packet_id']}"))
        elif packet["state"] == "published":
            human_requirements.append("human-reviewed packet PR merge")
        elif packet["state"] == "merged":
            actions.append(workflow_action("import-packets", "continuity-share", f"{prefix} note share import"))
        elif packet["state"] == "imported":
            next_skill = "continuity-triage"
            for record in packet.get("imports", []):
                for note_id in record.get("item_ids", []):
                    actions.append(
                        workflow_action(
                            "triage-imported-note",
                            "continuity-triage",
                            f"{prefix} workflow status --note-id {note_id}",
                        )
                    )
        if packet.get("blockers") and actions:
            blocked_actions = [blocked_workflow_action(action, packet["blockers"]) for action in actions]
            actions = []
        evidence = {
            "version": packet["version"],
            "content_hash": packet["content_hash"],
            "target_project_id": packet["target_project_id"],
            "approval_current": packet["approval_current"],
            "publication": packet.get("publication"),
            "committed_paths": packet.get("committed_paths", []),
            "imports": packet.get("imports", []),
        }
        imported_note_ids = [
            str(note_id)
            for record in packet.get("imports", [])
            for note_id in record.get("item_ids", [])
        ]
        handoff = workflow_handoff_envelope(
            stage=f"packet-{packet['state']}",
            subject_ids={"packet_id": packet["packet_id"], "source_note_ids": packet.get("note_ids", []), "imported_note_ids": imported_note_ids},
            inputs_used=[f"note:{value}" for value in packet.get("note_ids", [])],
            outputs_created=[f"packet:{packet['packet_id']}:v{packet['version']}"],
            decisions=[{"type": "packet-state", "value": packet["state"]}],
            evidence=evidence,
            blockers=packet.get("blockers", []),
            next_skill=next_skill,
            allowed_actions=actions,
            execution_authorized=False,
            blocked_actions=blocked_actions,
            human_requirements=human_requirements or None,
        )
        return {
            "schema_version": 1,
            "project_id": config["project_id"],
            "generated_at": iso_now(config),
            "packet": {
                **packet,
                "current_stage": handoff["stage"],
                "next_skill": next_skill,
                "allowed_actions": actions,
                "blocked_actions": blocked_actions,
                "human_requirements": handoff["human_requirements"],
                "handoff": handoff,
            },
        }
    queue_names = ("knowledge", "questions", "documentation", "backlog", "planning")
    queue_counts = {
        name: len(note_queue(argparse.Namespace(queue=name, status="eligible")))
        for name in queue_names
    }
    goal_records = [workflow_status_for_goal(root, config, goal) for goal in goals]
    goal_records.sort(key=lambda value: (value["state"], value["goal_id"]))
    if queue_counts["planning"] or queue_counts["backlog"]:
        next_skill = "continuity-plan"
    elif queue_counts["documentation"] or queue_counts["knowledge"]:
        next_skill = "continuity-memory"
    elif queue_counts["questions"]:
        next_skill = "continuity-triage"
    else:
        next_skill = "continuity-report"
    project_handoff = workflow_handoff_envelope(
        stage="project-routing",
        subject_ids={"project_id": config["project_id"]},
        inputs_used=[f"queue:{name}" for name in queue_names],
        outputs_created=[],
        decisions=[{"type": "queue-priority", "next_skill": next_skill}],
        evidence={"queue_counts": queue_counts, "goal_count": len(goal_records)},
        blockers=[],
        next_skill=next_skill,
        allowed_actions=[],
        execution_authorized=False,
    )
    return {
        "schema_version": 1,
        "project_id": config["project_id"],
        "generated_at": iso_now(config),
        "next_skill": next_skill,
        "queue_counts": queue_counts,
        "goals": goal_records,
        "legacy_goal_ids": [record["goal_id"] for record in goal_records if record["state"] in LEGACY_GOAL_STATES],
        "handoff": project_handoff,
    }


def record_compliance_stage(
    root: Path,
    config: dict[str, Any],
    directory: Path,
    goal: dict[str, Any],
    stage: str,
    status: str,
    evidence: list[str],
    actor: str,
) -> dict[str, Any]:
    if stage not in COMPLIANCE_STAGES:
        raise ContinuityError(f"Unknown compliance stage: {stage}")
    if status not in COMPLIANCE_STATUSES:
        raise ContinuityError(f"Invalid compliance status: {status}")
    if status in {"passed", "failed", "not-applicable"} and not evidence:
        raise ContinuityError("Non-pending compliance states require evidence")
    if goal.get("state") in TERMINAL_STATES and stage != "human-review":
        raise ContinuityError("Only human-review evidence may be added after a goal becomes terminal")
    stamp = iso_now(config)
    compliance = json_load(directory / "compliance.json", {})
    if compliance.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Compliance ledger uses a missing or unsupported assurance standard")
    compliance.setdefault("stages", {})[stage] = {
        "status": status,
        "evidence": evidence,
        "actor": actor,
        "updated_at": stamp,
    }
    compliance["updated_at"] = stamp
    json_dump(directory / "compliance.json", compliance)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": stamp,
            "event": "goal.compliance",
            "goal_id": goal["goal_id"],
            "plan_version": goal.get("plan_version"),
            "stage": stage,
            "status": status,
        },
    )
    return compliance["stages"][stage]


def goal_test_commands(config: dict[str, Any], goal: dict[str, Any] | None = None) -> list[str]:
    commands = list(config.get("validation_commands", []))
    if goal:
        commands.extend(goal.get("required_checks", []))
    seen: set[str] = set()
    ordered: list[str] = []
    for command in commands:
        if command not in seen:
            ordered.append(command)
            seen.add(command)
    return ordered


def worktree_source_snapshot(worktree: Path) -> dict[str, Any]:
    if not worktree.is_dir():
        raise ContinuityError(f"Test worktree is unavailable: {worktree}")
    head = git_result(worktree, "rev-parse", "HEAD")
    if head.returncode != 0:
        raise ContinuityError("Test worktree is not a Git repository")
    status = git_result(worktree, "status", "--porcelain=v1")
    diff = git_result(worktree, "diff", "--binary", "HEAD")
    untracked_result = git_result(worktree, "ls-files", "--others", "--exclude-standard", "-z")
    common_dir_result = git_result(worktree, "rev-parse", "--git-common-dir")
    branch_result = git_result(worktree, "rev-parse", "--abbrev-ref", "HEAD")
    if any(result.returncode != 0 for result in (status, diff, untracked_result, common_dir_result, branch_result)):
        raise ContinuityError("Unable to fingerprint the test worktree")
    excluded_fragments = (".continuity/private/", ".continuity-portfolio/", ".continuity-write.lock", ".continuity/state.lock", "__pycache__/")
    status_lines = [line for line in status.stdout.splitlines() if not any(value in line for value in excluded_fragments)]
    untracked: list[dict[str, str]] = []
    for relative in sorted(value for value in untracked_result.stdout.split("\0") if value):
        if any(value in relative for value in excluded_fragments):
            continue
        path = (worktree / relative).resolve()
        if path.is_file() and path.is_relative_to(worktree.resolve()):
            untracked.append({"path": relative, "sha256": hashlib.sha256(path.read_bytes()).hexdigest()})
    common_dir = Path(common_dir_result.stdout.strip())
    if not common_dir.is_absolute():
        common_dir = (worktree / common_dir).resolve()
    value = {
        "commit_sha": head.stdout.strip(),
        "branch": branch_result.stdout.strip(),
        "repository_fingerprint": hashlib.sha256(str(common_dir).encode()).hexdigest(),
        "status": "\n".join(status_lines),
        "diff_sha256": hashlib.sha256(diff.stdout.encode()).hexdigest(),
        "untracked": untracked,
    }
    value["source_fingerprint"] = canonical_hash(value)
    return value


def command_argv(command: str) -> list[str]:
    try:
        if os.name == "nt":
            import ctypes
            from ctypes import wintypes

            count = ctypes.c_int()
            shell = ctypes.WinDLL("shell32", use_last_error=True)
            kernel = ctypes.WinDLL("kernel32", use_last_error=True)
            shell.CommandLineToArgvW.argtypes = [wintypes.LPCWSTR, ctypes.POINTER(ctypes.c_int)]
            shell.CommandLineToArgvW.restype = ctypes.POINTER(wintypes.LPWSTR)
            kernel.LocalFree.argtypes = [ctypes.c_void_p]
            parsed = shell.CommandLineToArgvW(command, ctypes.byref(count))
            if not parsed:
                raise OSError(ctypes.get_last_error(), "CommandLineToArgvW failed")
            try:
                argv = [parsed[index] for index in range(count.value)]
            finally:
                kernel.LocalFree(parsed)
        else:
            argv = shlex.split(command)
    except (OSError, ValueError) as exc:
        raise ContinuityError(f"Invalid configured command: {command}") from exc
    if not argv:
        raise ContinuityError("Configured commands cannot be empty")
    shell_operators = {"|", "||", "&&", ";", ">", ">>", "<", "<<", "&"}
    if any(token in shell_operators for token in argv) or "=" in argv[0]:
        raise ContinuityError(f"Configured command must be a direct argv command without shell syntax: {command}")
    executable = Path(argv[0]).name.casefold()
    prohibited_shells = {
        "bash", "bash.exe", "cmd", "cmd.exe", "csh", "csh.exe", "fish", "fish.exe",
        "powershell", "powershell.exe", "pwsh", "pwsh.exe", "sh", "sh.exe", "tcsh", "tcsh.exe",
        "zsh", "zsh.exe",
    }
    if executable in prohibited_shells:
        raise ContinuityError(f"Configured validation and security commands cannot launch a command shell: {argv[0]}")
    if Path(executable).suffix in {".bat", ".cmd"}:
        raise ContinuityError(f"Configured validation and security commands cannot launch a shell script: {argv[0]}")
    sensitive_flags = {"--api-key", "--auth-token", "--password", "--private-key", "--secret", "--token"}
    for token in argv:
        option = token.casefold()
        if option in sensitive_flags or any(option.startswith(f"{flag}=") for flag in sensitive_flags):
            raise ContinuityError("Configured validation and security commands cannot contain inline credential arguments")
    return argv


def execute_evidence_command(command: str, worktree: Path, timeout_seconds: int) -> dict[str, Any]:
    argv = command_argv(command)
    if os.name == "nt":
        resolved = shutil.which(argv[0])
        if resolved and Path(resolved).suffix.casefold() in {".bat", ".cmd"}:
            raise ContinuityError(
                f"Configured validation and security commands must resolve to a native executable, not a shell script: {argv[0]}"
            )
    started = dt.datetime.now(dt.timezone.utc)
    try:
        result = runtime_lib.run_process_tree(
            argv,
            cwd=worktree,
            capture_output=True,
            text=True,
            timeout=max(1, timeout_seconds),
            check=False,
            env=runtime_lib.restricted_subprocess_environment({"PYTHONDONTWRITEBYTECODE": "1"}),
        )
        returncode = result.returncode
        stdout = runtime_lib.redact_sensitive_text(result.stdout[-20000:])
        stderr = runtime_lib.redact_sensitive_text(result.stderr[-20000:])
        timed_out = False
    except subprocess.TimeoutExpired as exc:
        returncode = 124
        stdout = runtime_lib.redact_sensitive_text((exc.stdout or "")[-20000:]) if isinstance(exc.stdout, str) else ""
        stderr = runtime_lib.redact_sensitive_text((exc.stderr or "")[-20000:]) if isinstance(exc.stderr, str) else ""
        timed_out = True
    finished = dt.datetime.now(dt.timezone.utc)
    return {
        "command": runtime_lib.redact_sensitive_text(command),
        "argv": [runtime_lib.redact_sensitive_text(value) for value in argv],
        "started_at": started.isoformat(timespec="seconds"),
        "finished_at": finished.isoformat(timespec="seconds"),
        "duration_seconds": round((finished - started).total_seconds(), 3),
        "returncode": returncode,
        "timed_out": timed_out,
        "stdout": stdout,
        "stderr": stderr,
        "passed": returncode == 0,
    }


def test_run(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if goal.get("state") not in {"running", "validating"}:
        raise ContinuityError("Machine tests may run only for a running or validating goal")
    execution = json_load(directory / "execution.json", {})
    recorded_worktree = execution.get("worktree") if isinstance(execution, dict) else None
    worktree = Path(args.worktree or recorded_worktree or root).expanduser().resolve()
    if recorded_worktree and worktree != Path(recorded_worktree).expanduser().resolve():
        raise ContinuityError("Test worktree does not match the goal execution record")
    before = worktree_source_snapshot(worktree)
    enrolled = worktree_source_snapshot(root)
    if before["repository_fingerprint"] != enrolled["repository_fingerprint"]:
        raise ContinuityError("Test worktree does not belong to the enrolled repository")
    recorded_branch = execution.get("branch") if isinstance(execution, dict) else None
    expected_branch = args.branch or recorded_branch
    if not expected_branch:
        raise ContinuityError("Test branch is missing from the goal execution record")
    if recorded_branch and args.branch and recorded_branch != args.branch:
        raise ContinuityError("Test branch does not match the goal execution record")
    if before["branch"] != expected_branch:
        raise ContinuityError(f"Test worktree is on {before['branch']}, not {expected_branch}")
    validation_commands = goal_test_commands(config, goal)
    security_commands = list(config.get("security_commands", []))
    results: list[dict[str, Any]] = []
    failures: list[str] = []
    if not validation_commands:
        failures.append("no configured validation commands")
    deadline = dt.datetime.now(dt.timezone.utc) + dt.timedelta(minutes=goal.get("runtime_limit_minutes", 360))
    for category, commands in (("validation", validation_commands), ("security", security_commands)):
        for command in commands:
            remaining = int((deadline - dt.datetime.now(dt.timezone.utc)).total_seconds())
            if remaining <= 0:
                failures.append("machine test runtime limit exhausted")
                break
            try:
                result = execute_evidence_command(command, worktree, remaining)
            except ContinuityError as exc:
                failures.append(str(exc))
                continue
            result["category"] = category
            results.append(result)
            if not result["passed"]:
                failures.append(f"{category} command failed: {command} (exit {result['returncode']})")
    after = worktree_source_snapshot(worktree)
    if before["source_fingerprint"] != after["source_fingerprint"]:
        failures.append("worktree changed while machine tests were running")
    report = {
        "schema_version": 1,
        "project_id": config["project_id"],
        "goal_id": args.goal_id,
        "status": "passed" if not failures else "failed",
        "actor": args.actor,
        "updated_at": iso_now(config),
        "worktree": str(worktree),
        "branch": before["branch"],
        "plan_hash": goal.get("plan_hash"),
        "behavior_configuration_hash": config.get("behavior_configuration_hash"),
        "commit_sha": after["commit_sha"],
        "repository_fingerprint": after["repository_fingerprint"],
        "source_fingerprint": after["source_fingerprint"],
        "validation_commands": validation_commands,
        "security_commands": security_commands,
        "results": results,
        "failures": failures,
    }
    report["evidence_hash"] = canonical_hash(report)
    json_dump(directory / "machine-test-run.json", report)
    append_jsonl(private_path(root, config) / "reports" / "machine-test-runs.jsonl", report)
    return report


def test_plan(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    goal: dict[str, Any] | None = None
    if args.goal_id:
        _directory, goal = load_goal(root, config, args.goal_id)
    return {
        "project_id": config["project_id"],
        "goal_id": goal.get("goal_id") if goal else None,
        "generated_at": iso_now(config),
        "assurance_standard_version": ASSURANCE_STANDARD_VERSION,
        "standard_reference": ".agents/continuity/references/testing-and-merge-standard.md",
        "worktree": args.worktree,
        "integration_branch": config.get("integration_branch"),
        "validation_commands": goal_test_commands(config, goal),
        "security_commands": list(config.get("security_commands", [])),
        "evergreen_checks": EVERGREEN_TEST_CHECKS,
        "merge_safety_checks": MERGE_SAFETY_CHECKS,
        "required_evidence": {
            "code_review": "diff review method, changed files or commit, findings, and resolution",
            "validation": "exact command, exit status, relevant output summary, and targeted regression coverage",
            "security_review": "configured scanner results plus evidence-based review of touched trust boundaries",
            "merge_safety": "base refresh, branch state, PR readiness, and unresolved risk",
        },
        "goal_context": {
            "state": goal.get("state") if goal else None,
            "acceptance_criteria": goal.get("acceptance_criteria", []) if goal else [],
            "source_note_ids": goal.get("source_note_ids", []) if goal else [],
            "memory_ids": goal.get("memory_ids", []) if goal else [],
            "roadmap_ids": goal.get("roadmap_ids", []) if goal else [],
        },
    }


def test_record(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    validation_evidence = args.validation_evidence or []
    security_evidence = args.security_evidence or []
    review_evidence = args.code_review_evidence or []
    machine_run = json_load(directory / "machine-test-run.json", {})
    machine_worktree = machine_run.get("worktree") if isinstance(machine_run, dict) else None
    evidence_root = Path(args.worktree or machine_worktree or root).expanduser().resolve()
    if args.status == "passed":
        missing = []
        if not review_evidence:
            missing.append("code-review evidence")
        if not security_evidence:
            missing.append("security-review evidence")
        if not isinstance(machine_run, dict) or machine_run.get("status") != "passed":
            missing.append("a passed machine test run")
        else:
            current_snapshot = worktree_source_snapshot(evidence_root)
            if machine_worktree and evidence_root != Path(machine_worktree).expanduser().resolve():
                missing.append("machine evidence for the recorded goal worktree")
            if machine_run.get("repository_fingerprint") != current_snapshot["repository_fingerprint"]:
                missing.append("machine evidence for the enrolled repository")
            if machine_run.get("branch") != current_snapshot["branch"]:
                missing.append("machine evidence for the current goal branch")
            if machine_run.get("commit_sha") != current_snapshot["commit_sha"]:
                missing.append("machine evidence for the current commit")
            if machine_run.get("source_fingerprint") != current_snapshot["source_fingerprint"]:
                missing.append("machine evidence for the current source fingerprint")
            if machine_run.get("plan_hash") != goal.get("plan_hash"):
                missing.append("machine evidence for the approved plan hash")
            if machine_run.get("behavior_configuration_hash") != config.get("behavior_configuration_hash"):
                missing.append("machine evidence for the current behavior configuration")
            if machine_run.get("validation_commands") != goal_test_commands(config, goal):
                missing.append("machine evidence for every configured validation command")
            if machine_run.get("security_commands") != list(config.get("security_commands", [])):
                missing.append("machine evidence for every configured security command")
        if missing:
            raise ContinuityError(f"Cannot record a passed test report without {', '.join(missing)}")
        validation_evidence = [
            f"machine-test-run:{machine_run.get('evidence_hash')}",
            f"source-fingerprint:{machine_run.get('source_fingerprint')}",
            *validation_evidence,
        ]
    stamp = iso_now(config)
    artifacts: list[str] = []
    for value in args.artifact or []:
        path = Path(value).expanduser().resolve()
        if not path.is_file():
            raise ContinuityError(f"Test artifact does not exist: {value}")
        if not path.is_relative_to(evidence_root):
            raise ContinuityError(f"Test artifact is outside the worktree: {value}")
        if path.is_relative_to(private_path(root, config)):
            raise ContinuityError("Private continuity state cannot be used as test evidence")
        artifacts.append(str(path))
    report = {
        "project_id": config["project_id"],
        "goal_id": args.goal_id,
        "status": args.status,
        "summary": args.summary,
        "actor": args.actor,
        "updated_at": stamp,
        "worktree": args.worktree or machine_run.get("worktree"),
        "branch": args.branch or machine_run.get("branch"),
        "plan_hash": goal.get("plan_hash"),
        "behavior_configuration_hash": machine_run.get("behavior_configuration_hash") if isinstance(machine_run, dict) else None,
        "commit_sha": machine_run.get("commit_sha") if isinstance(machine_run, dict) else None,
        "repository_fingerprint": machine_run.get("repository_fingerprint") if isinstance(machine_run, dict) else None,
        "source_fingerprint": machine_run.get("source_fingerprint") if isinstance(machine_run, dict) else None,
        "machine_evidence_hash": machine_run.get("evidence_hash") if isinstance(machine_run, dict) else None,
        "validation_commands": goal_test_commands(config, goal),
        "security_commands": list(config.get("security_commands", [])),
        "code_review_evidence": review_evidence,
        "validation_evidence": validation_evidence,
        "security_evidence": security_evidence,
        "findings": args.finding or [],
        "artifacts": artifacts,
        "evergreen_checks": EVERGREEN_TEST_CHECKS,
    }
    json_dump(directory / "test-report.json", report)
    append_jsonl(private_path(root, config) / "reports" / "test-reports.jsonl", report)
    if args.update_gates:
        gate_status = "passed" if args.status == "passed" else "failed"
        record_compliance_stage(root, config, directory, goal, "code-review", gate_status, review_evidence + (args.finding or []), args.actor)
        record_compliance_stage(root, config, directory, goal, "validation", gate_status, validation_evidence, args.actor)
        record_compliance_stage(root, config, directory, goal, "security-review", gate_status, security_evidence, args.actor)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": stamp,
            "event": "test.report",
            "goal_id": args.goal_id,
            "plan_version": goal.get("plan_version"),
            "status": args.status,
        },
    )
    return report


def current_test_evidence_failures(
    root: Path,
    config: dict[str, Any],
    directory: Path,
    goal: dict[str, Any],
) -> list[str]:
    failures: list[str] = []
    execution = json_load(directory / "execution.json", {})
    test_report = json_load(directory / "test-report.json", {})
    if not isinstance(test_report, dict) or test_report.get("status") != "passed":
        failures.append("current passed test report is missing")
    if failures:
        return failures
    if not isinstance(execution, dict):
        execution = {}
    worktree = Path(execution.get("worktree") or root).expanduser().resolve()
    try:
        snapshot = worktree_source_snapshot(worktree)
    except ContinuityError as exc:
        return [str(exc)]
    bindings = {
        "test source fingerprint": (test_report.get("source_fingerprint"), snapshot["source_fingerprint"]),
        "test repository": (test_report.get("repository_fingerprint"), snapshot["repository_fingerprint"]),
        "test commit": (test_report.get("commit_sha"), snapshot["commit_sha"]),
        "test branch": (test_report.get("branch"), snapshot["branch"]),
        "execution branch": (execution.get("branch"), snapshot["branch"]),
        "test plan": (test_report.get("plan_hash"), goal.get("plan_hash")),
        "test behavior": (test_report.get("behavior_configuration_hash"), config.get("behavior_configuration_hash")),
    }
    for label, (recorded, current) in bindings.items():
        if recorded != current:
            failures.append(f"{label} evidence is stale")
    return failures


def current_product_audit_evidence_failures(
    root: Path,
    config: dict[str, Any],
    directory: Path,
    goal: dict[str, Any],
) -> list[str]:
    compliance = json_load(directory / "compliance.json", {})
    stage = compliance.get("stages", {}).get("product-conformance", {})
    if stage.get("status") == "not-applicable":
        return []
    if stage.get("status") != "passed":
        return [f"compliance stage product-conformance is {stage.get('status') or 'missing'}"]
    record = json_load(directory / "product-audit.json", {})
    if not isinstance(record, dict) or record.get("status") != "passed":
        return ["current passed candidate product audit is missing"]
    failures: list[str] = []
    if record.get("profile") != "candidate":
        failures.append("product audit is not a candidate audit")
    if record.get("goal_id") != goal.get("goal_id"):
        failures.append("product audit goal binding is stale")
    goal_binding = record.get("goal_binding", {})
    if not isinstance(goal_binding, dict) or goal_binding.get("plan_hash") != goal.get("plan_hash"):
        failures.append("product audit plan evidence is stale")
    execution = json_load(directory / "execution.json", {})
    if not isinstance(execution, dict):
        execution = {}
    worktree = Path(execution.get("worktree") or root).expanduser().resolve()
    try:
        snapshot = worktree_source_snapshot(worktree)
    except ContinuityError as exc:
        return [*failures, str(exc)]
    binding = record.get("target_binding", {})
    if not isinstance(binding, dict):
        binding = {}
    bindings = {
        "product audit source fingerprint": (
            binding.get("source_fingerprint"),
            snapshot["source_fingerprint"],
        ),
        "product audit repository": (
            binding.get("repository_fingerprint"),
            snapshot["repository_fingerprint"],
        ),
        "product audit commit": (binding.get("commit_sha"), snapshot["commit_sha"]),
        "product audit branch": (binding.get("branch"), snapshot["branch"]),
        "product audit behavior": (
            binding.get("behavior_configuration_hash"),
            config.get("behavior_configuration_hash"),
        ),
    }
    for label, (recorded, current) in bindings.items():
        if recorded != current:
            failures.append(f"{label} evidence is stale")
    artifact = record.get("sanitized_artifact")
    if config.get("require_execution_artifacts", False):
        if not isinstance(artifact, dict) or artifact.get("path") != "product-conformance.md":
            failures.append("product-conformance.md audit artifact is missing")
        else:
            artifact_path = (worktree / str(artifact["path"])).resolve()
            if (
                not artifact_path.is_file()
                or not artifact_path.is_relative_to(worktree)
                or hashlib.sha256(artifact_path.read_bytes()).hexdigest() != artifact.get("sha256")
            ):
                failures.append("product-conformance.md audit artifact is stale")
    try:
        latest = product_audit_lib.latest_for_goal(root, config, str(goal["goal_id"]))
    except product_audit_lib.ProductAuditError as exc:
        failures.append(str(exc))
    else:
        if not latest or latest.get("result_hash") != record.get("result_hash"):
            failures.append("a newer candidate product audit exists")
    return failures


def current_review_evidence_failures(
    root: Path,
    config: dict[str, Any],
    directory: Path,
    goal: dict[str, Any],
) -> list[str]:
    failures = current_test_evidence_failures(root, config, directory, goal)
    failures.extend(current_product_audit_evidence_failures(root, config, directory, goal))
    merge_report = json_load(directory / "merge-assessment.json", {})
    if not isinstance(merge_report, dict) or merge_report.get("status") != "passed":
        failures.append("current passed merge assessment is missing")
    if failures:
        return failures
    execution = json_load(directory / "execution.json", {})
    if not isinstance(execution, dict):
        execution = {}
    worktree = Path(execution.get("worktree") or merge_report.get("worktree") or root).expanduser().resolve()
    try:
        snapshot = worktree_source_snapshot(worktree)
    except ContinuityError as exc:
        return [str(exc)]
    bindings = {
        "merge head": (merge_report.get("head_sha"), snapshot["commit_sha"]),
        "merge branch": (merge_report.get("branch"), snapshot["branch"]),
        "merge base": (merge_report.get("base"), config.get("integration_branch")),
    }
    for label, (recorded, current) in bindings.items():
        if recorded != current:
            failures.append(f"{label} evidence is stale")
    if config.get("require_remote", True) and merge_report.get("remote_head_sha") != snapshot["commit_sha"]:
        failures.append("remote branch evidence is stale")
    if config.get("require_pr", True):
        if merge_report.get("pr_head_sha") != snapshot["commit_sha"]:
            failures.append("PR head evidence is stale")
        if merge_report.get("pr_base") != config.get("integration_branch"):
            failures.append("PR base evidence is stale")
        if merge_report.get("pr_url") != execution.get("pr_url"):
            failures.append("PR URL evidence is stale")
        try:
            context = github_pr_context(worktree, str(merge_report.get("pr_url") or ""))
        except ContinuityError as exc:
            failures.append(str(exc))
        else:
            if merge_report.get("github_host") != context["host"]:
                failures.append("GitHub host evidence is stale")
            if merge_report.get("github_repository") != context["spec"]:
                failures.append("GitHub repository evidence is stale")
            if merge_report.get("github_pr_number") != context["number"]:
                failures.append("GitHub PR number evidence is stale")
    return failures


def merge_assess(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    execution = json_load(directory / "execution.json", {})
    branch = args.branch or execution.get("branch")
    base = args.base or config.get("integration_branch")
    pr_url = args.pr_url or execution.get("pr_url")
    worktree = Path(args.worktree or execution.get("worktree") or root).expanduser().resolve()
    failures: list[str] = []
    evidence = list(args.evidence or [])
    head_sha: str | None = None
    remote_head_sha: str | None = None
    pr_head_sha: str | None = None
    pr_base: str | None = None
    github_context: dict[str, Any] | None = None
    github_login: str | None = None
    github_evidence: dict[str, Any] = {}
    if branch:
        try:
            branch = validate_git_branch(worktree if worktree.is_dir() else root, branch, "goal branch")
        except ContinuityError as exc:
            failures.append(str(exc))
            branch = None
    if base:
        try:
            base = validate_git_branch(worktree if worktree.is_dir() else root, base, "merge base")
        except ContinuityError as exc:
            failures.append(str(exc))
            base = None
    if not branch:
        failures.append("goal branch is missing")
    elif branch == base:
        failures.append("goal branch must differ from integration branch")
    if not worktree.is_dir():
        failures.append(f"worktree is unavailable: {worktree}")
    else:
        inside = git_result(worktree, "rev-parse", "--is-inside-work-tree")
        if inside.returncode != 0:
            failures.append("worktree is not a Git repository")
        else:
            current_branch = git_result(worktree, "rev-parse", "--abbrev-ref", "HEAD")
            if current_branch.returncode == 0:
                actual_branch = current_branch.stdout.strip()
                evidence.append(f"worktree-branch:{actual_branch}")
                if branch and actual_branch != branch:
                    failures.append(f"worktree is on {actual_branch}, not {branch}")
            status = git_result(worktree, "status", "--short")
            if status.returncode != 0:
                failures.append("unable to inspect working tree status")
            else:
                dirty_lines = [
                    line for line in status.stdout.splitlines()
                    if ".continuity/private/" not in line
                    and ".continuity-write.lock" not in line
                    and ".continuity/state.lock" not in line
                    and ".agents/continuity/lib/__pycache__/" not in line
                ]
                if dirty_lines:
                    failures.append("working tree has uncommitted changes")
                else:
                    evidence.append("working-tree:clean")
            if base:
                merge_base = git_result(worktree, "merge-base", "HEAD", base)
                if merge_base.returncode != 0:
                    evidence.append(f"merge-base-check:unavailable:{base}")
                else:
                    evidence.append(f"merge-base:{merge_base.stdout.strip()}")
            head_result = git_result(worktree, "rev-parse", "HEAD")
            head_sha = head_result.stdout.strip() if head_result.returncode == 0 else None
            if not head_sha:
                failures.append("unable to resolve the goal branch head commit")
            elif config.get("require_remote", True) and branch:
                remote_head = git_result(worktree, "rev-parse", f"origin/{branch}")
                if remote_head.returncode != 0:
                    failures.append(f"remote branch origin/{branch} is unavailable")
                else:
                    remote_head_sha = remote_head.stdout.strip()
                if remote_head_sha and remote_head_sha != head_sha:
                    failures.append("remote branch head does not match the tested local commit")
                elif remote_head_sha:
                    evidence.append(f"remote-head:{head_sha}")
    if config.get("require_pr", True):
        if not pr_url:
            failures.append("PR URL is required")
        else:
            try:
                github_context = github_pr_context(worktree, str(pr_url))
                github_login = github_authenticated_login(worktree, github_context)
                pr_details = github_pr_details(
                    worktree,
                    str(pr_url),
                    [
                        "state",
                        "headRefName",
                        "baseRefName",
                        "headRefOid",
                        "isDraft",
                        "mergeStateStatus",
                        "reviewDecision",
                        "reviews",
                        "statusCheckRollup",
                        "mergeCommit",
                        "mergedBy",
                    ],
                    context=github_context,
                )
            except ContinuityError as exc:
                failures.append(str(exc))
            else:
                pr_head_sha = pr_details.get("headRefOid")
                pr_base = pr_details.get("baseRefName")
                pr_state = pr_details.get("state")
                reconciled_after_merge = pr_state == "MERGED"
                merge_commit = (pr_details.get("mergeCommit") or {}).get("oid")
                if pr_state not in {"OPEN", "MERGED"}:
                    failures.append("PR must be open or verifiably merged during merge-safety assessment")
                if pr_details.get("headRefName") != branch:
                    failures.append("PR head branch does not match the goal branch")
                if pr_details.get("baseRefName") != base:
                    failures.append("PR base branch does not match the configured integration branch")
                if not isinstance(pr_head_sha, str) or not re.fullmatch(r"[a-f0-9]{40}", pr_head_sha):
                    failures.append("PR head commit is not a full lowercase 40-character SHA")
                if head_sha and pr_details.get("headRefOid") != head_sha:
                    failures.append("PR head commit does not match the tested local commit")
                check_summary = github_check_summary(pr_details.get("statusCheckRollup"), config.get("github_required_checks", []))
                failures.extend(check_summary["failures"])
                if pr_details.get("isDraft") and not reconciled_after_merge:
                    failures.append("PR must be ready for review, not draft")
                if pr_details.get("reviewDecision") == "CHANGES_REQUESTED":
                    failures.append("PR has an unresolved changes-requested review")
                if not reconciled_after_merge and pr_details.get("mergeStateStatus") not in {"CLEAN", "HAS_HOOKS"}:
                    failures.append(f"PR merge state is not immediately mergeable: {pr_details.get('mergeStateStatus') or 'UNKNOWN'}")
                if reconciled_after_merge:
                    if not isinstance(merge_commit, str) or not re.fullmatch(r"[a-f0-9]{40}", merge_commit):
                        failures.append("merged PR does not expose a full lowercase 40-character merge commit SHA")
                    elif base and config.get("require_remote", True):
                        remote_base = f"origin/{base}"
                        merged_on_base = git_result(worktree, "merge-base", "--is-ancestor", merge_commit, remote_base)
                        if merged_on_base.returncode != 0:
                            failures.append("verified PR merge commit is not reachable from the remote integration branch")
                approved_reviewers = github_approved_reviewers(pr_details.get("reviews"))
                required_reviewers = int(config.get("github_required_reviewers", 0))
                if len(approved_reviewers) < required_reviewers:
                    failures.append(
                        f"PR has {len(approved_reviewers)} authenticated approving reviewers; {required_reviewers} required"
                    )
                github_evidence = {
                    "host": github_context["host"],
                    "repository": github_context["spec"],
                    "pr_number": github_context["number"],
                    "authenticated_login": github_login,
                    "is_draft": pr_details.get("isDraft"),
                    "merge_state_status": pr_details.get("mergeStateStatus"),
                    "review_decision": pr_details.get("reviewDecision"),
                    "approved_reviewers": sorted(approved_reviewers, key=str.casefold),
                    "required_reviewers": required_reviewers,
                    "checks": check_summary,
                    "state": pr_state,
                    "merge_commit": merge_commit,
                    "merged_by": (pr_details.get("mergedBy") or {}).get("login"),
                    "reconciled_after_merge": reconciled_after_merge,
                }
                if not failures:
                    evidence.append(f"github-repository:{github_context['spec']}")
                    evidence.append(f"github-pr:{github_context['number']}")
                    evidence.append(f"github-identity:{github_login}")
                    evidence.append(f"pr-head:{pr_details.get('headRefOid')}")
                    if reconciled_after_merge:
                        evidence.append(f"pr-state:MERGED")
                        evidence.append(f"merge-commit:{merge_commit}")
    test_report = json_load(directory / "test-report.json", {})
    if not isinstance(test_report, dict) or test_report.get("status") != "passed":
        failures.append("latest test report is not passed")
    else:
        evidence.append(f"test-report:{test_report.get('updated_at')}")
        try:
            current_snapshot = worktree_source_snapshot(worktree)
        except ContinuityError as exc:
            failures.append(str(exc))
        else:
            if test_report.get("source_fingerprint") != current_snapshot["source_fingerprint"]:
                failures.append("latest test report does not match the current source fingerprint")
            if test_report.get("repository_fingerprint") != current_snapshot["repository_fingerprint"]:
                failures.append("latest test report does not belong to the current repository")
            enrolled_snapshot = worktree_source_snapshot(root)
            if current_snapshot["repository_fingerprint"] != enrolled_snapshot["repository_fingerprint"]:
                failures.append("merge worktree does not belong to the enrolled repository")
            if test_report.get("plan_hash") != goal.get("plan_hash"):
                failures.append("latest test report does not match the approved plan hash")
            if test_report.get("commit_sha") != current_snapshot["commit_sha"]:
                failures.append("latest test report does not match the current commit")
    compliance = json_load(directory / "compliance.json", {})
    for stage in ("code-review", "validation", "security-review", "product-conformance"):
        status = compliance.get("stages", {}).get(stage, {}).get("status")
        if status not in {"passed", "not-applicable"}:
            failures.append(f"compliance stage {stage} is {status or 'missing'}")
    if compliance.get("stages", {}).get("product-conformance", {}).get("status") in {
        "passed",
        "not-applicable",
    }:
        failures.extend(current_product_audit_evidence_failures(root, config, directory, goal))
    computed_status = "failed" if failures else "passed"
    if args.status and args.status != computed_status:
        if args.status == "passed":
            raise ContinuityError(f"Cannot force a passed merge assessment with failures: {failures}")
        computed_status = args.status
    stamp = iso_now(config)
    report = {
        "project_id": config["project_id"],
        "goal_id": args.goal_id,
        "status": computed_status,
        "updated_at": stamp,
        "actor": args.actor,
        "branch": branch,
        "base": base,
        "head_sha": head_sha,
        "remote_head_sha": remote_head_sha,
        "pr_head_sha": pr_head_sha,
        "pr_base": pr_base,
        "pr_url": pr_url,
        "github_host": github_context.get("host") if github_context else None,
        "github_repository": github_context.get("spec") if github_context else None,
        "github_pr_number": github_context.get("number") if github_context else None,
        "github_authenticated_login": github_login,
        "github": github_evidence,
        "worktree": str(worktree),
        "failures": failures,
        "evidence": evidence,
        "human_merge_required": True,
        "auto_merge_allowed": False,
        "force_push_allowed": False,
        "merge_safety_checks": MERGE_SAFETY_CHECKS,
    }
    json_dump(directory / "merge-assessment.json", report)
    append_jsonl(private_path(root, config) / "reports" / "merge-assessments.jsonl", report)
    if args.update_gate:
        gate_status = "passed" if computed_status == "passed" else "failed"
        record_compliance_stage(root, config, directory, goal, "merge-safety", gate_status, evidence + failures, args.actor)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": stamp,
            "event": "merge.assess",
            "goal_id": args.goal_id,
            "plan_version": goal.get("plan_version"),
            "status": computed_status,
        },
    )
    return report


def github_pr_details(
    root: Path,
    pr_url: str,
    fields: list[str],
    *,
    context: dict[str, Any] | None = None,
) -> dict[str, Any]:
    gh = shutil.which("gh")
    if not gh:
        raise ContinuityError("GitHub CLI is required to verify PR state")
    context = context or github_pr_context(root, pr_url)
    requested_fields = list(dict.fromkeys([*fields, "url"]))
    result = subprocess.run(
        [
            gh,
            "pr",
            "view",
            str(context["number"]),
            "--repo",
            context["spec"],
            "--json",
            ",".join(requested_fields),
        ],
        cwd=root,
        capture_output=True,
        text=True,
        timeout=60,
        check=False,
    )
    if result.returncode != 0:
        raise ContinuityError(f"Unable to verify GitHub PR: {result.stderr.strip() or result.stdout.strip()}")
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise ContinuityError("GitHub PR verification returned invalid JSON") from exc
    if not isinstance(value, dict):
        raise ContinuityError("GitHub PR verification returned an invalid record")
    returned_url = value.get("url")
    try:
        returned = parse_github_pr_url(returned_url)
    except ContinuityError as exc:
        raise ContinuityError("GitHub PR verification did not return a canonical PR URL") from exc
    expected = (context["host"].casefold(), context["owner"].casefold(), context["repository"].casefold(), context["number"])
    actual = (returned["host"].casefold(), returned["owner"].casefold(), returned["repository"].casefold(), returned["number"])
    if actual != expected:
        raise ContinuityError("GitHub PR verification returned a different repository or pull request")
    return value


def github_check_summary(raw_checks: Any, required_names: list[str]) -> dict[str, Any]:
    checks = raw_checks if isinstance(raw_checks, list) else []
    normalized = []
    for item in checks:
        if not isinstance(item, dict):
            continue
        name = item.get("name") or item.get("context") or item.get("workflowName") or "unknown"
        result = item.get("conclusion") or item.get("state") or item.get("status") or "UNKNOWN"
        normalized.append({"name": name, "result": str(result).upper()})
    success = {"SUCCESS", "NEUTRAL", "SKIPPED"}
    failures = [f"GitHub check {item['name']} is {item['result']}" for item in normalized if item["result"] not in success]
    observed = {item["name"] for item in normalized}
    missing = sorted(set(required_names) - observed)
    failures.extend(f"Required GitHub check is missing: {name}" for name in missing)
    return {"checks": normalized, "required": required_names, "missing": missing, "failures": failures, "passed": not failures}


def github_approved_reviewers(raw_reviews: Any) -> set[str]:
    active: dict[str, str] = {}
    reviews = raw_reviews if isinstance(raw_reviews, list) else []
    for review in reviews:
        if not isinstance(review, dict) or not isinstance(review.get("author"), dict):
            continue
        login = review["author"].get("login")
        state = str(review.get("state") or "").upper()
        if not isinstance(login, str) or not login.strip():
            continue
        key = login.casefold()
        if state == "APPROVED":
            active[key] = login
        elif state in {"CHANGES_REQUESTED", "DISMISSED"}:
            active.pop(key, None)
    return set(active.values())


def github_authenticated_login(root: Path, context: dict[str, Any]) -> str:
    gh = shutil.which("gh")
    if not gh:
        raise ContinuityError("GitHub CLI is required to verify human identity")
    result = subprocess.run(
        [gh, "api", "user", "--hostname", context["host"], "--jq", ".login"],
        cwd=root,
        capture_output=True,
        text=True,
        timeout=60,
        check=False,
    )
    if result.returncode != 0 or not result.stdout.strip():
        raise ContinuityError(f"Unable to verify authenticated GitHub identity: {result.stderr.strip() or result.stdout.strip()}")
    login = result.stdout.strip()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,254}", login):
        raise ContinuityError("GitHub CLI returned an invalid authenticated login")
    return login


def merge_execute(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if not config.get("github_cli_merge_enabled", False):
        raise ContinuityError("GitHub CLI merge is disabled; enable github_cli_merge_enabled through reviewed project configuration")
    if not config.get("require_pr", True) or not config.get("require_pr_auth", True):
        raise ContinuityError("GitHub CLI merge requires authenticated PR verification")
    if goal.get("state") != "review-ready":
        raise ContinuityError("GitHub CLI merge requires review-ready work")
    github_context = github_pr_context(root, args.pr_url)
    if not re.fullmatch(r"[a-f0-9]{40}", args.head_sha):
        raise ContinuityError("--head-sha must be the full lowercase 40-character PR head commit")
    stale_evidence = current_review_evidence_failures(root, config, directory, goal)
    if stale_evidence:
        raise ContinuityError(f"GitHub CLI merge requires current review evidence: {stale_evidence}")
    assessment = json_load(directory / "merge-assessment.json", {})
    if not isinstance(assessment, dict) or assessment.get("status") != "passed":
        raise ContinuityError("GitHub CLI merge requires a passed merge assessment")
    if assessment.get("pr_url") != args.pr_url:
        raise ContinuityError("Authorized PR URL does not match the merge assessment")
    if (
        assessment.get("github_host") != github_context["host"]
        or assessment.get("github_repository") != github_context["spec"]
        or assessment.get("github_pr_number") != github_context["number"]
    ):
        raise ContinuityError("Authorized GitHub host, repository, or PR does not match the merge assessment")
    if assessment.get("head_sha") != args.head_sha or assessment.get("pr_head_sha") != args.head_sha:
        raise ContinuityError("Authorized head SHA does not match the assessed local and PR head")
    expected_authorization = f"Merge {args.goal_id} PR {args.pr_url} at {args.head_sha} using {args.merge_method}"
    if args.authorization_text != expected_authorization:
        raise ContinuityError(f"Merge authorization text must exactly equal: {expected_authorization}")
    authenticated_login = github_authenticated_login(root, github_context)
    if authenticated_login.casefold() != args.authorized_by.casefold():
        raise ContinuityError(f"--authorized-by must match authenticated GitHub identity {authenticated_login}")
    details = github_pr_details(
        root,
        args.pr_url,
        ["state", "headRefName", "baseRefName", "headRefOid", "isDraft", "mergeStateStatus", "reviewDecision", "reviews", "statusCheckRollup"],
        context=github_context,
    )
    if details.get("state") != "OPEN":
        raise ContinuityError("GitHub CLI merge requires an open PR")
    if details.get("isDraft"):
        raise ContinuityError("GitHub CLI merge requires a PR that is ready for review")
    if details.get("baseRefName") != config.get("integration_branch"):
        raise ContinuityError("PR base does not match the configured integration branch")
    if details.get("headRefName") != assessment.get("branch"):
        raise ContinuityError("PR head branch changed after human authorization")
    if details.get("headRefOid") != args.head_sha:
        raise ContinuityError("PR head changed after human authorization")
    if details.get("mergeStateStatus") not in {"CLEAN", "HAS_HOOKS"}:
        raise ContinuityError(f"PR merge state is not immediately mergeable: {details.get('mergeStateStatus') or 'UNKNOWN'}")
    checks = github_check_summary(details.get("statusCheckRollup"), config.get("github_required_checks", []))
    if not checks["passed"]:
        raise ContinuityError(f"GitHub CLI merge requires successful GitHub checks: {checks['failures']}")
    if details.get("reviewDecision") == "CHANGES_REQUESTED":
        raise ContinuityError("PR still has a changes-requested review")
    approved_reviewers = github_approved_reviewers(details.get("reviews"))
    required_reviewers = int(config.get("github_required_reviewers", 0))
    if len(approved_reviewers) < required_reviewers:
        raise ContinuityError(f"PR has {len(approved_reviewers)} authenticated approving reviewers; {required_reviewers} required")
    if config.get("require_signed_approvals", False) and not args.signing_key:
        raise ContinuityError("This project requires a signed GitHub CLI merge authorization")
    stamp = iso_now(config)
    authorization = {
        "schema_version": 1,
        "project_id": config["project_id"],
        "goal_id": args.goal_id,
        "plan_version": goal["plan_version"],
        "plan_hash": goal_material_hash(directory, goal),
        "execution_attempt": int(goal.get("execution_attempt", 1)),
        "authorized_at": stamp,
        "authorized_by": args.authorized_by,
        "authorization_text": args.authorization_text,
        "pr_url": args.pr_url,
        "github_host": github_context["host"],
        "github_repository": github_context["spec"],
        "pr_number": github_context["number"],
        "head_sha": args.head_sha,
        "merge_method": args.merge_method,
        "nonce": secrets.token_hex(16),
        "signature_format": "openssh-sshsig-v1" if args.signing_key else "legacy-unsigned",
    }
    try:
        runtime_lib.validate_schema_file(
            authorization,
            CONTROL_ROOT / "schemas" / "merge-authorization.schema.json",
            "merge authorization",
        )
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    if args.signing_key:
        sign_receipt_bytes(
            merge_authorization_bytes(authorization),
            args.signing_key,
            directory / "merge-authorization.sig",
            namespace="continuity-merge-authorization",
            label="merge authorization",
        )
        authorization["trust_anchor"] = verify_receipt_bytes(
            root,
            config,
            merge_authorization_bytes(authorization),
            directory / "merge-authorization.sig",
            args.authorized_by,
            namespace="continuity-merge-authorization",
            label="merge authorization",
        )
        try:
            runtime_lib.validate_schema_file(
                authorization,
                CONTROL_ROOT / "schemas" / "merge-authorization.schema.json",
                "merge authorization",
            )
        except runtime_lib.RuntimeIntegrityError as exc:
            raise ContinuityError(str(exc)) from exc
    json_dump(directory / "merge-authorization.json", authorization)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": stamp,
            "event": "merge.authorized",
            "goal_id": args.goal_id,
            "plan_version": goal.get("plan_version"),
            "pr_url": args.pr_url,
            "head_sha": args.head_sha,
            "merge_method": args.merge_method,
            "authorized_by": args.authorized_by,
        },
    )
    gh = shutil.which("gh")
    if not gh:
        raise ContinuityError("GitHub CLI is required to execute the authorized merge")
    result = subprocess.run(
        [
            gh,
            "pr",
            "merge",
            str(github_context["number"]),
            "--repo",
            github_context["spec"],
            f"--{args.merge_method}",
            "--match-head-commit",
            args.head_sha,
        ],
        cwd=root,
        capture_output=True,
        text=True,
        timeout=120,
        check=False,
    )
    if result.returncode != 0:
        append_jsonl(
            private_path(root, config) / "events.jsonl",
            {"at": iso_now(config), "event": "merge.execute-failed", "goal_id": args.goal_id, "head_sha": args.head_sha},
        )
        raise ContinuityError(f"Authorized GitHub CLI merge failed: {result.stderr.strip() or result.stdout.strip()}")
    merged = github_pr_details(
        root,
        args.pr_url,
        ["state", "mergeCommit", "mergedBy", "headRefOid", "baseRefName", "reviewDecision", "reviews", "statusCheckRollup", "mergeStateStatus"],
        context=github_context,
    )
    if merged.get("state") != "MERGED":
        append_jsonl(
            private_path(root, config) / "events.jsonl",
            {"at": iso_now(config), "event": "merge.pending-github", "goal_id": args.goal_id, "head_sha": args.head_sha},
        )
        return {
            "status": "pending-github",
            "goal_id": args.goal_id,
            "pr_url": args.pr_url,
            "head_sha": args.head_sha,
            "merge_method": args.merge_method,
            "authorization_recorded": True,
            "message": "GitHub accepted the merge command but has not reported the PR as merged; leave the goal review-ready and record the merged disposition after GitHub completes it.",
        }
    merge_commit = (merged.get("mergeCommit") or {}).get("oid")
    merged_by = (merged.get("mergedBy") or {}).get("login")
    if merged.get("headRefOid") != args.head_sha or not merge_commit:
        raise ContinuityError("GitHub reported a merged PR without the authorized head or merge commit")
    if not merged_by or merged_by.casefold() != authenticated_login.casefold():
        raise ContinuityError("GitHub merge actor does not match the authorized authenticated identity")
    disposition = merge_record_human(
        argparse.Namespace(
            goal_id=args.goal_id,
            pr_url=args.pr_url,
            merged_by=authenticated_login,
            disposition="merged",
            merge_commit=merge_commit,
            evidence=[
                f"Interactive authorization: {args.authorization_text}",
                f"GitHub CLI verified merged head {args.head_sha} using {args.merge_method}",
            ],
            actor=args.authorized_by,
            signing_key=args.signing_key,
            sentiment="unknown",
            perspective="internal",
        )
    )
    return {
        "status": "merged",
        "goal_id": args.goal_id,
        "pr_url": args.pr_url,
        "head_sha": args.head_sha,
        "merge_commit": merge_commit,
        "merge_method": args.merge_method,
        "authorized_by": args.authorized_by,
        "human_review": disposition,
    }


def merge_record_human(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if goal.get("state") != "review-ready":
        raise ContinuityError("Human PR disposition requires review-ready work")
    stale_evidence = current_review_evidence_failures(root, config, directory, goal)
    if stale_evidence and args.disposition in {"approved", "merged"}:
        raise ContinuityError(f"Human PR disposition requires current review evidence: {stale_evidence}")
    if not args.evidence:
        raise ContinuityError("Human merge review requires evidence")
    if config.get("require_signed_approvals", False) and not args.signing_key:
        raise ContinuityError("This project requires a signed human review disposition")
    github_context = github_pr_context(root, args.pr_url) if config.get("require_pr", True) else None
    if args.disposition == "merged" and not args.merge_commit:
        raise ContinuityError("Merged disposition requires --merge-commit")
    if args.disposition != "merged" and args.merge_commit:
        raise ContinuityError("--merge-commit is valid only with disposition merged")
    if config.get("require_pr", True) and args.disposition in {"approved", "merged"}:
        assert github_context is not None
        details = github_pr_details(
            root,
            args.pr_url,
            ["state", "mergeCommit", "headRefName", "baseRefName", "headRefOid", "isDraft", "reviewDecision", "reviews", "statusCheckRollup", "mergeStateStatus"],
            context=github_context,
        )
        assessment = json_load(directory / "merge-assessment.json", {})
        if not isinstance(assessment, dict) or assessment.get("status") != "passed":
            raise ContinuityError("Human disposition requires a passed merge assessment")
        if (
            assessment.get("github_host") != github_context["host"]
            or assessment.get("github_repository") != github_context["spec"]
            or assessment.get("github_pr_number") != github_context["number"]
        ):
            raise ContinuityError("Human disposition GitHub repository does not match the merge assessment")
        if details.get("baseRefName") != config.get("integration_branch"):
            raise ContinuityError("PR base does not match the configured integration branch")
        if details.get("headRefName") != assessment.get("branch") or details.get("headRefOid") != assessment.get("pr_head_sha"):
            raise ContinuityError("PR branch or head changed after merge assessment")
        checks = github_check_summary(details.get("statusCheckRollup"), config.get("github_required_checks", []))
        if not checks["passed"]:
            raise ContinuityError(f"Human disposition requires successful GitHub checks: {checks['failures']}")
        if args.disposition == "approved" and details.get("isDraft"):
            raise ContinuityError("Approved disposition requires a PR that is ready for review")
        if args.disposition == "approved" and details.get("mergeStateStatus") not in {"CLEAN", "HAS_HOOKS"}:
            raise ContinuityError("Approved disposition requires an immediately mergeable PR")
        if details.get("reviewDecision") == "CHANGES_REQUESTED":
            raise ContinuityError("PR still has a changes-requested review")
        approved_reviewers = github_approved_reviewers(details.get("reviews"))
        required_reviewers = int(config.get("github_required_reviewers", 0))
        if len(approved_reviewers) < required_reviewers:
            raise ContinuityError(f"PR has {len(approved_reviewers)} authenticated approving reviewers; {required_reviewers} required")
        authenticated_login = github_authenticated_login(root, github_context) if config.get("require_pr_auth", True) else args.merged_by
        if authenticated_login.casefold() != args.merged_by.casefold():
            raise ContinuityError(f"--merged-by must match authenticated GitHub identity {authenticated_login}")
        if args.disposition == "approved" and details.get("reviewDecision") != "APPROVED":
            raise ContinuityError("Approved disposition requires GitHub reviewDecision APPROVED")
        if args.disposition == "merged":
            merge_oid = (details.get("mergeCommit") or {}).get("oid")
            if details.get("state") != "MERGED" or merge_oid != args.merge_commit:
                raise ContinuityError("Merged disposition does not match the verified PR merge commit")
    stamp = iso_now(config)
    report = {
        "schema_version": 1,
        "project_id": config["project_id"],
        "goal_id": args.goal_id,
        "plan_version": goal["plan_version"],
        "plan_hash": goal_material_hash(directory, goal),
        "execution_attempt": int(goal.get("execution_attempt", 1)),
        "status": args.disposition,
        "updated_at": stamp,
        "actor": args.actor,
        "pr_url": args.pr_url,
        "github_host": github_context.get("host") if github_context else None,
        "github_repository": github_context.get("spec") if github_context else None,
        "github_pr_number": github_context.get("number") if github_context else None,
        "merged_by": args.merged_by,
        "merge_commit": args.merge_commit,
        "evidence": args.evidence,
        "review_evidence_current": not stale_evidence,
        "stale_evidence": stale_evidence,
        "human_merge_required": True,
        "auto_merge_used": False,
        "github_identity_verified": config.get("require_pr", True) and config.get("require_pr_auth", True) and args.disposition in {"approved", "merged"},
        "nonce": secrets.token_hex(16),
        "signature_format": "openssh-sshsig-v1" if args.signing_key else "legacy-unsigned",
    }
    if args.signing_key:
        sign_receipt_bytes(
            disposition_receipt_bytes(report),
            args.signing_key,
            directory / "human-review.sig",
            namespace="continuity-disposition",
            label="human disposition",
        )
        report["trust_anchor"] = verify_receipt_bytes(
            root,
            config,
            disposition_receipt_bytes(report),
            directory / "human-review.sig",
            args.merged_by,
            namespace="continuity-disposition",
            label="human disposition",
        )
    capture = capture_goal_feedback(
        root,
        config,
        args.goal_id,
        args.disposition,
        args.evidence,
        args.merged_by,
        args.sentiment,
        args.perspective,
    )
    report["feedback_capture_id"] = capture["capture_id"]
    json_dump(directory / "human-review.json", report)
    record_compliance_stage(root, config, directory, goal, "human-review", "passed", args.evidence, args.actor)
    if args.disposition == "merged":
        goal["state"] = "completed"
        goal["updated_at"] = stamp
        goal["completed_at"] = stamp
        json_dump(directory / "goal.json", goal)
        update_note_goal_links(root, config, goal.get("source_note_ids", []), args.goal_id, "completed")
    elif args.disposition == "changes-requested":
        reset_execution_evidence(
            directory,
            goal,
            config,
            "Human review requested in-scope changes; downstream evidence must be regenerated.",
            args.merged_by,
        )
        goal["state"] = "changes-requested"
        goal["updated_at"] = stamp
        json_dump(directory / "goal.json", goal)
        update_note_goal_links(root, config, goal.get("source_note_ids", []), args.goal_id, "changes-requested")
    elif args.disposition == "closed":
        goal["state"] = "cancelled"
        goal["updated_at"] = stamp
        json_dump(directory / "goal.json", goal)
        update_note_goal_links(root, config, goal.get("source_note_ids", []), args.goal_id, "cancelled")
    append_jsonl(private_path(root, config) / "reports" / "human-reviews.jsonl", report)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": stamp,
            "event": "merge.human-review",
            "goal_id": args.goal_id,
            "plan_version": goal.get("plan_version"),
            "status": report["status"],
        },
    )
    return report


def run_update(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if args.state not in {"running", "validating", "review-ready", "partially-completed", "blocked", "cancelled"}:
        raise ContinuityError(f"Invalid execution state: {args.state}")
    current = goal.get("state")
    allowed = {
        "dispatched": {"running", "blocked", "cancelled"},
        "running": {"running", "validating", "partially-completed", "blocked", "cancelled"},
        "validating": {"validating", "review-ready", "partially-completed", "blocked", "cancelled"},
    }
    if args.state not in allowed.get(current, set()):
        raise ContinuityError(f"Illegal execution transition: {current} -> {args.state}")
    dispatch = json_load(directory / "dispatch.json", {})
    if not isinstance(dispatch, dict) or not dispatch.get("deadline"):
        raise ContinuityError("Execution requires a valid dispatch record")
    try:
        deadline = dt.datetime.fromisoformat(dispatch["deadline"])
    except (TypeError, ValueError) as exc:
        raise ContinuityError("Dispatch record has an invalid deadline") from exc
    if deadline.tzinfo is None:
        deadline = deadline.replace(tzinfo=ZoneInfo(config["timezone"]))
    if now(config) > deadline and args.state in {"running", "validating"}:
        raise ContinuityError("Runtime deadline has expired; record a blocked or partial terminal state")
    if args.state == "running" and config.get("require_isolated_worktree", False):
        if not args.worktree:
            raise ContinuityError("An isolated execution worktree is required")
        worktree = Path(args.worktree).expanduser().resolve()
        if worktree == root or not worktree.is_dir():
            raise ContinuityError("Execution worktree must exist and differ from the configured project root")
        common_root = git_result(root, "rev-parse", "--git-common-dir")
        common_worktree = git_result(worktree, "rev-parse", "--git-common-dir")
        if common_worktree.returncode != 0:
            raise ContinuityError("Execution path is not a Git worktree")
        root_common = (root / common_root.stdout.strip()).resolve()
        worktree_common = (worktree / common_worktree.stdout.strip()).resolve()
        if root_common != worktree_common:
            raise ContinuityError("Execution worktree does not belong to the configured repository")
    if args.state == "review-ready":
        compliance = json_load(directory / "compliance.json", {})
        if compliance.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
            raise ContinuityError("Cannot mark review-ready under a missing or unsupported assurance standard")
        required = [stage for stage in COMPLIANCE_STAGES if stage != "human-review"]
        incomplete = {
            stage: compliance.get("stages", {}).get(stage, {}).get("status", "missing")
            for stage in required
            if compliance.get("stages", {}).get(stage, {}).get("status") not in {"passed", "not-applicable"}
        }
        if incomplete:
            raise ContinuityError(f"Cannot mark review-ready; compliance stages incomplete: {incomplete}")
        stale_evidence = current_review_evidence_failures(root, config, directory, goal)
        if stale_evidence:
            raise ContinuityError(f"Cannot mark review-ready; current test or merge evidence failed: {stale_evidence}")
    stamp = iso_now(config)
    manifest = json_load(directory / "execution.json", {})
    artifacts = dict(manifest.get("artifacts", {}))
    evidence_root = Path(args.worktree or manifest.get("worktree") or root).expanduser().resolve()
    for value in args.artifact or []:
        path = Path(value).expanduser().resolve()
        if not path.is_file():
            raise ContinuityError(f"Execution artifact does not exist: {value}")
        if not path.is_relative_to(evidence_root):
            raise ContinuityError(f"Execution artifact is outside the execution worktree: {value}")
        if path.is_relative_to(private_path(root, config)):
            raise ContinuityError("Private continuity state cannot be used as PR evidence")
        artifacts[path.name] = str(path)
    manifest.update(
        {
            "goal_id": args.goal_id,
            "state": args.state,
            "updated_at": stamp,
            "task_id": args.task_id or manifest.get("task_id"),
            "branch": args.branch or manifest.get("branch"),
            "pr_url": args.pr_url or manifest.get("pr_url"),
            "summary": args.summary or manifest.get("summary"),
            "worktree": args.worktree or manifest.get("worktree"),
            "artifacts": artifacts,
        }
    )
    if args.state == "running" and "started_at" not in manifest:
        manifest["started_at"] = stamp
    if args.state == "review-ready":
        manifest["review_ready_at"] = stamp
    elif args.state in TERMINAL_STATES:
        manifest["completed_at"] = stamp
    if args.state == "review-ready":
        missing_fields = [key for key in ("started_at", "branch", "summary") if not manifest.get(key)]
        if config.get("require_pr", False):
            pr_url = str(manifest.get("pr_url") or "")
            try:
                github_pr_context(evidence_root, pr_url)
            except ContinuityError:
                missing_fields.append("valid GitHub pr_url")
        if config.get("require_execution_artifacts", False):
            required_artifacts = {
                "request-alignment.md",
                "implementation-report.md",
                "validation-and-security.md",
                "product-conformance.md",
                "memory-impact.md",
                "roadmap-impact.md",
                "evidence.md",
            }
            missing_fields.extend(sorted(required_artifacts - set(artifacts)))
            if not list(iter_jsonl(directory / "checkpoints.jsonl")):
                missing_fields.append("alignment checkpoint")
        if missing_fields:
            raise ContinuityError(f"Cannot mark review-ready; missing execution evidence: {missing_fields}")
    json_dump(directory / "execution.json", manifest)
    goal["state"] = args.state
    goal["updated_at"] = stamp
    json_dump(directory / "goal.json", goal)
    update_note_goal_links(root, config, goal.get("source_note_ids", []), args.goal_id, args.state)
    if args.state in TERMINAL_STATES:
        lock_path = private_path(root, config) / "project.lock.json"
        lock = json_load(lock_path)
        if isinstance(lock, dict) and lock.get("goal_id") == args.goal_id:
            lock_path.unlink(missing_ok=True)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": stamp,
            "event": f"run.{args.state}",
            "goal_id": args.goal_id,
            "plan_version": goal.get("plan_version"),
        },
    )
    return manifest


def morning_decision_report(root: Path, config: dict[str, Any]) -> dict[str, Any]:
    goals = goal_list(argparse.Namespace(state=None))
    notes = note_list(argparse.Namespace(kind=None))
    pattern_report = note_patterns(argparse.Namespace(min_count=2))
    workflow_records = {goal["goal_id"]: workflow_status_for_goal(root, config, goal) for goal in goals}
    queue_names = ("knowledge", "questions", "documentation", "backlog", "planning")
    queue_counts = {name: len(note_queue(argparse.Namespace(queue=name, status="eligible"))) for name in queue_names}
    memory_report = json_load(private_path(root, config) / "reports" / "memory-health.json", {})
    roadmap_report = json_load(private_path(root, config) / "reports" / "roadmap-health.json", {})
    product_audits = product_audit_lib.show(root, config)
    product_audit_due = product_audit_lib.due(
        root, config, int(config.get("product_audit_stale_after_days", 30))
    )
    active_runs = [
        run for run in scheduler_run_snapshots(root, config).values()
        if run.get("status") in SCHEDULER_ACTIVE_STATES
    ]
    active_runs.sort(key=lambda value: value.get("last_event_at", ""), reverse=True)
    current_time = now(config)
    pattern_dispositions: dict[str, dict[str, Any]] = {}
    for disposition in iter_jsonl(private_path(root, config) / "reports" / "pattern-dispositions.jsonl"):
        pattern_id = disposition.get("pattern_id")
        if isinstance(pattern_id, str):
            pattern_dispositions[pattern_id] = disposition
    decisions_needed: list[dict[str, Any]] = []
    completed_overnight: list[dict[str, Any]] = []
    blocked_or_at_risk: list[dict[str, Any]] = []
    prepared_next: list[dict[str, Any]] = []
    goal_statuses: list[dict[str, Any]] = []
    note_lifecycles: list[dict[str, Any]] = []
    note_stage_counts: dict[str, int] = {}
    unconfirmed_relationships: list[dict[str, Any]] = []
    overnight_cutoff = now(config) - dt.timedelta(hours=24)
    for goal in sorted(goals, key=lambda value: value.get("updated_at", ""), reverse=True):
        directory = goal_dir(root, config, goal["goal_id"])
        execution = json_load(directory / "execution.json", {})
        compliance = json_load(directory / "compliance.json", {})
        test_report = json_load(directory / "test-report.json", {})
        machine_run = json_load(directory / "machine-test-run.json", {})
        merge_report = json_load(directory / "merge-assessment.json", {})
        human_review = json_load(directory / "human-review.json", {})
        product_audit = json_load(directory / "product-audit.json", {})
        evidence_files = [
            name for name in (
                "goal.json", "plan.md", "approval.json", "dispatch.json", "execution.json", "preflight.json",
                "machine-test-run.json", "test-report.json", "product-audit.json", "merge-assessment.json", "human-review.json", "compliance.json",
            )
            if (directory / name).exists()
        ]
        workflow = workflow_records[goal["goal_id"]]
        detail = {
            "goal_id": goal["goal_id"],
            "title": goal["title"],
            "state": goal["state"],
            "updated_at": goal.get("updated_at"),
            "pr_url": execution.get("pr_url") if isinstance(execution, dict) else None,
            "summary": execution.get("summary") if isinstance(execution, dict) else None,
            "workflow": workflow,
            "allowed_dispositions": workflow["allowed_actions"],
            "blocked_dispositions": workflow["blocked_actions"],
            "evidence_references": [runtime_lib.project_relative_posix(directory / name, root) for name in evidence_files],
        }
        stages = compliance.get("stages", {}) if isinstance(compliance, dict) else {}
        goal_statuses.append(
            {
                **detail,
                "active_run_ids": [run["run_id"] for run in active_runs if run.get("goal_id") == goal["goal_id"]],
                "machine_evidence": {
                    "status": machine_run.get("status") if isinstance(machine_run, dict) else None,
                    "evidence_hash": machine_run.get("evidence_hash") if isinstance(machine_run, dict) else None,
                    "commit_sha": machine_run.get("commit_sha") if isinstance(machine_run, dict) else None,
                    "source_fingerprint": machine_run.get("source_fingerprint") if isinstance(machine_run, dict) else None,
                },
                "test": {
                    "status": test_report.get("status") if isinstance(test_report, dict) else None,
                    "commit_sha": test_report.get("commit_sha") if isinstance(test_report, dict) else None,
                    "machine_evidence_hash": test_report.get("machine_evidence_hash") if isinstance(test_report, dict) else None,
                },
                "security": stages.get("security-review", {"status": "pending", "evidence": []}),
                "product_conformance": {
                    "gate": stages.get("product-conformance", {"status": "pending", "evidence": []}),
                    "audit_id": product_audit.get("audit_id") if isinstance(product_audit, dict) else None,
                    "status": product_audit.get("status") if isinstance(product_audit, dict) else None,
                    "result_hash": product_audit.get("result_hash") if isinstance(product_audit, dict) else None,
                },
                "merge": {
                    "status": merge_report.get("status") if isinstance(merge_report, dict) else None,
                    "head_sha": merge_report.get("head_sha") if isinstance(merge_report, dict) else None,
                    "pr_url": merge_report.get("pr_url") if isinstance(merge_report, dict) else None,
                    "github": merge_report.get("github") if isinstance(merge_report, dict) else None,
                },
                "human_review": {
                    "disposition": human_review.get("status") if isinstance(human_review, dict) else None,
                    "actor": human_review.get("merged_by") if isinstance(human_review, dict) else None,
                    "feedback_capture_id": human_review.get("feedback_capture_id") if isinstance(human_review, dict) else None,
                },
                "compliance": {
                    "pending": workflow["pending_compliance"],
                    "failed": workflow["failed_compliance"],
                },
            }
        )
        if workflow["blockers"] and goal["state"] not in REWORK_STATES:
            blocked_or_at_risk.append(detail)
        if goal["state"] == "review-ready":
            decisions_needed.append({**detail, "decision": "Review the draft PR and record a human disposition.", "recommendation": "Review current source-bound evidence before choosing an allowed disposition."})
        elif goal["state"] in {"proposed-plan", "approved", "awaiting-feedback"}:
            prepared_next.append(detail)
            decisions_needed.append({**detail, "decision": "Review this exact plan version or migrate its legacy state.", "recommendation": "Approve only when scope and business outcome are decision-complete."})
        elif goal["state"] in REWORK_STATES:
            blocked_or_at_risk.append(detail)
            decisions_needed.append({**detail, "decision": "Choose an allowed rework, revision, or cancellation disposition.", "recommendation": "Resume only when feedback remains inside the approved plan; revise expanded scope."})
        elif goal["state"] == "completed":
            completed_at = parse_recorded_time(goal.get("completed_at"), config["timezone"])
            if completed_at is not None and completed_at >= overnight_cutoff:
                completed_overnight.append(detail)
    for note in notes:
        _path, capture, current_note = find_note_item(root, config, str(note["item_id"]))
        note_status = note_workflow_status(
            root,
            config,
            capture,
            current_note,
            candidate_goals=goals,
            include_timeline=False,
        )
        lifecycle = note_status["lifecycle"]
        stage_name = str(lifecycle["current_stage"])
        note_stage_counts[stage_name] = note_stage_counts.get(stage_name, 0) + 1
        note_lifecycles.append(
            {
                "note_id": note.get("item_id"),
                "capture_id": note.get("capture_id"),
                "kind": note.get("kind"),
                "summary_status": lifecycle["summary_status"],
                "current_stage": stage_name,
                "stage_entered_at": lifecycle["stage_entered_at"],
                "planning_disposition": lifecycle["planning_disposition"],
                "goal_tracks": lifecycle["goal_tracks"],
            }
        )
        candidates = lifecycle.get("relationship_candidates", [])
        if (
            candidates
            and float(candidates[0].get("similarity", 0.0)) >= RELATED_GOAL_REPORT_MIN_SCORE
            and len(unconfirmed_relationships) < RELATED_GOAL_REPORT_LIMIT
            and lifecycle["planning_disposition"] == "not-considered"
            and note.get("kind") in {
            "backlog-candidate", "execution-candidate", "explicit-instruction"
            }
        ):
            candidate_goal_id = str(candidates[0]["goal_id"])
            relationship = {
                "note_id": note.get("item_id"),
                "title": note.get("text"),
                "state": stage_name,
                "candidates": candidates,
                "decision": "Confirm whether this note belongs to a current plan, later work, or context only.",
                "recommendation": "Inspect the local similarity evidence, then record scope only through planning or an explicit non-authorizing relationship.",
                "allowed_dispositions": [
                    workflow_action(
                        "inspect-related-goals",
                        "continuity-triage",
                        f'.agents/continuity/bin/continuity --project-root "$PWD" note related-goals {note["item_id"]}',
                        human_required=True,
                    ),
                    *(
                        [
                            workflow_action(
                                "plan-current-goal",
                                "continuity-plan",
                                f'.agents/continuity/bin/continuity --project-root "$PWD" goal revise {candidate_goal_id} --goal-file <revision-with-note-disposition.json> --author <human> --summary <reason>',
                                human_required=True,
                            )
                        ]
                        if candidates[0].get("goal_state") in {"proposed-plan", "awaiting-feedback", "approved", "queued", "held", *REWORK_STATES}
                        else []
                    ),
                    workflow_action(
                        "relate-later",
                        "continuity-triage",
                        f'.agents/continuity/bin/continuity --project-root "$PWD" note relate {note["item_id"]} --goal-id {candidate_goal_id} --disposition later --reason <reason> --review-after <iso-date-time> --actor <human>',
                        human_required=True,
                    ),
                    workflow_action(
                        "relate-context-only",
                        "continuity-triage",
                        f'.agents/continuity/bin/continuity --project-root "$PWD" note relate {note["item_id"]} --goal-id {candidate_goal_id} --disposition context-only --reason <reason> --actor <human>',
                        human_required=True,
                    ),
                ],
            }
            unconfirmed_relationships.append(relationship)
            decisions_needed.append(relationship)
        if note.get("kind") == "question" and note.get("work_status") in {"open", "deferred"}:
            review_after = parse_recorded_time(note.get("review_after"), config["timezone"])
            if note.get("work_status") == "deferred" and review_after is not None and review_after > current_time:
                continue
            decisions_needed.append(
                {
                    "note_id": note.get("item_id"),
                    "title": note.get("text"),
                    "state": note.get("work_status"),
                    "decision": "Answer or defer the open project question.",
                    "recommendation": "Answer only when it affects an upcoming approved goal.",
                    "allowed_dispositions": [
                        workflow_action("answered", "continuity-triage", f'.agents/continuity/bin/continuity --project-root "$PWD" note resolve {note["capture_id"]} {note["item_id"]} --resolution <answer> --actor <human>', human_required=True),
                        workflow_action("deferred", "continuity-triage", f'.agents/continuity/bin/continuity --project-root "$PWD" note triage {note["capture_id"]} {note["item_id"]} --action defer --review-after <iso-date-time>', human_required=True),
                        workflow_action("archived", "continuity-triage", f'.agents/continuity/bin/continuity --project-root "$PWD" note triage {note["capture_id"]} {note["item_id"]} --action archive', human_required=True),
                    ],
                }
            )
    for pattern in pattern_report["patterns"]:
        if pattern["occurrence_type"] not in {"change", "behavior", "risk", "failure"} and pattern["max_impact"] not in {"high", "critical"}:
            continue
        disposition = pattern_dispositions.get(pattern["pattern_id"])
        if disposition and disposition.get("pattern_hash") == canonical_hash(pattern):
            if disposition.get("disposition") in {"accepted", "dismissed"}:
                continue
            if disposition.get("disposition") == "deferred":
                review_after = parse_recorded_time(disposition.get("review_after"), config["timezone"])
                if review_after is not None and review_after > current_time:
                    continue
        decisions_needed.append(
            {
                "pattern_id": pattern["pattern_id"],
                "title": f"Recurring {pattern['occurrence_type']} signal for {pattern['axis']}",
                "state": "pattern-review",
                "decision": "Accept the recommendation, defer it, or connect it to a roadmap item.",
                "recommendation": pattern["recommendation"],
                "evidence": pattern["note_ids"],
                "allowed_dispositions": [
                    workflow_action(disposition_name, "continuity-triage", f'.agents/continuity/bin/continuity --project-root "$PWD" note pattern-review {pattern["pattern_id"]} --disposition {disposition_name} --actor <human> --evidence <reason>{" --review-after <iso-date-time>" if disposition_name == "deferred" else ""}', human_required=True)
                    for disposition_name in ("accepted", "deferred", "dismissed")
                ] + [
                    workflow_action("accepted-and-linked", "continuity-roadmap", f'.agents/continuity/bin/continuity --project-root "$PWD" note pattern-review {pattern["pattern_id"]} --disposition accepted --actor <human> --evidence <reason> --roadmap-id <roadmap-id>', human_required=True)
                ],
            }
        )
    for audit in product_audits:
        if audit.get("status") in {"failed", "partial", "blocked"}:
            blocked_or_at_risk.append(
                {
                    "type": "product-audit",
                    **audit,
                    "recommendation": "Review current-goal mismatches and capture later-work findings without expanding scope.",
                }
            )
        record = product_audit_lib.load_record(root, config, str(audit["audit_id"]))
        mismatch = [
            item
            for item in (record or {}).get("findings", [])
            if item.get("status") in product_audit_lib.MISMATCH_STATUSES
        ]
        if mismatch and not (record or {}).get("findings_capture"):
            decisions_needed.append(
                {
                    "type": "product-audit-findings",
                    "audit_id": audit["audit_id"],
                    "title": audit["title"],
                    "state": audit["status"],
                    "decision": "Capture product-conformance mismatches for triage.",
                    "recommendation": "Capture findings as non-authorizing project signals, then disposition them through planning.",
                    "finding_count": len(mismatch),
                    "allowed_dispositions": [
                        workflow_action(
                            "capture-findings",
                            "continuity-product-audit",
                            f'.agents/continuity/bin/continuity --project-root "$PWD" audit capture-findings {audit["audit_id"]}',
                        )
                    ],
                }
            )
    if product_audit_due["baseline_required"]:
        decisions_needed.append(
            {
                "type": "product-audit-baseline",
                "title": "Product-conformance baseline is not established",
                "state": "baseline-required",
                "decision": "Choose whether to plan a baseline product audit for the current production surface.",
                "recommendation": "Plan representative journeys when a safe target is available; record explicit constraints instead of inventing access.",
                "allowed_dispositions": [
                    workflow_action(
                        "plan-baseline-audit",
                        "continuity-product-audit",
                        '.agents/continuity/bin/continuity --project-root "$PWD" audit plan --input <baseline-audit-input.json>',
                        human_required=True,
                    )
                ],
            }
        )
    scheduler_health = scheduler_registration_status_for(root, config)
    if scheduler_health["state"] in {"requires-user-registration", "stale"} or scheduler_health["stale_runs"]:
        blocked_or_at_risk.append({"type": "scheduler", "state": scheduler_health["state"], "stale_runs": scheduler_health["stale_runs"], "problems": scheduler_health["problems"]})
    ledger_health = []
    for path in sorted(private_path(root, config).rglob("*.jsonl")):
        try:
            ledger_health.append(runtime_lib.verify_jsonl_records(path))
        except runtime_lib.RuntimeIntegrityError as exc:
            ledger_health.append({"path": runtime_lib.project_relative_posix(path, root), "healthy": False, "problem": str(exc)})
            blocked_or_at_risk.append({"type": "state-integrity", "state": "failed", "problems": [str(exc)]})
    audit_checkpoint = {"required": bool(config.get("require_audit_checkpoints", False)), "verified": True}
    if audit_checkpoint["required"]:
        try:
            audit_checkpoint.update(verify_audit_checkpoint(root, config))
        except ContinuityError as exc:
            audit_checkpoint.update({"verified": False, "problem": str(exc)})
            blocked_or_at_risk.append({"type": "audit-checkpoint", "state": "failed", "problems": [str(exc)]})
    lease = json_load(private_path(root, config) / "remote-lease.json", {})
    return {
        "schema_version": 1,
        "project_id": config["project_id"],
        "generated_at": iso_now(config),
        "decisions_needed": decisions_needed,
        "completed_overnight": completed_overnight,
        "blocked_or_at_risk": blocked_or_at_risk,
        "prepared_next": prepared_next,
        "patterns": pattern_report["patterns"],
        "workflow_status": goal_statuses,
        "note_lifecycle": {
            "stage_counts": note_stage_counts,
            "notes": note_lifecycles,
            "unconfirmed_relationships": unconfirmed_relationships,
        },
        "queue_counts": queue_counts,
        "memory_health": {
            "status": "healthy" if memory_report.get("healthy") else ("unhealthy" if memory_report else "not-audited"),
            "report": memory_report,
        },
        "roadmap_health": {
            "status": "healthy" if roadmap_report.get("healthy") else ("unhealthy" if roadmap_report else "not-audited"),
            "report": roadmap_report,
        },
        "product_audit_health": {
            "status": "attention" if product_audit_due["due"] or product_audit_due["baseline_required"] else "healthy",
            "audit_count": len(product_audits),
            "stale_after_days": product_audit_due["stale_after_days"],
            "baseline_required": product_audit_due["baseline_required"],
            "due": product_audit_due["due"],
            "latest": max(product_audits, key=lambda value: value.get("updated_at", ""), default=None),
        },
        "active_runs": active_runs,
        "behavior_configuration_hash": config.get("behavior_configuration_hash"),
        "no_action_required": not decisions_needed and not blocked_or_at_risk,
        "scheduler": scheduler_health,
        "suite_installation": suite_installation_status(root),
        "state_integrity": {
            "healthy": all(item.get("healthy") for item in ledger_health) and audit_checkpoint["verified"],
            "ledgers": ledger_health,
            "external_checkpoint": audit_checkpoint,
        },
        "remote_lease": {
            key: lease.get(key)
            for key in ("status", "goal_id", "attempt_id", "expires_at", "lease_commit")
            if isinstance(lease, dict) and lease.get(key) is not None
        },
    }


def report_morning(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    return morning_decision_report(root, config)


def report_project(args: argparse.Namespace) -> str:
    root, config = load_context()
    goals = goal_list(argparse.Namespace(state=None))
    decision_report = morning_decision_report(root, config)
    counts: dict[str, int] = {}
    for goal in goals:
        counts[goal["state"]] = counts.get(goal["state"], 0) + 1
    memory_report = json_load(private_path(root, config) / "reports" / "memory-health.json", {})
    roadmap_report = json_load(private_path(root, config) / "reports" / "roadmap-health.json", {})
    product_audits = product_audit_lib.show(root, config)
    shared_inbox = list(iter_jsonl(private_path(root, config) / "queues" / "shared-notes.jsonl"))
    test_reports = list(iter_jsonl(private_path(root, config) / "reports" / "test-reports.jsonl"))
    merge_reports = list(iter_jsonl(private_path(root, config) / "reports" / "merge-assessments.jsonl"))
    human_reviews = list(iter_jsonl(private_path(root, config) / "reports" / "human-reviews.jsonl"))
    lines = [
        f"# Continuity Report: {config['project_id']}",
        "",
        f"Generated: {iso_now(config)}",
        "",
        "## Decisions needed",
        "",
    ]
    if not decision_report["decisions_needed"]:
        lines.append("- No decisions are required.")
    for item in decision_report["decisions_needed"]:
        identifier = item.get("goal_id") or item.get("note_id") or item.get("audit_id") or item.get("type") or "project"
        lines.append(f"- **{identifier}** — {item.get('title', 'Operational decision')} — {item['decision']} Recommendation: {item['recommendation']}")
        for action in item.get("allowed_dispositions", []):
            lines.append(f"  - `{action.get('disposition')}`: `{action.get('command')}`")
    lines.extend(["", "## Completed overnight", ""])
    if not decision_report["completed_overnight"]:
        lines.append("- No work was recorded as human-complete during this reporting window.")
    for item in decision_report["completed_overnight"]:
        lines.append(f"- **{item['goal_id']}** — {item['title']} — {item.get('summary') or 'Completed with recorded evidence.'}")
    lines.extend(["", "## Blocked or at risk", ""])
    if not decision_report["blocked_or_at_risk"]:
        lines.append("- No recorded blockers or operational risks.")
    for item in decision_report["blocked_or_at_risk"]:
        identifier = item.get("goal_id") or item.get("type", "project")
        lines.append(f"- **{identifier}** — `{item.get('state', 'unknown')}` — {item.get('summary') or ', '.join(item.get('problems', [])) or 'Review recorded evidence.'}")
    lines.extend([
        "",
        "## Configuration",
        "",
        f"- Behavior hash: `{config.get('behavior_configuration_hash', 'legacy-unconfigured')}`",
        f"- Behavior skill: `{config.get('behavior_skill_path', 'legacy-unconfigured')}`",
        "- Health: validated",
        "",
        "## Goals",
        "",
    ])
    if not goals:
        lines.append("No tracked goals.")
    for state, count in sorted(counts.items()):
        lines.append(f"- {state}: {count}")
    lines.extend(["", "## Note lifecycle", ""])
    note_lifecycle = decision_report.get("note_lifecycle", {})
    stage_counts = note_lifecycle.get("stage_counts", {}) if isinstance(note_lifecycle, dict) else {}
    if not stage_counts:
        lines.append("- No captured notes.")
    for stage, count in sorted(stage_counts.items()):
        lines.append(f"- {stage}: {count}")
    for item in note_lifecycle.get("unconfirmed_relationships", []) if isinstance(note_lifecycle, dict) else []:
        lines.append(f"- **{item['note_id']}** — unconfirmed related-goal suggestion; run the listed inspection disposition.")
    lines.extend(["", "## Goal detail", ""])
    for goal in sorted(goals, key=lambda value: value.get("updated_at", ""), reverse=True):
        compliance = json_load(goal_dir(root, config, goal["goal_id"]) / "compliance.json", {})
        pending = [stage for stage, detail in compliance.get("stages", {}).items() if detail.get("status") in {"pending", "failed"}]
        lines.append(f"- **{goal['goal_id']}** — {goal['title']} — `{goal['state']}` — compliance pending: {', '.join(pending) or 'none'}")
    lines.extend(["", "## Project memory", ""])
    if memory_report:
        lines.extend(
            [
                f"- Entries audited: {memory_report.get('entries', 0)}",
                f"- Missing metadata: {len(memory_report.get('missing_frontmatter', []))}",
                f"- Stale entries: {len(memory_report.get('stale', []))}",
                f"- Healthy: {memory_report.get('healthy', False)}",
            ]
        )
    else:
        lines.append("- Memory health has not been audited.")
    lines.extend(["", "## Roadmap and shared context", ""])
    if roadmap_report:
        lines.extend([
            f"- Roadmap entries audited: {roadmap_report.get('entries', 0)}",
            f"- Roadmap healthy: {roadmap_report.get('healthy', False)}",
            f"- Roadmap cycles: {len(roadmap_report.get('cycles', []))}",
            f"- Roadmap stale note links: {len(roadmap_report.get('stale_note_links', []))}",
        ])
    else:
        lines.append("- Roadmap health has not been audited.")
    lines.append(f"- Imported shared-note packets awaiting triage: {len(shared_inbox)}")
    lines.extend(["", "## Product conformance", ""])
    if product_audits:
        latest_audit = max(product_audits, key=lambda value: value.get("updated_at", ""))
        lines.extend(
            [
                f"- Audits recorded or in progress: {len(product_audits)}",
                f"- Latest audit: `{latest_audit['audit_id']}` — `{latest_audit['status']}` — {latest_audit['title']}",
                f"- Refresh interval: {config.get('product_audit_stale_after_days', 30)} days",
            ]
        )
    else:
        lines.append("- No product-conformance audit has been planned.")
    lines.extend(["", "## Testing and merge readiness", ""])
    if test_reports:
        latest_test = test_reports[-1]
        lines.append(f"- Latest test report: `{latest_test.get('status')}` for `{latest_test.get('goal_id')}` — {latest_test.get('summary', '')}")
    else:
        lines.append("- No Continuity test report has been recorded.")
    if merge_reports:
        latest_merge = merge_reports[-1]
        lines.append(f"- Latest merge assessment: `{latest_merge.get('status')}` for `{latest_merge.get('goal_id')}` — PR: {latest_merge.get('pr_url') or 'not recorded'}")
    else:
        lines.append("- No merge-safety assessment has been recorded.")
    lines.append(f"- Human review records: {len(human_reviews)}")
    return "\n".join(lines) + "\n"


def product_audit_goal_context(
    root: Path,
    config: dict[str, Any],
    goal_id: str,
) -> tuple[Path, dict[str, Any], dict[str, Any], list[dict[str, Any]]]:
    directory, goal = load_goal(root, config, goal_id)
    binding = {
        "goal_id": goal_id,
        "plan_version": goal.get("plan_version"),
        "plan_hash": goal.get("plan_hash"),
        "source_capture_refs": goal.get("source_capture_refs", []),
        "memory_ids": goal.get("memory_ids", []),
        "roadmap_ids": goal.get("roadmap_ids", []),
    }
    sources: list[dict[str, Any]] = [
        {
            "source_id": f"goal-{goal_id}",
            "source_type": "approved-goal",
            "authority": "current-approved",
            "applicability": "Current approved scope, exclusions, and acceptance criteria.",
            "time_horizon": "current",
            "reference": f".continuity/private/goals/{goal_id}/plan.md",
            "content_hash": str(goal.get("plan_hash")),
            "revision": str(goal.get("plan_version")),
        }
    ]
    for capture in goal.get("source_capture_refs", []):
        capture_id = str(capture.get("capture_id"))
        sources.append(
            {
                "source_id": f"capture-{capture_id}",
                "source_type": "project-intent",
                "authority": "canonical" if capture.get("source_authority") == "project-intent" else "advisory",
                "applicability": "Captured source document associated with the approved goal.",
                "time_horizon": "current",
                "reference": f"capture:{capture_id}",
                "content_hash": capture.get("source_hash"),
                "revision": str(capture.get("document_revision", "unknown")),
            }
        )
    for memory_id in goal.get("memory_ids", []):
        sources.append(
            {
                "source_id": f"memory-{memory_id}",
                "source_type": "memory",
                "authority": "canonical",
                "applicability": "Current project-memory context named by the approved goal.",
                "time_horizon": "current",
                "reference": f"memory:{memory_id}",
            }
        )
    for roadmap_id in goal.get("roadmap_ids", []):
        sources.append(
            {
                "source_id": f"roadmap-{roadmap_id}",
                "source_type": "roadmap",
                "authority": "canonical",
                "applicability": "Roadmap context; future intent is advisory unless included in current acceptance criteria.",
                "time_horizon": "future",
                "reference": f"roadmap:{roadmap_id}",
            }
        )
    return directory, goal, binding, sources


def product_audit_target_binding(
    root: Path,
    config: dict[str, Any],
    goal: dict[str, Any] | None,
    worktree_value: str | None,
    branch_value: str | None,
) -> tuple[Path, dict[str, Any]]:
    execution: dict[str, Any] = {}
    if goal is not None:
        execution = json_load(goal_dir(root, config, str(goal["goal_id"])) / "execution.json", {})
        if not isinstance(execution, dict):
            execution = {}
    worktree = Path(worktree_value or execution.get("worktree") or root).expanduser().resolve()
    snapshot = worktree_source_snapshot(worktree)
    enrolled = worktree_source_snapshot(root)
    if snapshot["repository_fingerprint"] != enrolled["repository_fingerprint"]:
        raise ContinuityError("Product audit worktree does not belong to the enrolled repository")
    expected_branch = branch_value or execution.get("branch")
    if expected_branch and snapshot["branch"] != expected_branch:
        raise ContinuityError(
            f"Product audit worktree is on {snapshot['branch']}, not {expected_branch}"
        )
    if goal is not None and execution.get("branch") and snapshot["branch"] != execution.get("branch"):
        raise ContinuityError("Product audit does not match the goal execution branch")
    snapshot["worktree"] = str(worktree)
    snapshot["plan_hash"] = goal.get("plan_hash") if goal else None
    snapshot["behavior_configuration_hash"] = config.get("behavior_configuration_hash")
    return worktree, snapshot


def product_audit_command(args: argparse.Namespace) -> Any:
    root, config = load_context()
    try:
        if args.command == "plan":
            payload = json_load(Path(args.input).expanduser().resolve(), {})
            if not isinstance(payload, dict):
                raise ContinuityError("Product audit input must be a JSON object")
            goal_id = args.goal_id or payload.get("goal_id")
            binding = None
            sources: list[dict[str, Any]] = []
            if goal_id:
                _directory, _goal, binding, sources = product_audit_goal_context(
                    root, config, str(goal_id)
                )
            return product_audit_lib.create_plan(
                root,
                config,
                Path(args.input).expanduser().resolve(),
                goal_binding=binding,
                additional_sources=sources,
            )
        if args.command == "start":
            plan = product_audit_lib.load_plan(root, config, args.audit_id)
            goal = None
            if plan.get("goal_id"):
                _directory, goal = load_goal(root, config, str(plan["goal_id"]))
            _worktree, binding = product_audit_target_binding(
                root, config, goal, args.worktree, args.branch
            )
            return product_audit_lib.start(
                root, config, args.audit_id, actor=args.actor, target_binding=binding
            )
        if args.command == "record":
            plan = product_audit_lib.load_plan(root, config, args.audit_id)
            directory = None
            goal = None
            if plan.get("goal_id"):
                directory, goal = load_goal(root, config, str(plan["goal_id"]))
            worktree, binding = product_audit_target_binding(
                root, config, goal, args.worktree, args.branch
            )
            artifact = None
            if args.artifact:
                artifact_path = Path(args.artifact).expanduser()
                if not artifact_path.is_absolute():
                    artifact_path = worktree / artifact_path
                artifact_path = artifact_path.resolve()
                if (
                    not artifact_path.is_file()
                    or artifact_path.name != "product-conformance.md"
                    or not artifact_path.is_relative_to(worktree)
                ):
                    raise ContinuityError(
                        "Product conformance artifact must be product-conformance.md inside the audited worktree"
                    )
                artifact = {
                    "path": str(artifact_path.relative_to(worktree)),
                    "sha256": hashlib.sha256(artifact_path.read_bytes()).hexdigest(),
                }
            if (
                plan.get("profile") == "candidate"
                and config.get("require_execution_artifacts", False)
                and artifact is None
            ):
                raise ContinuityError("Candidate product audits require product-conformance.md")
            if (
                plan.get("profile") == "candidate"
                and directory is not None
                and goal is not None
                and args.update_gate
            ):
                test_failures = current_test_evidence_failures(root, config, directory, goal)
                if test_failures:
                    raise ContinuityError(
                        f"Candidate product audit requires current passed test evidence: {test_failures}"
                    )
            record = product_audit_lib.record(
                root,
                config,
                args.audit_id,
                Path(args.result_file).expanduser().resolve(),
                actor=args.actor,
                current_binding=binding,
                sanitized_artifact=artifact,
                evidence_root=worktree,
            )
            if directory is not None and goal is not None:
                json_dump(directory / "product-audit.json", record)
                if args.update_gate:
                    gate_status = "passed" if record["status"] == "passed" else "failed"
                    record_compliance_stage(
                        root,
                        config,
                        directory,
                        goal,
                        "product-conformance",
                        gate_status,
                        [
                            f"audit:{record['audit_id']}",
                            f"result-hash:{record['result_hash']}",
                            f"source-set-hash:{record['source_set_hash']}",
                            f"source-fingerprint:{binding['source_fingerprint']}",
                        ],
                        args.actor,
                    )
            return record
        if args.command == "capture-findings":
            record = product_audit_lib.load_record(root, config, args.audit_id)
            if record is None:
                raise ContinuityError("Product audit has no recorded findings")
            if record.get("findings_capture"):
                return {
                    "audit_id": args.audit_id,
                    "deduplicated": True,
                    "findings_capture": record["findings_capture"],
                    "execution_authorized": False,
                }
            mismatch = [
                item
                for item in record.get("findings", [])
                if item.get("status") in product_audit_lib.MISMATCH_STATUSES
            ]
            if not mismatch:
                return {
                    "audit_id": args.audit_id,
                    "captured": False,
                    "reason": "No mismatch findings require capture",
                    "execution_authorized": False,
                }
            items = []
            for item in mismatch:
                severity = str(item.get("severity", "medium"))
                items.append(
                    {
                        "kind": "execution-candidate" if severity in {"high", "critical"} else "backlog-candidate",
                        "text": f"{item['title']}: {item['summary']} Recommendation: {item['recommendation']}",
                        "perspective": "internal",
                        "sentiment": "negative",
                        "occurrence_type": "failure" if item.get("status") in {"missing", "contradicted", "regressed"} else "observation",
                        "impact": severity if severity in NOTE_IMPACTS else "unknown",
                        "confidence": item.get("confidence", "unknown"),
                        "actionability": "urgent-review" if severity == "critical" else ("plan" if severity in {"high", "medium"} else "monitor"),
                        "themes": ["product-conformance", str(item.get("status"))],
                    }
                )
            capture_input = private_path(root, config) / "audits" / args.audit_id / "findings-capture-input.json"
            json_dump(
                capture_input,
                {
                    "source_type": "product-audit",
                    "source_ref": f"product-audit:{args.audit_id}",
                    "dedupe_key": record["result_hash"],
                    "items": items,
                },
            )
            capture = note_capture(
                argparse.Namespace(
                    items_file=str(capture_input),
                    text=None,
                    file=None,
                    source_type="product-audit",
                    source_ref=f"product-audit:{args.audit_id}",
                    document_type=None,
                    document_id=None,
                    document_version=None,
                    source_authority=None,
                )
            )
            binding = product_audit_lib.attach_capture(
                root,
                config,
                args.audit_id,
                capture_id=str(capture["capture_id"]),
                note_ids=[str(item["item_id"]) for item in capture.get("items", [])],
            )
            return {
                "audit_id": args.audit_id,
                "captured": True,
                "findings_capture": binding,
                "execution_authorized": False,
            }
        if args.command == "show":
            return product_audit_lib.show(root, config, args.audit_id)
        if args.command == "compare":
            return product_audit_lib.compare(root, config, args.audit_id, args.against)
        if args.command == "due":
            return product_audit_lib.due(
                root, config, int(config.get("product_audit_stale_after_days", 30))
            )
    except product_audit_lib.ProductAuditError as exc:
        raise ContinuityError(str(exc)) from exc
    raise ContinuityError(f"Unsupported product audit command: {args.command}")


