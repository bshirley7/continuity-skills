def automatic_roadmap_sync(args: argparse.Namespace, value: Any) -> Any:
    mutating_handlers = {
        goal_create,
        goal_revise,
        goal_approve,
        goal_activate,
        goal_proceed,
        goal_start,
        goal_transition,
        run_update,
        merge_execute,
        merge_record_human,
    }
    roadmap_mutation = args.handler is roadmap_command and getattr(args, "command", None) in {"create", "revise", "link-note"}
    if args.handler not in mutating_handlers and not roadmap_mutation:
        return value
    if args.handler is goal_create and isinstance(value, dict) and value.get("authorization_mode") == "goal-request":
        # /goal immediately activates after creation; publish the dispatched state once instead of syncing twice.
        return value
    root, config = load_context()
    if config.get("planning_patterns", {}).get("tracker_provider") != "github":
        return value
    connection = github_projects_lib.load_connection(root, config, required=False)
    if connection is None or connection.get("sync_policy", {}).get("automatic") is not True:
        return value
    try:
        sync_result = github_projects_lib.sync(
            root,
            config,
            client=github_projects_lib.GitHubClient(
                host=str(connection["destination"].get("host", "github.com")),
                timeout_seconds=5,
            ),
        )
    except github_projects_lib.GitHubProjectsError as exc:
        stamp = iso_now(config)
        sync_result = {
            "status": "advisory-failed",
            "provider": "github-projects",
            "at": stamp,
            "problem": str(exc),
            "canonical_transition_preserved": True,
        }
        json_dump(
            private_path(root, config) / "integrations" / "github-projects" / "last-sync.json",
            sync_result,
        )
        append_jsonl(
            private_path(root, config) / "events.jsonl",
            {"at": stamp, "event": "roadmap.sync-advisory", "provider": "github-projects", "problem": str(exc)},
        )
    if isinstance(value, dict):
        return {**value, "roadmap_sync": sync_result}
    return value


def main() -> int:
    runtime_lib.configure_utf8_stdio()
    parser = build_parser()
    args = parser.parse_args()
    if args.project_root:
        os.environ["CONTINUITY_PROJECT_ROOT"] = str(Path(args.project_root).expanduser().resolve())
    try:
        if args.domain == "portfolio" or os.environ.get("CONTINUITY_STATE_LOCK_HELD") == "1":
            value = args.handler(args)
        else:
            root = find_project_root()
            restore_pending = (root / ".continuity-restore").exists()
            restore_diagnostic = args.domain == "project" and args.command == "doctor"
            restore_recovery = args.domain == "state" and args.command == "recover-restore"
            if restore_pending and not (restore_diagnostic or restore_recovery):
                raise ContinuityError(
                    "an interrupted state restore blocks normal operation; run `state recover-restore`"
                )
            with exclusive_file_lock(project_state_lock_path(root)):
                os.environ["CONTINUITY_STATE_LOCK_HELD"] = "1"
                try:
                    value = args.handler(args)
                    value = automatic_roadmap_sync(args, value)
                finally:
                    os.environ.pop("CONTINUITY_STATE_LOCK_HELD", None)
        output(value, args.json)
        return 0
    except ContinuityError as exc:
        print(f"continuity: {runtime_lib.redact_sensitive_text(exc)}", file=sys.stderr)
        return 2
    except sqlite3.OperationalError as exc:
        print(f"continuity: SQLite search failed: {runtime_lib.redact_sensitive_text(exc)}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
