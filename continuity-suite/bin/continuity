class ContinuityError(RuntimeError):
    pass


def now(config: dict[str, Any]) -> dt.datetime:
    return dt.datetime.now(ZoneInfo(config.get("timezone", "America/Chicago")))


def iso_now(config: dict[str, Any]) -> str:
    return now(config).isoformat(timespec="seconds")


def json_dump(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(path.suffix + ".tmp")
    temp.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temp.replace(path)


def json_load(path: Path, default: Any = None) -> Any:
    if not path.exists():
        return default
    return json.loads(path.read_text(encoding="utf-8"))


def append_jsonl(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(value, sort_keys=True) + "\n")


def iter_jsonl(path: Path) -> Iterable[dict[str, Any]]:
    if not path.exists():
        return []
    values: list[dict[str, Any]] = []
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        if not line.strip():
            continue
        try:
            values.append(json.loads(line))
        except json.JSONDecodeError as exc:
            raise ContinuityError(f"Invalid JSONL at {path}:{number}: {exc}") from exc
    return values


def find_project_root(start: Path | None = None) -> Path:
    env = os.environ.get("CONTINUITY_PROJECT_ROOT")
    if env:
        root = Path(env).expanduser().resolve()
        if not (root / ".continuity" / "config.json").exists():
            raise ContinuityError(f"No .continuity/config.json below {root}")
        return root
    current = (start or Path.cwd()).resolve()
    for candidate in [current, *current.parents]:
        if (candidate / ".continuity" / "config.json").exists():
            return candidate
    raise ContinuityError("Run inside a configured project or set CONTINUITY_PROJECT_ROOT")


def load_context(start: Path | None = None, *, validate_behavior: bool = True) -> tuple[Path, dict[str, Any]]:
    root = find_project_root(start)
    config = json_load(root / ".continuity" / "config.json")
    if not isinstance(config, dict) or config.get("schema_version") != SCHEMA_VERSION:
        raise ContinuityError("Unsupported or missing continuity configuration")
    if config.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Missing or unsupported development assurance standard")
    confined_path(root, config.get("private_dir", ".continuity/private"), "private_dir")
    confined_path(root, config.get("memory_docs", "docs/project-memory"), "memory_docs")
    confined_path(root, config.get("roadmap_docs", "docs/project-roadmap"), "roadmap_docs")
    if validate_behavior and config.get("behavior_config_path"):
        validate_project_behavior(root, config)
    return root, config


def load_project_manifest(root: Path) -> dict[str, Any]:
    manifest = json_load(root / ".continuity" / "project.json", {})
    if not isinstance(manifest, dict) or manifest.get("schema_version") != SCHEMA_VERSION:
        raise ContinuityError(f"Project-local continuity manifest is missing or invalid at {root}")
    if manifest.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError(f"Project-local assurance standard is missing or unsupported at {root}")
    return manifest


def confined_path(root: Path, value: str, label: str) -> Path:
    candidate = Path(value)
    if candidate.is_absolute():
        raise ContinuityError(f"{label} must be a project-relative path")
    resolved = (root / candidate).resolve()
    if not resolved.is_relative_to(root.resolve()):
        raise ContinuityError(f"{label} escapes the project root")
    return resolved


def private_path(root: Path, config: dict[str, Any]) -> Path:
    return confined_path(root, config.get("private_dir", ".continuity/private"), "private_dir")


def slug(value: str, limit: int = 56) -> str:
    normalized = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return normalized[:limit].rstrip("-") or "item"


def stable_id(prefix: str, *parts: str) -> str:
    digest = hashlib.sha256("\x1f".join(parts).encode()).hexdigest()[:10]
    return f"{prefix}-{digest}"


def validate_identifier(value: str, label: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", value):
        raise ContinuityError(f"Invalid {label}: use 1-128 letters, numbers, dots, underscores, or hyphens")
    return value


def canonical_hash(value: Any) -> str:
    return hashlib.sha256(
        json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()


def validate_string_list(value: Any, label: str, *, required: bool = False) -> list[str]:
    if not isinstance(value, list) or any(not isinstance(item, str) or not item.strip() for item in value):
        raise ContinuityError(f"{label} must be an array of non-empty strings")
    if required and not value:
        raise ContinuityError(f"{label} must contain at least one item")
    return value


def validate_dag(nodes: set[str], edges: dict[str, list[str]], label: str) -> None:
    for node, blockers in edges.items():
        unknown = sorted(set(blockers) - nodes)
        if unknown:
            raise ContinuityError(f"{label} {node} references unknown blockers: {unknown}")
        if node in blockers:
            raise ContinuityError(f"{label} {node} cannot block itself")
    visiting: set[str] = set()
    visited: set[str] = set()

    def visit(node: str) -> None:
        if node in visiting:
            raise ContinuityError(f"{label} dependency graph contains a cycle at {node}")
        if node in visited:
            return
        visiting.add(node)
        for blocker in edges.get(node, []):
            visit(blocker)
        visiting.remove(node)
        visited.add(node)

    for node in sorted(nodes):
        visit(node)


def validate_triage_brief(value: Any) -> dict[str, Any] | None:
    if value is None:
        return None
    if not isinstance(value, dict):
        raise ContinuityError("triage_brief must be a JSON object")
    required_strings = ("summary", "classification", "claim_status", "current_behavior", "desired_behavior")
    for key in required_strings:
        if not isinstance(value.get(key), str) or not value[key].strip():
            raise ContinuityError(f"triage_brief.{key} must be a non-empty string")
    if value["classification"] not in NOTE_KINDS:
        raise ContinuityError("triage_brief.classification is not a supported note kind")
    if value["claim_status"] not in {"confirmed", "unconfirmed", "contradicted", "not-applicable"}:
        raise ContinuityError("triage_brief.claim_status is unsupported")
    for key in ("acceptance_criteria", "scope_exclusions", "evidence"):
        validate_string_list(value.get(key), f"triage_brief.{key}", required=key != "scope_exclusions")
    checks = value.get("codebase_checks")
    if not isinstance(checks, dict) or set(checks) != {"redundancy", "prior_decisions"}:
        raise ContinuityError("triage_brief.codebase_checks must define exactly redundancy and prior_decisions")
    for key, check in checks.items():
        if not isinstance(check, dict) or check.get("status") not in {"clear", "found", "uncertain", "not-applicable"}:
            raise ContinuityError(f"triage_brief.codebase_checks.{key}.status is unsupported")
        validate_string_list(check.get("evidence"), f"triage_brief.codebase_checks.{key}.evidence", required=True)
    normalized = dict(value)
    if normalized.get("execution_authorized") not in {None, False}:
        raise ContinuityError("A triage brief cannot authorize execution")
    normalized["execution_authorized"] = False
    return normalized


def validate_decision_map(value: Any) -> dict[str, Any] | None:
    if value is None:
        return None
    if not isinstance(value, dict) or not isinstance(value.get("destination"), str) or not value["destination"].strip():
        raise ContinuityError("decision_map requires a non-empty destination")
    for key in ("unresolved_territory", "out_of_scope"):
        validate_string_list(value.get(key), f"decision_map.{key}")
    decisions = value.get("decisions")
    if not isinstance(decisions, list) or not decisions:
        raise ContinuityError("decision_map.decisions must contain at least one decision")
    nodes: set[str] = set()
    edges: dict[str, list[str]] = {}
    for decision in decisions:
        if not isinstance(decision, dict):
            raise ContinuityError("Each decision_map decision must be a JSON object")
        decision_id = validate_identifier(str(decision.get("decision_id", "")), "decision ID")
        if decision_id in nodes:
            raise ContinuityError(f"Duplicate decision ID: {decision_id}")
        nodes.add(decision_id)
        for key in ("title", "question"):
            if not isinstance(decision.get(key), str) or not decision[key].strip():
                raise ContinuityError(f"Decision {decision_id} requires a non-empty {key}")
        if decision.get("status") not in {"open", "resolved", "blocked", "human-required"}:
            raise ContinuityError(f"Decision {decision_id} has an unsupported status")
        blockers = validate_string_list(decision.get("blocked_by", []), f"Decision {decision_id}.blocked_by")
        edges[decision_id] = blockers
        if decision.get("status") == "resolved" and (not isinstance(decision.get("resolution"), str) or not decision["resolution"].strip()):
            raise ContinuityError(f"Resolved decision {decision_id} requires a resolution")
    validate_dag(nodes, edges, "Decision")
    normalized = dict(value)
    if normalized.get("execution_authorized") not in {None, False}:
        raise ContinuityError("A decision map cannot authorize execution")
    normalized["execution_authorized"] = False
    return normalized


def validate_delivery_slices(value: Any) -> list[dict[str, Any]]:
    if value is None:
        return []
    if not isinstance(value, list):
        raise ContinuityError("delivery_slices must be a JSON array")
    nodes: set[str] = set()
    edges: dict[str, list[str]] = {}
    normalized: list[dict[str, Any]] = []
    for item in value:
        if not isinstance(item, dict):
            raise ContinuityError("Each delivery slice must be a JSON object")
        ticket_id = validate_identifier(str(item.get("ticket_id", "")), "delivery slice ID")
        if ticket_id in nodes:
            raise ContinuityError(f"Duplicate delivery slice ID: {ticket_id}")
        nodes.add(ticket_id)
        for key in ("title", "delivers"):
            if not isinstance(item.get(key), str) or not item[key].strip():
                raise ContinuityError(f"Delivery slice {ticket_id} requires a non-empty {key}")
        validate_string_list(item.get("acceptance_criteria"), f"Delivery slice {ticket_id}.acceptance_criteria", required=True)
        blockers = validate_string_list(item.get("blocked_by", []), f"Delivery slice {ticket_id}.blocked_by")
        edges[ticket_id] = blockers
        if item.get("status", "planning-candidate") != "planning-candidate":
            raise ContinuityError("Delivery slices remain planning-candidate until the parent goal is approved and dispatched")
        if item.get("execution_authorized") not in {None, False}:
            raise ContinuityError("A delivery slice cannot authorize execution")
        normalized.append({**item, "status": "planning-candidate", "execution_authorized": False})
    validate_dag(nodes, edges, "Delivery slice")
    return normalized


def validate_roadmap_impact(value: Any, roadmap_ids: list[str]) -> dict[str, Any]:
    if value is None:
        return {"entries": [], "documentation_required": False, "summary": "No roadmap change planned."}
    if not isinstance(value, dict):
        raise ContinuityError("roadmap_impact must be a JSON object")
    entries = value.get("entries", [])
    if not isinstance(entries, list):
        raise ContinuityError("roadmap_impact.entries must be an array")
    normalized = []
    seen: set[tuple[str, str]] = set()
    for item in entries:
        if not isinstance(item, dict):
            raise ContinuityError("Each roadmap impact must be a JSON object")
        roadmap_id = validate_identifier(str(item.get("roadmap_id", "")), "roadmap ID")
        action = item.get("action")
        if action not in roadmap_lib.IMPACT_ACTIONS:
            raise ContinuityError(f"Unsupported roadmap impact action: {action}")
        if roadmap_id not in roadmap_ids:
            raise ContinuityError(f"Roadmap impact {roadmap_id} is absent from roadmap_ids")
        if (roadmap_id, action) in seen:
            raise ContinuityError(f"Duplicate roadmap impact: {roadmap_id} {action}")
        seen.add((roadmap_id, action))
        rationale = item.get("rationale")
        if not isinstance(rationale, str) or not rationale.strip():
            raise ContinuityError(f"Roadmap impact {roadmap_id} requires a rationale")
        normalized.append({**item, "roadmap_id": roadmap_id, "action": action, "rationale": rationale.strip()})
    summary = value.get("summary", "")
    if not isinstance(summary, str) or not summary.strip():
        raise ContinuityError("roadmap_impact.summary must be a non-empty string")
    documentation_required = value.get("documentation_required", bool([item for item in normalized if item["action"] != "none"]))
    if not isinstance(documentation_required, bool):
        raise ContinuityError("roadmap_impact.documentation_required must be true or false")
    if any(item["action"] != "none" for item in normalized) and not documentation_required:
        raise ContinuityError("Roadmap changes require roadmap impact documentation")
    return {"entries": normalized, "documentation_required": documentation_required, "summary": summary.strip()}


def validate_goal_roadmap_targets(root: Path, config: dict[str, Any], roadmap_ids: list[str], impact: dict[str, Any]) -> None:
    roadmap_entries = roadmap_lib.entries(root, config)
    current = {item.get("roadmap_id") for item in roadmap_entries}
    actions = {item["roadmap_id"]: item["action"] for item in impact.get("entries", [])}
    counts = {roadmap_id: sum(1 for item in roadmap_entries if item.get("roadmap_id") == roadmap_id) for roadmap_id in roadmap_ids}
    for roadmap_id in roadmap_ids:
        action = actions.get(roadmap_id, "none")
        if action == "create" and roadmap_id in current:
            raise ContinuityError(f"Roadmap create target already exists: {roadmap_id}")
        if action != "create" and roadmap_id not in current:
            raise ContinuityError(f"Roadmap retrieval target does not exist: {roadmap_id}")
        if counts[roadmap_id] > 1:
            raise ContinuityError(f"Roadmap retrieval target is duplicated: {roadmap_id}")
        if action != "create":
            try:
                roadmap_lib.normalize_entry(next(item for item in roadmap_entries if item.get("roadmap_id") == roadmap_id))
            except roadmap_lib.RoadmapError as exc:
                raise ContinuityError(f"Roadmap retrieval target is invalid: {roadmap_id}: {exc}") from exc
    if roadmap_ids:
        report = roadmap_lib.audit(root, config)
        targets = set(roadmap_ids)
        blocking = []
        for key in ("unknown_parents", "unknown_dependencies", "unknown_links", "contradictions", "stale_note_links"):
            for issue in report.get(key, []):
                if issue.get("roadmap_id") in targets:
                    blocking.append({key: issue})
        for cycle in report.get("cycles", []):
            if targets.intersection(cycle):
                blocking.append({"cycle": cycle})
        if blocking:
            raise ContinuityError(f"Roadmap context requires reconciliation before planning: {blocking}")


def roadmap_fingerprint(root: Path, config: dict[str, Any], roadmap_ids: list[str]) -> str:
    by_id = {item.get("roadmap_id"): item for item in roadmap_lib.entries(root, config)}
    material = {}
    for roadmap_id in sorted(roadmap_ids):
        item = by_id.get(roadmap_id)
        material[roadmap_id] = hashlib.sha256((root / item["path"]).read_bytes()).hexdigest() if item else "missing-at-plan-time"
    return canonical_hash(material)


def render_planning_artifacts(goal: dict[str, Any]) -> str:
    lines = ["<!-- continuity-planning-artifacts:start -->", "## Planning evidence and decomposition"]
    brief = goal.get("triage_brief")
    if brief:
        lines.extend([
            "", "### Evidence triage brief", "",
            f"- Classification: `{brief['classification']}`",
            f"- Claim status: `{brief['claim_status']}`",
            f"- Summary: {brief['summary']}",
            f"- Current behavior: {brief['current_behavior']}",
            f"- Desired behavior: {brief['desired_behavior']}",
        ])
    decision_map = goal.get("decision_map")
    if decision_map:
        lines.extend(["", "### Decision map", "", f"Destination: {decision_map['destination']}", ""])
        for decision in decision_map["decisions"]:
            blockers = ", ".join(decision.get("blocked_by", [])) or "none"
            lines.append(f"- **{decision['title']}** (`{decision['decision_id']}`, {decision['status']}; blocked by: {blockers}) — {decision['question']}")
        if decision_map["unresolved_territory"]:
            lines.extend(["", "Unresolved territory:", *[f"- {item}" for item in decision_map["unresolved_territory"]]])
        if decision_map["out_of_scope"]:
            lines.extend(["", "Out of scope:", *[f"- {item}" for item in decision_map["out_of_scope"]]])
    slices = goal.get("delivery_slices", [])
    if slices:
        lines.extend(["", "### Delivery slices", ""])
        for item in slices:
            blockers = ", ".join(item.get("blocked_by", [])) or "none"
            lines.append(f"- **{item['title']}** (`{item['ticket_id']}`; blocked by: {blockers}) — {item['delivers']}")
    roadmap_ids = goal.get("roadmap_ids", [])
    impact = goal.get("roadmap_impact", {})
    lines.extend(["", "### Roadmap context and impact", "", f"Retrieved roadmap IDs: {', '.join(roadmap_ids) or 'none'}"])
    lines.append(f"Roadmap baseline fingerprint: `{goal.get('roadmap_fingerprint', 'not-recorded')}`")
    if impact.get("entries"):
        for item in impact["entries"]:
            lines.append(f"- `{item['roadmap_id']}` — **{item['action']}** — {item['rationale']}")
    else:
        lines.append("- No committed roadmap change is planned.")
    lines.append(f"- Impact summary: {impact.get('summary', 'No roadmap change planned.')}")
    lines.extend(["", "These artifacts inform the plan and are included in its approval hash. They do not authorize execution.", "<!-- continuity-planning-artifacts:end -->"])
    return "\n".join(lines)


def with_planning_artifacts(plan: str, goal: dict[str, Any]) -> str:
    start = "<!-- continuity-planning-artifacts:start -->"
    end = "<!-- continuity-planning-artifacts:end -->"
    if start in plan and end in plan:
        plan = plan.split(start, 1)[0].rstrip() + "\n\n" + plan.split(end, 1)[1].lstrip()
    return plan.rstrip() + "\n\n" + render_planning_artifacts(goal) + "\n"


def behavior_payload_hash(record: dict[str, Any]) -> str:
    payload = {key: value for key, value in record.items() if key != "configuration_hash"}
    return canonical_hash(payload)


def render_project_behavior_skill(record: dict[str, Any]) -> str:
    project_id = validate_identifier(str(record.get("project_id", "")), "project id")
    configuration_hash = str(record.get("configuration_hash", ""))
    settings = record.get("settings", {})
    fixed = record.get("fixed_guardrails", {})
    overrides = record.get("overrides", [])
    return f'''---
name: continuity-local
description: Apply the committed project-specific continuity configuration for {project_id}. Use with every continuity capture, triage, memory, planning, dispatch, execution, testing, merge, or reporting action in this repository.
---

# Continuity Local Behavior

This skill is generated from `.continuity/project-behavior.json`. Reconfigure through `$continuity` or `continuity project configure`; do not edit this generated file directly.

Configuration hash: `{configuration_hash}`
Recommendation profile: `{record.get("recommendation_profile", BEHAVIOR_PROFILE)}`

## Required use

1. Read this skill after the task-specific continuity skill and before acting.
2. Apply the effective settings below as project instructions.
3. Treat the fixed guardrails as non-overridable. A requested exception requires a suite change and review; a local configuration answer cannot weaken them.
4. Run `continuity project doctor` and stop on configuration drift or hash mismatch.

## Effective settings

```json
{json.dumps(settings, indent=2, sort_keys=True)}
```

Explicitly overridden fields: `{json.dumps(overrides)}`

## Fixed guardrails

```json
{json.dumps(fixed, indent=2, sort_keys=True)}
```

Project settings refine how the suite operates; they never convert notes into authorization or bypass approval, audit, security, validation, merge-safety, documentation, or human-review gates.
'''


def replace_managed_block(text: str, start: str, end: str, block: str | None) -> str:
    if start in text and end in text:
        before = text.split(start, 1)[0].rstrip()
        after = text.split(end, 1)[1].lstrip()
        pieces = [item for item in (before, block.rstrip() if block else "", after) if item]
        return "\n\n".join(pieces).rstrip() + "\n" if pieces else ""
    if not block:
        return text
    return text.rstrip() + ("\n\n" if text.strip() else "") + block.rstrip() + "\n"


def continuity_skill_names(root: Path) -> list[str]:
    skills_root = root / ".agents" / "skills"
    return sorted(
        path.name
        for path in skills_root.glob("continuity*")
        if path.is_dir() and (path / "SKILL.md").is_file()
    )


def remove_owned_skill_adapters(target: Path) -> None:
    if not target.exists():
        return
    for path in target.glob("continuity*"):
        if path.is_dir() and not path.is_symlink():
            shutil.rmtree(path)
        elif path.exists() or path.is_symlink():
            path.unlink()


def remove_owned_reference_adapters(root: Path, surface_root: Path) -> None:
    source_references = root / ".agents" / "references"
    target_references = surface_root / "references"
    if not source_references.is_dir() or not target_references.is_dir():
        return
    for source in source_references.rglob("*"):
        if source.is_file():
            target = target_references / source.relative_to(source_references)
            if target.is_file():
                target.unlink()


def directory_fingerprint(path: Path) -> dict[str, str]:
    if not path.is_dir():
        return {}
    return {
        str(item.relative_to(path)): hashlib.sha256(item.read_bytes()).hexdigest()
        for item in sorted(path.rglob("*"))
        if item.is_file() and "__pycache__" not in item.parts and item.suffix != ".pyc"
    }


def directory_contains(source: Path, target: Path) -> bool:
    source_files = directory_fingerprint(source)
    target_files = directory_fingerprint(target)
    return bool(source_files) and all(target_files.get(name) == digest for name, digest in source_files.items())


def sync_skill_adapter(root: Path, surface_root: Path) -> None:
    source_skills = root / ".agents" / "skills"
    target_skills = surface_root / "skills"
    target_skills.mkdir(parents=True, exist_ok=True)
    remove_owned_skill_adapters(target_skills)
    for name in continuity_skill_names(root):
        shutil.copytree(source_skills / name, target_skills / name)
    source_references = root / ".agents" / "references"
    if source_references.is_dir():
        shutil.copytree(source_references, surface_root / "references", dirs_exist_ok=True)


def render_surface_command(skill_name: str) -> str:
    return (
        f"# {skill_name}\n\n"
        "Read and follow `AGENTS.md`, then read the canonical skill at "
        f"`.agents/skills/{skill_name}/SKILL.md` and the project-specific "
        "`.agents/skills/continuity-local/SKILL.md`. Use the project-local CLI at "
        "`.agents/continuity/bin/continuity`. Preserve all approval, testing, security, "
        "merge-safety, and human-review gates. Treat any trailing user text as task context.\n"
    )


def scheduler_plan(settings: dict[str, Any]) -> dict[str, Any]:
    provider = settings["scheduler"]["provider"]
    return {
        "schema_version": 1,
        "provider": provider,
        "registration_state": "not-requested" if provider == "none" else "requires-user-registration",
        "primary_surface": settings["agent_surfaces"]["primary"],
        "enabled_surfaces": settings["agent_surfaces"]["enabled"],
        "timezone": settings["timezone"],
        "schedules": settings["schedules"],
        "prompts": {
            "review": ".agents/continuity/automation/nightly-review.md",
            "dispatch": ".agents/continuity/automation/default-dispatch.md",
            "report": ".agents/continuity/automation/morning-report.md",
        },
        "note": "Schedule intent is configured. Persistent registration remains an explicit user action in the selected scheduler.",
    }


def sync_surface_adapters(root: Path, settings: dict[str, Any]) -> None:
    enabled = set(settings["agent_surfaces"]["enabled"])

    claude_path = root / "CLAUDE.md"
    claude_text = claude_path.read_text(encoding="utf-8") if claude_path.exists() else ""
    claude_start = "<!-- continuity:claude:start -->"
    claude_end = "<!-- continuity:claude:end -->"
    claude_block = None
    if "claude-code" in enabled:
        claude_block = f"{claude_start}\n@AGENTS.md\n{claude_end}"
        sync_skill_adapter(root, root / ".claude")
    else:
        remove_owned_skill_adapters(root / ".claude" / "skills")
        remove_owned_reference_adapters(root, root / ".claude")
    updated_claude = replace_managed_block(claude_text, claude_start, claude_end, claude_block)
    if updated_claude.strip():
        claude_path.write_text(updated_claude, encoding="utf-8")
    elif claude_path.exists():
        claude_path.unlink()

    cursor_commands = root / ".cursor" / "commands"
    cursor_rule = root / ".cursor" / "rules" / "continuity.mdc"
    if "cursor" in enabled:
        cursor_rule.parent.mkdir(parents=True, exist_ok=True)
        cursor_rule.write_text(
            "---\ndescription: Apply Continuity project controls and route requests to the installed Continuity workflows.\nglobs:\nalwaysApply: true\n---\n\n"
            "Read and follow `AGENTS.md`. Continuity skills are canonical under `.agents/skills/`; use `.agents/skills/continuity-local/SKILL.md` with every task-specific Continuity workflow.\n",
            encoding="utf-8",
        )
        cursor_commands.mkdir(parents=True, exist_ok=True)
        for existing in cursor_commands.glob("continuity*.md"):
            existing.unlink()
        for name in continuity_skill_names(root):
            (cursor_commands / f"{name}.md").write_text(render_surface_command(name), encoding="utf-8")
    else:
        if cursor_rule.exists():
            cursor_rule.unlink()
        if cursor_commands.exists():
            for existing in cursor_commands.glob("continuity*.md"):
                existing.unlink()

    if "windsurf" in enabled:
        sync_skill_adapter(root, root / ".windsurf")
    else:
        remove_owned_skill_adapters(root / ".windsurf" / "skills")
        remove_owned_reference_adapters(root, root / ".windsurf")

    json_dump(root / ".continuity" / "scheduler.json", scheduler_plan(settings))


def surface_adapter_problems(root: Path, settings: dict[str, Any]) -> list[str]:
    enabled = set(settings["agent_surfaces"]["enabled"])
    problems: list[str] = []
    names = continuity_skill_names(root)
    if "claude-code" in enabled:
        claude_text = (root / "CLAUDE.md").read_text(encoding="utf-8") if (root / "CLAUDE.md").exists() else ""
        if "@AGENTS.md" not in claude_text:
            problems.append("Claude Code adapter is missing its AGENTS.md import")
        for name in names:
            if directory_fingerprint(root / ".agents" / "skills" / name) != directory_fingerprint(root / ".claude" / "skills" / name):
                problems.append(f"Claude Code skill adapter is missing or stale: {name}")
        if not directory_contains(root / ".agents" / "references", root / ".claude" / "references"):
            problems.append("Claude Code reference adapter is missing or stale")
    if "cursor" in enabled:
        if not (root / ".cursor" / "rules" / "continuity.mdc").is_file():
            problems.append("Cursor Continuity rule is missing")
        for name in names:
            if not (root / ".cursor" / "commands" / f"{name}.md").is_file():
                problems.append(f"Cursor command adapter is missing: {name}")
    if "windsurf" in enabled:
        for name in names:
            if directory_fingerprint(root / ".agents" / "skills" / name) != directory_fingerprint(root / ".windsurf" / "skills" / name):
                problems.append(f"Windsurf skill adapter is missing or stale: {name}")
        if not directory_contains(root / ".agents" / "references", root / ".windsurf" / "references"):
            problems.append("Windsurf reference adapter is missing or stale")
    expected_scheduler = scheduler_plan(settings)
    if json_load(root / ".continuity" / "scheduler.json", {}) != expected_scheduler:
        problems.append("Scheduler handoff is missing or out of sync")
    return problems


def validate_project_behavior(root: Path, config: dict[str, Any]) -> dict[str, Any]:
    behavior_path = confined_path(root, config.get("behavior_config_path", BEHAVIOR_CONFIG_PATH), "behavior_config_path")
    skill_path = confined_path(root, config.get("behavior_skill_path", BEHAVIOR_SKILL_PATH), "behavior_skill_path")
    record = json_load(behavior_path, {})
    if not isinstance(record, dict) or record.get("schema_version") != BEHAVIOR_SCHEMA_VERSION:
        raise ContinuityError("Project behavior configuration is missing or unsupported")
    if record.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Project behavior uses a missing or unsupported assurance standard")
    if record.get("project_id") != config.get("project_id"):
        raise ContinuityError("Project behavior and continuity configuration IDs differ")
    if record.get("recommendation_profile") != BEHAVIOR_PROFILE:
        raise ContinuityError("Project behavior recommendation profile is unsupported")
    settings = validate_behavior_settings(root, record.get("settings"))
    expected_hash = behavior_payload_hash(record)
    if record.get("configuration_hash") != expected_hash:
        raise ContinuityError("Project behavior configuration hash is stale or invalid")
    if config.get("behavior_configuration_hash") != expected_hash:
        raise ContinuityError("Continuity configuration does not match project behavior")
    manifest = load_project_manifest(root)
    if manifest.get("behavior_configuration_hash") != expected_hash:
        raise ContinuityError("Project manifest does not match project behavior")
    if record.get("fixed_guardrails") != FIXED_GUARDRAILS:
        raise ContinuityError("Project behavior attempts to change fixed continuity guardrails")
    expected_config = {
        "integration_branch": settings["integration_branch"],
        "timezone": settings["timezone"],
        "default_start_time": settings["schedules"]["dispatch"],
        "max_runtime_minutes": settings["max_runtime_minutes"],
        "memory_stale_after_days": settings["memory_stale_after_days"],
        "validation_commands": settings["validation_commands"],
        "security_commands": settings["security_commands"],
        "documentation_map": settings["documentation_map"],
        "visual_evidence_mode": settings["visual_evidence_mode"],
        "branch_prefix": settings["branch_prefix"],
        "project_instructions": settings["project_instructions"],
        "planning_patterns": settings["planning_patterns"],
        "roadmap": settings["roadmap"],
        "agent_surfaces": settings["agent_surfaces"],
        "scheduler": settings["scheduler"],
        "roadmap_docs": "docs/project-roadmap",
    }
    config_drift = sorted(key for key, value in expected_config.items() if config.get(key) != value)
    if config_drift:
        raise ContinuityError(f"Continuity configuration drifted from project behavior: {config_drift}")
    fixed_config = {
        "require_remote": True,
        "require_pr": True,
        "require_pr_auth": True,
        "require_execution_artifacts": True,
        "require_isolated_worktree": True,
        "refresh_base_on_preflight": True,
    }
    weakened = sorted(key for key, value in fixed_config.items() if config.get(key) is not value)
    if weakened:
        raise ContinuityError(f"Continuity configuration weakens fixed safeguards: {weakened}")
    expected_manifest = {
        "project_id": record["project_id"],
        "integration_branch": settings["integration_branch"],
        "timezone": settings["timezone"],
        "schedules": settings["schedules"],
        "roadmap": settings["roadmap"],
        "agent_surfaces": settings["agent_surfaces"],
        "scheduler": settings["scheduler"],
        "max_concurrency": 1,
        "execution_enabled": settings["execution_enabled"],
    }
    manifest_drift = sorted(key for key, value in expected_manifest.items() if manifest.get(key) != value)
    if manifest_drift:
        raise ContinuityError(f"Project manifest drifted from project behavior: {manifest_drift}")
    if not skill_path.exists() or skill_path.read_text(encoding="utf-8") != render_project_behavior_skill(record):
        raise ContinuityError("Generated project behavior skill is missing or out of sync")
    adapter_problems = surface_adapter_problems(root, settings)
    if adapter_problems:
        raise ContinuityError(f"Agent surface adapters are missing or out of sync: {adapter_problems}")
    return record


def parse_scalar(value: str) -> Any:
    value = value.strip()
    if not value:
        return ""
    if value in {"true", "false"}:
        return value == "true"
    if value in {"null", "~"}:
        return None
    if value.startswith("[") and value.endswith("]"):
        try:
            return json.loads(value)
        except json.JSONDecodeError:
            return [item.strip() for item in value[1:-1].split(",") if item.strip()]
    return value.strip('"\'')


def parse_markdown(path: Path) -> tuple[dict[str, Any], str, str]:
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        return {}, text, ""
    end = text.find("\n---\n", 4)
    if end < 0:
        return {}, text, ""
    metadata: dict[str, Any] = {}
    for line in text[4:end].splitlines():
        if not line.strip() or line.lstrip().startswith("#") or ":" not in line:
            continue
        key, value = line.split(":", 1)
        metadata[key.strip()] = parse_scalar(value)
    body = text[end + 5 :]
    heading = ""
    for line in body.splitlines():
        if line.startswith("# "):
            heading = line[2:].strip()
            break
    return metadata, body, heading


def render_markdown(metadata: dict[str, Any], body: str) -> str:
    lines = ["---"]
    for key, value in metadata.items():
        if isinstance(value, (list, dict)):
            rendered = json.dumps(value, sort_keys=True)
        elif value is None:
            rendered = "null"
        else:
            rendered = str(value)
        lines.append(f"{key}: {rendered}")
    lines.extend(["---", "", body.rstrip(), ""])
    return "\n".join(lines)


def note_capture(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    stamp = iso_now(config)
    if args.items_file:
        payload = json_load(Path(args.items_file).expanduser())
        if not isinstance(payload, dict) or not isinstance(payload.get("items"), list):
            raise ContinuityError("Items file must contain an object with an items array")
    else:
        text = args.text
        if args.file:
            text = Path(args.file).expanduser().read_text(encoding="utf-8")
        if not text:
            raise ContinuityError("Provide --text, --file, or --items-file")
        payload = {
            "source_type": "file" if args.file else "manual",
            "source_ref": args.file or "manual-entry",
            "items": [{"kind": "context", "text": text}],
        }
    source_type = payload.get("source_type", args.source_type or "conversation")
    if source_type not in {"conversation", "manual", "file", "notion", "linear"}:
        raise ContinuityError(f"Unsupported source_type: {source_type}")
    raw_items = payload["items"]
    items: list[dict[str, Any]] = []
    for index, item in enumerate(raw_items, 1):
        if not isinstance(item, dict) or not str(item.get("text", "")).strip():
            raise ContinuityError(f"Capture item {index} must include text")
        kind = item.get("kind", "context")
        if kind not in NOTE_KINDS:
            raise ContinuityError(f"Invalid note kind: {kind}")
        item_id = item.get("item_id") or stable_id("note", stamp, str(index), item["text"])
        item_created_at = item.get("created_at") or item.get("source_timestamp") or payload.get("source_timestamp") or stamp
        item_work_status = item.get("work_status", "open")
        if item_work_status not in NOTE_WORK_STATUSES:
            raise ContinuityError(f"Invalid note work status: {item_work_status}")
        items.append(
            {
                **item,
                "item_id": item_id,
                "kind": kind,
                "text": item["text"].strip(),
                "created_at": item_created_at,
                "updated_at": item.get("updated_at", stamp),
                "execution_authorized": False,
                "routing_status": item.get("routing_status", "captured"),
                "work_status": item_work_status,
            }
        )
    content_fingerprint = canonical_hash(
        [{"kind": item["kind"], "text": item["text"]} for item in items]
    )
    capture_id = payload.get("capture_id") or stable_id(
        "capture", config["project_id"], stamp, content_fingerprint
    )
    captures_root = private_path(root, config) / "captures"
    dedupe_key = payload.get("dedupe_key") or canonical_hash(
        {
            "source_type": source_type,
            "source_ref": payload.get("source_ref", args.source_ref),
            "items": content_fingerprint,
        }
    )
    for existing_path in captures_root.glob("**/*.json"):
        existing = json_load(existing_path, {})
        if existing.get("dedupe_key") == dedupe_key and existing.get("source_ref") == payload.get("source_ref", args.source_ref):
            existing["deduplicated"] = True
            existing["path"] = str(existing_path.relative_to(root))
            return existing
    capture = {
        "schema_version": SCHEMA_VERSION,
        "capture_id": capture_id,
        "captured_at": stamp,
        "project_id": config["project_id"],
        "repository": str(root),
        "source_type": source_type,
        "source_ref": payload.get("source_ref", args.source_ref),
        "source_timestamp": payload.get("source_timestamp"),
        "dedupe_key": dedupe_key,
        "execution_authorized": False,
        "items": items,
    }
    target = private_path(root, config) / "captures" / stamp[:10] / f"{capture_id}.json"
    json_dump(target, capture)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {"at": stamp, "event": "capture.created", "capture_id": capture_id},
    )
    capture["path"] = str(target.relative_to(root))
    return capture


def find_capture(root: Path, config: dict[str, Any], capture_id: str) -> Path:
    validate_identifier(capture_id, "capture ID")
    matches = [path for path in (private_path(root, config) / "captures").glob("**/*.json") if path.stem == capture_id]
    if len(matches) != 1:
        raise ContinuityError(f"Expected one capture {capture_id}; found {len(matches)}")
    return matches[0]


def update_note_work_status(root: Path, config: dict[str, Any], item_ids: Iterable[str], work_status: str, *, goal_id: str | None = None) -> list[dict[str, str]]:
    if work_status not in NOTE_WORK_STATUSES:
        raise ContinuityError(f"Invalid note work status: {work_status}")
    targets = {item_id for item_id in item_ids if item_id}
    if not targets:
        return []
    stamp = iso_now(config)
    updated: list[dict[str, str]] = []
    for path in (private_path(root, config) / "captures").glob("**/*.json"):
        capture = json_load(path, {})
        if not isinstance(capture, dict):
            continue
        changed = False
        for item in capture.get("items", []):
            if not isinstance(item, dict) or item.get("item_id") not in targets:
                continue
            previous = item.get("work_status", "open")
            item.setdefault("created_at", capture.get("captured_at", stamp))
            item["updated_at"] = stamp
            item["work_status"] = work_status
            item["execution_authorized"] = False
            if goal_id:
                related = item.setdefault("related_goal_ids", [])
                if goal_id not in related:
                    related.append(goal_id)
            item.setdefault("work_status_history", []).append({"at": stamp, "from": previous, "to": work_status, "goal_id": goal_id})
            updated.append({"capture_id": str(capture.get("capture_id", "")), "item_id": str(item["item_id"]), "work_status": work_status})
            changed = True
        if changed:
            json_dump(path, capture)
    if updated:
        append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": "note.work-status", "goal_id": goal_id, "items": updated})
    return updated


def route_for_kind(kind: str) -> str:
    return {
        "context": "knowledge",
        "insight": "knowledge",
        "decision": "knowledge",
        "question": "questions",
        "documentation-candidate": "documentation",
        "backlog-candidate": "backlog",
        "execution-candidate": "planning",
        "explicit-instruction": "planning",
    }[kind]


def note_triage(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    path = find_capture(root, config, args.capture_id)
    capture = json_load(path)
    selected = None
    for item in capture["items"]:
        if item["item_id"] == args.item_id:
            selected = item
            break
    if selected is None:
        raise ContinuityError(f"Unknown item {args.item_id}")
    stamp = iso_now(config)
    selected.setdefault("created_at", capture.get("captured_at", stamp))
    selected.setdefault("work_status", "open")
    previous = {
        "kind": selected.get("kind"),
        "routing_status": selected.get("routing_status"),
        "queue": selected.get("queue"),
        "review_after": selected.get("review_after"),
        "work_status": selected.get("work_status"),
    }
    if args.kind:
        if args.kind not in NOTE_KINDS:
            raise ContinuityError(f"Invalid kind: {args.kind}")
        selected["kind"] = args.kind
    selected["routing_status"] = args.action
    selected["execution_authorized"] = False
    selected["updated_at"] = stamp
    if args.review_after:
        selected["review_after"] = args.review_after
    if args.action == "defer":
        selected["work_status"] = "deferred"
    elif args.action == "archive":
        selected["work_status"] = "archived"
        selected.pop("queue", None)
    if args.action in {"route", "defer", "promote"}:
        queue = route_for_kind(selected["kind"])
        selected["queue"] = queue
        queue_path = private_path(root, config) / "queues" / f"{queue}.jsonl"
        already_queued = any(
            row.get("capture_id") == capture["capture_id"]
            and row.get("item_id") == selected["item_id"]
            and row.get("kind") == selected["kind"]
            and row.get("routing_status") == selected["routing_status"]
            for row in iter_jsonl(queue_path)
        )
        if not already_queued:
            append_jsonl(queue_path, {"at": stamp, "capture_id": capture["capture_id"], **selected})
    current = {
        "kind": selected.get("kind"),
        "routing_status": selected.get("routing_status"),
        "queue": selected.get("queue"),
        "review_after": selected.get("review_after"),
        "work_status": selected.get("work_status"),
    }
    if previous != current:
        selected.setdefault("revision_history", []).append({"at": stamp, "previous": previous, "current": current})
    json_dump(path, capture)
    event = {
        "at": stamp,
        "event": f"note.{args.action}",
        "capture_id": capture["capture_id"],
        "item_id": selected["item_id"],
        "kind": selected["kind"],
        "work_status": selected.get("work_status"),
    }
    append_jsonl(private_path(root, config) / "events.jsonl", event)
    return selected


def note_list(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    result: list[dict[str, Any]] = []
    for path in sorted((private_path(root, config) / "captures").glob("**/*.json")):
        capture = json_load(path)
        for item in capture.get("items", []):
            if args.kind and item.get("kind") != args.kind:
                continue
            result.append({"capture_id": capture["capture_id"], **item})
    return result


def memory_db(root: Path, config: dict[str, Any]) -> Path:
    return private_path(root, config) / "index" / "project-memory.sqlite"


def memory_sources(root: Path, config: dict[str, Any], scope: str) -> list[tuple[Path, str]]:
    docs_root = confined_path(root, config.get("memory_docs", "docs/project-memory"), "memory_docs")
    result = [
        (path, "trusted")
        for path in sorted(docs_root.glob("**/*.md"))
        if path.is_file() and path.resolve().is_relative_to(docs_root)
    ]
    if scope in {"private", "all"}:
        private_docs = private_path(root, config) / "knowledge"
        result.extend(
            (path, "private")
            for path in sorted(private_docs.glob("**/*.md"))
            if path.is_file() and path.resolve().is_relative_to(private_docs.resolve())
        )
    return result


def memory_source_fingerprint(root: Path, config: dict[str, Any], scope: str) -> str:
    records = []
    for path, source_scope in memory_sources(root, config, scope):
        records.append(
            {
                "path": str(path.relative_to(root)),
                "scope": source_scope,
                "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            }
        )
    return canonical_hash(records)


def memory_index(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    db_path = memory_db(root, config)
    db_path.parent.mkdir(parents=True, exist_ok=True)
    connection = sqlite3.connect(db_path)
    connection.executescript(
        """
        DROP TABLE IF EXISTS memory;
        DROP TABLE IF EXISTS memory_fts;
        CREATE TABLE memory (
          memory_id TEXT PRIMARY KEY, path TEXT NOT NULL, heading TEXT, title TEXT,
          entry_type TEXT, status TEXT, system_name TEXT, summary TEXT, tags TEXT,
          aliases TEXT, sources TEXT, updated_at TEXT, last_verified_at TEXT,
          verified_against TEXT, confidence TEXT, scope TEXT, body TEXT
        );
        CREATE VIRTUAL TABLE memory_fts USING fts5(
          memory_id UNINDEXED, title, heading, summary, tags, aliases, system_name, body,
          tokenize='unicode61'
        );
        """
    )
    indexed = 0
    warnings: list[str] = []
    seen: set[str] = set()
    for path, scope in memory_sources(root, config, args.scope):
        metadata, body, heading = parse_markdown(path)
        absent = sorted(FRONTMATTER_REQUIRED - set(metadata))
        if absent:
            warnings.append(f"skipped {path.relative_to(root)}: missing {', '.join(absent)}")
            continue
        memory_id = str(metadata.get("memory_id") or stable_id("memory", str(path.relative_to(root))))
        if memory_id in seen:
            warnings.append(f"duplicate memory_id {memory_id}: {path.relative_to(root)}")
            continue
        seen.add(memory_id)
        row = (
            memory_id,
            str(path.relative_to(root)),
            heading,
            str(metadata.get("title") or heading or path.stem),
            str(metadata.get("type", "unclassified")),
            str(metadata.get("status", "proposed")),
            str(metadata.get("system", "project")),
            str(metadata.get("summary", "")),
            json.dumps(metadata.get("tags", [])),
            json.dumps(metadata.get("aliases", [])),
            json.dumps(metadata.get("sources", [])),
            str(metadata.get("updated_at", "")),
            str(metadata.get("last_verified_at", "")),
            str(metadata.get("verified_against", "")),
            str(metadata.get("confidence", "unknown")),
            scope,
            body,
        )
        connection.execute("INSERT INTO memory VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", row)
        connection.execute(
            "INSERT INTO memory_fts VALUES (?,?,?,?,?,?,?,?)",
            (memory_id, row[3], heading, row[7], row[8], row[9], row[6], body),
        )
        indexed += 1
    connection.commit()
    connection.close()
    manifest = {
        "indexed_at": iso_now(config),
        "entries": indexed,
        "scope": args.scope,
        "warnings": warnings,
        "database": str(db_path.relative_to(root)),
        "source_fingerprint": memory_source_fingerprint(root, config, args.scope),
    }
    json_dump(private_path(root, config) / "index" / "manifest.json", manifest)
    return manifest


def ensure_index(root: Path, config: dict[str, Any], scope: str = "trusted") -> None:
    manifest = json_load(private_path(root, config) / "index" / "manifest.json", {})
    fingerprint = memory_source_fingerprint(root, config, scope)
    if (
        not memory_db(root, config).exists()
        or manifest.get("scope") != scope
        or manifest.get("source_fingerprint") != fingerprint
    ):
        memory_index(argparse.Namespace(scope=scope))


def memory_search(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    ensure_index(root, config, args.scope)
    connection = sqlite3.connect(memory_db(root, config))
    connection.row_factory = sqlite3.Row
    tokens = re.findall(r"[\w-]+", args.query, flags=re.UNICODE)
    if not tokens:
        raise ContinuityError("Search query contains no searchable terms")
    safe_query = " AND ".join(f'"{token.replace(chr(34), chr(34) * 2)}"' for token in tokens)
    where = ["memory_fts MATCH ?"]
    params: list[Any] = [safe_query]
    if args.type:
        where.append("m.entry_type = ?")
        params.append(args.type)
    if args.status:
        where.append("m.status = ?")
        params.append(args.status)
    if args.system:
        where.append("m.system_name = ?")
        params.append(args.system)
    if args.tag:
        where.append("m.tags LIKE ?")
        params.append(f"%{args.tag}%")
    if args.source:
        where.append("m.sources LIKE ?")
        params.append(f"%{args.source}%")
    if args.since:
        where.append("m.updated_at >= ?")
        params.append(args.since)
    if args.scope != "all":
        where.append("m.scope = ?")
        params.append(args.scope)
    query = f"""
      SELECT m.*, bm25(memory_fts) AS rank
      FROM memory_fts JOIN memory m USING(memory_id)
      WHERE {' AND '.join(where)}
      ORDER BY CASE m.status WHEN 'current' THEN 0 WHEN 'proposed' THEN 1 ELSE 2 END,
               rank, m.last_verified_at DESC
      LIMIT ?
    """
    params.append(args.limit)
    rows = [dict(row) for row in connection.execute(query, params).fetchall()]
    connection.close()
    for row in rows:
        row["citation"] = f"{row['path']}#{slug(row['heading'])}" if row["heading"] else row["path"]
        row.pop("body", None)
    return rows


def memory_brief(args: argparse.Namespace) -> str:
    search_args = argparse.Namespace(
        query=args.query,
        type=None,
        status=None,
        system=None,
        tag=None,
        source=None,
        since=None,
        scope=args.scope,
        limit=args.limit,
    )
    rows = memory_search(search_args)
    lines = [f"# Project Memory Brief: {args.query}", ""]
    if not rows:
        lines.append("No matching trusted project memory was found.")
    for row in rows:
        lines.extend(
            [
                f"## {row['title']} ({row['memory_id']})",
                "",
                row["summary"] or "No summary recorded.",
                "",
                f"- Status: {row['status']}",
                f"- System: {row['system_name']}",
                f"- Verified: {row['last_verified_at'] or 'not recorded'} against {row['verified_against'] or 'not recorded'}",
                f"- Source: `{row['citation']}`",
                "",
            ]
        )
    return "\n".join(lines)


def memory_audit(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    entries: list[dict[str, Any]] = []
    missing: list[dict[str, Any]] = []
    invalid_status: list[dict[str, str]] = []
    duplicates: dict[str, list[str]] = {}
    ids: dict[str, str] = {}
    relationships: list[tuple[str, str, str]] = []
    title_states: dict[str, list[dict[str, str]]] = {}
    stale: list[dict[str, str]] = []
    stale_days = int(config.get("memory_stale_after_days", 90))
    cutoff = now(config).date() - dt.timedelta(days=stale_days)
    for path, scope in memory_sources(root, config, args.scope):
        metadata, _body, _heading = parse_markdown(path)
        relative = str(path.relative_to(root))
        entry_id = str(metadata.get("memory_id", ""))
        absent = sorted(FRONTMATTER_REQUIRED - set(metadata))
        if absent:
            missing.append({"path": relative, "fields": absent})
        if metadata.get("status") and metadata["status"] not in MEMORY_STATUSES:
            invalid_status.append({"path": relative, "status": str(metadata["status"])})
        if entry_id:
            if entry_id in ids:
                duplicates.setdefault(entry_id, [ids[entry_id]]).append(relative)
            else:
                ids[entry_id] = relative
        title_key = str(metadata.get("title", "")).strip().lower()
        if title_key:
            title_states.setdefault(title_key, []).append(
                {"path": relative, "status": str(metadata.get("status", "proposed")), "memory_id": entry_id}
            )
        for relationship_key in ("related", "supersedes"):
            values = metadata.get(relationship_key) or []
            if isinstance(values, str):
                values = [values]
            for target in values:
                relationships.append((relative, relationship_key, str(target)))
        verified = str(metadata.get("last_verified_at", ""))[:10]
        if not verified:
            stale.append({"path": relative, "reason": "never verified"})
        else:
            try:
                if dt.date.fromisoformat(verified) < cutoff:
                    stale.append({"path": relative, "reason": f"older than {stale_days} days"})
            except ValueError:
                stale.append({"path": relative, "reason": "invalid last_verified_at"})
        entries.append({"path": relative, "scope": scope, "memory_id": entry_id})
    orphan_relationships = [
        {"path": source, "field": field, "target": target}
        for source, field, target in relationships
        if target and target not in ids
    ]
    possible_conflicts = {
        title: values
        for title, values in title_states.items()
        if len(values) > 1 and sum(value["status"] in {"current", "proposed", "disputed"} for value in values) > 1
    }
    report = {
        "audited_at": iso_now(config),
        "entries": len(entries),
        "missing_frontmatter": missing,
        "invalid_status": invalid_status,
        "duplicates": duplicates,
        "orphan_relationships": orphan_relationships,
        "possible_conflicts": possible_conflicts,
        "stale": stale,
        "healthy": not (missing or invalid_status or duplicates or orphan_relationships or possible_conflicts or stale),
    }
    json_dump(private_path(root, config) / "reports" / "memory-health.json", report)
    return report


def find_memory_entry(root: Path, config: dict[str, Any], memory_id: str) -> Path:
    matches = []
    for path, _scope in memory_sources(root, config, "all"):
        metadata, _body, _heading = parse_markdown(path)
        if metadata.get("memory_id") == memory_id:
            matches.append(path)
    if len(matches) != 1:
        raise ContinuityError(f"Expected one memory entry {memory_id}; found {len(matches)}")
    return matches[0]


def require_goal_approval(
    root: Path,
    config: dict[str, Any],
    goal_id: str,
    *,
    note_id: str | None = None,
    memory_ids: Iterable[str] = (),
) -> dict[str, Any]:
    goal, _approval = validate_approval(root, config, goal_id)
    if goal.get("state") not in {"approved", "queued", "dispatched", "running", "validating"}:
        raise ContinuityError(f"Goal {goal_id} is not active and cannot authorize memory changes")
    if not goal.get("documentation_updates"):
        raise ContinuityError(f"Goal {goal_id} does not authorize documentation or memory updates")
    if note_id and note_id not in goal.get("source_note_ids", []):
        raise ContinuityError(f"Note {note_id} is outside goal {goal_id} scope")
    missing = sorted(set(memory_ids) - set(goal.get("memory_ids", [])))
    if missing:
        raise ContinuityError(f"Memory entries outside goal {goal_id} scope: {missing}")
    return goal


def memory_verify(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    require_goal_approval(root, config, args.goal_id, memory_ids=[args.memory_id])
    path = find_memory_entry(root, config, args.memory_id)
    metadata, body, _heading = parse_markdown(path)
    stamp = iso_now(config)
    metadata["last_verified_at"] = stamp
    metadata["updated_at"] = stamp
    metadata["verified_against"] = args.commit
    if metadata.get("status") in {"proposed", "disputed"} and args.mark_current:
        metadata["status"] = "current"
    path.write_text(render_markdown(metadata, body), encoding="utf-8")
    memory_index(argparse.Namespace(scope="trusted"))
    return {"memory_id": args.memory_id, "path": str(path.relative_to(root)), "verified_against": args.commit}


def memory_promote(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    require_goal_approval(root, config, args.goal_id, note_id=args.note_id)
    selected = None
    source_capture = None
    for capture_path in (private_path(root, config) / "captures").glob("**/*.json"):
        capture = json_load(capture_path, {})
        for item in capture.get("items", []):
            if item.get("item_id") == args.note_id:
                selected = item
                source_capture = capture.get("capture_id")
                break
        if selected:
            break
    if not selected:
        raise ContinuityError(f"Unknown note {args.note_id}")
    if selected.get("kind") not in {"context", "insight", "decision", "documentation-candidate"}:
        raise ContinuityError("Only knowledge or documentation candidates may be promoted to memory")
    stamp = iso_now(config)
    memory_id = args.memory_id or stable_id("memory", config["project_id"], args.note_id, args.title)
    metadata = {
        "memory_id": memory_id,
        "title": args.title,
        "type": args.type,
        "system": args.system,
        "summary": args.summary,
        "status": "proposed",
        "tags": args.tag or [],
        "aliases": [],
        "created_at": stamp,
        "updated_at": stamp,
        "last_verified_at": "",
        "verified_against": "",
        "sources": [f"capture:{source_capture}", f"note:{args.note_id}", f"goal:{args.goal_id}"],
        "related": [],
        "supersedes": [],
        "confidence": args.confidence,
        "unresolved_gaps": [],
    }
    target = confined_path(root, config.get("memory_docs", "docs/project-memory"), "memory_docs") / "proposed" / f"{slug(memory_id)}.md"
    if target.exists():
        raise ContinuityError(f"Memory entry already exists at {target.relative_to(root)}")
    target.parent.mkdir(parents=True, exist_ok=True)
    body = f"# {args.title}\n\n{selected['text']}\n"
    target.write_text(render_markdown(metadata, body), encoding="utf-8")
    memory_index(argparse.Namespace(scope="trusted"))
    return {"memory_id": memory_id, "path": str(target.relative_to(root)), "status": "proposed"}


def memory_supersede(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    require_goal_approval(root, config, args.goal_id, memory_ids=[args.memory_id, args.replacement_id])
    old_path = find_memory_entry(root, config, args.memory_id)
    new_path = find_memory_entry(root, config, args.replacement_id)
    old_meta, old_body, _old_heading = parse_markdown(old_path)
    new_meta, new_body, _new_heading = parse_markdown(new_path)
    stamp = iso_now(config)
    old_meta["status"] = "superseded"
    old_meta["updated_at"] = stamp
    related = list(old_meta.get("related") or [])
    if args.replacement_id not in related:
        related.append(args.replacement_id)
    old_meta["related"] = related
    supersedes = list(new_meta.get("supersedes") or [])
    if args.memory_id not in supersedes:
        supersedes.append(args.memory_id)
    new_meta["supersedes"] = supersedes
    new_meta["updated_at"] = stamp
    old_path.write_text(render_markdown(old_meta, old_body), encoding="utf-8")
    new_path.write_text(render_markdown(new_meta, new_body), encoding="utf-8")
    memory_index(argparse.Namespace(scope="trusted"))
    return {"superseded": args.memory_id, "replacement": args.replacement_id}


def goal_dir(root: Path, config: dict[str, Any], goal_id: str) -> Path:
    validate_identifier(goal_id, "goal ID")
    return private_path(root, config) / "goals" / goal_id


def load_goal(root: Path, config: dict[str, Any], goal_id: str) -> tuple[Path, dict[str, Any]]:
    directory = goal_dir(root, config, goal_id)
    goal = json_load(directory / "goal.json")
    if not isinstance(goal, dict):
        raise ContinuityError(f"Unknown goal {goal_id}")
    return directory, goal


def validate_goal_planning_artifacts(goal: dict[str, Any], *, require_resolved: bool = False) -> None:
    validate_triage_brief(goal.get("triage_brief"))
    decision_map = validate_decision_map(goal.get("decision_map"))
    validate_delivery_slices(goal.get("delivery_slices"))
    roadmap_ids = validate_string_list(goal.get("roadmap_ids", []), "roadmap_ids")
    validate_roadmap_impact(goal.get("roadmap_impact"), roadmap_ids)
    if require_resolved and decision_map:
        unresolved = [
            decision["decision_id"]
            for decision in decision_map["decisions"]
            if decision.get("status") != "resolved"
        ]
        if unresolved:
            raise ContinuityError(f"Decision map is not decision-complete; unresolved decisions: {unresolved}")


def validate_planning_artifact_parity(directory: Path, goal: dict[str, Any]) -> None:
    plan = (directory / "plan.md").read_text(encoding="utf-8")
    expected = render_planning_artifacts(goal)
    if plan.count("<!-- continuity-planning-artifacts:start -->") != 1 or plan.count("<!-- continuity-planning-artifacts:end -->") != 1:
        raise ContinuityError("Plan must contain exactly one managed planning-artifacts block")
    start = plan.index("<!-- continuity-planning-artifacts:start -->")
    end = plan.index("<!-- continuity-planning-artifacts:end -->", start) + len("<!-- continuity-planning-artifacts:end -->")
    if plan[start:end] != expected:
        raise ContinuityError("Planning artifacts are out of sync with the machine goal; use goal revise")


def goal_material_hash(directory: Path, goal: dict[str, Any]) -> str:
    immutable_keys = {
        "schema_version",
        "goal_id",
        "project_id",
        "title",
        "plan_version",
        "priority",
        "depends_on",
        "source_note_ids",
        "memory_ids",
        "roadmap_ids",
        "roadmap_impact",
        "roadmap_fingerprint",
        "scope",
        "exclusions",
        "acceptance_criteria",
        "documentation_updates",
        "required_checks",
        "runtime_limit_minutes",
        "triage_brief",
        "decision_map",
        "delivery_slices",
    }
    machine = {key: goal.get(key) for key in sorted(immutable_keys)}
    plan = (directory / "plan.md").read_text(encoding="utf-8")
    return hashlib.sha256((json.dumps(machine, sort_keys=True) + "\n" + plan).encode()).hexdigest()


def goal_create(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    payload = json_load(Path(args.goal_file).expanduser())
    if not isinstance(payload, dict):
        raise ContinuityError("Goal file must be a JSON object")
    if not isinstance(payload.get("title"), str) or not payload["title"].strip():
        raise ContinuityError("Goal requires a non-empty title")
    if not isinstance(payload.get("scope"), str) or not payload["scope"].strip():
        raise ContinuityError("Goal requires a non-empty scope")
    for key in (
        "acceptance_criteria",
        "depends_on",
        "source_note_ids",
        "memory_ids",
        "roadmap_ids",
        "exclusions",
        "documentation_updates",
        "required_checks",
    ):
        value = payload.get(key, [])
        if not isinstance(value, list) or not all(isinstance(item, str) and item.strip() for item in value):
            raise ContinuityError(f"Goal field {key} must be an array of non-empty strings")
    if not payload.get("acceptance_criteria"):
        raise ContinuityError("Goal requires acceptance_criteria")
    plan_version = payload.get("plan_version", 1)
    runtime_limit = payload.get("runtime_limit_minutes", config.get("max_runtime_minutes", 360))
    if not isinstance(plan_version, int) or isinstance(plan_version, bool) or plan_version < 1:
        raise ContinuityError("plan_version must be an integer of at least 1")
    if not isinstance(runtime_limit, int) or isinstance(runtime_limit, bool) or runtime_limit < 1:
        raise ContinuityError("runtime_limit_minutes must be an integer of at least 1")
    if runtime_limit > int(config.get("max_runtime_minutes", 360)):
        raise ContinuityError("runtime_limit_minutes exceeds the configured project maximum")
    stamp = iso_now(config)
    goal_id = validate_identifier(payload.get("goal_id") or stable_id("goal", config["project_id"], stamp, payload["title"]), "goal ID")
    directory = goal_dir(root, config, goal_id)
    if directory.exists():
        raise ContinuityError(f"Goal already exists: {goal_id}")
    goal = {
        "schema_version": SCHEMA_VERSION,
        "goal_id": goal_id,
        "project_id": config["project_id"],
        "title": payload["title"],
        "plan_version": plan_version,
        "state": "awaiting-feedback",
        "priority": payload.get("priority", "normal"),
        "depends_on": payload.get("depends_on", []),
        "source_note_ids": payload.get("source_note_ids", []),
        "memory_ids": payload.get("memory_ids", []),
        "roadmap_ids": payload.get("roadmap_ids", []),
        "roadmap_impact": validate_roadmap_impact(payload.get("roadmap_impact"), payload.get("roadmap_ids", [])),
        "scope": payload["scope"],
        "exclusions": payload.get("exclusions", []),
        "acceptance_criteria": payload["acceptance_criteria"],
        "documentation_updates": payload.get("documentation_updates", []),
        "required_checks": payload.get("required_checks", []),
        "runtime_limit_minutes": runtime_limit,
        "triage_brief": validate_triage_brief(payload.get("triage_brief")),
        "decision_map": validate_decision_map(payload.get("decision_map")),
        "delivery_slices": validate_delivery_slices(payload.get("delivery_slices")),
        "created_at": stamp,
        "updated_at": stamp,
    }
    validate_goal_roadmap_targets(root, config, goal["roadmap_ids"], goal["roadmap_impact"])
    goal["roadmap_fingerprint"] = roadmap_fingerprint(root, config, goal["roadmap_ids"])
    plan = payload.get("plan_markdown") or (
        f"# {goal_id}: {goal['title']}\n\n"
        f"## Context and memory\n\nNotes: {', '.join(goal['source_note_ids']) or 'None'}  \n"
        f"Memory: {', '.join(goal['memory_ids']) or 'None'}\n\n"
        f"Roadmap: {', '.join(goal['roadmap_ids']) or 'None'}\n\n"
        f"## Proposed execution scope\n\n{goal['scope']}\n\n"
        f"## Exclusions\n\n" + "\n".join(f"- {item}" for item in goal["exclusions"]) + "\n\n"
        f"## Acceptance criteria\n\n" + "\n".join(f"- {item}" for item in goal["acceptance_criteria"]) + "\n"
    )
    plan = with_planning_artifacts(plan, goal)
    directory.mkdir(parents=True, exist_ok=False)
    (directory / "plan.md").write_text(plan, encoding="utf-8")
    goal["plan_hash"] = goal_material_hash(directory, goal)
    json_dump(directory / "goal.json", goal)
    stamp = iso_now(config)
    compliance = {
        "schema_version": SCHEMA_VERSION,
        "assurance_standard_version": ASSURANCE_STANDARD_VERSION,
        "goal_id": goal_id,
        "updated_at": stamp,
        "stages": {
            stage: {"status": "pending", "evidence": [], "updated_at": stamp}
            for stage in COMPLIANCE_STAGES
        },
    }
    compliance["stages"]["capture-triage"] = {
        "status": "passed" if goal["source_note_ids"] else "not-applicable",
        "evidence": goal["source_note_ids"] or ["Goal was created directly without captured notes"],
        "updated_at": stamp,
    }
    compliance["stages"]["memory-retrieval"] = {
        "status": "passed" if goal["memory_ids"] else "pending",
        "evidence": goal["memory_ids"],
        "updated_at": stamp,
    }
    compliance["stages"]["roadmap-retrieval"] = {
        "status": "passed" if goal["roadmap_ids"] else "not-applicable",
        "evidence": goal["roadmap_ids"] or ["Goal has no roadmap context"],
        "updated_at": stamp,
    }
    if payload.get("plan_reviewed"):
        compliance["stages"]["plan-review"] = {
            "status": "passed",
            "evidence": [str(payload.get("plan_review_evidence", "Plan reviewed for scope, decisions, and acceptance criteria"))],
            "updated_at": stamp,
        }
    json_dump(directory / "compliance.json", compliance)
    (directory / "feedback.jsonl").touch()
    update_note_work_status(root, config, goal["source_note_ids"], "planned", goal_id=goal_id)
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": "goal.created", "goal_id": goal_id})
    return goal


def next_default_start(config: dict[str, Any]) -> str:
    current = now(config)
    hour, minute = [int(value) for value in config.get("default_start_time", "22:00").split(":", 1)]
    scheduled = current.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if scheduled <= current:
        scheduled += dt.timedelta(days=1)
    return scheduled.isoformat(timespec="minutes")


def parse_schedule(value: str, config: dict[str, Any]) -> str:
    try:
        scheduled = dt.datetime.fromisoformat(value)
    except ValueError as exc:
        raise ContinuityError("Schedule must be an ISO 8601 date-time") from exc
    if scheduled.tzinfo is None:
        scheduled = scheduled.replace(tzinfo=ZoneInfo(config["timezone"]))
    return scheduled.isoformat(timespec="minutes")


def validate_approval(root: Path, config: dict[str, Any], goal_id: str) -> tuple[dict[str, Any], dict[str, Any]]:
    directory, goal = load_goal(root, config, goal_id)
    compliance = json_load(directory / "compliance.json", {})
    if compliance.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Goal compliance ledger uses a missing or unsupported assurance standard")
    approval = json_load(directory / "approval.json")
    if not isinstance(approval, dict):
        raise ContinuityError(f"Goal {goal_id} has no approval record")
    validate_goal_planning_artifacts(goal, require_resolved=True)
    validate_planning_artifact_parity(directory, goal)
    current_hash = goal_material_hash(directory, goal)
    if approval.get("plan_version") != goal.get("plan_version") or approval.get("plan_hash") != current_hash:
        raise ContinuityError("Approval is stale because the plan or goal record changed")
    if goal.get("state") in {"approved", "queued"} and goal.get("roadmap_fingerprint") != roadmap_fingerprint(root, config, goal.get("roadmap_ids", [])):
        raise ContinuityError("Approval is stale because retrieved roadmap context changed")
    if goal.get("state") not in {"approved", "queued", "dispatched", "running", "validating"}:
        raise ContinuityError(f"Goal state {goal.get('state')} is not approved")
    return goal, approval


def goal_revise(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if goal.get("state") not in {"awaiting-feedback", "queued", "held"}:
        raise ContinuityError(f"Goal in state {goal.get('state')} cannot be revised")
    if goal.get("state") == "held" and goal.get("held_from") not in {"awaiting-feedback", "queued"}:
        raise ContinuityError("Only a pre-execution held goal can be revised")
    payload = json_load(Path(args.goal_file).expanduser())
    if not isinstance(payload, dict):
        raise ContinuityError("Revision file must be a JSON object")
    allowed = {
        "title",
        "priority",
        "depends_on",
        "source_note_ids",
        "memory_ids",
        "roadmap_ids",
        "roadmap_impact",
        "scope",
        "exclusions",
        "acceptance_criteria",
        "documentation_updates",
        "required_checks",
        "runtime_limit_minutes",
        "triage_brief",
        "decision_map",
        "delivery_slices",
    }
    for key, value in payload.items():
        if key in allowed:
            goal[key] = value
    for key in ("depends_on", "source_note_ids", "memory_ids", "roadmap_ids", "exclusions", "acceptance_criteria", "documentation_updates", "required_checks"):
        value = goal.get(key)
        if not isinstance(value, list) or not all(isinstance(item, str) and item.strip() for item in value):
            raise ContinuityError(f"Goal field {key} must be an array of non-empty strings")
    if not goal.get("acceptance_criteria"):
        raise ContinuityError("Goal requires acceptance_criteria")
    if not isinstance(goal.get("title"), str) or not goal["title"].strip() or not isinstance(goal.get("scope"), str) or not goal["scope"].strip():
        raise ContinuityError("Revised title and scope must be non-empty strings")
    if not isinstance(goal.get("runtime_limit_minutes"), int) or goal["runtime_limit_minutes"] < 1:
        raise ContinuityError("runtime_limit_minutes must be an integer of at least 1")
    if goal["runtime_limit_minutes"] > int(config.get("max_runtime_minutes", 360)):
        raise ContinuityError("runtime_limit_minutes exceeds the configured project maximum")
    goal["triage_brief"] = validate_triage_brief(goal.get("triage_brief"))
    goal["decision_map"] = validate_decision_map(goal.get("decision_map"))
    goal["delivery_slices"] = validate_delivery_slices(goal.get("delivery_slices"))
    goal["roadmap_impact"] = validate_roadmap_impact(goal.get("roadmap_impact"), goal.get("roadmap_ids", []))
    validate_goal_roadmap_targets(root, config, goal.get("roadmap_ids", []), goal["roadmap_impact"])
    goal["roadmap_fingerprint"] = roadmap_fingerprint(root, config, goal.get("roadmap_ids", []))
    plan = payload.get("plan_markdown")
    if plan is not None:
        if not isinstance(plan, str) or not plan.strip():
            raise ContinuityError("plan_markdown must be a non-empty string")
    revision_root = directory / "revisions" / f"v{goal['plan_version']}"
    revision_root.mkdir(parents=True, exist_ok=False)
    shutil.copy2(directory / "plan.md", revision_root / "plan.md")
    json_dump(revision_root / "goal.json", json_load(directory / "goal.json", {}))
    if (directory / "approval.json").exists():
        shutil.copy2(directory / "approval.json", revision_root / "approval.json")
    plan_source = plan if plan is not None else (directory / "plan.md").read_text(encoding="utf-8")
    (directory / "plan.md").write_text(with_planning_artifacts(plan_source, goal), encoding="utf-8")
    goal["plan_version"] += 1
    goal["state"] = "awaiting-feedback"
    goal.pop("held_from", None)
    goal.pop("scheduled_for", None)
    goal.pop("dispatched_at", None)
    goal["updated_at"] = iso_now(config)
    goal["plan_hash"] = goal_material_hash(directory, goal)
    json_dump(directory / "goal.json", goal)
    (directory / "approval.json").unlink(missing_ok=True)
    compliance = json_load(directory / "compliance.json", {})
    compliance.setdefault("stages", {})["approval"] = {
        "status": "pending",
        "evidence": [f"Approval invalidated by revision v{goal['plan_version']}"],
        "updated_at": goal["updated_at"],
    }
    compliance["stages"]["plan-review"] = {"status": "pending", "evidence": [], "updated_at": goal["updated_at"]}
    compliance["stages"]["roadmap-retrieval"] = {
        "status": "passed" if goal.get("roadmap_ids") else "not-applicable",
        "evidence": goal.get("roadmap_ids") or ["Goal has no roadmap context"],
        "updated_at": goal["updated_at"],
    }
    compliance["updated_at"] = goal["updated_at"]
    json_dump(directory / "compliance.json", compliance)
    update_note_work_status(root, config, goal.get("source_note_ids", []), "planned", goal_id=goal["goal_id"])
    append_jsonl(directory / "feedback.jsonl", {"at": goal["updated_at"], "author": args.author, "type": "revision", "text": args.summary})
    return goal


def goal_approve(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, goal = load_goal(root, config, args.goal_id)
    if goal.get("state") != "awaiting-feedback":
        raise ContinuityError(f"Only an awaiting-feedback goal can be approved; current state is {goal.get('state')}")
    if int(args.version) != goal["plan_version"]:
        raise ContinuityError(f"Requested v{args.version}; current plan is v{goal['plan_version']}")
    validate_goal_planning_artifacts(goal, require_resolved=True)
    validate_planning_artifact_parity(directory, goal)
    if goal.get("roadmap_fingerprint") != roadmap_fingerprint(root, config, goal.get("roadmap_ids", [])):
        raise ContinuityError("Roadmap context changed after planning; revise the goal before approval")
    compliance = json_load(directory / "compliance.json", {})
    if compliance.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Goal compliance ledger uses a missing or unsupported assurance standard")
    for stage in ("memory-retrieval", "roadmap-retrieval", "plan-review"):
        state = compliance.get("stages", {}).get(stage, {}).get("status")
        if state not in {"passed", "not-applicable"}:
            raise ContinuityError(f"Compliance stage {stage} must pass before approval")
    expected_authorization = re.compile(
        rf"\b{re.escape(goal['goal_id'])}\b.*\bplan\s+v{goal['plan_version']}\b",
        re.IGNORECASE,
    )
    if not expected_authorization.search(args.authorization_text):
        raise ContinuityError("Authorization text must explicitly name the goal ID and plan version")
    plan_hash = goal_material_hash(directory, goal)
    scheduled_for = parse_schedule(args.schedule, config) if args.schedule else next_default_start(config)
    stamp = iso_now(config)
    approval = {
        "schema_version": SCHEMA_VERSION,
        "goal_id": goal["goal_id"],
        "plan_version": goal["plan_version"],
        "plan_hash": plan_hash,
        "approved_at": stamp,
        "approved_by": args.approved_by,
        "authorization_text": args.authorization_text,
    }
    json_dump(directory / "approval.json", approval)
    compliance["stages"]["approval"] = {
        "status": "passed",
        "evidence": [approval["authorization_text"], plan_hash],
        "updated_at": stamp,
    }
    compliance["updated_at"] = stamp
    json_dump(directory / "compliance.json", compliance)
    goal["plan_hash"] = plan_hash
    goal["state"] = "queued"
    goal["scheduled_for"] = scheduled_for
    goal["updated_at"] = stamp
    json_dump(directory / "goal.json", goal)
    update_note_work_status(root, config, goal.get("source_note_ids", []), "queued", goal_id=goal["goal_id"])
    append_jsonl(directory / "feedback.jsonl", {"at": stamp, "author": args.approved_by, "type": "approval", "text": approval["authorization_text"]})
    append_jsonl(private_path(root, config) / "events.jsonl", {"at": stamp, "event": "goal.approved", "goal_id": goal["goal_id"], "scheduled_for": goal["scheduled_for"]})
    return {"goal": goal, "approval": approval}


def requested_workspace_roots(values: Iterable[str] = ()) -> list[Path]:
    raw = [value for value in values if value]
    if not raw:
        raw = [value for value in os.environ.get("CONTINUITY_WORKSPACE_ROOTS", "").split(os.pathsep) if value]
    if not raw:
        raw = [str(Path.cwd())]
    roots: list[Path] = []
    for value in raw:
        root = Path(value).expanduser().resolve()
        if not root.is_dir() or root == Path("/"):
            raise ContinuityError(f"Unsafe or missing workspace root: {root}")
        if root not in roots:
            roots.append(root)
    return roots


def discover_projects(workspace_roots: Iterable[Path]) -> list[dict[str, Any]]:
    discovered: dict[str, dict[str, Any]] = {}
    pruned = {".git", ".agents", ".continuity", "node_modules", ".venv", "venv", "dist", "build", "target", "vendor", "__pycache__"}
    for workspace_root in workspace_roots:
        for current, directories, _files in os.walk(workspace_root, followlinks=False):
            current_path = Path(current).resolve()
            if not current_path.is_relative_to(workspace_root):
                directories[:] = []
                continue
            manifest_path = current_path / ".continuity" / "project.json"
            if manifest_path.is_file() and manifest_path.resolve().is_relative_to(current_path):
                try:
                    manifest = load_project_manifest(current_path)
                    config = json_load(current_path / ".continuity" / "config.json", {})
                    problems = []
                    if not manifest.get("continuity_enabled"):
                        problems.append("continuity is disabled")
                    if not isinstance(config, dict) or config.get("schema_version") != SCHEMA_VERSION:
                        problems.append("configuration is missing or invalid")
                    elif config.get("project_id") != manifest.get("project_id"):
                        problems.append("manifest and configuration project IDs differ")
                    if not (current_path / "AGENTS.md").is_file():
                        problems.append("AGENTS.md is missing")
                    if not (current_path / ".agents" / "continuity" / "bin" / "continuity").is_file():
                        problems.append("project-local continuity CLI is missing")
                    installed_skills = current_path / ".agents" / "skills"
                    missing_skills = [
                        name for name in (
                            "continuity-capture",
                            "continuity-triage",
                            "continuity-memory",
                            "continuity-roadmap",
                            "continuity-share",
                            "continuity-plan",
                            "continuity-dispatch",
                            "continuity-execute",
                            "continuity-test",
                            "continuity-merge",
                            "continuity-report",
                        )
                        if not (installed_skills / name / "SKILL.md").is_file()
                    ]
                    if missing_skills:
                        problems.append(f"missing skills: {missing_skills}")
                    project_id = str(manifest.get("project_id", ""))
                    if not project_id:
                        problems.append("project_id is missing")
                        project_id = str(current_path)
                    record = {
                        "project_id": project_id,
                        "path": str(current_path),
                        "manifest": manifest,
                        "healthy": not problems,
                        "problems": problems,
                    }
                    if project_id in discovered and discovered[project_id]["path"] != record["path"]:
                        discovered[project_id]["healthy"] = False
                        discovered[project_id]["problems"].append(f"duplicate project ID at {record['path']}")
                    else:
                        discovered[project_id] = record
                except (ContinuityError, json.JSONDecodeError) as exc:
                    discovered[str(current_path)] = {
                        "project_id": None,
                        "path": str(current_path),
                        "healthy": False,
                        "problems": [str(exc)],
                    }
                directories[:] = []
                continue
            directories[:] = [name for name in directories if name not in pruned and not name.startswith(".")]
    return sorted(discovered.values(), key=lambda item: (str(item.get("project_id")), item["path"]))


def dependency_states(root: Path, config: dict[str, Any], goal: dict[str, Any]) -> dict[str, str]:
    states: dict[str, str] = {}
    for dependency in goal.get("depends_on", []):
        try:
            dependency_root = root
            dependency_config = config
            dependency_goal_id = dependency
            if ":" in dependency:
                project_id, dependency_goal_id = dependency.split(":", 1)
                project = next(
                    (item for item in discover_projects(requested_workspace_roots()) if item.get("project_id") == project_id and item.get("healthy")),
                    None,
                )
                if not project:
                    raise ContinuityError(f"Unknown dependency project {project_id}")
                dependency_root = Path(project["path"]).expanduser().resolve()
                dependency_config = json_load(dependency_root / ".continuity" / "config.json", {})
            _directory, dep = load_goal(dependency_root, dependency_config, dependency_goal_id)
            states[dependency] = dep.get("state", "unknown")
        except ContinuityError:
            states[dependency] = "missing"
    return states


def portfolio_goals(args: argparse.Namespace) -> list[dict[str, Any]]:
    workspace_roots = requested_workspace_roots(args.root or [])
    os.environ["CONTINUITY_WORKSPACE_ROOTS"] = os.pathsep.join(str(root) for root in workspace_roots)
    projects = discover_projects(workspace_roots)
    if args.discover:
        return projects
    results: list[dict[str, Any]] = []
    for project in projects:
        if not project.get("healthy"):
            results.append(project)
            continue
        project_root = Path(project["path"]).expanduser().resolve()
        manifest = project["manifest"]
        config = json_load(project_root / ".continuity" / "config.json", {})
        if args.due and not manifest.get("execution_enabled"):
            continue
        if args.due:
            previous = os.environ.get("CONTINUITY_PROJECT_ROOT")
            os.environ["CONTINUITY_PROJECT_ROOT"] = str(project_root)
            try:
                goals = goal_due(argparse.Namespace())
            finally:
                if previous is None:
                    os.environ.pop("CONTINUITY_PROJECT_ROOT", None)
                else:
                    os.environ["CONTINUITY_PROJECT_ROOT"] = previous
        else:
            goals = []
            for path in sorted((private_path(project_root, config) / "goals").glob("*/goal.json")):
                goal = json_load(path, {})
                if isinstance(goal, dict):
                    goals.append(goal)
        for goal in goals:
            results.append(
                {
                    "project_id": project.get("project_id"),
                    "path": str(project_root),
                    "integration_branch": manifest.get("integration_branch"),
                    "execution_enabled": manifest.get("execution_enabled", False),
                    "project_lock": json_load(private_path(project_root, config) / "project.lock.json"),
                    **goal,
                }
            )
    return results


def detected_validation_commands(root: Path) -> list[str]:
    package_path = root / "package.json"
    if not package_path.exists():
        return []
    package = json_load(package_path, {})
    scripts = package.get("scripts", {}) if isinstance(package, dict) else {}
    if not isinstance(scripts, dict):
        return []
    runner = "pnpm" if (root / "pnpm-lock.yaml").exists() else "npm run"
    detected: list[str] = []
    for name in ("typecheck", "test", "build"):
        if name not in scripts:
            continue
        detected.append(f"{runner} {name}" if runner == "pnpm" else f"{runner} {name}")
    return detected


def current_behavior_settings(root: Path, config: dict[str, Any], manifest: dict[str, Any]) -> dict[str, Any]:
    existing_path = confined_path(root, config.get("behavior_config_path", BEHAVIOR_CONFIG_PATH), "behavior_config_path")
    existing = json_load(existing_path, {})
    if isinstance(existing, dict) and isinstance(existing.get("settings"), dict):
        settings = dict(existing["settings"])
        settings.setdefault("planning_patterns", dict(DEFAULT_PLANNING_PATTERNS))
        settings.setdefault("roadmap", dict(DEFAULT_ROADMAP_SETTINGS))
        settings.setdefault("agent_surfaces", dict(DEFAULT_AGENT_SURFACES))
        settings.setdefault("scheduler", dict(DEFAULT_SCHEDULER))
        documentation_map = dict(settings.get("documentation_map", {}))
        documentation_map.setdefault("project-roadmap", "docs/project-roadmap/INDEX.md")
        settings["documentation_map"] = documentation_map
        return settings
    schedules = manifest.get("schedules", {}) if isinstance(manifest.get("schedules"), dict) else {}
    return {
        "integration_branch": config.get("integration_branch", manifest.get("integration_branch", "main")),
        "timezone": config.get("timezone", manifest.get("timezone", "America/Chicago")),
        "schedules": {
            "review": schedules.get("review", "20:00"),
            "dispatch": schedules.get("dispatch", config.get("default_start_time", "22:00")),
            "report": schedules.get("report", "07:00"),
        },
        "max_runtime_minutes": config.get("max_runtime_minutes", 360),
        "memory_stale_after_days": config.get("memory_stale_after_days", 90),
        "validation_commands": config.get("validation_commands", []),
        "security_commands": config.get("security_commands", []),
        "documentation_map": {**config.get("documentation_map", {"project-memory": "docs/project-memory/INDEX.md"}), "project-roadmap": "docs/project-roadmap/INDEX.md"},
        "visual_evidence_mode": config.get("visual_evidence_mode", "when-applicable"),
        "branch_prefix": config.get("branch_prefix", "continuity"),
        "project_instructions": config.get("project_instructions", []),
        "planning_patterns": config.get("planning_patterns", dict(DEFAULT_PLANNING_PATTERNS)),
        "roadmap": config.get("roadmap", dict(DEFAULT_ROADMAP_SETTINGS)),
        "agent_surfaces": config.get("agent_surfaces", manifest.get("agent_surfaces", dict(DEFAULT_AGENT_SURFACES))),
        "scheduler": config.get("scheduler", manifest.get("scheduler", dict(DEFAULT_SCHEDULER))),
        "execution_enabled": bool(manifest.get("execution_enabled", False)),
    }


def recommended_behavior_settings(root: Path, config: dict[str, Any], manifest: dict[str, Any]) -> dict[str, Any]:
    current = current_behavior_settings(root, config, manifest)
    detected = detected_validation_commands(root)
    return {
        "integration_branch": current["integration_branch"],
        "timezone": current["timezone"],
        "schedules": current["schedules"],
        "max_runtime_minutes": current["max_runtime_minutes"],
        "memory_stale_after_days": current["memory_stale_after_days"],
        "validation_commands": detected or current.get("validation_commands", []),
        "security_commands": current.get("security_commands", []),
        "documentation_map": current.get("documentation_map", {"project-memory": "docs/project-memory/INDEX.md"}),
        "visual_evidence_mode": "when-applicable",
        "branch_prefix": "continuity",
        "project_instructions": current.get("project_instructions", []),
        "planning_patterns": current.get("planning_patterns", dict(DEFAULT_PLANNING_PATTERNS)),
        "roadmap": current.get("roadmap", dict(DEFAULT_ROADMAP_SETTINGS)),
        "agent_surfaces": current.get("agent_surfaces", dict(DEFAULT_AGENT_SURFACES)),
        "scheduler": current.get("scheduler", dict(DEFAULT_SCHEDULER)),
        "execution_enabled": False,
    }


