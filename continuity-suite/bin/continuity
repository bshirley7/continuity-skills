class ContinuityError(RuntimeError):
    pass


GITHUB_REPOSITORY_PART = re.compile(r"[A-Za-z0-9_.-]+")


def canonical_github_host(parsed: urllib.parse.SplitResult) -> str:
    if parsed.username is not None or parsed.password is not None:
        raise ContinuityError("GitHub URLs must not contain inline credentials")
    hostname = parsed.hostname
    if not hostname:
        raise ContinuityError("GitHub URL is missing a hostname")
    try:
        hostname = hostname.encode("idna").decode("ascii").lower()
        port = parsed.port
    except (UnicodeError, ValueError) as exc:
        raise ContinuityError("GitHub URL has an invalid hostname or port") from exc
    labels = hostname.split(".")
    if (
        len(hostname) > 253
        or any(not label or len(label) > 63 or not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]*[a-z0-9])?", label) for label in labels)
    ):
        raise ContinuityError("GitHub URL has an invalid hostname")
    if port is not None and not 1 <= port <= 65535:
        raise ContinuityError("GitHub URL has an invalid port")
    return f"{hostname}:{port}" if port is not None else hostname


def github_repository_parts(path: str) -> tuple[str, str]:
    components = path.strip("/").split("/")
    if len(components) != 2:
        raise ContinuityError("GitHub repository URL must identify exactly OWNER/REPOSITORY")
    owner, repository = components
    if repository.endswith(".git"):
        repository = repository[:-4]
    if (
        not GITHUB_REPOSITORY_PART.fullmatch(owner)
        or not GITHUB_REPOSITORY_PART.fullmatch(repository)
        or owner in {".", ".."}
        or repository in {".", ".."}
    ):
        raise ContinuityError("GitHub repository URL has an invalid owner or repository name")
    return owner, repository


def github_repository_from_remote(root: Path, remote: str = "origin") -> dict[str, Any]:
    if remote != "origin":
        raise ContinuityError("GitHub delivery is bound to the origin remote")
    result = git_result(root, "config", "--get", "remote.origin.url")
    value = result.stdout.strip() if result.returncode == 0 else ""
    if not value or any(character in value for character in "\r\n\x00"):
        raise ContinuityError("GitHub delivery requires one valid origin remote URL")
    if "://" in value:
        parsed = urllib.parse.urlsplit(value)
        if parsed.scheme not in {"https", "ssh", "git"} or parsed.query or parsed.fragment:
            raise ContinuityError("origin must use a canonical HTTPS, SSH, or Git GitHub repository URL")
        host = canonical_github_host(parsed)
        owner, repository = github_repository_parts(parsed.path)
    else:
        match = re.fullmatch(r"(?:[A-Za-z0-9._-]+@)?(?P<host>[^/:\s]+):(?P<path>[^\s]+)", value)
        if not match:
            raise ContinuityError("origin must use a canonical GitHub repository URL")
        parsed = urllib.parse.urlsplit(f"ssh://{match.group('host')}/{match.group('path')}")
        host = canonical_github_host(parsed)
        owner, repository = github_repository_parts(match.group("path"))
    return {
        "host": host,
        "owner": owner,
        "repository": repository,
        "slug": f"{owner}/{repository}",
        "spec": f"{host}/{owner}/{repository}",
        "remote": remote,
    }


def parse_github_pr_url(pr_url: str) -> dict[str, Any]:
    if not isinstance(pr_url, str) or any(character in pr_url for character in "\r\n\x00"):
        raise ContinuityError("A canonical GitHub pull-request URL is required")
    parsed = urllib.parse.urlsplit(pr_url)
    if parsed.scheme != "https" or parsed.query or parsed.fragment or parsed.path.endswith("/"):
        raise ContinuityError("A canonical HTTPS GitHub pull-request URL is required")
    host = canonical_github_host(parsed)
    components = parsed.path.strip("/").split("/")
    if len(components) != 4 or components[2] != "pull" or not re.fullmatch(r"[1-9][0-9]*", components[3]):
        raise ContinuityError("A canonical GitHub pull-request URL is required")
    owner, repository = github_repository_parts("/".join(components[:2]))
    number = int(components[3])
    return {
        "host": host,
        "owner": owner,
        "repository": repository,
        "slug": f"{owner}/{repository}",
        "spec": f"{host}/{owner}/{repository}",
        "number": number,
        "url": f"https://{host}/{owner}/{repository}/pull/{number}",
    }


def github_pr_context(root: Path, pr_url: str) -> dict[str, Any]:
    requested = parse_github_pr_url(pr_url)
    local = github_repository_from_remote(root)
    expected = (local["host"].casefold(), local["owner"].casefold(), local["repository"].casefold())
    actual = (requested["host"].casefold(), requested["owner"].casefold(), requested["repository"].casefold())
    if actual != expected:
        raise ContinuityError(
            f"PR repository {requested['spec']} does not match origin repository {local['spec']}"
        )
    return {**requested, "remote": local["remote"]}


def now(config: dict[str, Any]) -> dt.datetime:
    return dt.datetime.now(ZoneInfo(config.get("timezone", "America/Chicago")))


def iso_now(config: dict[str, Any]) -> str:
    return now(config).isoformat(timespec="seconds")


def json_dump(path: Path, value: Any) -> None:
    try:
        runtime_lib.atomic_write_json(path, value)
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc


def json_load(path: Path, default: Any = None) -> Any:
    if not path.exists():
        return default
    return json.loads(path.read_text(encoding="utf-8"))


def append_jsonl(path: Path, value: Any) -> None:
    try:
        runtime_lib.append_integrity_jsonl(path, value)
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc


def exclusive_file_lock(path: Path) -> Iterable[None]:
    return runtime_lib.exclusive_file_lock(path)


def iter_jsonl(path: Path) -> Iterable[dict[str, Any]]:
    try:
        values = runtime_lib.load_jsonl(path)
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    return [{key: item for key, item in value.items() if key != "_integrity"} for value in values]


def find_project_root(start: Path | None = None) -> Path:
    env = os.environ.get("CONTINUITY_PROJECT_ROOT")
    if env:
        root = Path(env).expanduser().resolve()
        if not (root / ".continuity" / "config.json").exists():
            raise ContinuityError(f"No .continuity/config.json below {root}")
        return root
    current = (start or Path.cwd()).resolve()
    for candidate in [current, *current.parents]:
        if (candidate / ".continuity" / "config.json").exists():
            return candidate
    raise ContinuityError("Run inside a configured project or set CONTINUITY_PROJECT_ROOT")


def load_context(start: Path | None = None, *, validate_behavior: bool = True) -> tuple[Path, dict[str, Any]]:
    root = find_project_root(start)
    try:
        runtime_lib.validate_project_filesystem(root)
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    config = json_load(root / ".continuity" / "config.json")
    if not isinstance(config, dict) or config.get("schema_version") != SCHEMA_VERSION:
        raise ContinuityError("Unsupported or missing continuity configuration")
    if config.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Missing or unsupported development assurance standard")
    confined_path(root, config.get("private_dir", ".continuity/private"), "private_dir")
    confined_path(root, config.get("memory_docs", "docs/project-memory"), "memory_docs")
    confined_path(root, config.get("roadmap_docs", "docs/project-roadmap"), "roadmap_docs")
    validate_git_branch(root, config.get("integration_branch"), "integration_branch")
    if validate_behavior and config.get("behavior_config_path"):
        validate_project_behavior(root, config)
    return root, config


def load_project_manifest(root: Path) -> dict[str, Any]:
    manifest = json_load(root / ".continuity" / "project.json", {})
    if not isinstance(manifest, dict) or manifest.get("schema_version") != SCHEMA_VERSION:
        raise ContinuityError(f"Project-local continuity manifest is missing or invalid at {root}")
    if manifest.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError(f"Project-local assurance standard is missing or unsupported at {root}")
    return manifest


def confined_path(root: Path, value: str, label: str) -> Path:
    try:
        portable = runtime_lib.validate_portable_relative_path(value, label=label)
    except runtime_lib.RuntimeIntegrityError as exc:
        raise ContinuityError(str(exc)) from exc
    candidate = Path(portable)
    resolved = (root / candidate).resolve()
    if not resolved.is_relative_to(root.resolve()):
        raise ContinuityError(f"{label} escapes the project root")
    return resolved


def private_path(root: Path, config: dict[str, Any]) -> Path:
    return confined_path(root, config.get("private_dir", ".continuity/private"), "private_dir")


def slug(value: str, limit: int = 56) -> str:
    normalized = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return normalized[:limit].rstrip("-") or "item"


def stable_id(prefix: str, *parts: str) -> str:
    digest = hashlib.sha256("\x1f".join(parts).encode()).hexdigest()[:10]
    return f"{prefix}-{digest}"


def validate_identifier(value: str, label: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", value):
        raise ContinuityError(f"Invalid {label}: use 1-128 letters, numbers, dots, underscores, or hyphens")
    return value


def validate_git_remote_name(value: Any) -> str:
    remote = str(value)
    if remote in {".", ".."} or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", remote):
        raise ContinuityError("Invalid Git remote name: use a configured remote name, not a URL or option")
    return remote


def validate_git_object_id(value: Any, label: str = "Git object ID") -> str:
    object_id = str(value)
    if not re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", object_id):
        raise ContinuityError(f"Invalid {label}: expected a full lowercase hexadecimal object ID")
    return object_id


def validate_git_branch(root: Path, value: Any, label: str = "Git branch") -> str:
    if not isinstance(value, str):
        raise ContinuityError(f"{label} must be a Git branch name")
    branch = value
    if (
        not branch
        or len(branch.encode("utf-8")) > 255
        or branch.startswith("-")
        or any(character.isspace() or ord(character) < 32 for character in branch)
        or any(token in branch for token in ("..", "@{", "\\", "~", "^", ":", "?", "*", "["))
        or branch.endswith(("/", "."))
        or any(part in {"", ".", ".."} or part.endswith(".lock") for part in branch.split("/"))
    ):
        raise ContinuityError(f"{label} is not a safe Git branch name")
    if git_result(root, "check-ref-format", "--branch", branch).returncode != 0:
        raise ContinuityError(f"{label} is not a valid Git branch name")
    return branch


def validate_release_version(value: Any) -> str:
    version = str(value)
    if len(version) > 128 or not re.fullmatch(
        r"v?(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?",
        version,
    ):
        raise ContinuityError("Invalid release version: expected a SemVer tag such as v1.2.3 or 1.2.3-rc.1")
    return version


def validate_remote_tracking_ref(root: Path, value: Any) -> str:
    ref = str(value)
    if ref.startswith("-") or not ref or ":" in ref or "\\" in ref:
        raise ContinuityError("Invalid approval trust ref")
    checked = git_result(root, "check-ref-format", f"refs/remotes/{ref}")
    if checked.returncode != 0:
        raise ContinuityError("Invalid approval trust ref")
    return ref


def validate_task_id(value: str, label: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}", value):
        raise ContinuityError(
            f"Invalid {label}: use 1-256 letters, numbers, dots, underscores, colons, slashes, or hyphens"
        )
    return value


def canonical_hash(value: Any) -> str:
    return hashlib.sha256(
        json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()


def validate_string_list(value: Any, label: str, *, required: bool = False) -> list[str]:
    if not isinstance(value, list) or any(not isinstance(item, str) or not item.strip() for item in value):
        raise ContinuityError(f"{label} must be an array of non-empty strings")
    if required and not value:
        raise ContinuityError(f"{label} must contain at least one item")
    return value


def validate_dag(nodes: set[str], edges: dict[str, list[str]], label: str) -> None:
    for node, blockers in edges.items():
        unknown = sorted(set(blockers) - nodes)
        if unknown:
            raise ContinuityError(f"{label} {node} references unknown blockers: {unknown}")
        if node in blockers:
            raise ContinuityError(f"{label} {node} cannot block itself")
    visiting: set[str] = set()
    visited: set[str] = set()

    def visit(node: str) -> None:
        if node in visiting:
            raise ContinuityError(f"{label} dependency graph contains a cycle at {node}")
        if node in visited:
            return
        visiting.add(node)
        for blocker in edges.get(node, []):
            visit(blocker)
        visiting.remove(node)
        visited.add(node)

    for node in sorted(nodes):
        visit(node)


def validate_triage_brief(value: Any) -> dict[str, Any] | None:
    if value is None:
        return None
    if not isinstance(value, dict):
        raise ContinuityError("triage_brief must be a JSON object")
    required_strings = ("summary", "classification", "claim_status", "current_behavior", "desired_behavior")
    for key in required_strings:
        if not isinstance(value.get(key), str) or not value[key].strip():
            raise ContinuityError(f"triage_brief.{key} must be a non-empty string")
    if value["classification"] not in NOTE_KINDS:
        raise ContinuityError("triage_brief.classification is not a supported note kind")
    if value["claim_status"] not in {"confirmed", "unconfirmed", "contradicted", "not-applicable"}:
        raise ContinuityError("triage_brief.claim_status is unsupported")
    for key in ("acceptance_criteria", "scope_exclusions", "evidence"):
        validate_string_list(value.get(key), f"triage_brief.{key}", required=key != "scope_exclusions")
    checks = value.get("codebase_checks")
    if not isinstance(checks, dict) or set(checks) != {"redundancy", "prior_decisions"}:
        raise ContinuityError("triage_brief.codebase_checks must define exactly redundancy and prior_decisions")
    for key, check in checks.items():
        if not isinstance(check, dict) or check.get("status") not in {"clear", "found", "uncertain", "not-applicable"}:
            raise ContinuityError(f"triage_brief.codebase_checks.{key}.status is unsupported")
        validate_string_list(check.get("evidence"), f"triage_brief.codebase_checks.{key}.evidence", required=True)
    normalized = dict(value)
    if normalized.get("execution_authorized") not in {None, False}:
        raise ContinuityError("A triage brief cannot authorize execution")
    normalized["execution_authorized"] = False
    return normalized


def validate_decision_map(value: Any) -> dict[str, Any] | None:
    if value is None:
        return None
    if not isinstance(value, dict) or not isinstance(value.get("destination"), str) or not value["destination"].strip():
        raise ContinuityError("decision_map requires a non-empty destination")
    for key in ("unresolved_territory", "out_of_scope"):
        validate_string_list(value.get(key), f"decision_map.{key}")
    decisions = value.get("decisions")
    if not isinstance(decisions, list) or not decisions:
        raise ContinuityError("decision_map.decisions must contain at least one decision")
    nodes: set[str] = set()
    edges: dict[str, list[str]] = {}
    for decision in decisions:
        if not isinstance(decision, dict):
            raise ContinuityError("Each decision_map decision must be a JSON object")
        decision_id = validate_identifier(str(decision.get("decision_id", "")), "decision ID")
        if decision_id in nodes:
            raise ContinuityError(f"Duplicate decision ID: {decision_id}")
        nodes.add(decision_id)
        for key in ("title", "question"):
            if not isinstance(decision.get(key), str) or not decision[key].strip():
                raise ContinuityError(f"Decision {decision_id} requires a non-empty {key}")
        if decision.get("status") not in {"open", "resolved", "blocked", "human-required"}:
            raise ContinuityError(f"Decision {decision_id} has an unsupported status")
        blockers = validate_string_list(decision.get("blocked_by", []), f"Decision {decision_id}.blocked_by")
        edges[decision_id] = blockers
        if decision.get("status") == "resolved" and (not isinstance(decision.get("resolution"), str) or not decision["resolution"].strip()):
            raise ContinuityError(f"Resolved decision {decision_id} requires a resolution")
    validate_dag(nodes, edges, "Decision")
    normalized = dict(value)
    if normalized.get("execution_authorized") not in {None, False}:
        raise ContinuityError("A decision map cannot authorize execution")
    normalized["execution_authorized"] = False
    return normalized


def validate_delivery_slices(value: Any) -> list[dict[str, Any]]:
    if value is None:
        return []
    if not isinstance(value, list):
        raise ContinuityError("delivery_slices must be a JSON array")
    nodes: set[str] = set()
    edges: dict[str, list[str]] = {}
    normalized: list[dict[str, Any]] = []
    for item in value:
        if not isinstance(item, dict):
            raise ContinuityError("Each delivery slice must be a JSON object")
        ticket_id = validate_identifier(str(item.get("ticket_id", "")), "delivery slice ID")
        if ticket_id in nodes:
            raise ContinuityError(f"Duplicate delivery slice ID: {ticket_id}")
        nodes.add(ticket_id)
        for key in ("title", "delivers"):
            if not isinstance(item.get(key), str) or not item[key].strip():
                raise ContinuityError(f"Delivery slice {ticket_id} requires a non-empty {key}")
        validate_string_list(item.get("acceptance_criteria"), f"Delivery slice {ticket_id}.acceptance_criteria", required=True)
        blockers = validate_string_list(item.get("blocked_by", []), f"Delivery slice {ticket_id}.blocked_by")
        edges[ticket_id] = blockers
        if item.get("status", "planning-candidate") != "planning-candidate":
            raise ContinuityError("Delivery slices remain planning-candidate until the parent goal is approved and dispatched")
        if item.get("execution_authorized") not in {None, False}:
            raise ContinuityError("A delivery slice cannot authorize execution")
        normalized.append({**item, "status": "planning-candidate", "execution_authorized": False})
    validate_dag(nodes, edges, "Delivery slice")
    return normalized


def validate_note_dispositions(
    value: Any,
    source_note_ids: list[str],
    delivery_slices: list[dict[str, Any]],
    roadmap_ids: list[str],
) -> list[dict[str, Any]]:
    if value is None:
        if source_note_ids:
            raise ContinuityError(
                "note_dispositions is required when source_note_ids are present; "
                "classify every note as current-goal, later, context-only, or duplicate"
            )
        value = []
    if not isinstance(value, list):
        raise ContinuityError("note_dispositions must be a JSON array")
    slice_ids = {str(item["ticket_id"]) for item in delivery_slices}
    source_ids = set(source_note_ids)
    seen: set[str] = set()
    normalized: list[dict[str, Any]] = []
    for item in value:
        if not isinstance(item, dict):
            raise ContinuityError("Each note disposition must be a JSON object")
        note_id = validate_identifier(str(item.get("note_id", "")), "note disposition note ID")
        if note_id in seen:
            raise ContinuityError(f"Duplicate note disposition: {note_id}")
        seen.add(note_id)
        disposition = str(item.get("disposition", ""))
        if disposition not in NOTE_PLANNING_DISPOSITIONS:
            raise ContinuityError(f"Unsupported note disposition: {disposition}")
        reason = item.get("reason")
        if not isinstance(reason, str) or not reason.strip():
            raise ContinuityError(f"Note disposition {note_id} requires a reason")
        delivery_slice_ids = validate_string_list(
            item.get("delivery_slice_ids", []),
            f"Note disposition {note_id}.delivery_slice_ids",
        )
        unknown_slices = sorted(set(delivery_slice_ids) - slice_ids)
        if unknown_slices:
            raise ContinuityError(f"Note disposition {note_id} references unknown delivery slices: {unknown_slices}")
        review_after = item.get("review_after")
        if review_after is not None and not isinstance(review_after, str):
            raise ContinuityError(f"Note disposition {note_id}.review_after must be an ISO date-time or null")
        roadmap_id = item.get("roadmap_id")
        if roadmap_id is not None:
            roadmap_id = validate_identifier(str(roadmap_id), "note disposition roadmap ID")
            if roadmap_id not in roadmap_ids:
                raise ContinuityError(f"Note disposition {note_id} roadmap ID is absent from roadmap_ids")
        canonical_note_id = item.get("canonical_note_id")
        if canonical_note_id is not None:
            canonical_note_id = validate_identifier(str(canonical_note_id), "canonical note ID")
        if disposition == "current-goal":
            if review_after is not None or roadmap_id is not None or canonical_note_id is not None:
                raise ContinuityError(f"Current-goal note disposition {note_id} cannot define later or duplicate fields")
        elif disposition == "later":
            if not review_after and not roadmap_id:
                raise ContinuityError(f"Later note disposition {note_id} requires review_after or roadmap_id")
            if delivery_slice_ids or canonical_note_id is not None:
                raise ContinuityError(f"Later note disposition {note_id} cannot enter a delivery slice or duplicate another note")
        elif disposition == "context-only":
            if delivery_slice_ids or review_after is not None or roadmap_id is not None or canonical_note_id is not None:
                raise ContinuityError(f"Context-only note disposition {note_id} cannot define execution, later, or duplicate fields")
        elif disposition == "duplicate":
            if not canonical_note_id or canonical_note_id == note_id:
                raise ContinuityError(f"Duplicate note disposition {note_id} requires a different canonical_note_id")
            if delivery_slice_ids or review_after is not None or roadmap_id is not None:
                raise ContinuityError(f"Duplicate note disposition {note_id} cannot define execution or later fields")
        normalized.append(
            {
                "note_id": note_id,
                "disposition": disposition,
                "reason": reason.strip(),
                "delivery_slice_ids": delivery_slice_ids,
                "review_after": review_after,
                "roadmap_id": roadmap_id,
                "canonical_note_id": canonical_note_id,
                "execution_authorized": False,
            }
        )
    if seen != source_ids:
        raise ContinuityError(
            f"note_dispositions must cover source_note_ids exactly; missing={sorted(source_ids - seen)}, extra={sorted(seen - source_ids)}"
        )
    return normalized


def validate_roadmap_impact(value: Any, roadmap_ids: list[str]) -> dict[str, Any]:
    if value is None:
        return {"entries": [], "documentation_required": False, "summary": "No roadmap change planned."}
    if not isinstance(value, dict):
        raise ContinuityError("roadmap_impact must be a JSON object")
    entries = value.get("entries", [])
    if not isinstance(entries, list):
        raise ContinuityError("roadmap_impact.entries must be an array")
    normalized = []
    seen: set[tuple[str, str]] = set()
    for item in entries:
        if not isinstance(item, dict):
            raise ContinuityError("Each roadmap impact must be a JSON object")
        roadmap_id = validate_identifier(str(item.get("roadmap_id", "")), "roadmap ID")
        action = item.get("action")
        if action not in roadmap_lib.IMPACT_ACTIONS:
            raise ContinuityError(f"Unsupported roadmap impact action: {action}")
        if roadmap_id not in roadmap_ids:
            raise ContinuityError(f"Roadmap impact {roadmap_id} is absent from roadmap_ids")
        if (roadmap_id, action) in seen:
            raise ContinuityError(f"Duplicate roadmap impact: {roadmap_id} {action}")
        seen.add((roadmap_id, action))
        rationale = item.get("rationale")
        if not isinstance(rationale, str) or not rationale.strip():
            raise ContinuityError(f"Roadmap impact {roadmap_id} requires a rationale")
        normalized.append({**item, "roadmap_id": roadmap_id, "action": action, "rationale": rationale.strip()})
    summary = value.get("summary", "")
    if not isinstance(summary, str) or not summary.strip():
        raise ContinuityError("roadmap_impact.summary must be a non-empty string")
    documentation_required = value.get("documentation_required", bool([item for item in normalized if item["action"] != "none"]))
    if not isinstance(documentation_required, bool):
        raise ContinuityError("roadmap_impact.documentation_required must be true or false")
    if any(item["action"] != "none" for item in normalized) and not documentation_required:
        raise ContinuityError("Roadmap changes require roadmap impact documentation")
    return {"entries": normalized, "documentation_required": documentation_required, "summary": summary.strip()}


def validate_goal_roadmap_targets(root: Path, config: dict[str, Any], roadmap_ids: list[str], impact: dict[str, Any]) -> None:
    roadmap_entries = roadmap_lib.entries(root, config)
    current = {item.get("roadmap_id") for item in roadmap_entries}
    actions = {item["roadmap_id"]: item["action"] for item in impact.get("entries", [])}
    counts = {roadmap_id: sum(1 for item in roadmap_entries if item.get("roadmap_id") == roadmap_id) for roadmap_id in roadmap_ids}
    for roadmap_id in roadmap_ids:
        action = actions.get(roadmap_id, "none")
        if action == "create" and roadmap_id in current:
            raise ContinuityError(f"Roadmap create target already exists: {roadmap_id}")
        if action != "create" and roadmap_id not in current:
            raise ContinuityError(f"Roadmap retrieval target does not exist: {roadmap_id}")
        if counts[roadmap_id] > 1:
            raise ContinuityError(f"Roadmap retrieval target is duplicated: {roadmap_id}")
        if action != "create":
            try:
                roadmap_lib.normalize_entry(next(item for item in roadmap_entries if item.get("roadmap_id") == roadmap_id))
            except roadmap_lib.RoadmapError as exc:
                raise ContinuityError(f"Roadmap retrieval target is invalid: {roadmap_id}: {exc}") from exc
    if roadmap_ids:
        report = roadmap_lib.audit(root, config)
        targets = set(roadmap_ids)
        blocking = []
        for key in ("unknown_parents", "unknown_dependencies", "unknown_links", "contradictions", "stale_note_links"):
            for issue in report.get(key, []):
                if issue.get("roadmap_id") in targets:
                    blocking.append({key: issue})
        for cycle in report.get("cycles", []):
            if targets.intersection(cycle):
                blocking.append({"cycle": cycle})
        if blocking:
            raise ContinuityError(f"Roadmap context requires reconciliation before planning: {blocking}")


def roadmap_fingerprint(root: Path, config: dict[str, Any], roadmap_ids: list[str]) -> str:
    by_id = {item.get("roadmap_id"): item for item in roadmap_lib.entries(root, config)}
    material = {}
    for roadmap_id in sorted(roadmap_ids):
        item = by_id.get(roadmap_id)
        material[roadmap_id] = hashlib.sha256((root / item["path"]).read_bytes()).hexdigest() if item else "missing-at-plan-time"
    return canonical_hash(material)


def source_capture_refs_for_notes(root: Path, config: dict[str, Any], note_ids: list[str]) -> list[dict[str, Any]]:
    refs: dict[str, dict[str, Any]] = {}
    for note_id in note_ids:
        _path, capture, _item = find_note_item(root, config, note_id)
        if capture.get("document_type") not in DOCUMENT_TYPES:
            continue
        capture_id = str(capture.get("capture_id"))
        refs[capture_id] = {
            "capture_id": capture_id,
            "document_id": str(capture.get("document_id")),
            "document_type": str(capture.get("document_type")),
            "document_revision": int(capture.get("document_revision", 0)),
            "document_version": capture.get("document_version"),
            "source_authority": str(capture.get("source_authority")),
            "source_ref": str(capture.get("source_ref")),
            "source_hash": str(capture.get("source_hash")),
        }
    return [refs[key] for key in sorted(refs)]


def render_planning_artifacts(goal: dict[str, Any]) -> str:
    lines = ["<!-- continuity-planning-artifacts:start -->", "## Planning evidence and decomposition"]
    if "source_capture_refs" in goal:
        source_capture_refs = goal.get("source_capture_refs", [])
        lines.extend(["", "### Source documents", ""])
        if source_capture_refs:
            for item in source_capture_refs:
                version = f"; document version: {item['document_version']}" if item.get("document_version") else ""
                lines.append(
                    f"- `{item['document_id']}` — `{item['document_type']}` revision {item['document_revision']}{version}; "
                    f"capture `{item['capture_id']}`; source hash `{item['source_hash']}`; authority `{item['source_authority']}`"
                )
        else:
            lines.append("- No PRD or feature-request source document is attached to this goal.")
    if "design_refs" in goal:
        lines.extend(["", "### Approved design", ""])
        design_refs = goal.get("design_refs", [])
        if design_refs:
            for item in design_refs:
                packs = ", ".join(f"{pack['pack_id']}@{pack['version']}" for pack in item.get("catalog_packs", []))
                lines.append(f"- `{item['design_id']}` revision {item['revision']}; design hash `{item['design_hash']}`; catalog packs: {packs or 'none'}")
        else:
            lines.append("- No approved design document is attached to this goal.")
    brief = goal.get("triage_brief")
    if brief:
        lines.extend([
            "", "### Evidence triage brief", "",
            f"- Classification: `{brief['classification']}`",
            f"- Claim status: `{brief['claim_status']}`",
            f"- Summary: {brief['summary']}",
            f"- Current behavior: {brief['current_behavior']}",
            f"- Desired behavior: {brief['desired_behavior']}",
        ])
    decision_map = goal.get("decision_map")
    if decision_map:
        lines.extend(["", "### Decision map", "", f"Destination: {decision_map['destination']}", ""])
        for decision in decision_map["decisions"]:
            blockers = ", ".join(decision.get("blocked_by", [])) or "none"
            lines.append(f"- **{decision['title']}** (`{decision['decision_id']}`, {decision['status']}; blocked by: {blockers}) — {decision['question']}")
        if decision_map["unresolved_territory"]:
            lines.extend(["", "Unresolved territory:", *[f"- {item}" for item in decision_map["unresolved_territory"]]])
        if decision_map["out_of_scope"]:
            lines.extend(["", "Out of scope:", *[f"- {item}" for item in decision_map["out_of_scope"]]])
    slices = goal.get("delivery_slices", [])
    if slices:
        lines.extend(["", "### Delivery slices", ""])
        for item in slices:
            blockers = ", ".join(item.get("blocked_by", [])) or "none"
            lines.append(f"- **{item['title']}** (`{item['ticket_id']}`; blocked by: {blockers}) — {item['delivers']}")
    note_dispositions = goal.get("note_dispositions", [])
    lines.extend(["", "### Note dispositions", ""])
    if note_dispositions:
        for item in note_dispositions:
            details = []
            if item.get("delivery_slice_ids"):
                details.append(f"slices: {', '.join(item['delivery_slice_ids'])}")
            if item.get("review_after"):
                details.append(f"review after: {item['review_after']}")
            if item.get("roadmap_id"):
                details.append(f"roadmap: {item['roadmap_id']}")
            if item.get("canonical_note_id"):
                details.append(f"canonical note: {item['canonical_note_id']}")
            suffix = f"; {'; '.join(details)}" if details else ""
            lines.append(f"- `{item['note_id']}` — **{item['disposition']}**{suffix} — {item['reason']}")
    else:
        lines.append("- No captured note is attached to this goal.")
    roadmap_ids = goal.get("roadmap_ids", [])
    impact = goal.get("roadmap_impact", {})
    lines.extend(["", "### Roadmap context and impact", "", f"Retrieved roadmap IDs: {', '.join(roadmap_ids) or 'none'}"])
    lines.append(f"Roadmap baseline fingerprint: `{goal.get('roadmap_fingerprint', 'not-recorded')}`")
    if impact.get("entries"):
        for item in impact["entries"]:
            lines.append(f"- `{item['roadmap_id']}` — **{item['action']}** — {item['rationale']}")
    else:
        lines.append("- No committed roadmap change is planned.")
    lines.append(f"- Impact summary: {impact.get('summary', 'No roadmap change planned.')}")
    lines.extend(["", "These artifacts inform the plan and are included in its approval hash. They do not authorize execution.", "<!-- continuity-planning-artifacts:end -->"])
    return "\n".join(lines)


def with_planning_artifacts(plan: str, goal: dict[str, Any]) -> str:
    start = "<!-- continuity-planning-artifacts:start -->"
    end = "<!-- continuity-planning-artifacts:end -->"
    if start in plan and end in plan:
        plan = plan.split(start, 1)[0].rstrip() + "\n\n" + plan.split(end, 1)[1].lstrip()
    return plan.rstrip() + "\n\n" + render_planning_artifacts(goal) + "\n"


def behavior_payload_hash(record: dict[str, Any]) -> str:
    payload = {key: value for key, value in record.items() if key != "configuration_hash"}
    return canonical_hash(payload)


def render_project_behavior_skill(record: dict[str, Any]) -> str:
    project_id = validate_identifier(str(record.get("project_id", "")), "project id")
    configuration_hash = str(record.get("configuration_hash", ""))
    settings = record.get("settings", {})
    fixed = record.get("fixed_guardrails", {})
    overrides = record.get("overrides", [])
    return f'''---
name: continuity-local
description: Apply the committed project-specific continuity configuration for {project_id}. Use with every continuity capture, triage, memory, planning, dispatch, execution, testing, merge, or reporting action in this repository.
---

# Continuity Local Behavior

This skill is generated from `.continuity/project-behavior.json`. Reconfigure through `$continuity` or `continuity project configure`; do not edit this generated file directly.

Configuration hash: `{configuration_hash}`
Recommendation profile: `{record.get("recommendation_profile", BEHAVIOR_PROFILE)}`

## Required use

1. Read this skill after the task-specific continuity skill and before acting.
2. Apply the effective settings below as project instructions.
3. Treat the fixed guardrails as non-overridable. A requested exception requires a suite change and review; a local configuration answer cannot weaken them.
4. Run `continuity project doctor` and stop on configuration drift or hash mismatch.

## Effective settings

```json
{json.dumps(settings, indent=2, sort_keys=True)}
```

Explicitly overridden fields: `{json.dumps(overrides)}`

## Fixed guardrails

```json
{json.dumps(fixed, indent=2, sort_keys=True)}
```

Project settings refine how the suite operates; they never convert notes into authorization or bypass approval, audit, security, validation, merge-safety, documentation, or human-review gates.
'''


def replace_managed_block(text: str, start: str, end: str, block: str | None) -> str:
    if start in text and end in text:
        before = text.split(start, 1)[0].rstrip()
        after = text.split(end, 1)[1].lstrip()
        pieces = [item for item in (before, block.rstrip() if block else "", after) if item]
        return "\n\n".join(pieces).rstrip() + "\n" if pieces else ""
    if not block:
        return text
    return text.rstrip() + ("\n\n" if text.strip() else "") + block.rstrip() + "\n"


def continuity_skill_names(root: Path) -> list[str]:
    skills_root = root / ".agents" / "skills"
    return sorted(
        path.name
        for path in skills_root.iterdir()
        if (path.name == "goal" or path.name.startswith("continuity"))
        and path.is_dir()
        and (path / "SKILL.md").is_file()
    )


def remove_owned_skill_adapters(target: Path) -> None:
    if not target.exists():
        return
    for path in target.iterdir():
        if path.name != "goal" and not path.name.startswith("continuity"):
            continue
        if path.is_dir() and not path.is_symlink():
            shutil.rmtree(path)
        elif path.exists() or path.is_symlink():
            path.unlink()


def remove_owned_reference_adapters(root: Path, surface_root: Path) -> None:
    source_references = root / ".agents" / "references"
    target_references = surface_root / "references"
    if not source_references.is_dir() or not target_references.is_dir():
        return
    for source in source_references.rglob("*"):
        if source.is_file():
            target = target_references / source.relative_to(source_references)
            if target.is_file():
                target.unlink()


def directory_fingerprint(path: Path) -> dict[str, str]:
    if not path.is_dir():
        return {}
    return {
        item.relative_to(path).as_posix(): hashlib.sha256(item.read_bytes()).hexdigest()
        for item in sorted(path.rglob("*"))
        if item.is_file() and "__pycache__" not in item.parts and item.suffix != ".pyc"
    }


def directory_contains(source: Path, target: Path) -> bool:
    source_files = directory_fingerprint(source)
    target_files = directory_fingerprint(target)
    return bool(source_files) and all(target_files.get(name) == digest for name, digest in source_files.items())


def sync_skill_adapter(root: Path, surface_root: Path) -> None:
    source_skills = root / ".agents" / "skills"
    target_skills = surface_root / "skills"
    target_skills.mkdir(parents=True, exist_ok=True)
    remove_owned_skill_adapters(target_skills)
    for name in continuity_skill_names(root):
        shutil.copytree(source_skills / name, target_skills / name)
    source_references = root / ".agents" / "references"
    if source_references.is_dir():
        shutil.copytree(source_references, surface_root / "references", dirs_exist_ok=True)


def render_surface_command(skill_name: str) -> str:
    if skill_name == "goal":
        return (
            "# goal\n\n"
            "Slash command: `/goal`\n\n"
            "Read and follow `AGENTS.md`, then read `.agents/skills/goal/SKILL.md` and "
            "`.agents/skills/continuity-local/SKILL.md`. Treat trailing user text as the exact "
            "interactive goal request. Capture and triage it, project actionable notes into the "
            "private roadmap inbox, create the smallest aligned routine goal, bind the exact request "
            "with `goal activate`, and continue into coding without separate approval or start pauses. "
            "Stop for material scope or risk expansion, destructive or irreversible action, private-data "
            "disclosure, new cost, restricted external effects, or final merge authority.\n"
        )
    return (
        f"# {skill_name}\n\n"
        f"Slash command: `/{skill_name}`\n\n"
        "Read and follow `AGENTS.md`, then read the canonical skill at "
        f"`.agents/skills/{skill_name}/SKILL.md` and the project-specific "
        "`.agents/skills/continuity-local/SKILL.md`. Use the project-local CLI at "
        "`.agents/continuity/bin/continuity`. Preserve all approval, testing, security, "
        "merge-safety, and human-review gates. Treat any trailing user text as task context. "
        "For manual work, return control to `.agents/skills/continuity-workflow/SKILL.md` after "
        "the selected skill records its handoff; continue through machine-selected non-human "
        "skills and remediation, and pause only at an explicit `human_required` approval boundary.\n"
    )


def normalize_scheduler(value: Any) -> dict[str, Any]:
    scheduler = dict(DEFAULT_SCHEDULER)
    if isinstance(value, dict):
        scheduler.update(value)
    return scheduler


def scheduler_plan(settings: dict[str, Any]) -> dict[str, Any]:
    scheduler = normalize_scheduler(settings["scheduler"])
    provider = scheduler["provider"]
    return {
        "schema_version": 2,
        "provider": provider,
        "registration_state": "not-requested" if provider == "none" else "requires-user-registration",
        "primary_surface": settings["agent_surfaces"]["primary"],
        "enabled_surfaces": settings["agent_surfaces"]["enabled"],
        "timezone": settings["timezone"],
        "schedules": settings["schedules"],
        "policy": {key: value for key, value in scheduler.items() if key != "provider"},
        "prompts": {
            "supervisor": ".agents/continuity/automation/portfolio-supervisor.md",
            "review": ".agents/continuity/automation/nightly-review.md",
            "dispatch": ".agents/continuity/automation/default-dispatch.md",
            "report": ".agents/continuity/automation/morning-report.md",
        },
        "note": "Register one provider-owned supervisor task, then record its task ID and workspace roots in private project state.",
    }


def sync_surface_adapters(root: Path, settings: dict[str, Any]) -> None:
    enabled = set(settings["agent_surfaces"]["enabled"])
    skill_names = continuity_skill_names(root)

    claude_path = root / "CLAUDE.md"
    claude_text = claude_path.read_text(encoding="utf-8") if claude_path.exists() else ""
    claude_start = "<!-- continuity:claude:start -->"
    claude_end = "<!-- continuity:claude:end -->"
    claude_block = None
    if "claude-code" in enabled:
        claude_block = f"{claude_start}\n@AGENTS.md\n{claude_end}"
        sync_skill_adapter(root, root / ".claude")
    else:
        remove_owned_skill_adapters(root / ".claude" / "skills")
        remove_owned_reference_adapters(root, root / ".claude")
    updated_claude = replace_managed_block(claude_text, claude_start, claude_end, claude_block)
    if updated_claude.strip():
        claude_path.write_text(updated_claude, encoding="utf-8")
    elif claude_path.exists():
        claude_path.unlink()

    for commands_root in (root / ".claude" / "commands", root / ".cursor" / "commands"):
        commands_root.mkdir(parents=True, exist_ok=True)
        for name in skill_names:
            (commands_root / f"{name}.md").write_text(render_surface_command(name), encoding="utf-8")

    cursor_commands = root / ".cursor" / "commands"
    cursor_rule = root / ".cursor" / "rules" / "continuity.mdc"
    if "cursor" in enabled:
        cursor_rule.parent.mkdir(parents=True, exist_ok=True)
        cursor_rule.write_text(
            "---\ndescription: Apply Continuity project controls and route requests to the installed Continuity workflows.\nglobs:\nalwaysApply: true\n---\n\n"
            "Read and follow `AGENTS.md`. Continuity skills are canonical under `.agents/skills/`; use `.agents/skills/continuity-local/SKILL.md` with every task-specific Continuity workflow.\n",
            encoding="utf-8",
        )
    else:
        if cursor_rule.exists():
            cursor_rule.unlink()

    if "windsurf" in enabled:
        sync_skill_adapter(root, root / ".windsurf")
    else:
        remove_owned_skill_adapters(root / ".windsurf" / "skills")
        remove_owned_reference_adapters(root, root / ".windsurf")

    json_dump(root / ".continuity" / "scheduler.json", scheduler_plan(settings))


def surface_adapter_problems(root: Path, settings: dict[str, Any]) -> list[str]:
    enabled = set(settings["agent_surfaces"]["enabled"])
    problems: list[str] = []
    names = continuity_skill_names(root)
    for commands_root, label in (
        (root / ".claude" / "commands", "Claude Code slash command"),
        (root / ".cursor" / "commands", "Cursor slash command"),
    ):
        for name in names:
            command_path = commands_root / f"{name}.md"
            if not command_path.is_file():
                problems.append(f"{label} adapter is missing: {name}")
            elif command_path.read_text(encoding="utf-8") != render_surface_command(name):
                problems.append(f"{label} adapter is stale: {name}")
    if "claude-code" in enabled:
        claude_text = (root / "CLAUDE.md").read_text(encoding="utf-8") if (root / "CLAUDE.md").exists() else ""
        if "@AGENTS.md" not in claude_text:
            problems.append("Claude Code adapter is missing its AGENTS.md import")
        for name in names:
            if directory_fingerprint(root / ".agents" / "skills" / name) != directory_fingerprint(root / ".claude" / "skills" / name):
                problems.append(f"Claude Code skill adapter is missing or stale: {name}")
        if not directory_contains(root / ".agents" / "references", root / ".claude" / "references"):
            problems.append("Claude Code reference adapter is missing or stale")
    if "cursor" in enabled:
        if not (root / ".cursor" / "rules" / "continuity.mdc").is_file():
            problems.append("Cursor Continuity rule is missing")
        for name in names:
            if not (root / ".cursor" / "commands" / f"{name}.md").is_file():
                problems.append(f"Cursor command adapter is missing: {name}")
    if "windsurf" in enabled:
        for name in names:
            if directory_fingerprint(root / ".agents" / "skills" / name) != directory_fingerprint(root / ".windsurf" / "skills" / name):
                problems.append(f"Windsurf skill adapter is missing or stale: {name}")
        if not directory_contains(root / ".agents" / "references", root / ".windsurf" / "references"):
            problems.append("Windsurf reference adapter is missing or stale")
    expected_scheduler = scheduler_plan(settings)
    if json_load(root / ".continuity" / "scheduler.json", {}) != expected_scheduler:
        problems.append("Scheduler handoff is missing or out of sync")
    return problems


def validate_project_behavior(root: Path, config: dict[str, Any]) -> dict[str, Any]:
    behavior_path = confined_path(root, config.get("behavior_config_path", BEHAVIOR_CONFIG_PATH), "behavior_config_path")
    skill_path = confined_path(root, config.get("behavior_skill_path", BEHAVIOR_SKILL_PATH), "behavior_skill_path")
    record = json_load(behavior_path, {})
    if not isinstance(record, dict) or record.get("schema_version") != BEHAVIOR_SCHEMA_VERSION:
        raise ContinuityError("Project behavior configuration is missing or unsupported")
    if record.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Project behavior uses a missing or unsupported assurance standard")
    if record.get("project_id") != config.get("project_id"):
        raise ContinuityError("Project behavior and continuity configuration IDs differ")
    if record.get("recommendation_profile") != BEHAVIOR_PROFILE:
        raise ContinuityError("Project behavior recommendation profile is unsupported")
    settings = validate_behavior_settings(root, record.get("settings"))
    expected_hash = behavior_payload_hash(record)
    if record.get("configuration_hash") != expected_hash:
        raise ContinuityError("Project behavior configuration hash is stale or invalid")
    if config.get("behavior_configuration_hash") != expected_hash:
        raise ContinuityError("Continuity configuration does not match project behavior")
    manifest = load_project_manifest(root)
    if manifest.get("behavior_configuration_hash") != expected_hash:
        raise ContinuityError("Project manifest does not match project behavior")
    if record.get("fixed_guardrails") != FIXED_GUARDRAILS:
        raise ContinuityError("Project behavior attempts to change fixed continuity guardrails")
    expected_config = {
        "integration_branch": settings["integration_branch"],
        "timezone": settings["timezone"],
        "default_start_time": settings["schedules"]["dispatch"],
        "max_runtime_minutes": settings["max_runtime_minutes"],
        "memory_stale_after_days": settings["memory_stale_after_days"],
        "product_audit_stale_after_days": settings["product_audit_stale_after_days"],
        "validation_commands": settings["validation_commands"],
        "security_commands": settings["security_commands"],
        "github_cli_merge_enabled": settings["github_cli_merge_enabled"],
        "documentation_map": settings["documentation_map"],
        "visual_evidence_mode": settings["visual_evidence_mode"],
        "branch_prefix": settings["branch_prefix"],
        "project_instructions": settings["project_instructions"],
        "planning_patterns": settings["planning_patterns"],
        "roadmap": settings["roadmap"],
        "agent_surfaces": settings["agent_surfaces"],
        "scheduler": settings["scheduler"],
        "roadmap_docs": "docs/project-roadmap",
    }
    config_drift = sorted(key for key, value in expected_config.items() if config.get(key) != value)
    if config_drift:
        raise ContinuityError(f"Continuity configuration drifted from project behavior: {config_drift}")
    fixed_config = {
        "require_remote": True,
        "require_pr": True,
        "require_pr_auth": True,
        "require_execution_artifacts": True,
        "require_isolated_worktree": True,
        "refresh_base_on_preflight": True,
    }
    weakened = sorted(key for key, value in fixed_config.items() if config.get(key) is not value)
    if weakened:
        raise ContinuityError(f"Continuity configuration weakens fixed safeguards: {weakened}")
    expected_manifest = {
        "project_id": record["project_id"],
        "integration_branch": settings["integration_branch"],
        "timezone": settings["timezone"],
        "schedules": settings["schedules"],
        "roadmap": settings["roadmap"],
        "agent_surfaces": settings["agent_surfaces"],
        "scheduler": settings["scheduler"],
        "max_concurrency": 1,
        "execution_enabled": settings["execution_enabled"],
    }
    manifest_drift = sorted(key for key, value in expected_manifest.items() if manifest.get(key) != value)
    if manifest_drift:
        raise ContinuityError(f"Project manifest drifted from project behavior: {manifest_drift}")
    if not skill_path.exists() or skill_path.read_text(encoding="utf-8") != render_project_behavior_skill(record):
        raise ContinuityError("Generated project behavior skill is missing or out of sync")
    adapter_problems = surface_adapter_problems(root, settings)
    if adapter_problems:
        raise ContinuityError(f"Agent surface adapters are missing or out of sync: {adapter_problems}")
    return record


def parse_scalar(value: str) -> Any:
    value = value.strip()
    if not value:
        return ""
    if value in {"true", "false"}:
        return value == "true"
    if value in {"null", "~"}:
        return None
    if value.startswith("[") and value.endswith("]"):
        try:
            return json.loads(value)
        except json.JSONDecodeError:
            return [item.strip() for item in value[1:-1].split(",") if item.strip()]
    return value.strip('"\'')


def parse_markdown(path: Path) -> tuple[dict[str, Any], str, str]:
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        return {}, text, ""
    end = text.find("\n---\n", 4)
    if end < 0:
        return {}, text, ""
    metadata: dict[str, Any] = {}
    for line in text[4:end].splitlines():
        if not line.strip() or line.lstrip().startswith("#") or ":" not in line:
            continue
        key, value = line.split(":", 1)
        metadata[key.strip()] = parse_scalar(value)
    body = text[end + 5 :]
    heading = ""
    for line in body.splitlines():
        if line.startswith("# "):
            heading = line[2:].strip()
            break
    return metadata, body, heading


def render_markdown(metadata: dict[str, Any], body: str) -> str:
    lines = ["---"]
    for key, value in metadata.items():
        if isinstance(value, (list, dict)):
            rendered = json.dumps(value, sort_keys=True)
        elif value is None:
            rendered = "null"
        else:
            rendered = str(value)
        lines.append(f"{key}: {rendered}")
    lines.extend(["---", "", body.rstrip(), ""])
    return "\n".join(lines)


def normalize_note_dimensions(item: dict[str, Any], occurred_at: str) -> dict[str, Any]:
    dimensions = {
        "perspective": item.get("perspective", "unknown"),
        "sentiment": item.get("sentiment", "unknown"),
        "occurrence_type": item.get("occurrence_type", "observation"),
        "impact": item.get("impact", "unknown"),
        "confidence": item.get("confidence", "unknown"),
        "actionability": item.get("actionability", "context"),
    }
    allowed = {
        "perspective": NOTE_PERSPECTIVES,
        "sentiment": NOTE_SENTIMENTS,
        "occurrence_type": NOTE_OCCURRENCE_TYPES,
        "impact": NOTE_IMPACTS,
        "confidence": NOTE_CONFIDENCE,
        "actionability": NOTE_ACTIONABILITY,
    }
    for key, values in allowed.items():
        if dimensions[key] not in values:
            raise ContinuityError(f"Invalid note {key}: {dimensions[key]}")
    for key in ("stakeholders", "themes"):
        dimensions[key] = sorted(set(validate_string_list(item.get(key, []), f"note {key}")))
    dimensions["occurred_at"] = item.get("occurred_at") or occurred_at
    if parse_recorded_time(dimensions["occurred_at"], "UTC") is None:
        raise ContinuityError("note occurred_at must be an ISO 8601 date or datetime")
    occurred_at_confidence = item.get("occurred_at_confidence") or (
        "exact" if item.get("occurred_at") else "capture-time"
    )
    if occurred_at_confidence not in NOTE_OCCURRED_AT_CONFIDENCE:
        raise ContinuityError(f"Invalid note occurred_at confidence: {occurred_at_confidence}")
    dimensions["occurred_at_confidence"] = occurred_at_confidence
    pattern_key = item.get("pattern_key")
    if pattern_key is not None:
        dimensions["pattern_key"] = validate_identifier(str(pattern_key), "note pattern key")
    return dimensions


def document_source_anchor(item: dict[str, Any], index: int) -> dict[str, Any]:
    anchor = item.get("source_anchor")
    if not isinstance(anchor, dict):
        raise ContinuityError(f"Document capture item {index} requires a source_anchor object")
    source_item_key = validate_identifier(str(anchor.get("source_item_key", "")), "document source item key")
    heading_path = validate_string_list(anchor.get("heading_path", []), "document heading_path", required=True)
    normalized = {"source_item_key": source_item_key, "heading_path": heading_path}
    for key in ("section", "requirement_id"):
        value = anchor.get(key)
        if value is not None:
            if not isinstance(value, str) or not value.strip():
                raise ContinuityError(f"Document source anchor {key} must be a non-empty string")
            normalized[key] = value.strip()
    return normalized


def document_capture_history(root: Path, config: dict[str, Any], document_id: str) -> list[tuple[Path, dict[str, Any]]]:
    history: list[tuple[Path, dict[str, Any]]] = []
    for path in sorted((private_path(root, config) / "captures").glob("**/*.json")):
        capture = json_load(path, {})
        if isinstance(capture, dict) and capture.get("document_id") == document_id:
            history.append((path, capture))
    history.sort(key=lambda value: (int(value[1].get("document_revision", 0)), str(value[1].get("captured_at", ""))))
    return history


def prepare_document_capture(
    root: Path,
    config: dict[str, Any],
    payload: dict[str, Any],
    args: argparse.Namespace,
) -> tuple[dict[str, Any] | None, bytes | None, dict[str, Any] | None]:
    document_type = payload.get("document_type") or getattr(args, "document_type", None)
    if document_type is None:
        return None, None, None
    if document_type not in DOCUMENT_TYPES:
        raise ContinuityError(f"Unsupported document_type: {document_type}")
    source_type = payload.get("source_type", getattr(args, "source_type", None) or "file")
    if source_type != "file":
        raise ContinuityError("PRD and feature-request capture currently supports source_type file only")
    if not getattr(args, "items_file", None):
        raise ContinuityError("Document capture requires --items-file so the source is split into atomic items")
    source_file = payload.get("source_file") or getattr(args, "file", None)
    if not isinstance(source_file, str) or not source_file.strip():
        raise ContinuityError("Document capture requires source_file in the items payload")
    source_path = Path(source_file).expanduser().resolve()
    if not source_path.is_file():
        raise ContinuityError("Document source_file must identify an existing file")
    if source_path.suffix.lower() not in DOCUMENT_EXTENSIONS:
        raise ContinuityError("Document capture supports only Markdown and plain-text files")
    source_bytes = source_path.read_bytes()
    if len(source_bytes) > MAX_DOCUMENT_BYTES:
        raise ContinuityError(f"Document source exceeds the {MAX_DOCUMENT_BYTES}-byte limit")
    try:
        source_text = source_bytes.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise ContinuityError("Document source must be UTF-8 text") from exc
    if not source_text.strip():
        raise ContinuityError("Document source must not be empty")
    inside_project = source_path.is_relative_to(root.resolve())
    provided_ref = payload.get("source_ref") or getattr(args, "source_ref", None)
    if inside_project:
        source_ref = source_path.relative_to(root.resolve()).as_posix()
    else:
        if isinstance(provided_ref, str) and provided_ref.strip() and not Path(provided_ref).is_absolute():
            source_ref = provided_ref.strip()
        else:
            source_ref = f"external:{source_path.name}"
    source_authority = payload.get("source_authority") or getattr(args, "source_authority", None) or "supplied-reference"
    if source_authority not in DOCUMENT_SOURCE_AUTHORITIES:
        raise ContinuityError(f"Unsupported document source_authority: {source_authority}")
    if source_authority == "project-intent" and not inside_project:
        raise ContinuityError("project-intent documents must be located inside the project root")
    document_id = validate_identifier(
        str(payload.get("document_id") or getattr(args, "document_id", None) or stable_id(
            "document", config["project_id"], document_type, source_ref
        )),
        "document ID",
    )
    document_version = payload.get("document_version") or getattr(args, "document_version", None)
    if document_version is not None and (not isinstance(document_version, str) or not document_version.strip()):
        raise ContinuityError("document_version must be a non-empty string when provided")
    document_title = payload.get("document_title")
    if document_title is not None and (not isinstance(document_title, str) or not document_title.strip()):
        raise ContinuityError("document_title must be a non-empty string when provided")
    source_hash = hashlib.sha256(source_bytes).hexdigest()
    history = document_capture_history(root, config, document_id)
    duplicate = next((capture for _path, capture in history if capture.get("source_hash") == source_hash), None)
    previous = history[-1][1] if history else None
    document_revision = int(previous.get("document_revision", 0)) + 1 if previous else 1
    snapshot = private_path(root, config) / "source-snapshots" / document_id / f"{source_hash}{source_path.suffix.lower()}"
    metadata = {
        "document_type": document_type,
        "document_id": document_id,
        "document_title": document_title.strip() if isinstance(document_title, str) else source_path.stem,
        "document_version": document_version.strip() if isinstance(document_version, str) else None,
        "document_revision": document_revision,
        "source_authority": source_authority,
        "source_ref": source_ref,
        "source_hash": source_hash,
        "raw_snapshot_ref": snapshot.relative_to(root).as_posix(),
        "previous_capture_id": previous.get("capture_id") if previous else None,
        "document_memory_id": stable_id("document-memory", document_id, source_hash),
    }
    return metadata, source_bytes, duplicate


def note_capture(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    stamp = iso_now(config)
    if args.items_file:
        payload = json_load(Path(args.items_file).expanduser())
        if not isinstance(payload, dict) or not isinstance(payload.get("items"), list):
            raise ContinuityError("Items file must contain an object with an items array")
    else:
        text = args.text
        if args.file:
            text = Path(args.file).expanduser().read_text(encoding="utf-8")
        if not text:
            raise ContinuityError("Provide --text, --file, or --items-file")
        payload = {
            "source_type": args.source_type or ("file" if args.file else "manual"),
            "source_ref": args.file or "manual-entry",
            "items": [{"kind": "context", "text": text}],
        }
    document, document_bytes, document_duplicate = prepare_document_capture(root, config, payload, args)
    if document_duplicate is not None:
        document_duplicate["deduplicated"] = True
        duplicate_path = find_capture(root, config, str(document_duplicate["capture_id"]))
        document_duplicate["path"] = runtime_lib.project_relative_posix(duplicate_path, root)
        return document_duplicate
    source_type = payload.get("source_type", args.source_type or "conversation")
    if source_type not in {"conversation", "meeting", "manual", "file", "notion", "linear", "goal-feedback", "shared-packet", "product-audit"}:
        raise ContinuityError(f"Unsupported source_type: {source_type}")
    raw_items = list(payload["items"])
    if document:
        source_item_keys = [
            document_source_anchor(item, index)["source_item_key"]
            for index, item in enumerate(raw_items, 1)
            if isinstance(item, dict)
        ]
        if len(source_item_keys) != len(set(source_item_keys)):
            raise ContinuityError("Document capture source_item_key values must be unique within a revision")
    previous_items: dict[str, dict[str, Any]] = {}
    if document and document.get("previous_capture_id"):
        previous_path = find_capture(root, config, str(document["previous_capture_id"]))
        previous_capture = json_load(previous_path, {})
        for previous_item in previous_capture.get("items", []):
            if not isinstance(previous_item, dict):
                continue
            anchor = previous_item.get("source_anchor")
            if isinstance(anchor, dict) and isinstance(anchor.get("source_item_key"), str):
                previous_items[anchor["source_item_key"]] = previous_item
        current_keys = {
            document_source_anchor(item, index)["source_item_key"]
            for index, item in enumerate(raw_items, 1)
            if isinstance(item, dict)
        }
        for source_item_key, previous_item in previous_items.items():
            if source_item_key in current_keys:
                continue
            raw_items.append(
                {
                    "kind": "insight",
                    "text": str(previous_item.get("text", "")),
                    "source_anchor": previous_item.get("source_anchor"),
                    "revision_status": "removed",
                    "supersedes_item_id": previous_item.get("item_id"),
                    "perspective": previous_item.get("perspective", "unknown"),
                    "sentiment": "neutral",
                    "occurrence_type": "change",
                    "impact": previous_item.get("impact", "unknown"),
                    "confidence": "high",
                    "actionability": "monitor",
                    "stakeholders": previous_item.get("stakeholders", []),
                    "themes": sorted(set([*previous_item.get("themes", []), "document-revision"])),
                }
            )
    if not raw_items:
        raise ContinuityError("Capture requires at least one atomic item")
    if len(raw_items) > MAX_CAPTURE_ITEMS:
        raise ContinuityError(f"Capture exceeds the {MAX_CAPTURE_ITEMS}-item batch limit; split it by meeting or source")
    items: list[dict[str, Any]] = []
    for index, item in enumerate(raw_items, 1):
        if not isinstance(item, dict) or not str(item.get("text", "")).strip():
            raise ContinuityError(f"Capture item {index} must include text")
        if len(str(item["text"])) > MAX_NOTE_TEXT_CHARS:
            raise ContinuityError(f"Capture item {index} exceeds the {MAX_NOTE_TEXT_CHARS}-character limit; split it atomically")
        kind = item.get("kind", "context")
        if kind not in NOTE_KINDS:
            raise ContinuityError(f"Invalid note kind: {kind}")
        item_id = item.get("item_id") or stable_id("note", stamp, str(index), item["text"])
        item_created_at = item.get("created_at") or item.get("source_timestamp") or payload.get("source_timestamp") or stamp
        item_work_status = item.get("work_status", "open")
        if item_work_status not in NOTE_WORK_STATUSES:
            raise ContinuityError(f"Invalid note work status: {item_work_status}")
        document_fields: dict[str, Any] = {}
        routing_status = item.get("routing_status", "captured")
        if document:
            anchor = document_source_anchor(item, index)
            source_item_key = anchor["source_item_key"]
            previous_item = previous_items.get(source_item_key)
            revision_status = item.get("revision_status")
            if revision_status != "removed":
                if previous_item is None:
                    revision_status = "added"
                elif str(previous_item.get("text", "")).strip() == str(item["text"]).strip():
                    revision_status = "unchanged"
                else:
                    revision_status = "changed"
            if revision_status not in DOCUMENT_REVISION_STATUSES:
                raise ContinuityError(f"Invalid document revision_status: {revision_status}")
            document_fields = {"source_anchor": anchor, "revision_status": revision_status}
            if previous_item is not None:
                if revision_status == "unchanged":
                    document_fields["same_as_item_id"] = previous_item.get("same_as_item_id") or previous_item.get("item_id")
                    routing_status = "archive"
                    item_work_status = "archived"
                elif revision_status == "changed":
                    document_fields["supersedes_item_id"] = previous_item.get("item_id")
            if revision_status == "removed" and item.get("supersedes_item_id"):
                document_fields["supersedes_item_id"] = item["supersedes_item_id"]
        items.append(
            {
                **item,
                **normalize_note_dimensions(item, item_created_at),
                **document_fields,
                "item_id": item_id,
                "kind": kind,
                "text": item["text"].strip(),
                "created_at": item_created_at,
                "updated_at": item.get("updated_at", stamp),
                "execution_authorized": False,
                "routing_status": routing_status,
                "work_status": item_work_status,
            }
        )
    content_fingerprint = canonical_hash(
        [{"kind": item["kind"], "text": item["text"]} for item in items]
    )
    capture_id = payload.get("capture_id") or (
        stable_id("capture", config["project_id"], stamp, document["document_id"], document["source_hash"])
        if document
        else stable_id("capture", config["project_id"], stamp, content_fingerprint)
    )
    captures_root = private_path(root, config) / "captures"
    source_ref = document["source_ref"] if document else payload.get("source_ref", args.source_ref)
    dedupe_key = payload.get("dedupe_key") or canonical_hash(
        {"source_type": source_type, "source_ref": source_ref, "items": content_fingerprint}
    )
    for existing_path in captures_root.glob("**/*.json"):
        existing = json_load(existing_path, {})
        if existing.get("dedupe_key") == dedupe_key and existing.get("source_ref") == source_ref:
            existing["deduplicated"] = True
            existing["path"] = runtime_lib.project_relative_posix(existing_path, root)
            return existing
    capture = {
        "schema_version": SCHEMA_VERSION,
        "capture_id": capture_id,
        "captured_at": stamp,
        "project_id": config["project_id"],
        "repository": str(root),
        "source_type": source_type,
        "source_ref": source_ref,
        "source_timestamp": payload.get("source_timestamp"),
        "capture_mode": "batch" if len(items) > 1 else "singular",
        "item_count": len(items),
        "dedupe_key": dedupe_key,
        "execution_authorized": False,
        "items": items,
    }
    if document:
        capture.update(document)
        capture["revision_counts"] = {
            status: sum(1 for item in items if item.get("revision_status") == status)
            for status in sorted(DOCUMENT_REVISION_STATUSES)
        }
        if document_bytes is None:
            raise ContinuityError("Document snapshot content is unavailable")
        snapshot = confined_path(root, str(document["raw_snapshot_ref"]), "raw_snapshot_ref")
        if not snapshot.is_relative_to(private_path(root, config)):
            raise ContinuityError("Document snapshot must remain in private continuity state")
        runtime_lib.atomic_write_bytes(snapshot, document_bytes)
    target = private_path(root, config) / "captures" / stamp[:10] / f"{capture_id}.json"
    json_dump(target, capture)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": stamp,
            "event": "capture.created",
            "capture_id": capture_id,
            "document_id": capture.get("document_id"),
            "document_revision": capture.get("document_revision"),
            "source_hash": capture.get("source_hash"),
        },
    )
    capture["path"] = target.relative_to(root).as_posix()
    return capture


def find_capture(root: Path, config: dict[str, Any], capture_id: str) -> Path:
    validate_identifier(capture_id, "capture ID")
    matches = [path for path in (private_path(root, config) / "captures").glob("**/*.json") if path.stem == capture_id]
    if len(matches) != 1:
        raise ContinuityError(f"Expected one capture {capture_id}; found {len(matches)}")
    return matches[0]


def find_note_item(root: Path, config: dict[str, Any], item_id: str) -> tuple[Path, dict[str, Any], dict[str, Any]]:
    validate_identifier(item_id, "note ID")
    matches: list[tuple[Path, dict[str, Any], dict[str, Any]]] = []
    for path in sorted((private_path(root, config) / "captures").glob("**/*.json")):
        capture = json_load(path, {})
        if not isinstance(capture, dict):
            continue
        for item in capture.get("items", []):
            if isinstance(item, dict) and item.get("item_id") == item_id:
                current = dict(item)
                hydrate_note_goal_links(root, config, current)
                current["work_status"] = derived_note_work_status(current, now(config))
                matches.append((path, capture, current))
    if len(matches) != 1:
        raise ContinuityError(f"Expected one note {item_id}; found {len(matches)}")
    return matches[0]


def validate_note_disposition_targets(root: Path, config: dict[str, Any], dispositions: list[dict[str, Any]]) -> None:
    for item in dispositions:
        try:
            find_note_item(root, config, str(item["note_id"]))
        except ContinuityError as exc:
            raise ContinuityError(f"Goal references an unavailable source note {item['note_id']}") from exc
        if item.get("canonical_note_id"):
            try:
                find_note_item(root, config, str(item["canonical_note_id"]))
            except ContinuityError as exc:
                raise ContinuityError(
                    f"Duplicate disposition references an unavailable canonical note {item['canonical_note_id']}"
                ) from exc


def note_link_disposition(link: dict[str, Any]) -> str:
    disposition = str(link.get("disposition", "current-goal"))
    return disposition if disposition in NOTE_PLANNING_DISPOSITIONS else "current-goal"


def note_later_is_due(link: dict[str, Any], current_time: dt.datetime | None) -> bool:
    if current_time is None or not link.get("review_after"):
        return False
    try:
        review_after = dt.datetime.fromisoformat(str(link["review_after"]))
    except ValueError:
        return False
    if review_after.tzinfo is None:
        review_after = review_after.replace(tzinfo=current_time.tzinfo)
    return review_after <= current_time


def derived_note_work_status(item: dict[str, Any], current_time: dt.datetime | None = None) -> str:
    links = item.get("goal_links", {})
    if not isinstance(links, dict) or not links:
        return str(item.get("routing_work_status", item.get("work_status", "open")))
    current_goal_links = [
        link
        for link in links.values()
        if isinstance(link, dict)
        and link.get("state") != "unlinked"
        and note_link_disposition(link) == "current-goal"
    ]
    statuses = [
        NOTE_GOAL_STATUS_MAP.get(str(link.get("state")), "open")
        for link in current_goal_links
    ]
    active_priority = {
        "running": 90,
        "validating": 85,
        "dispatched": 80,
        "queued": 70,
        "planned": 60,
        "review-ready": 50,
        "deferred": 40,
    }
    active = [status for status in statuses if status in active_priority]
    if active:
        return max(active, key=lambda status: active_priority[status])
    later_links = [
        link
        for link in links.values()
        if isinstance(link, dict)
        and link.get("state") != "unlinked"
        and note_link_disposition(link) == "later"
    ]
    if later_links:
        if any(note_later_is_due(link, current_time) for link in later_links):
            return "open"
        return "deferred"
    if statuses and all(status == "completed" for status in statuses):
        return "completed"
    for status in ("partially-completed", "blocked", "completed", "cancelled"):
        if status in statuses:
            return status
    live_links = [link for link in links.values() if isinstance(link, dict) and link.get("state") != "unlinked"]
    if live_links and all(note_link_disposition(link) == "duplicate" for link in live_links):
        return "not-applicable"
    return str(item.get("routing_work_status", item.get("work_status", "open")))


def hydrate_note_goal_links(root: Path, config: dict[str, Any], item: dict[str, Any]) -> dict[str, Any]:
    links = item.get("goal_links")
    if isinstance(links, dict):
        return links
    current_status = str(item.get("work_status", "open"))
    if "routing_work_status" not in item:
        item["routing_work_status"] = current_status if current_status in {"open", "deferred", "archived", "not-applicable"} else "open"
    hydrated: dict[str, Any] = {}
    for goal_id in item.get("related_goal_ids", []):
        if not isinstance(goal_id, str) or not goal_id:
            continue
        goal = json_load(goal_dir(root, config, goal_id) / "goal.json", {})
        if isinstance(goal, dict) and goal.get("state"):
            planning = next(
                (
                    value
                    for value in goal.get("note_dispositions", [])
                    if isinstance(value, dict) and value.get("note_id") == item.get("item_id")
                ),
                None,
            )
            planning = planning or {
                "disposition": "current-goal",
                "reason": "Compatibility default for a legacy source-note link.",
                "delivery_slice_ids": [],
            }
            hydrated[goal_id] = {
                "state": goal["state"],
                "disposition": planning.get("disposition", "current-goal"),
                "reason": planning.get("reason"),
                "delivery_slice_ids": list(planning.get("delivery_slice_ids", [])),
                "review_after": planning.get("review_after"),
                "roadmap_id": planning.get("roadmap_id"),
                "canonical_note_id": planning.get("canonical_note_id"),
                "plan_version": goal.get("plan_version"),
                "decided_at": goal.get("created_at") or goal.get("updated_at"),
                "updated_at": goal.get("updated_at"),
            }
    item["goal_links"] = hydrated
    return hydrated


def legacy_note_link_ids(root: Path, config: dict[str, Any]) -> list[str]:
    legacy: list[str] = []
    for path in sorted((private_path(root, config) / "captures").glob("**/*.json")):
        capture = json_load(path, {})
        if not isinstance(capture, dict):
            continue
        for item in capture.get("items", []):
            if (
                isinstance(item, dict)
                and item.get("related_goal_ids")
                and "goal_links" not in item
            ):
                legacy.append(str(item.get("item_id") or f"{capture.get('capture_id')}:unknown"))
    return legacy


def note_migrate_links(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    stamp = iso_now(config)
    migrated: list[dict[str, Any]] = []
    for path in sorted((private_path(root, config) / "captures").glob("**/*.json")):
        capture = json_load(path, {})
        if not isinstance(capture, dict):
            continue
        changed = False
        for item in capture.get("items", []):
            if not isinstance(item, dict) or not item.get("related_goal_ids") or "goal_links" in item:
                continue
            previous = str(item.get("work_status", "open"))
            links = hydrate_note_goal_links(root, config, item)
            item["work_status"] = derived_note_work_status(item, now(config))
            item["updated_at"] = stamp
            item["goal_links_migrated_at"] = stamp
            if previous != item["work_status"]:
                item.setdefault("work_status_history", []).append(
                    {"at": stamp, "from": previous, "to": item["work_status"], "actor": args.actor}
                )
            migrated.append(
                {
                    "capture_id": capture.get("capture_id"),
                    "item_id": item.get("item_id"),
                    "goal_ids": sorted(links),
                    "work_status": item["work_status"],
                }
            )
            changed = True
        if changed:
            json_dump(path, capture)
    if migrated:
        append_jsonl(
            private_path(root, config) / "events.jsonl",
            {"at": stamp, "event": "note.goal-links-migrated", "actor": args.actor, "items": migrated},
        )
    return {"migrated": len(migrated), "items": migrated, "remaining_legacy_note_ids": legacy_note_link_ids(root, config)}


def note_migrate_lifecycle(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    stamp = iso_now(config)
    pending: list[tuple[Path, dict[str, Any]]] = []
    migrated: list[dict[str, Any]] = []
    unresolved: list[str] = []
    for path in sorted((private_path(root, config) / "captures").glob("**/*.json")):
        capture = json_load(path, {})
        if not isinstance(capture, dict):
            continue
        captured_text = capture.get("captured_at")
        captured_at = parse_recorded_time(captured_text, config["timezone"])
        capture_changed = False
        for item in capture.get("items", []):
            if not isinstance(item, dict) or not item.get("item_id"):
                continue
            note_id = str(item["item_id"])
            created_at = parse_recorded_time(item.get("created_at"), config["timezone"])
            updated_at = parse_recorded_time(item.get("updated_at"), config["timezone"])
            if item.get("created_at") is not None and created_at is None:
                unresolved.append(f"note {note_id} has an invalid created_at that cannot be inferred")
                continue
            if item.get("updated_at") is not None and updated_at is None:
                unresolved.append(f"note {note_id} has an invalid updated_at that cannot be inferred")
                continue
            changes: list[dict[str, str]] = []
            if created_at is None:
                if captured_at is None or not isinstance(captured_text, str):
                    unresolved.append(f"note {note_id} has no valid capture timestamp for created_at")
                    continue
                item["created_at"] = captured_text
                created_at = captured_at
                changes.append({"field": "created_at", "source": "capture.captured_at"})
            if updated_at is None:
                candidates: list[tuple[dt.datetime, str, str]] = [(created_at, str(item["created_at"]), "note.created_at")]
                for revision in item.get("revision_history", []):
                    if not isinstance(revision, dict) or not isinstance(revision.get("at"), str):
                        continue
                    revision_at = parse_recorded_time(revision["at"], config["timezone"])
                    if revision_at is not None:
                        candidates.append((revision_at, revision["at"], "revision_history.at"))
                _chosen_at, chosen_text, chosen_source = max(candidates, key=lambda value: value[0])
                item["updated_at"] = chosen_text
                changes.append({"field": "updated_at", "source": chosen_source})
            if changes:
                capture_changed = True
                migrated.append({"capture_id": capture.get("capture_id"), "item_id": note_id, "changes": changes})
        if capture_changed:
            pending.append((path, capture))
    if unresolved:
        raise ContinuityError(f"Legacy lifecycle migration requires manual review: {unresolved}")
    for path, capture in pending:
        json_dump(path, capture)
    if migrated:
        append_jsonl(
            private_path(root, config) / "events.jsonl",
            {"at": stamp, "event": "note.lifecycle-migrated", "actor": args.actor, "items": migrated},
        )
    return {"migrated": len(migrated), "items": migrated}


def update_note_goal_links(
    root: Path,
    config: dict[str, Any],
    item_ids: Iterable[str],
    goal_id: str,
    goal_state: str | None,
    *,
    remove: bool = False,
    dispositions: list[dict[str, Any]] | None = None,
    plan_version: int | None = None,
    stamp: str | None = None,
) -> list[dict[str, Any]]:
    targets = {item_id for item_id in item_ids if item_id}
    if not targets:
        return []
    stamp = stamp or iso_now(config)
    disposition_map = {
        str(item["note_id"]): item
        for item in (dispositions or [])
        if isinstance(item, dict) and item.get("note_id")
    }
    updated: list[dict[str, Any]] = []
    for path in (private_path(root, config) / "captures").glob("**/*.json"):
        capture = json_load(path, {})
        if not isinstance(capture, dict):
            continue
        changed = False
        for item in capture.get("items", []):
            if not isinstance(item, dict) or item.get("item_id") not in targets:
                continue
            previous = str(item.get("work_status", "open"))
            links = hydrate_note_goal_links(root, config, item)
            item.setdefault("routing_work_status", previous)
            prior = links.get(goal_id, {})
            prior = prior if isinstance(prior, dict) else {}
            if remove:
                links[goal_id] = {
                    "state": "unlinked",
                    "previous_state": prior.get("state"),
                    **{key: value for key, value in prior.items() if key not in {"state", "previous_state", "updated_at"}},
                    "updated_at": stamp,
                }
            else:
                planning = disposition_map.get(str(item["item_id"]))
                disposition = str((planning or prior).get("disposition", "current-goal"))
                decision_material = {
                    "disposition": disposition,
                    "reason": (planning or prior).get("reason"),
                    "delivery_slice_ids": list((planning or prior).get("delivery_slice_ids", [])),
                    "review_after": (planning or prior).get("review_after"),
                    "roadmap_id": (planning or prior).get("roadmap_id"),
                    "canonical_note_id": (planning or prior).get("canonical_note_id"),
                    "plan_version": plan_version or prior.get("plan_version"),
                }
                prior_decision = {key: prior.get(key) for key in decision_material}
                links[goal_id] = {
                    "state": goal_state,
                    **decision_material,
                    "decided_at": stamp if decision_material != prior_decision else prior.get("decided_at", stamp),
                    "updated_at": stamp,
                }
                related = item.setdefault("related_goal_ids", [])
                if goal_id not in related:
                    related.append(goal_id)
            item.setdefault("created_at", capture.get("captured_at", stamp))
            item["updated_at"] = stamp
            item["work_status"] = derived_note_work_status(item, now(config))
            item["execution_authorized"] = False
            if previous != item["work_status"] or remove or prior != links[goal_id]:
                item.setdefault("work_status_history", []).append(
                    {
                        "at": stamp,
                        "from": previous,
                        "to": item["work_status"],
                        "goal_id": goal_id,
                        "goal_state": links[goal_id].get("state"),
                        "disposition": links[goal_id].get("disposition"),
                        "plan_version": links[goal_id].get("plan_version"),
                    }
                )
            updated.append(
                {
                    "capture_id": str(capture.get("capture_id", "")),
                    "item_id": str(item["item_id"]),
                    "work_status": item["work_status"],
                    "disposition": links[goal_id].get("disposition"),
                    "plan_version": links[goal_id].get("plan_version"),
                    "decided_at": links[goal_id].get("decided_at"),
                }
            )
            changed = True
        if changed:
            json_dump(path, capture)
    if updated:
        append_jsonl(
            private_path(root, config) / "events.jsonl",
            {"at": stamp, "event": "note.goal-link", "goal_id": goal_id, "state": goal_state, "removed": remove, "items": updated},
        )
    return updated


def route_for_kind(kind: str) -> str:
    return {
        "context": "knowledge",
        "insight": "knowledge",
        "decision": "knowledge",
        "question": "questions",
        "documentation-candidate": "documentation",
        "backlog-candidate": "backlog",
        "execution-candidate": "planning",
        "explicit-instruction": "planning",
    }[kind]


def note_triage(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    path = find_capture(root, config, args.capture_id)
    capture = json_load(path)
    selected = None
    for item in capture["items"]:
        if item["item_id"] == args.item_id:
            selected = item
            break
    if selected is None:
        raise ContinuityError(f"Unknown item {args.item_id}")
    if args.action == "defer" and not args.review_after:
        raise ContinuityError("Deferred notes require --review-after")
    if args.review_after and parse_recorded_time(args.review_after, config["timezone"]) is None:
        raise ContinuityError("Note review date must be an ISO 8601 date-time")
    stamp = iso_now(config)
    selected.setdefault("created_at", capture.get("captured_at", stamp))
    selected.setdefault("work_status", "open")
    previous = {
        "kind": selected.get("kind"),
        "routing_status": selected.get("routing_status"),
        "queue": selected.get("queue"),
        "review_after": selected.get("review_after"),
        "work_status": selected.get("work_status"),
    }
    if args.kind:
        if args.kind not in NOTE_KINDS:
            raise ContinuityError(f"Invalid kind: {args.kind}")
        selected["kind"] = args.kind
    dimension_updates = {
        "perspective": args.perspective,
        "sentiment": args.sentiment,
        "occurrence_type": args.occurrence_type,
        "impact": args.impact,
        "confidence": args.confidence,
        "actionability": args.actionability,
        "occurred_at_confidence": args.occurred_at_confidence,
    }
    for key, value in dimension_updates.items():
        if value is not None:
            selected[key] = value
    if args.stakeholder is not None:
        selected["stakeholders"] = sorted(set(args.stakeholder))
    if args.theme is not None:
        selected["themes"] = sorted(set(args.theme))
    if args.pattern_key is not None:
        selected["pattern_key"] = validate_identifier(args.pattern_key, "note pattern key")
    selected.update(normalize_note_dimensions(selected, selected.get("created_at", stamp)))
    selected["routing_status"] = args.action
    selected["execution_authorized"] = False
    selected["updated_at"] = stamp
    if args.review_after:
        selected["review_after"] = args.review_after
    if args.action == "defer":
        selected["routing_work_status"] = "deferred"
    elif args.action == "archive":
        selected["routing_work_status"] = "archived"
        selected.pop("queue", None)
    else:
        selected["routing_work_status"] = "open"
    hydrate_note_goal_links(root, config, selected)
    selected["work_status"] = derived_note_work_status(selected, now(config))
    if args.action in {"route", "defer", "promote"}:
        queue = route_for_kind(selected["kind"])
        selected["queue"] = queue
        queue_path = private_path(root, config) / "queues" / f"{queue}.jsonl"
        already_queued = any(
            row.get("capture_id") == capture["capture_id"]
            and row.get("item_id") == selected["item_id"]
            and row.get("kind") == selected["kind"]
            and row.get("routing_status") == selected["routing_status"]
            for row in iter_jsonl(queue_path)
        )
        if not already_queued:
            append_jsonl(queue_path, {"at": stamp, "capture_id": capture["capture_id"], **selected})
    current = {
        "kind": selected.get("kind"),
        "routing_status": selected.get("routing_status"),
        "queue": selected.get("queue"),
        "review_after": selected.get("review_after"),
        "work_status": selected.get("work_status"),
    }
    if previous != current:
        selected.setdefault("revision_history", []).append({"at": stamp, "previous": previous, "current": current})
    json_dump(path, capture)
    event = {
        "at": stamp,
        "event": f"note.{args.action}",
        "capture_id": capture["capture_id"],
        "item_id": selected["item_id"],
        "kind": selected["kind"],
        "work_status": selected.get("work_status"),
    }
    append_jsonl(private_path(root, config) / "events.jsonl", event)
    try:
        roadmap_lib.projection(root, config)
    except roadmap_lib.RoadmapError as exc:
        raise ContinuityError(f"Note was triaged but roadmap projection failed: {exc}") from exc
    return selected


def note_list(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    result: list[dict[str, Any]] = []
    for path in sorted((private_path(root, config) / "captures").glob("**/*.json")):
        capture = json_load(path)
        for item in capture.get("items", []):
            if args.kind and item.get("kind") != args.kind:
                continue
            current = dict(item)
            hydrate_note_goal_links(root, config, current)
            current["work_status"] = derived_note_work_status(current, now(config))
            result.append({"capture_id": capture["capture_id"], **current})
    return result


def note_queue(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    current = now(config)
    result: list[dict[str, Any]] = []
    for item in note_list(argparse.Namespace(kind=None)):
        if item.get("routing_status") not in {"route", "defer", "promote"}:
            continue
        queue = route_for_kind(str(item.get("kind")))
        if args.queue and queue != args.queue:
            continue
        status = str(item.get("work_status", "open"))
        if args.status == "eligible":
            if status not in {"open", "deferred"}:
                continue
            review_after = parse_recorded_time(item.get("review_after"), config["timezone"])
            if status == "deferred" and (review_after is None or review_after > current):
                continue
        result.append({**item, "queue": queue})
    result.sort(key=lambda item: (item.get("review_after") or "", item.get("created_at") or "", item["item_id"]))
    return result


def note_resolve(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    path = find_capture(root, config, args.capture_id)
    capture = json_load(path, {})
    if not isinstance(capture, dict):
        raise ContinuityError("Capture is invalid")
    item = next((value for value in capture.get("items", []) if value.get("item_id") == args.item_id), None)
    if not isinstance(item, dict):
        raise ContinuityError(f"Capture {args.capture_id} has no item {args.item_id}")
    links = hydrate_note_goal_links(root, config, item)
    if isinstance(links, dict) and any(
        isinstance(link, dict)
        and note_link_disposition(link) == "current-goal"
        and link.get("state") not in {"completed", "cancelled", "unlinked"}
        for link in links.values()
    ):
        raise ContinuityError("A note linked to active goals must be resolved through the goal lifecycle")
    stamp = iso_now(config)
    previous = str(item.get("work_status", "open"))
    item["work_status"] = "completed"
    item["routing_work_status"] = "completed"
    item["updated_at"] = stamp
    item.setdefault("resolution_history", []).append(
        {"at": stamp, "actor": args.actor, "resolution": args.resolution, "previous_status": previous}
    )
    item.setdefault("work_status_history", []).append(
        {"at": stamp, "from": previous, "to": "completed", "actor": args.actor}
    )
    json_dump(path, capture)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {"at": stamp, "event": "note.resolved", "capture_id": args.capture_id, "item_id": args.item_id, "actor": args.actor},
    )
    return {"capture_id": args.capture_id, **item}


def related_goal_candidates(
    root: Path,
    config: dict[str, Any],
    item: dict[str, Any],
    *,
    limit: int = 5,
    min_score: float = RELATED_GOAL_DEFAULT_MIN_SCORE,
    goals: Iterable[dict[str, Any]] | None = None,
) -> list[dict[str, Any]]:
    limit = max(1, min(int(limit), RELATED_GOAL_MAX_RESULTS))
    min_score = max(0.0, min(float(min_score), 1.0))
    note_text = " ".join(
        [
            str(item.get("text", "")),
            " ".join(str(value) for value in item.get("themes", [])),
            str(item.get("occurrence_type", "")),
        ]
    )
    note_features = semantic_features(note_text)
    links = item.get("goal_links", {}) if isinstance(item.get("goal_links"), dict) else {}
    candidates: list[dict[str, Any]] = []
    goal_records = goals
    if goal_records is None:
        goal_records = [
            json_load(goal_path, {})
            for goal_path in sorted((private_path(root, config) / "goals").glob("*/goal.json"))
        ]
    for goal in goal_records:
        if not isinstance(goal, dict) or goal.get("state") in {"completed", "cancelled"}:
            continue
        searchable = " ".join(
            [
                str(goal.get("title", "")),
                str(goal.get("scope", "")),
                " ".join(str(value) for value in goal.get("acceptance_criteria", [])),
                " ".join(str(value) for value in goal.get("roadmap_ids", [])),
                json.dumps(goal.get("triage_brief", {}), sort_keys=True),
            ]
        )
        goal_features = semantic_features(searchable)
        score = cosine_similarity(note_features, goal_features)
        if score < min_score:
            continue
        shared = sorted(
            set(note_features).intersection(goal_features),
            key=lambda value: note_features[value] * goal_features[value],
            reverse=True,
        )[:8]
        existing = links.get(goal.get("goal_id"), {})
        already_linked = bool(existing) and isinstance(existing, dict) and existing.get("state") not in {None, "unlinked"}
        candidates.append(
            {
                "goal_id": goal.get("goal_id"),
                "title": goal.get("title"),
                "goal_state": goal.get("state"),
                "similarity": round(score, 4),
                "confidence": "high" if score >= 0.35 else "medium" if score >= RELATED_GOAL_REPORT_MIN_SCORE else "low",
                "shared_terms": shared,
                "already_linked": already_linked,
                "current_disposition": note_link_disposition(existing) if already_linked else None,
                "execution_authorized": False,
            }
        )
    candidates.sort(key=lambda value: (value["similarity"], str(value["goal_id"])), reverse=True)
    return candidates[:limit]


def note_related_goals(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    _path, _capture, item = find_note_item(root, config, args.note_id)
    return related_goal_candidates(root, config, item, limit=args.limit, min_score=args.min_score)


def note_relate(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    _path, _capture, item = find_note_item(root, config, args.note_id)
    _directory, goal = load_goal(root, config, args.goal_id)
    if args.disposition == "current-goal":
        raise ContinuityError(
            "Current-goal scope must be recorded through goal create or goal revise so the note disposition is plan-hashed and reapproved"
        )
    if args.note_id in goal.get("source_note_ids", []):
        raise ContinuityError("A plan-hashed source-note disposition must be changed through goal revise")
    if goal.get("state") in {"completed", "cancelled"} and args.disposition == "later":
        raise ContinuityError("Later work cannot be anchored to a completed or cancelled goal; use roadmap or a new goal")
    planning = validate_note_dispositions(
        [
            {
                "note_id": args.note_id,
                "disposition": args.disposition,
                "reason": args.reason,
                "delivery_slice_ids": [],
                "review_after": args.review_after,
                "roadmap_id": args.roadmap_id,
                "canonical_note_id": args.canonical_note_id,
            }
        ],
        [args.note_id],
        goal.get("delivery_slices", []),
        goal.get("roadmap_ids", []),
    )
    if args.review_after and parse_recorded_time(args.review_after, config["timezone"]) is None:
        raise ContinuityError("Relationship review_after must be an ISO date-time")
    if args.canonical_note_id:
        find_note_item(root, config, args.canonical_note_id)
    updated = update_note_goal_links(
        root,
        config,
        [args.note_id],
        args.goal_id,
        str(goal.get("state")),
        dispositions=planning,
        plan_version=int(goal.get("plan_version", 1)),
    )
    if len(updated) != 1:
        raise ContinuityError(f"Unable to relate note {args.note_id} to goal {args.goal_id}")
    stamp = iso_now(config)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {
            "at": stamp,
            "event": "note.related",
            "item_id": args.note_id,
            "goal_id": args.goal_id,
            "disposition": args.disposition,
            "actor": args.actor,
        },
    )
    _path, capture, current = find_note_item(root, config, args.note_id)
    return note_workflow_status(root, config, capture, current)


def pattern_recommendation(axis: str, occurrence_type: str, sentiments: dict[str, int]) -> str:
    if occurrence_type in {"change", "behavior"}:
        return "Design the affected scope for adaptability and isolate likely revision points before implementation."
    if sentiments.get("negative", 0) > sentiments.get("positive", 0):
        return "Review the recurring negative signal before the next related roadmap or dispatch decision."
    if sentiments.get("positive", 0) > 1:
        return "Preserve and test the behavior producing this repeated positive signal."
    if occurrence_type == "need":
        return "Compare this recurring need with current roadmap priority and acceptance criteria."
    if occurrence_type in {"risk", "failure"}:
        return "Create or update a bounded mitigation item before related execution continues."
    return f"Review the recurring {axis} signal during the next planning pass."


def note_patterns(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    if args.min_count < 2:
        raise ContinuityError("Pattern minimum count must be at least 2")
    notes = note_list(argparse.Namespace(kind=None))
    groups: dict[tuple[str, str], list[dict[str, Any]]] = {}
    for note in notes:
        occurrence = str(note.get("occurrence_type", "observation"))
        axes: set[str] = set()
        if note.get("pattern_key"):
            axes.add(f"pattern:{note['pattern_key']}")
        axes.update(f"stakeholder:{value}" for value in note.get("stakeholders", []))
        axes.update(f"theme:{value}" for value in note.get("themes", []))
        if not axes:
            axes.add("project:general")
        for axis in axes:
            groups.setdefault((axis, occurrence), []).append(note)
    patterns: list[dict[str, Any]] = []
    for (axis, occurrence), items in groups.items():
        if len(items) < args.min_count:
            continue
        sentiments = {value: 0 for value in sorted(NOTE_SENTIMENTS)}
        for item in items:
            sentiments[str(item.get("sentiment", "unknown"))] += 1
        timestamps = sorted(str(item.get("occurred_at") or item.get("created_at") or "") for item in items)
        patterns.append(
            {
                "pattern_id": stable_id("pattern", axis, occurrence),
                "axis": axis,
                "occurrence_type": occurrence,
                "count": len(items),
                "first_seen_at": timestamps[0],
                "last_seen_at": timestamps[-1],
                "sentiments": {key: value for key, value in sentiments.items() if value},
                "max_impact": max(
                    (str(item.get("impact", "unknown")) for item in items),
                    key=lambda value: {"unknown": 0, "low": 1, "medium": 2, "high": 3, "critical": 4}.get(value, 0),
                ),
                "note_ids": [item["item_id"] for item in items],
                "recommendation": pattern_recommendation(axis, occurrence, sentiments),
            }
        )
    patterns.sort(key=lambda item: (-item["count"], item["axis"], item["occurrence_type"]))
    report = {
        "schema_version": 1,
        "project_id": config["project_id"],
        "generated_at": iso_now(config),
        "minimum_count": args.min_count,
        "patterns": patterns,
    }
    json_dump(private_path(root, config) / "reports" / "note-patterns.json", report)
    return report


def note_pattern_review(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    if args.disposition == "deferred" and not args.review_after:
        raise ContinuityError("Deferred pattern review requires --review-after")
    if args.review_after and parse_recorded_time(args.review_after, config["timezone"]) is None:
        raise ContinuityError("Pattern review date must be an ISO 8601 date-time")
    report = note_patterns(argparse.Namespace(min_count=args.min_count))
    pattern = next((item for item in report["patterns"] if item["pattern_id"] == args.pattern_id), None)
    if pattern is None:
        raise ContinuityError(f"Unknown current pattern: {args.pattern_id}")
    record = {
        "schema_version": 1,
        "project_id": config["project_id"],
        "pattern_id": args.pattern_id,
        "pattern_hash": canonical_hash(pattern),
        "disposition": args.disposition,
        "actor": args.actor,
        "evidence": args.evidence,
        "roadmap_ids": args.roadmap_id or [],
        "review_after": args.review_after if args.disposition == "deferred" else None,
        "recorded_at": iso_now(config),
    }
    append_jsonl(private_path(root, config) / "reports" / "pattern-dispositions.jsonl", record)
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {"at": record["recorded_at"], "event": "note.pattern-review", "pattern_id": args.pattern_id, "disposition": args.disposition},
    )
    return record


def memory_db(root: Path, config: dict[str, Any]) -> Path:
    return private_path(root, config) / "index" / "project-memory.sqlite"


def memory_sources(root: Path, config: dict[str, Any], scope: str) -> list[tuple[Path, str]]:
    docs_root = confined_path(root, config.get("memory_docs", "docs/project-memory"), "memory_docs")
    result = [
        (path, "trusted")
        for path in sorted(docs_root.glob("**/*.md"))
        if path.is_file() and path.resolve().is_relative_to(docs_root)
    ]
    if scope in {"private", "all"}:
        private_docs = private_path(root, config) / "knowledge"
        result.extend(
            (path, "private")
            for path in sorted(private_docs.glob("**/*.md"))
            if path.is_file() and path.resolve().is_relative_to(private_docs.resolve())
        )
    return result


def document_capture_records(root: Path, config: dict[str, Any], scope: str) -> list[tuple[Path, dict[str, Any], str]]:
    records: list[tuple[Path, dict[str, Any], str]] = []
    for path in sorted((private_path(root, config) / "captures").glob("**/*.json")):
        capture = json_load(path, {})
        if not isinstance(capture, dict) or capture.get("document_type") not in DOCUMENT_TYPES:
            continue
        source_scope = "trusted" if capture.get("source_authority") == "project-intent" else "private"
        if scope == "trusted" and source_scope != "trusted":
            continue
        if scope == "private" and source_scope != "private":
            continue
        records.append((path, capture, source_scope))
    return records


def memory_source_fingerprint(root: Path, config: dict[str, Any], scope: str) -> str:
    records = []
    for path, source_scope in memory_sources(root, config, scope):
        records.append(
            {
                "path": runtime_lib.project_relative_posix(path, root),
                "scope": source_scope,
                "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            }
        )
    capture_paths: set[Path] = set()
    if scope in {"private", "all"}:
        capture_paths.update((private_path(root, config) / "captures").glob("**/*.json"))
    capture_paths.update(path for path, _capture, _source_scope in document_capture_records(root, config, scope))
    for path in sorted(capture_paths):
        records.append(
            {
                "path": runtime_lib.project_relative_posix(path, root),
                "scope": "capture",
                "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            }
        )
        capture = json_load(path, {})
        snapshot_ref = capture.get("raw_snapshot_ref") if isinstance(capture, dict) else None
        if isinstance(snapshot_ref, str):
            snapshot = confined_path(root, snapshot_ref, "raw_snapshot_ref")
            if snapshot.is_file() and snapshot.is_relative_to(private_path(root, config)):
                records.append(
                    {
                        "path": runtime_lib.project_relative_posix(snapshot, root),
                        "scope": "document-snapshot",
                        "sha256": hashlib.sha256(snapshot.read_bytes()).hexdigest(),
                    }
                )
    return canonical_hash(records)


def memory_index(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    db_path = memory_db(root, config)
    db_path.parent.mkdir(parents=True, exist_ok=True)
    connection = sqlite3.connect(db_path)
    connection.executescript(
        """
        DROP TABLE IF EXISTS memory;
        DROP TABLE IF EXISTS memory_fts;
        CREATE TABLE memory (
          memory_id TEXT PRIMARY KEY, path TEXT NOT NULL, heading TEXT, title TEXT,
          entry_type TEXT, status TEXT, system_name TEXT, summary TEXT, tags TEXT,
          aliases TEXT, sources TEXT, updated_at TEXT, last_verified_at TEXT,
          verified_against TEXT, confidence TEXT, scope TEXT, body TEXT
        );
        CREATE VIRTUAL TABLE memory_fts USING fts5(
          memory_id UNINDEXED, title, heading, summary, tags, aliases, system_name, body,
          tokenize='unicode61'
        );
        """
    )
    indexed = 0
    warnings: list[str] = []
    seen: set[str] = set()
    for path, scope in memory_sources(root, config, args.scope):
        metadata, body, heading = parse_markdown(path)
        absent = sorted(FRONTMATTER_REQUIRED - set(metadata))
        if absent:
            warnings.append(f"skipped {runtime_lib.project_relative_posix(path, root)}: missing {', '.join(absent)}")
            continue
        memory_id = str(metadata.get("memory_id") or stable_id("memory", runtime_lib.project_relative_posix(path, root)))
        if memory_id in seen:
            warnings.append(f"duplicate memory_id {memory_id}: {runtime_lib.project_relative_posix(path, root)}")
            continue
        seen.add(memory_id)
        row = (
            memory_id,
            runtime_lib.project_relative_posix(path, root),
            heading,
            str(metadata.get("title") or heading or path.stem),
            str(metadata.get("type", "unclassified")),
            str(metadata.get("status", "proposed")),
            str(metadata.get("system", "project")),
            str(metadata.get("summary", "")),
            json.dumps(metadata.get("tags", [])),
            json.dumps(metadata.get("aliases", [])),
            json.dumps(metadata.get("sources", [])),
            str(metadata.get("updated_at", "")),
            str(metadata.get("last_verified_at", "")),
            str(metadata.get("verified_against", "")),
            str(metadata.get("confidence", "unknown")),
            scope,
            body,
        )
        connection.execute("INSERT INTO memory VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", row)
        connection.execute(
            "INSERT INTO memory_fts VALUES (?,?,?,?,?,?,?,?)",
            (memory_id, row[3], heading, row[7], row[8], row[9], row[6], body),
        )
        indexed += 1
    latest_document_revisions: dict[str, int] = {}
    for _path, capture, _source_scope in document_capture_records(root, config, "all"):
        document_id = str(capture.get("document_id", ""))
        latest_document_revisions[document_id] = max(
            latest_document_revisions.get(document_id, 0), int(capture.get("document_revision", 0))
        )
    for path, capture, source_scope in document_capture_records(root, config, args.scope):
        memory_id = str(capture.get("document_memory_id") or stable_id(
            "document-memory", str(capture.get("document_id", "")), str(capture.get("source_hash", ""))
        ))
        if memory_id in seen:
            warnings.append(f"duplicate memory_id {memory_id}: {runtime_lib.project_relative_posix(path, root)}")
            continue
        snapshot_ref = capture.get("raw_snapshot_ref")
        if not isinstance(snapshot_ref, str):
            warnings.append(f"skipped {runtime_lib.project_relative_posix(path, root)}: document snapshot reference is missing")
            continue
        snapshot = confined_path(root, snapshot_ref, "raw_snapshot_ref")
        if not snapshot.is_file() or not snapshot.is_relative_to(private_path(root, config)):
            warnings.append(f"skipped {runtime_lib.project_relative_posix(path, root)}: document snapshot is missing or unsafe")
            continue
        snapshot_bytes = snapshot.read_bytes()
        if hashlib.sha256(snapshot_bytes).hexdigest() != capture.get("source_hash"):
            warnings.append(f"skipped {runtime_lib.project_relative_posix(path, root)}: document snapshot hash mismatch")
            continue
        try:
            body = snapshot_bytes.decode("utf-8")
        except UnicodeDecodeError:
            warnings.append(f"skipped {runtime_lib.project_relative_posix(path, root)}: document snapshot is not UTF-8")
            continue
        seen.add(memory_id)
        document_id = str(capture.get("document_id"))
        document_revision = int(capture.get("document_revision", 0))
        status = "current" if document_revision == latest_document_revisions.get(document_id) else "historical"
        title = str(capture.get("document_title") or capture.get("source_ref") or document_id)
        entry_type = f"source-document:{capture.get('document_type')}"
        summary = (
            f"{capture.get('document_type')} source snapshot revision {document_revision}; "
            f"authority {capture.get('source_authority')}. This records product intent, not verified implementation behavior."
        )
        tags = ["source-document", str(capture.get("document_type")), str(capture.get("source_authority"))]
        sources = [
            str(capture.get("source_ref")),
            f"capture:{capture.get('capture_id')}",
            f"sha256:{capture.get('source_hash')}",
        ]
        row = (
            memory_id,
            f"{runtime_lib.project_relative_posix(path, root)}#document",
            "",
            title,
            entry_type,
            status,
            config["project_id"],
            summary,
            json.dumps(tags),
            json.dumps([document_id]),
            json.dumps(sources),
            str(capture.get("captured_at", "")),
            str(capture.get("captured_at", "")),
            str(capture.get("source_hash", "")),
            "high" if source_scope == "trusted" else "medium",
            source_scope,
            body,
        )
        connection.execute("INSERT INTO memory VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", row)
        connection.execute(
            "INSERT INTO memory_fts VALUES (?,?,?,?,?,?,?,?)",
            (memory_id, title, "", summary, row[8], row[9], row[6], body),
        )
        indexed += 1
    if args.scope in {"private", "all"}:
        captures_root = private_path(root, config) / "captures"
        for path in sorted(captures_root.glob("**/*.json")):
            capture = json_load(path, {})
            if not isinstance(capture, dict):
                continue
            for item in capture.get("items", []):
                if not isinstance(item, dict) or not isinstance(item.get("item_id"), str):
                    continue
                memory_id = item["item_id"]
                if memory_id in seen:
                    warnings.append(f"duplicate memory_id {memory_id}: {runtime_lib.project_relative_posix(path, root)}")
                    continue
                seen.add(memory_id)
                concepts = [
                    *item.get("themes", []),
                    *item.get("stakeholders", []),
                    f"sentiment:{item.get('sentiment', 'unknown')}",
                    f"perspective:{item.get('perspective', 'unknown')}",
                    f"occurrence:{item.get('occurrence_type', 'observation')}",
                    f"impact:{item.get('impact', 'unknown')}",
                    f"actionability:{item.get('actionability', 'context')}",
                ]
                text = str(item.get("text", ""))
                title = text[:120] or memory_id
                relative = f"{runtime_lib.project_relative_posix(path, root)}#{memory_id}"
                row = (
                    memory_id,
                    relative,
                    "",
                    title,
                    f"capture:{item.get('kind', 'context')}",
                    "proposed",
                    config["project_id"],
                    text,
                    json.dumps(concepts),
                    json.dumps(item.get("themes", [])),
                    json.dumps([capture.get("source_type"), capture.get("source_ref")]),
                    str(item.get("updated_at", capture.get("captured_at", ""))),
                    "",
                    "",
                    str(item.get("confidence", "unknown")),
                    "private",
                    text,
                )
                connection.execute("INSERT INTO memory VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", row)
                connection.execute(
                    "INSERT INTO memory_fts VALUES (?,?,?,?,?,?,?,?)",
                    (memory_id, title, "", text, row[8], row[9], row[6], text),
                )
                indexed += 1
    connection.commit()
    connection.close()
    manifest = {
        "indexed_at": iso_now(config),
        "entries": indexed,
        "scope": args.scope,
        "warnings": warnings,
        "database": runtime_lib.project_relative_posix(db_path, root),
        "source_fingerprint": memory_source_fingerprint(root, config, args.scope),
    }
    json_dump(private_path(root, config) / "index" / "manifest.json", manifest)
    return manifest


def ensure_index(root: Path, config: dict[str, Any], scope: str = "trusted") -> None:
    manifest = json_load(private_path(root, config) / "index" / "manifest.json", {})
    fingerprint = memory_source_fingerprint(root, config, scope)
    if (
        not memory_db(root, config).exists()
        or manifest.get("scope") != scope
        or manifest.get("source_fingerprint") != fingerprint
    ):
        memory_index(argparse.Namespace(scope=scope))


def memory_search(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    ensure_index(root, config, args.scope)
    connection = sqlite3.connect(memory_db(root, config))
    connection.row_factory = sqlite3.Row
    tokens = re.findall(r"[\w-]+", args.query, flags=re.UNICODE)
    if not tokens:
        raise ContinuityError("Search query contains no searchable terms")
    safe_query = " AND ".join(f'"{token.replace(chr(34), chr(34) * 2)}"' for token in tokens)
    where = ["memory_fts MATCH ?"]
    params: list[Any] = [safe_query]
    if args.type:
        where.append("m.entry_type = ?")
        params.append(args.type)
    if args.status:
        where.append("m.status = ?")
        params.append(args.status)
    if args.system:
        where.append("m.system_name = ?")
        params.append(args.system)
    if args.tag:
        where.append("m.tags LIKE ?")
        params.append(f"%{args.tag}%")
    if args.source:
        where.append("m.sources LIKE ?")
        params.append(f"%{args.source}%")
    if args.since:
        where.append("m.updated_at >= ?")
        params.append(args.since)
    if args.scope != "all":
        where.append("m.scope = ?")
        params.append(args.scope)
    query = f"""
      SELECT m.*, bm25(memory_fts) AS rank
      FROM memory_fts JOIN memory m USING(memory_id)
      WHERE {' AND '.join(where)}
      ORDER BY CASE m.status WHEN 'current' THEN 0 WHEN 'proposed' THEN 1 ELSE 2 END,
               rank, m.last_verified_at DESC
      LIMIT ?
    """
    params.append(args.limit)
    rows = [dict(row) for row in connection.execute(query, params).fetchall()]
    connection.close()
    for row in rows:
        row["citation"] = f"{row['path']}#{slug(row['heading'])}" if row["heading"] else row["path"]
        row.pop("body", None)
    return rows


SEMANTIC_CONCEPTS = {
    "adaptability": {"change", "changed", "revision", "revise", "rework", "flexible", "adaptable", "mind"},
    "positive-feedback": {"positive", "good", "great", "approved", "success", "liked", "valuable"},
    "negative-feedback": {"negative", "bad", "failed", "failure", "concern", "problem", "disliked"},
    "customer-need": {"need", "needs", "request", "requested", "customer", "user", "requirement"},
    "risk": {"risk", "security", "blocked", "failure", "concern", "unsafe", "vulnerability"},
    "decision": {"decision", "decide", "approved", "rejected", "choice", "direction"},
}


def semantic_features(text: str) -> dict[str, float]:
    tokens = [token.lower() for token in re.findall(r"[A-Za-z0-9_-]+", text)]
    features: dict[str, float] = {}
    for token in tokens:
        stem = re.sub(r"(ing|ed|es|s)$", "", token) if len(token) > 4 else token
        features[f"term:{stem}"] = features.get(f"term:{stem}", 0.0) + 1.0
    for left, right in zip(tokens, tokens[1:]):
        features[f"pair:{left}:{right}"] = features.get(f"pair:{left}:{right}", 0.0) + 0.5
    token_set = set(tokens)
    for concept, terms in SEMANTIC_CONCEPTS.items():
        overlap = token_set & terms
        if overlap:
            features[f"concept:{concept}"] = float(len(overlap) * 2)
    return features


def cosine_similarity(left: dict[str, float], right: dict[str, float]) -> float:
    common = set(left) & set(right)
    numerator = sum(left[key] * right[key] for key in common)
    left_norm = sum(value * value for value in left.values()) ** 0.5
    right_norm = sum(value * value for value in right.values()) ** 0.5
    if not left_norm or not right_norm:
        return 0.0
    return numerator / (left_norm * right_norm)


def memory_similar(args: argparse.Namespace) -> list[dict[str, Any]]:
    root, config = load_context()
    if args.limit < 1 or args.min_score < 0 or args.min_score > 1:
        raise ContinuityError("Similarity limit must be positive and min-score must be between 0 and 1")
    ensure_index(root, config, args.scope)
    query_features = semantic_features(args.query)
    if not query_features:
        raise ContinuityError("Similarity query contains no semantic features")
    connection = sqlite3.connect(memory_db(root, config))
    connection.row_factory = sqlite3.Row
    where = "" if args.scope == "all" else "WHERE scope = ?"
    params: tuple[Any, ...] = () if args.scope == "all" else (args.scope,)
    candidates = [dict(row) for row in connection.execute(f"SELECT * FROM memory {where}", params).fetchall()]
    connection.close()
    ranked: list[dict[str, Any]] = []
    for row in candidates:
        searchable = " ".join(
            str(row.get(key, "")) for key in ("title", "summary", "tags", "aliases", "system_name", "body")
        )
        score = cosine_similarity(query_features, semantic_features(searchable))
        if score < args.min_score:
            continue
        row["similarity"] = round(score, 4)
        row["citation"] = row["path"]
        row.pop("body", None)
        ranked.append(row)
    ranked.sort(key=lambda row: (row["similarity"], row.get("updated_at", "")), reverse=True)
    return ranked[: args.limit]


def memory_brief(args: argparse.Namespace) -> str:
    search_args = argparse.Namespace(
        query=args.query,
        type=None,
        status=None,
        system=None,
        tag=None,
        source=None,
        since=None,
        scope=args.scope,
        limit=args.limit,
    )
    rows = memory_search(search_args)
    lines = [f"# Project Memory Brief: {args.query}", ""]
    if not rows:
        lines.append("No matching trusted project memory was found.")
    for row in rows:
        lines.extend(
            [
                f"## {row['title']} ({row['memory_id']})",
                "",
                row["summary"] or "No summary recorded.",
                "",
                f"- Type: {row['entry_type']}",
                f"- Scope: {row['scope']}",
                f"- Status: {row['status']}",
                f"- System: {row['system_name']}",
                f"- Verified: {row['last_verified_at'] or 'not recorded'} against {row['verified_against'] or 'not recorded'}",
                f"- Source: `{row['citation']}`",
                "",
            ]
        )
    return "\n".join(lines)


def memory_audit(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    entries: list[dict[str, Any]] = []
    missing: list[dict[str, Any]] = []
    invalid_status: list[dict[str, str]] = []
    duplicates: dict[str, list[str]] = {}
    ids: dict[str, str] = {}
    relationships: list[tuple[str, str, str]] = []
    title_states: dict[str, list[dict[str, str]]] = {}
    stale: list[dict[str, str]] = []
    stale_days = int(config.get("memory_stale_after_days", 90))
    cutoff = now(config).date() - dt.timedelta(days=stale_days)
    for path, scope in memory_sources(root, config, args.scope):
        metadata, _body, _heading = parse_markdown(path)
        relative = runtime_lib.project_relative_posix(path, root)
        entry_id = str(metadata.get("memory_id", ""))
        absent = sorted(FRONTMATTER_REQUIRED - set(metadata))
        if absent:
            missing.append({"path": relative, "fields": absent})
        if metadata.get("status") and metadata["status"] not in MEMORY_STATUSES:
            invalid_status.append({"path": relative, "status": str(metadata["status"])})
        if entry_id:
            if entry_id in ids:
                duplicates.setdefault(entry_id, [ids[entry_id]]).append(relative)
            else:
                ids[entry_id] = relative
        title_key = str(metadata.get("title", "")).strip().lower()
        if title_key:
            title_states.setdefault(title_key, []).append(
                {"path": relative, "status": str(metadata.get("status", "proposed")), "memory_id": entry_id}
            )
        for relationship_key in ("related", "supersedes"):
            values = metadata.get(relationship_key) or []
            if isinstance(values, str):
                values = [values]
            for target in values:
                relationships.append((relative, relationship_key, str(target)))
        verified = str(metadata.get("last_verified_at", ""))[:10]
        if not verified:
            stale.append({"path": relative, "reason": "never verified"})
        else:
            try:
                if dt.date.fromisoformat(verified) < cutoff:
                    stale.append({"path": relative, "reason": f"older than {stale_days} days"})
            except ValueError:
                stale.append({"path": relative, "reason": "invalid last_verified_at"})
        entries.append({"path": relative, "scope": scope, "memory_id": entry_id})
    orphan_relationships = [
        {"path": source, "field": field, "target": target}
        for source, field, target in relationships
        if target and target not in ids
    ]
    possible_conflicts = {
        title: values
        for title, values in title_states.items()
        if len(values) > 1 and sum(value["status"] in {"current", "proposed", "disputed"} for value in values) > 1
    }
    report = {
        "audited_at": iso_now(config),
        "entries": len(entries),
        "missing_frontmatter": missing,
        "invalid_status": invalid_status,
        "duplicates": duplicates,
        "orphan_relationships": orphan_relationships,
        "possible_conflicts": possible_conflicts,
        "stale": stale,
        "healthy": not (missing or invalid_status or duplicates or orphan_relationships or possible_conflicts or stale),
    }
    json_dump(private_path(root, config) / "reports" / "memory-health.json", report)
    return report


def find_memory_entry(root: Path, config: dict[str, Any], memory_id: str) -> Path:
    matches = []
    for path, _scope in memory_sources(root, config, "all"):
        metadata, _body, _heading = parse_markdown(path)
        if metadata.get("memory_id") == memory_id:
            matches.append(path)
    if len(matches) != 1:
        raise ContinuityError(f"Expected one memory entry {memory_id}; found {len(matches)}")
    return matches[0]


def find_document_memory_capture(root: Path, config: dict[str, Any], memory_id: str) -> tuple[Path, dict[str, Any]] | None:
    matches = [
        (path, capture)
        for path, capture, _scope in document_capture_records(root, config, "all")
        if capture.get("document_memory_id") == memory_id
    ]
    if len(matches) > 1:
        raise ContinuityError(f"Expected one document memory entry {memory_id}; found {len(matches)}")
    return matches[0] if matches else None


def require_goal_approval(
    root: Path,
    config: dict[str, Any],
    goal_id: str,
    *,
    note_id: str | None = None,
    memory_ids: Iterable[str] = (),
) -> dict[str, Any]:
    goal, _approval = validate_approval(root, config, goal_id)
    if goal.get("state") not in {"approved", "queued", "dispatched", "running", "validating"}:
        raise ContinuityError(f"Goal {goal_id} is not active and cannot authorize memory changes")
    if not goal.get("documentation_updates"):
        raise ContinuityError(f"Goal {goal_id} does not authorize documentation or memory updates")
    if note_id and note_id not in goal.get("source_note_ids", []):
        raise ContinuityError(f"Note {note_id} is outside goal {goal_id} scope")
    missing = sorted(set(memory_ids) - set(goal.get("memory_ids", [])))
    if missing:
        raise ContinuityError(f"Memory entries outside goal {goal_id} scope: {missing}")
    return goal


def memory_verify(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    require_goal_approval(root, config, args.goal_id, memory_ids=[args.memory_id])
    path = find_memory_entry(root, config, args.memory_id)
    metadata, body, _heading = parse_markdown(path)
    stamp = iso_now(config)
    metadata["last_verified_at"] = stamp
    metadata["updated_at"] = stamp
    metadata["verified_against"] = args.commit
    if metadata.get("status") in {"proposed", "disputed"} and args.mark_current:
        metadata["status"] = "current"
    path.write_text(render_markdown(metadata, body), encoding="utf-8")
    memory_index(argparse.Namespace(scope="trusted"))
    return {"memory_id": args.memory_id, "path": runtime_lib.project_relative_posix(path, root), "verified_against": args.commit}


def memory_promote(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    require_goal_approval(root, config, args.goal_id, note_id=args.note_id)
    selected = None
    source_capture = None
    for capture_path in (private_path(root, config) / "captures").glob("**/*.json"):
        capture = json_load(capture_path, {})
        for item in capture.get("items", []):
            if item.get("item_id") == args.note_id:
                selected = item
                source_capture = capture.get("capture_id")
                break
        if selected:
            break
    if not selected:
        raise ContinuityError(f"Unknown note {args.note_id}")
    if selected.get("kind") not in {"context", "insight", "decision", "documentation-candidate"}:
        raise ContinuityError("Only knowledge or documentation candidates may be promoted to memory")
    stamp = iso_now(config)
    memory_id = args.memory_id or stable_id("memory", config["project_id"], args.note_id, args.title)
    metadata = {
        "memory_id": memory_id,
        "title": args.title,
        "type": args.type,
        "system": args.system,
        "summary": args.summary,
        "status": "proposed",
        "tags": args.tag or [],
        "aliases": [],
        "created_at": stamp,
        "updated_at": stamp,
        "last_verified_at": "",
        "verified_against": "",
        "sources": [f"capture:{source_capture}", f"note:{args.note_id}", f"goal:{args.goal_id}"],
        "related": [],
        "supersedes": [],
        "confidence": args.confidence,
        "unresolved_gaps": [],
    }
    target = confined_path(root, config.get("memory_docs", "docs/project-memory"), "memory_docs") / "proposed" / f"{slug(memory_id)}.md"
    if target.exists():
        raise ContinuityError(f"Memory entry already exists at {runtime_lib.project_relative_posix(target, root)}")
    target.parent.mkdir(parents=True, exist_ok=True)
    body = f"# {args.title}\n\n{selected['text']}\n"
    target.write_text(render_markdown(metadata, body), encoding="utf-8")
    memory_index(argparse.Namespace(scope="trusted"))
    return {"memory_id": memory_id, "path": runtime_lib.project_relative_posix(target, root), "status": "proposed"}


def memory_supersede(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    require_goal_approval(root, config, args.goal_id, memory_ids=[args.memory_id, args.replacement_id])
    old_path = find_memory_entry(root, config, args.memory_id)
    new_path = find_memory_entry(root, config, args.replacement_id)
    old_meta, old_body, _old_heading = parse_markdown(old_path)
    new_meta, new_body, _new_heading = parse_markdown(new_path)
    stamp = iso_now(config)
    old_meta["status"] = "superseded"
    old_meta["updated_at"] = stamp
    related = list(old_meta.get("related") or [])
    if args.replacement_id not in related:
        related.append(args.replacement_id)
    old_meta["related"] = related
    supersedes = list(new_meta.get("supersedes") or [])
    if args.memory_id not in supersedes:
        supersedes.append(args.memory_id)
    new_meta["supersedes"] = supersedes
    new_meta["updated_at"] = stamp
    old_path.write_text(render_markdown(old_meta, old_body), encoding="utf-8")
    new_path.write_text(render_markdown(new_meta, new_body), encoding="utf-8")
    memory_index(argparse.Namespace(scope="trusted"))
    return {"superseded": args.memory_id, "replacement": args.replacement_id}


def goal_dir(root: Path, config: dict[str, Any], goal_id: str) -> Path:
    validate_identifier(goal_id, "goal ID")
    return private_path(root, config) / "goals" / goal_id


def load_goal(root: Path, config: dict[str, Any], goal_id: str) -> tuple[Path, dict[str, Any]]:
    directory = goal_dir(root, config, goal_id)
    goal = json_load(directory / "goal.json")
    if not isinstance(goal, dict):
        raise ContinuityError(f"Unknown goal {goal_id}")
    return directory, goal


def validate_goal_planning_artifacts(goal: dict[str, Any], *, require_resolved: bool = False) -> None:
    validate_triage_brief(goal.get("triage_brief"))
    decision_map = validate_decision_map(goal.get("decision_map"))
    delivery_slices = validate_delivery_slices(goal.get("delivery_slices"))
    roadmap_ids = validate_string_list(goal.get("roadmap_ids", []), "roadmap_ids")
    source_note_ids = validate_string_list(goal.get("source_note_ids", []), "source_note_ids")
    validate_note_dispositions(goal.get("note_dispositions"), source_note_ids, delivery_slices, roadmap_ids)
    validate_roadmap_impact(goal.get("roadmap_impact"), roadmap_ids)
    if require_resolved and decision_map:
        unresolved = [
            decision["decision_id"]
            for decision in decision_map["decisions"]
            if decision.get("status") != "resolved"
        ]
        if unresolved:
            raise ContinuityError(f"Decision map is not decision-complete; unresolved decisions: {unresolved}")


def validate_planning_artifact_parity(directory: Path, goal: dict[str, Any]) -> None:
    plan = (directory / "plan.md").read_text(encoding="utf-8")
    expected = render_planning_artifacts(goal)
    if plan.count("<!-- continuity-planning-artifacts:start -->") != 1 or plan.count("<!-- continuity-planning-artifacts:end -->") != 1:
        raise ContinuityError("Plan must contain exactly one managed planning-artifacts block")
    start = plan.index("<!-- continuity-planning-artifacts:start -->")
    end = plan.index("<!-- continuity-planning-artifacts:end -->", start) + len("<!-- continuity-planning-artifacts:end -->")
    if plan[start:end] != expected:
        raise ContinuityError("Planning artifacts are out of sync with the machine goal; use goal revise")


def goal_material_hash(directory: Path, goal: dict[str, Any]) -> str:
    immutable_keys = {
        "schema_version",
        "goal_id",
        "project_id",
        "title",
        "plan_version",
        "priority",
        "depends_on",
        "source_note_ids",
        "note_dispositions",
        "memory_ids",
        "roadmap_ids",
        "roadmap_impact",
        "roadmap_fingerprint",
        "scope",
        "exclusions",
        "acceptance_criteria",
        "documentation_updates",
        "required_checks",
        "authorization_mode",
        "risk_level",
        "restricted_side_effects",
        "runtime_limit_minutes",
        "triage_brief",
        "decision_map",
        "delivery_slices",
    }
    machine = {key: goal.get(key) for key in sorted(immutable_keys)}
    if "source_capture_refs" in goal:
        machine["source_capture_refs"] = goal.get("source_capture_refs", [])
    if "design_refs" in goal:
        machine["design_refs"] = goal.get("design_refs", [])
    plan = (directory / "plan.md").read_text(encoding="utf-8")
    return hashlib.sha256((json.dumps(machine, sort_keys=True) + "\n" + plan).encode()).hexdigest()


def goal_create(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    payload = json_load(Path(args.goal_file).expanduser())
    if not isinstance(payload, dict):
        raise ContinuityError("Goal file must be a JSON object")
    if not isinstance(payload.get("title"), str) or not payload["title"].strip():
        raise ContinuityError("Goal requires a non-empty title")
    if not isinstance(payload.get("scope"), str) or not payload["scope"].strip():
        raise ContinuityError("Goal requires a non-empty scope")
    for key in (
        "acceptance_criteria",
        "depends_on",
        "source_note_ids",
        "memory_ids",
        "design_ids",
        "roadmap_ids",
        "exclusions",
        "documentation_updates",
        "required_checks",
        "restricted_side_effects",
    ):
        value = payload.get(key, [])
        if not isinstance(value, list) or not all(isinstance(item, str) and item.strip() for item in value):
            raise ContinuityError(f"Goal field {key} must be an array of non-empty strings")
    if not payload.get("acceptance_criteria"):
        raise ContinuityError("Goal requires acceptance_criteria")
    plan_version = payload.get("plan_version", 1)
    runtime_limit = payload.get("runtime_limit_minutes", config.get("max_runtime_minutes", 360))
    if not isinstance(plan_version, int) or isinstance(plan_version, bool) or plan_version < 1:
        raise ContinuityError("plan_version must be an integer of at least 1")
    if not isinstance(runtime_limit, int) or isinstance(runtime_limit, bool) or runtime_limit < 1:
        raise ContinuityError("runtime_limit_minutes must be an integer of at least 1")
    if runtime_limit > int(config.get("max_runtime_minutes", 360)):
        raise ContinuityError("runtime_limit_minutes exceeds the configured project maximum")
    authorization_mode = payload.get("authorization_mode", "separate-approval")
    if authorization_mode not in {"separate-approval", "goal-request"}:
        raise ContinuityError("authorization_mode must be separate-approval or goal-request")
    risk_level = payload.get("risk_level", "routine")
    if risk_level not in {"routine", "elevated", "consequential"}:
        raise ContinuityError("risk_level must be routine, elevated, or consequential")
    stamp = iso_now(config)
    goal_id = validate_identifier(payload.get("goal_id") or stable_id("goal", config["project_id"], stamp, payload["title"]), "goal ID")
    directory = goal_dir(root, config, goal_id)
    if directory.exists():
        raise ContinuityError(f"Goal already exists: {goal_id}")
    delivery_slices = validate_delivery_slices(payload.get("delivery_slices"))
    roadmap_ids = payload.get("roadmap_ids", [])
    note_dispositions = validate_note_dispositions(
        payload.get("note_dispositions"),
        payload.get("source_note_ids", []),
        delivery_slices,
        roadmap_ids,
    )
    for item in note_dispositions:
        if item.get("review_after") and parse_recorded_time(item["review_after"], config["timezone"]) is None:
            raise ContinuityError(f"Note disposition {item['note_id']} has an invalid review_after")
    validate_note_disposition_targets(root, config, note_dispositions)
    goal = {
        "schema_version": SCHEMA_VERSION,
        "goal_id": goal_id,
        "project_id": config["project_id"],
        "title": payload["title"],
        "plan_version": plan_version,
        "state": "awaiting-feedback",
        "priority": payload.get("priority", "normal"),
        "depends_on": payload.get("depends_on", []),
        "source_note_ids": payload.get("source_note_ids", []),
        "note_dispositions": note_dispositions,
        "memory_ids": payload.get("memory_ids", []),
        "design_ids": payload.get("design_ids", []),
        "roadmap_ids": roadmap_ids,
        "roadmap_impact": validate_roadmap_impact(payload.get("roadmap_impact"), roadmap_ids),
        "scope": payload["scope"],
        "exclusions": payload.get("exclusions", []),
        "acceptance_criteria": payload["acceptance_criteria"],
        "documentation_updates": payload.get("documentation_updates", []),
        "required_checks": payload.get("required_checks", []),
        "authorization_mode": authorization_mode,
        "risk_level": risk_level,
        "restricted_side_effects": payload.get("restricted_side_effects", []),
        "runtime_limit_minutes": runtime_limit,
        "triage_brief": validate_triage_brief(payload.get("triage_brief")),
        "decision_map": validate_decision_map(payload.get("decision_map")),
        "delivery_slices": delivery_slices,
        "created_at": stamp,
        "updated_at": stamp,
    }
    validate_goal_roadmap_targets(root, config, goal["roadmap_ids"], goal["roadmap_impact"])
    goal["roadmap_fingerprint"] = roadmap_fingerprint(root, config, goal["roadmap_ids"])
    goal["source_capture_refs"] = source_capture_refs_for_notes(root, config, goal["source_note_ids"])
    try:
        goal["design_refs"] = design_lib.bind_approved(root, config, goal["design_ids"])
    except design_lib.DesignError as exc:
        raise ContinuityError(str(exc)) from exc
    plan = payload.get("plan_markdown") or (
        f"# {goal_id}: {goal['title']}\n\n"
        f"## Context and memory\n\nNotes: {', '.join(goal['source_note_ids']) or 'None'}  \n"
        f"Source documents: {', '.join(item['document_id'] + '@' + item['source_hash'][:12] for item in goal['source_capture_refs']) or 'None'}  \n"
        f"Memory: {', '.join(goal['memory_ids']) or 'None'}\n\n"
        f"Approved design: {', '.join(item['design_id'] + '@' + item['design_hash'][:12] for item in goal['design_refs']) or 'None'}\n\n"
        f"Roadmap: {', '.join(goal['roadmap_ids']) or 'None'}\n\n"
        f"## Proposed execution scope\n\n{goal['scope']}\n\n"
        f"## Exclusions\n\n" + "\n".join(f"- {item}" for item in goal["exclusions"]) + "\n\n"
        f"## Acceptance criteria\n\n" + "\n".join(f"- {item}" for item in goal["acceptance_criteria"]) + "\n"
    )
    plan = with_planning_artifacts(plan, goal)
    directory.mkdir(parents=True, exist_ok=False)
    (directory / "plan.md").write_text(plan, encoding="utf-8")
    goal["plan_hash"] = goal_material_hash(directory, goal)
    json_dump(directory / "goal.json", goal)
    stamp = iso_now(config)
    compliance = {
        "schema_version": SCHEMA_VERSION,
        "assurance_standard_version": ASSURANCE_STANDARD_VERSION,
        "goal_id": goal_id,
        "updated_at": stamp,
        "stages": {
            stage: {"status": "pending", "evidence": [], "updated_at": stamp}
            for stage in COMPLIANCE_STAGES
        },
    }
    compliance["stages"]["capture-triage"] = {
        "status": "passed" if goal["source_note_ids"] else "not-applicable",
        "evidence": goal["source_note_ids"] or ["Goal was created directly without captured notes"],
        "updated_at": stamp,
    }
    compliance["stages"]["memory-retrieval"] = {
        "status": "passed" if goal["memory_ids"] else "not-applicable" if payload.get("memory_reviewed") else "pending",
        "evidence": goal["memory_ids"]
        or ([str(payload.get("memory_review_evidence", "Relevant project memory was reviewed; no matching trusted record was found"))] if payload.get("memory_reviewed") else []),
        "updated_at": stamp,
    }
    compliance["stages"]["roadmap-retrieval"] = {
        "status": "passed" if goal["roadmap_ids"] else "not-applicable",
        "evidence": goal["roadmap_ids"] or ["Goal has no roadmap context"],
        "updated_at": stamp,
    }
    if payload.get("plan_reviewed"):
        compliance["stages"]["plan-review"] = {
            "status": "passed",
            "evidence": [str(payload.get("plan_review_evidence", "Plan reviewed for scope, decisions, and acceptance criteria"))],
            "updated_at": stamp,
        }
    json_dump(directory / "compliance.json", compliance)
    (directory / "feedback.jsonl").touch()
    update_note_goal_links(
        root,
        config,
        goal["source_note_ids"],
        goal_id,
        "awaiting-feedback",
        dispositions=goal["note_dispositions"],
        plan_version=goal["plan_version"],
    )
    append_jsonl(
        private_path(root, config) / "events.jsonl",
        {"at": stamp, "event": "goal.created", "goal_id": goal_id, "plan_version": goal["plan_version"]},
    )
    return goal


def next_default_start(config: dict[str, Any]) -> str:
    current = now(config)
    hour, minute = [int(value) for value in config.get("default_start_time", "22:00").split(":", 1)]
    scheduled = current.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if scheduled <= current:
        scheduled += dt.timedelta(days=1)
    return scheduled.isoformat(timespec="minutes")


def parse_schedule(value: str, config: dict[str, Any]) -> str:
    try:
        scheduled = dt.datetime.fromisoformat(value)
    except ValueError as exc:
        raise ContinuityError("Schedule must be an ISO 8601 date-time") from exc
    if scheduled.tzinfo is None:
        scheduled = scheduled.replace(tzinfo=ZoneInfo(config["timezone"]))
    return scheduled.isoformat(timespec="minutes")


def validate_approval(root: Path, config: dict[str, Any], goal_id: str) -> tuple[dict[str, Any], dict[str, Any]]:
    directory, goal = load_goal(root, config, goal_id)
    compliance = json_load(directory / "compliance.json", {})
    if compliance.get("assurance_standard_version") != ASSURANCE_STANDARD_VERSION:
        raise ContinuityError("Goal compliance ledger uses a missing or unsupported assurance standard")
    approval = json_load(directory / "approval.json")
    if not isinstance(approval, dict):
        raise ContinuityError(f"Goal {goal_id} has no approval record")
    if approval.get("signature_format") == "openssh-sshsig-v1":
        try:
            runtime_lib.validate_schema_file(approval, CONTROL_ROOT / "schemas" / "approval-receipt.schema.json", "approval receipt")
        except runtime_lib.RuntimeIntegrityError as exc:
            raise ContinuityError(str(exc)) from exc
        verify_approval_signature(root, config, directory, approval)
    elif (
        config.get("require_signed_approvals", False)
        and approval.get("authorization_source") not in {"goal-request", "plan-proceed"}
    ):
        raise ContinuityError("This project requires an SSH-signed approval receipt")
    if approval.get("authorization_source") in {"goal-request", "plan-proceed"}:
        if goal.get("risk_level") != "routine" or goal.get("restricted_side_effects"):
            raise ContinuityError("Conversation approval is valid only for routine work without restricted side effects")
    validate_goal_planning_artifacts(goal, require_resolved=True)
    validate_planning_artifact_parity(directory, goal)
    current_hash = goal_material_hash(directory, goal)
    if approval.get("plan_version") != goal.get("plan_version") or approval.get("plan_hash") != current_hash:
        raise ContinuityError("Approval is stale because the plan or goal record changed")
    if goal.get("state") in {"approved", "queued"} and goal.get("roadmap_fingerprint") != roadmap_fingerprint(root, config, goal.get("roadmap_ids", [])):
        raise ContinuityError("Approval is stale because retrieved roadmap context changed")
    if goal.get("state") not in {"approved", "queued", "dispatched", "running", "validating", "review-ready", *REWORK_STATES}:
        raise ContinuityError(f"Goal state {goal.get('state')} is not approved")
    return goal, approval


def approval_allowed_signers_path(root: Path, config: dict[str, Any]) -> Path:
    return confined_path(root, config.get("approval_allowed_signers", ".continuity/trusted-approvers"), "approval_allowed_signers")


def verify_approval_trust_anchor(root: Path, config: dict[str, Any]) -> dict[str, Any]:
    """Bind project-local approvers to the fetched integration branch in production."""
    allowed = approval_allowed_signers_path(root, config)
    if not allowed.is_file():
        raise ContinuityError("Trusted approver allowlist is unavailable")
    if not config.get("require_remote", True):
        return {"mode": "local", "path": runtime_lib.project_relative_posix(allowed, root), "verified": True}
    relative = allowed.relative_to(root).as_posix()
    ref = validate_remote_tracking_ref(root, config.get("approval_trust_ref") or f"origin/{config['integration_branch']}")
    result = git_result(root, "show", "--end-of-options", f"{ref}:{relative}")
    if result.returncode != 0:
        raise ContinuityError(f"Trusted approvers are not anchored at {ref}:{relative}")
    local = allowed.read_bytes()
    remote = result.stdout.encode()
    if local != remote:
        raise ContinuityError(
            "Trusted approvers differ from the fetched integration-branch anchor; "
            "merge the trust change through human review and fetch it before approval"
        )
    return {
        "mode": "integration-branch",
        "path": relative,
        "ref": ref,
        "sha256": hashlib.sha256(local).hexdigest(),
        "verified": True,
    }


def approval_receipt_payload(approval: dict[str, Any]) -> dict[str, Any]:
    return {
        key: approval[key]
        for key in (
            "schema_version",
            "project_id",
            "goal_id",
            "plan_version",
            "plan_hash",
            "behavior_configuration_hash",
            "approved_at",
            "approved_by",
            "authorization_text",
            "authorization_source",
            "nonce",
        )
        if key in approval
    }


def approval_receipt_bytes(approval: dict[str, Any]) -> bytes:
    return (runtime_lib.canonical_json(approval_receipt_payload(approval)) + "\n").encode()


def sign_approval_receipt(approval: dict[str, Any], signing_key: str, signature_path: Path) -> None:
    sign_receipt_bytes(
        approval_receipt_bytes(approval),
        signing_key,
        signature_path,
        namespace="continuity-approval",
        label="approval",
    )


def sign_receipt_bytes(
    payload: bytes,
    signing_key: str,
    signature_path: Path,
    *,
    namespace: str,
    label: str,
) -> None:
    executable = shutil.which("ssh-keygen")
    if not executable:
        raise ContinuityError(f"ssh-keygen is required for signed {label} receipts")
    key = Path(signing_key).expanduser().resolve()
    if not key.is_file():
        raise ContinuityError(f"{label.title()} signing key is unavailable: {key}")
    with tempfile.TemporaryDirectory(prefix=f"continuity-{slug(label)}-") as temporary:
        receipt = Path(temporary) / "receipt.json"
        receipt.write_bytes(payload)
        result = subprocess.run(
            [executable, "-Y", "sign", "-f", str(key), "-n", namespace, str(receipt)],
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
        generated = receipt.with_suffix(receipt.suffix + ".sig")
        if result.returncode != 0 or not generated.is_file():
            raise ContinuityError(f"Unable to sign {label} receipt: {result.stderr.strip() or result.stdout.strip()}")
        runtime_lib.atomic_write_bytes(signature_path, generated.read_bytes())


def verify_receipt_bytes(
    root: Path,
    config: dict[str, Any],
    payload: bytes,
    signature: Path,
    identity: str,
    *,
    namespace: str,
    label: str,
) -> dict[str, Any]:
    executable = shutil.which("ssh-keygen")
    if not executable:
        raise ContinuityError(f"ssh-keygen is required to verify {label} authority")
    trust = verify_approval_trust_anchor(root, config)
    allowed = approval_allowed_signers_path(root, config)
    if not signature.is_file():
        raise ContinuityError(f"Signed {label} requires {signature.name}")
    result = subprocess.run(
        [executable, "-Y", "verify", "-f", str(allowed), "-I", identity, "-n", namespace, "-s", str(signature)],
        input=payload,
        capture_output=True,
        timeout=60,
        check=False,
    )
    if result.returncode != 0:
        message = result.stderr.decode(errors="replace").strip() or result.stdout.decode(errors="replace").strip()
        raise ContinuityError(f"{label.title()} signature verification failed: {message}")
    return trust


def verify_approval_signature(root: Path, config: dict[str, Any], directory: Path, approval: dict[str, Any]) -> None:
    verify_receipt_bytes(
        root,
        config,
        approval_receipt_bytes(approval),
        directory / "approval.sig",
        str(approval.get("approved_by", "")),
        namespace="continuity-approval",
        label="approval",
    )


def approval_trust_add(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    identity = validate_task_id(args.identity, "approver identity")
    public_key_path = Path(args.public_key).expanduser().resolve()
    if not public_key_path.is_file():
        raise ContinuityError(f"Public key is unavailable: {public_key_path}")
    fields = public_key_path.read_text(encoding="utf-8").strip().split()
    if len(fields) < 2 or not fields[0].startswith("ssh-"):
        raise ContinuityError("Public key must use OpenSSH public-key format")
    allowed = approval_allowed_signers_path(root, config)
    existing = [line for line in allowed.read_text(encoding="utf-8").splitlines() if line.strip()] if allowed.exists() else []
    record = f"{identity} {fields[0]} {fields[1]}"
    retained = [line for line in existing if not line.split(maxsplit=1)[0] == identity]
    runtime_lib.atomic_write_text(allowed, "\n".join([*retained, record]) + "\n", mode=0o644)
    return {
        "identity": identity,
        "allowed_signers": runtime_lib.project_relative_posix(allowed, root),
        "replaced": len(retained) != len(existing),
        "authorization_state": "pending-integration-branch-anchor" if config.get("require_remote", True) else "local-test-only",
        "next_step": "Commit this trust change, merge it through protected human review, then fetch the integration branch.",
    }


def approval_trust_list(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    allowed = approval_allowed_signers_path(root, config)
    identities = []
    if allowed.exists():
        identities = [line.split(maxsplit=1)[0] for line in allowed.read_text(encoding="utf-8").splitlines() if line.strip() and not line.lstrip().startswith("#")]
    return {"allowed_signers": runtime_lib.project_relative_posix(allowed, root), "identities": identities}


def approval_verify(args: argparse.Namespace) -> dict[str, Any]:
    root, config = load_context()
    directory, _goal = load_goal(root, config, args.goal_id)
    approval = json_load(directory / "approval.json", {})
    if not isinstance(approval, dict) or not approval:
        raise ContinuityError(f"Goal {args.goal_id} has no approval")
    verify_approval_signature(root, config, directory, approval)
    return {"goal_id": args.goal_id, "approved_by": approval.get("approved_by"), "verified": True, "plan_hash": approval.get("plan_hash")}


