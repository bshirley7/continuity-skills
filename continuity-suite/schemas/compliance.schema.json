{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity compliance ledger",
  "type": "object",
  "required": ["schema_version", "assurance_standard_version", "goal_id", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "assurance_standard_version": {"const": 2},
    "goal_id": {"type": "string"},
    "stages": {
      "type": "object",
      "propertyNames": {"enum": ["capture-triage", "memory-retrieval", "roadmap-retrieval", "plan-review", "approval", "execution-preflight", "implementation", "code-review", "validation", "security-review", "merge-safety", "documentation", "memory-impact", "roadmap-impact", "final-alignment", "human-review"]},
      "additionalProperties": {
        "type": "object",
        "required": ["status", "evidence", "updated_at"],
        "properties": {
          "status": {"enum": ["pending", "passed", "failed", "not-applicable"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
