{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity design input",
  "type": "object",
  "required": [
    "title",
    "intent",
    "audiences",
    "targets"
  ],
  "properties": {
    "design_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "audiences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ui", "document", "image"]}
    },
    "industry": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "themes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "message_structures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "lenses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "preserve": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "working_assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "consequences": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "workflow_signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interaction_signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk_signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_note_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "memory_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "content_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content_id", "classification", "statement"],
        "properties": {
          "content_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "classification": {"enum": ["inspected", "supplied", "inferred", "illustrative"]},
          "statement": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_qualification": {"type": "string"},
          "allowed_uses": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "audience_architecture": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["shared-core", "differentiated", "unresolved"]},
        "shared_core": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "routes": {"type": "array", "items": {"type": "object", "required": ["audience", "route", "needs"], "properties": {"audience": {"type": "string", "minLength": 1}, "route": {"type": "string", "minLength": 1}, "needs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
        "unresolved_conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "prototype_scope": {
      "type": "object",
      "required": ["maturity", "artifact_type"],
      "properties": {
        "maturity": {"enum": ["directional", "behavioral", "implementation-facing"]},
        "artifact_type": {"type": "string", "minLength": 1},
        "demonstrated_surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "demonstrated_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "omitted_surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "omitted_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fixture_data": {"enum": ["none", "present"]}
      },
      "additionalProperties": false
    },
    "validation_matrix": {
      "type": "array",
      "items": {"type": "object", "required": ["scenario", "status"], "properties": {"scenario": {"type": "string", "minLength": 1}, "status": {"enum": ["required", "passed", "not-applicable"]}, "evidence": {"type": "string"}}, "additionalProperties": false}
    },
    "direction_assessment": {
      "type": "object",
      "required": ["material_ambiguities", "resolved_by_evidence"],
      "properties": {
        "material_ambiguities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resolved_by_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "directions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
