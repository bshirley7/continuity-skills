{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity design input",
  "type": "object",
  "required": [
    "title",
    "intent",
    "audiences",
    "targets"
  ],
  "properties": {
    "design_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "audiences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ui", "document", "image"]}
    },
    "industry": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "themes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "message_structures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "lenses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "preserve": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "working_assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "consequences": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "workflow_signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interaction_signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk_signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_note_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "memory_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "content_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["content_id", "classification", "statement"],
        "properties": {
          "content_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "classification": {"enum": ["inspected", "supplied", "inferred", "illustrative"]},
          "statement": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_qualification": {"type": "string"},
          "allowed_uses": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "audience_architecture": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["shared-core", "differentiated", "unresolved"]},
        "shared_core": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "routes": {"type": "array", "items": {"type": "object", "required": ["audience", "route", "needs"], "properties": {"audience": {"type": "string", "minLength": 1}, "route": {"type": "string", "minLength": 1}, "needs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
        "unresolved_conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "prototype_scope": {
      "type": "object",
      "required": ["maturity", "artifact_type"],
      "properties": {
        "maturity": {"enum": ["directional", "behavioral", "implementation-facing"]},
        "artifact_type": {"type": "string", "minLength": 1},
        "demonstrated_surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "demonstrated_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "omitted_surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "omitted_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fixture_data": {"enum": ["none", "present"]}
      },
      "additionalProperties": false
    },
    "implementation_context": {
      "type": "object",
      "required": ["framework", "evidence_refs"],
      "properties": {
        "framework": {"type": "string", "minLength": 1},
        "framework_version": {"type": "string"},
        "react_version": {"type": "string"},
        "styling_systems": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ui_libraries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "motion_libraries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "data_libraries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "icon_libraries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "component_roots": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "token_sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "asset_roots": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "storybook_available": {"type": "boolean"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "component_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "experience_need", "surface", "strategy", "components", "required_states", "responsive_behavior", "accessibility_contract", "custom_expression"],
        "properties": {
          "component_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "experience_need": {"type": "string", "minLength": 1},
          "surface": {"type": "string", "minLength": 1},
          "existing_capability": {"type": "string"},
          "strategy": {"enum": ["reuse", "compose", "extend", "custom", "missing-capability"]},
          "components": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_states": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "responsive_behavior": {"type": "string", "minLength": 1},
          "accessibility_contract": {"type": "string", "minLength": 1},
          "custom_expression": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "asset_strategy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "purpose", "source", "art_direction", "provenance_status", "responsive_treatment", "accessibility_alternative", "fallback", "claim_boundary"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "purpose": {"type": "string", "minLength": 1},
          "source": {"enum": ["existing", "supplied", "generated", "derived", "deliberately-omitted"]},
          "art_direction": {"type": "string", "minLength": 1},
          "provenance_status": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_crops": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "responsive_treatment": {"type": "string", "minLength": 1},
          "accessibility_alternative": {"type": "string", "minLength": 1},
          "fallback": {"type": "string", "minLength": 1},
          "claim_boundary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "completion_contract": {
      "type": "object",
      "required": ["mode", "required_viewports", "required_states", "content_status", "artifact_critique_required"],
      "properties": {
        "mode": {"enum": ["exploration", "complete-prototype"]},
        "required_viewports": {"type": "array", "uniqueItems": true, "items": {"enum": ["desktop", "tablet", "mobile"]}},
        "required_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "content_status": {"enum": ["representative", "production", "mixed"]},
        "artifact_critique_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "validation_matrix": {
      "type": "array",
      "items": {"type": "object", "required": ["scenario", "status"], "properties": {"scenario": {"type": "string", "minLength": 1}, "status": {"enum": ["required", "passed", "not-applicable"]}, "evidence": {"type": "string"}}, "additionalProperties": false}
    },
    "direction_assessment": {
      "type": "object",
      "required": ["material_ambiguities", "resolved_by_evidence"],
      "properties": {
        "material_ambiguities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resolved_by_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "insight_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["insight_id", "insight", "status", "design_response", "affected_surfaces", "affected_states", "observable_evidence"],
        "properties": {
          "insight_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "insight": {"type": "string", "minLength": 1},
          "status": {"enum": ["decided", "provisional", "omitted"]},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "design_response": {"type": "string", "minLength": 1},
          "affected_surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "affected_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "observable_evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "directions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
