{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved Continuity design record",
  "type": "object",
  "required": ["schema_version", "design_id", "revision", "design_hash", "status", "document_path", "catalog_packs", "approved_at", "approved_by", "execution_authorized"],
  "properties": {
    "schema_version": {"const": 1},
    "design_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "design_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "approved"},
    "document_path": {"const": "docs/design/design.md"},
    "catalog_packs": {"type": "array", "items": {"type": "object", "required": ["pack_id", "version"], "properties": {"pack_id": {"type": "string"}, "version": {"type": "string"}}, "additionalProperties": false}},
    "alignment_contract": {
      "type": "object",
      "required": ["selected_direction_ids", "creative_signatures", "distinctive_expression", "creative_provenance", "preserve", "non_goals", "implementation_guidance", "validation_criteria", "prohibited_patterns"],
      "properties": {
        "selected_direction_ids": {"type": "array", "items": {"type": "string"}},
        "creative_signatures": {"type": "array", "items": {"type": "string"}},
        "distinctive_expression": {"type": "array", "items": {"type": "object"}},
        "creative_provenance": {"type": "array", "items": {"type": "object"}},
        "content_provenance": {"type": "array", "items": {"type": "object"}},
        "audience_architecture": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "prototype_scope": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "implementation_context": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "component_map": {"type": "array", "items": {"type": "object"}},
        "asset_strategy": {"type": "array", "items": {"type": "object"}},
        "completion_contract": {"oneOf": [{"type": "object"}, {"type": "null"}]},
        "validation_matrix": {"type": "array", "items": {"type": "object"}},
        "insight_decisions": {"type": "array", "items": {"type": "object"}},
        "content_rules": {"type": "array", "items": {"type": "string"}},
        "audience_strategy": {"type": "array", "items": {"type": "string"}},
        "prototype_boundaries": {"type": "array", "items": {"type": "string"}},
        "preserve": {"type": "array", "items": {"type": "string"}},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "implementation_guidance": {"type": "array", "items": {"type": "string"}},
        "validation_criteria": {"type": "array", "items": {"type": "string"}},
        "prohibited_patterns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "approved_at": {"type": "string"},
    "approved_by": {"type": "string"},
    "execution_authorized": {"const": false}
  },
  "additionalProperties": false
}
