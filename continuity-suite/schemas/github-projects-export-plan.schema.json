{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approval-ready GitHub Projects export plan",
  "type": "object",
  "required": ["schema_version", "plan_hash", "generated_at", "authorization_text", "material"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "authorization_text": {"type": "string", "minLength": 1},
    "material": {
      "type": "object",
      "required": ["schema_version", "provider", "project_id", "destination", "settings_path", "mode", "item_mode", "publish_statuses", "field_names", "items"]
    }
  },
  "additionalProperties": false
}
