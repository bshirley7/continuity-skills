{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity-Design presentation benchmark run",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "workflow", "run_id", "status", "definition_sha256", "brief_sha256", "source", "seed", "doctor", "checkpoints", "concepts", "refinement_passes", "selection", "prototype_validation", "approval", "evidence", "reviews", "hard_failure_reviews", "execution_authorized"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "benchmark_id": {"enum": ["continuity-design-presentation-v1", "continuity-design-presentation-v2"]},
    "workflow": {"const": "$continuity-design"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "status": {"enum": ["directions", "selected", "prototype-validated", "approved", "scored"]},
    "definition_sha256": {"$ref": "#/$defs/hash"},
    "brief_sha256": {"$ref": "#/$defs/hash"},
    "source": {"type": "object"},
    "seed": {"type": "object"},
    "doctor": {"$ref": "#/$defs/artifact"},
    "checkpoints": {"type": "array", "items": {"type": "object"}},
    "concepts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object"}},
    "creative_pathway": {"$ref": "#/$defs/creative_pathway"},
    "consultation": {"$ref": "#/$defs/consultation"},
    "refinement_passes": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "selection": {"type": ["object", "null"]},
    "prototype_validation": {"type": ["object", "null"]},
    "approval": {"type": ["object", "null"]},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "reviews": {"type": "array", "items": {"type": "object"}},
    "hard_failure_reviews": {"type": "array", "items": {"type": "object"}},
    "execution_authorized": {"const": false}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}, "additionalProperties": true},
    "creative_pathway": {
      "type": "object",
      "required": ["mode", "diagnosis", "fresh_evidence"],
      "properties": {
        "mode": {"enum": ["fresh-concepts", "existing-design-review", "selected-concept-refinement"]},
        "diagnosis": {"$ref": "#/$defs/artifact"},
        "fresh_evidence": {
          "anyOf": [
            {
              "type": "object",
              "required": ["research", "moodboard", "generative_laboratory", "concept_manifest", "comparison"],
              "properties": {
                "research": {"$ref": "#/$defs/artifact"},
                "moodboard": {"$ref": "#/$defs/artifact"},
                "generative_laboratory": {"$ref": "#/$defs/artifact"},
                "concept_manifest": {"$ref": "#/$defs/artifact"},
                "comparison": {"$ref": "#/$defs/artifact"}
              },
              "additionalProperties": false
            },
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "consultation": {
      "type": "object",
      "required": ["design_id", "private", "rounds", "execution_authorized"],
      "properties": {
        "design_id": {"type": "string", "minLength": 1},
        "private": {"const": true},
        "rounds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/consultation_round"}},
        "execution_authorized": {"const": false}
      },
      "additionalProperties": false
    },
    "consultation_round": {
      "type": "object",
      "required": ["round", "board", "snapshot", "feedback", "record", "delta_input", "delta_record"],
      "properties": {
        "round": {"type": "integer", "minimum": 1},
        "board": {"$ref": "#/$defs/artifact"},
        "snapshot": {"$ref": "#/$defs/artifact"},
        "feedback": {"$ref": "#/$defs/artifact"},
        "record": {"$ref": "#/$defs/artifact"},
        "delta_input": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "delta_record": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {"required": ["creative_pathway", "consultation"], "properties": {"benchmark_id": {"const": "continuity-design-presentation-v2"}}},
      "else": {"properties": {"benchmark_id": {"const": "continuity-design-presentation-v1"}}}
    }
  ],
  "additionalProperties": false
}
