{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity private scheduler run event",
  "type": "object",
  "required": ["schema_version", "run_id", "project_id", "action", "status", "at", "idempotency_key", "attempt", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["review", "dispatch", "report"]},
    "status": {"enum": ["started", "heartbeat", "succeeded", "failed", "blocked", "stale"]},
    "at": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "task_id": {"type": ["string", "null"]},
    "goal_id": {"type": ["string", "null"]},
    "summary": {"type": "string", "minLength": 1},
    "recovered_by": {"type": "string"}
  },
  "additionalProperties": true
}
