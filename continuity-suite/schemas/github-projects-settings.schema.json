{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub Projects projection settings",
  "type": "object",
  "required": ["schema_version", "provider", "owner_type", "owner", "project_number", "mode", "item_mode", "publish_statuses", "fields", "kind_options", "status_options", "health_options"],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"const": "github-projects"},
    "host": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
    "owner_type": {"enum": ["organization", "user"]},
    "owner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"},
    "project_number": {"type": "integer", "minimum": 1},
    "mode": {"const": "export-only"},
    "item_mode": {"const": "draft-issue"},
    "publish_statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["proposed", "inbox", "triaged", "ready", "planned", "active", "in-progress", "validating", "paused", "at-risk", "blocked", "completed", "done", "closed", "cancelled", "historical"]}
    },
    "fields": {
      "type": "object",
      "required": ["continuity_id", "kind", "status", "health"],
      "properties": {
        "continuity_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "health": {"type": "string", "minLength": 1},
        "priority": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "start_date": {"type": "string", "minLength": 1},
        "target_date": {"type": "string", "minLength": 1},
        "parent_ids": {"type": "string", "minLength": 1},
        "depends_on": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "kind_options": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "status_options": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "health_options": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
    ,"priority_options": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
    ,"phase_options": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
