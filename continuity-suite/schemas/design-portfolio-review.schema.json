{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity cross-run design portfolio review",
  "type": "object",
  "required": ["schema_version", "status", "portfolio_id", "reviewer", "reviewed_at", "conclusion", "audit_window", "generations", "recurring_tells", "strongest_prior_generation_id"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "passed"},
    "portfolio_id": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "conclusion": {"type": "string", "minLength": 1},
    "audit_window": {
      "type": "object",
      "required": ["first_generation_index", "last_generation_index", "runs_since_last_audit"],
      "properties": {
        "first_generation_index": {"type": "integer", "minimum": 0},
        "last_generation_index": {"type": "integer", "minimum": 0},
        "runs_since_last_audit": {"type": "integer", "minimum": 0, "maximum": 4}
      },
      "additionalProperties": false
    },
    "generations": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/generation"}},
    "recurring_tells": {"type": "array", "items": {"$ref": "#/$defs/tell"}},
    "strongest_prior_generation_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "file": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "fingerprint": {"type": "object", "required": ["palette-family", "typography-family", "composition-family", "label-style", "status-mark-style", "signature-language", "material-system", "section-rhythm"], "properties": {"palette-family": {"type": "string", "minLength": 1}, "typography-family": {"type": "string", "minLength": 1}, "composition-family": {"type": "string", "minLength": 1}, "label-style": {"type": "string", "minLength": 1}, "status-mark-style": {"type": "string", "minLength": 1}, "signature-language": {"type": "string", "minLength": 1}, "material-system": {"type": "string", "minLength": 1}, "section-rhythm": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "generation": {"type": "object", "required": ["generation_id", "reference_identity", "concept_name", "impact_score", "artifact", "fingerprint"], "properties": {"generation_id": {"type": "string", "minLength": 1}, "reference_identity": {"type": "string", "minLength": 1}, "concept_name": {"type": "string", "minLength": 1}, "impact_score": {"type": "number", "minimum": 0, "maximum": 5}, "artifact": {"$ref": "#/$defs/file"}, "fingerprint": {"$ref": "#/$defs/fingerprint"}}, "additionalProperties": false},
    "tell": {"type": "object", "required": ["tell_id", "dimension", "value", "description", "generation_ids", "default_response"], "properties": {"tell_id": {"type": "string", "minLength": 1}, "dimension": {"enum": ["palette-family", "typography-family", "composition-family", "label-style", "status-mark-style", "signature-language", "material-system", "section-rhythm"]}, "value": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "generation_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "default_response": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
