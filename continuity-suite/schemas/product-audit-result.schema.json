{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity product audit result input",
  "type": "object",
  "required": ["audit_id", "summary", "coverage", "evidence", "findings"],
  "properties": {
    "audit_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "status": {"enum": ["passed", "failed", "partial", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "object",
      "required": ["planned", "observed", "blocked"],
      "properties": {
        "planned": {"type": "integer", "minimum": 1},
        "observed": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "kind", "description", "captured_at"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "kind": {"enum": ["screenshot", "dom", "accessibility", "interaction", "command", "document", "code", "other"]},
          "description": {"type": "string", "minLength": 1},
          "captured_at": {"type": "string", "minLength": 1},
          "reference": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["finding_id", "requirement_ref", "title", "status", "severity", "confidence", "scope", "gate_impact", "source_refs", "evidence_refs", "summary", "recommendation"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "requirement_ref": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["aligned", "partial", "missing", "contradicted", "regressed", "unverifiable", "future-roadmap", "out-of-scope"]},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "confidence": {"enum": ["low", "medium", "high"]},
          "scope": {"enum": ["current-goal", "later", "context-only", "out-of-scope"]},
          "gate_impact": {"enum": ["blocking", "advisory", "none"]},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "summary": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
