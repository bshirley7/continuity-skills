{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity design improvement cycle",
  "type": "object",
  "required": ["schema_version", "cycle_id", "design_id", "objective", "max_passes", "source", "baseline", "passes"],
  "properties": {
    "schema_version": {"const": 1},
    "cycle_id": {"type": "string", "minLength": 1},
    "design_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "max_passes": {"type": "integer", "minimum": 1, "maximum": 8},
    "source": {
      "type": "object",
      "required": ["branch", "commit", "skill_sha256"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "skill_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["benchmark_evaluation", "self_assessment"],
      "properties": {"benchmark_evaluation": {"$ref": "#/$defs/file"}, "self_assessment": {"$ref": "#/$defs/file"}},
      "additionalProperties": false
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pass_number", "status", "findings", "changes", "validation", "human_gate"],
        "properties": {
          "pass_number": {"type": "integer", "minimum": 1},
          "status": {"enum": ["planned", "implemented", "validated", "awaiting-human", "accepted", "changes-requested"]},
          "findings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["finding_id", "category", "observation", "action", "success_metric"], "properties": {"finding_id": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "observation": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}, "success_metric": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
          "changes": {"type": "array", "items": {"type": "object", "required": ["finding_ids", "description", "artifacts"], "properties": {"finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "description": {"type": "string", "minLength": 1}, "artifacts": {"type": "array", "items": {"$ref": "#/$defs/file"}}}, "additionalProperties": false}},
          "validation": {"type": ["object", "null"]},
          "human_gate": {"type": "object", "required": ["required", "status"], "properties": {"required": {"const": true}, "status": {"enum": ["pending", "accepted", "changes-requested"]}, "actor_type": {"enum": ["human"]}, "actor": {"type": "string"}, "rationale": {"type": "string"}}, "additionalProperties": false}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {"file": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
  "additionalProperties": false
}
