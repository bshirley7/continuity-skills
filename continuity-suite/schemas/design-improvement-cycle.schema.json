{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity design improvement cycle",
  "type": "object",
  "required": ["schema_version", "cycle_id", "design_id", "objective", "max_passes", "source", "baseline", "passes"],
  "properties": {
    "schema_version": {"const": 1},
    "cycle_id": {"type": "string", "minLength": 1},
    "design_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "mode": {"enum": ["artifact-refinement", "fresh-design-experiments"], "default": "fresh-design-experiments"},
    "user_instruction": {"type": "string", "minLength": 1},
    "max_passes": {"type": "integer", "minimum": 1, "maximum": 8},
    "source": {
      "type": "object",
      "required": ["branch", "commit", "skill_sha256"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "skill_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["benchmark_evaluation", "self_assessment"],
      "properties": {"benchmark_evaluation": {"$ref": "#/$defs/file"}, "self_assessment": {"$ref": "#/$defs/file"}},
      "additionalProperties": false
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pass_number", "status", "findings", "changes", "validation", "human_gate"],
        "properties": {
          "pass_number": {"type": "integer", "minimum": 1},
          "status": {"enum": ["planned", "implemented", "validated", "awaiting-human", "accepted", "changes-requested"]},
          "experiment": {"oneOf": [{"$ref": "#/$defs/experiment"}, {"type": "null"}]},
          "findings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["finding_id", "category", "observation", "action", "success_metric"], "properties": {"finding_id": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "observation": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}, "success_metric": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
          "changes": {"type": "array", "items": {"type": "object", "required": ["finding_ids", "description", "artifacts"], "properties": {"finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "description": {"type": "string", "minLength": 1}, "artifacts": {"type": "array", "items": {"$ref": "#/$defs/file"}}}, "additionalProperties": false}},
          "validation": {"type": ["object", "null"]},
          "human_gate": {"type": "object", "required": ["required", "status"], "properties": {"required": {"const": true}, "status": {"enum": ["pending", "accepted", "changes-requested"]}, "actor_type": {"enum": ["human"]}, "actor": {"type": "string"}, "rationale": {"type": "string"}}, "additionalProperties": false}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "file": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "experiment": {
      "type": "object",
      "required": ["experiment_id", "source", "brief", "research", "moodboard", "generative_laboratory", "concept_manifest", "comparison", "creative_seed", "reference_families", "novelty_review"],
      "properties": {
        "experiment_id": {"type": "string", "minLength": 1},
        "source": {"type": "object", "required": ["commit", "skill_sha256"], "properties": {"commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "skill_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
        "brief": {"$ref": "#/$defs/file"},
        "research": {"$ref": "#/$defs/file"},
        "moodboard": {"$ref": "#/$defs/file"},
        "generative_laboratory": {"$ref": "#/$defs/file"},
        "concept_manifest": {"$ref": "#/$defs/file"},
        "comparison": {"$ref": "#/$defs/file"},
        "creative_seed": {"type": "object", "required": ["audience", "posture", "hero_mechanism", "reference_category"], "properties": {"audience": {"type": "string", "minLength": 1}, "posture": {"type": "string", "minLength": 1}, "hero_mechanism": {"type": "string", "minLength": 1}, "reference_category": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "reference_families": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "moodboard_quality": {"type": ["object", "null"], "properties": {"tile_count": {"type": "integer", "minimum": 8}, "direct_reference_tile_count": {"type": "integer", "minimum": 2}, "clear_tile_count": {"type": "integer", "minimum": 0}, "focal_crop_count": {"type": ["integer", "null"], "minimum": 0}, "unresolved_weak_tile_ids": {"type": "array", "items": {"type": "string"}}, "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "concept_mechanics": {"type": "array", "items": {"type": "object", "required": ["concept_id", "metaphor", "unique_interaction", "product_job"], "properties": {"concept_id": {"type": "string", "minLength": 1}, "metaphor": {"type": "string", "minLength": 1}, "unique_interaction": {"type": "string", "minLength": 1}, "product_job": {"type": "string", "minLength": 1}, "journey_roles": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
        "house_tell_review": {"type": ["object", "null"], "properties": {"compared_to_passes": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "avoided_tells": {"type": "array", "items": {"type": "string", "minLength": 1}}, "recurring_tells": {"type": "array", "items": {"type": "string", "minLength": 1}}, "justified_recurrences": {"type": "array", "items": {"type": "string", "minLength": 1}}, "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "category_reflex_review": {"type": ["object", "null"], "properties": {"category_defaults": {"type": "array", "items": {"type": "string", "minLength": 1}}, "avoided_defaults": {"type": "array", "items": {"type": "string", "minLength": 1}}, "intentional_risks": {"type": "array", "items": {"type": "object", "required": ["pattern", "rationale", "product_job"], "properties": {"pattern": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}, "product_job": {"type": "string", "minLength": 1}}, "additionalProperties": false}}, "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "novelty_review": {"type": "object", "required": ["compared_to_passes", "changed_dimensions", "inherited_constraints", "novel_conclusions"], "properties": {"compared_to_passes": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "changed_dimensions": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}}, "inherited_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "novel_conclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "artifact-refinement"}}, "required": ["mode"]},
      "then": {"required": ["user_instruction"]}
    }
  ],
  "additionalProperties": false
}
