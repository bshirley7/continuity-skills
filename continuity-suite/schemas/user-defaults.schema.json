{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity portable user defaults",
  "type": "object",
  "required": ["schema_version", "settings"],
  "properties": {
    "schema_version": {"const": 1},
    "settings": {
      "type": "object",
      "properties": {
        "timezone": {"type": "string", "minLength": 1},
        "schedules": {
          "type": "object",
          "required": ["review", "dispatch", "report"],
          "properties": {
            "review": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
            "dispatch": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
            "report": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
          },
          "additionalProperties": false
        },
        "max_runtime_minutes": {"type": "integer", "minimum": 1, "maximum": 360},
        "memory_stale_after_days": {"type": "integer", "minimum": 1, "maximum": 3650},
        "visual_evidence_mode": {"enum": ["when-applicable", "always", "explanation-allowed"]},
        "branch_prefix": {"type": "string", "minLength": 1},
        "planning_patterns": {
          "type": "object",
          "required": ["evidence_triage", "decision_mapping", "delivery_slicing", "tracker_provider"],
          "properties": {
            "evidence_triage": {"enum": ["disabled", "auto", "required"]},
            "decision_mapping": {"enum": ["disabled", "auto", "required"]},
            "delivery_slicing": {"enum": ["disabled", "auto", "required"]},
            "tracker_provider": {"enum": ["local", "github", "linear", "none"]}
          },
          "additionalProperties": false
        },
        "roadmap": {"$ref": "roadmap-settings.schema.json"},
        "agent_surfaces": {
          "type": "object",
          "required": ["primary", "enabled"],
          "properties": {
            "primary": {"enum": ["codex", "claude-code", "cursor", "windsurf", "generic"]},
            "enabled": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["codex", "claude-code", "cursor", "windsurf", "generic"]}}
          },
          "additionalProperties": false
        },
        "scheduler": {
          "type": "object",
          "required": ["provider"],
          "properties": {"provider": {"enum": ["codex", "claude-code", "external", "none"]}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
