{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity AI-slop check input",
  "type": "object",
  "required": ["stage", "ruleset_version", "visual_review"],
  "properties": {
    "stage": {"enum": ["concept", "prototype", "implementation"]},
    "ruleset_version": {"type": "string"},
    "design_id": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "design_hash": {"type": "string"},
    "approval_bundle_hash": {"type": "string"},
    "visual_review": {
      "type": "object",
      "required": ["signature_identifiable", "identity_specific", "not_category_reflex", "directions_structurally_distinct", "not_library_default", "signature_survives_states", "reference_transformed", "decoration_has_job"],
      "properties": {
        "signature_identifiable": {"$ref": "#/$defs/reviewAnswer"},
        "identity_specific": {"$ref": "#/$defs/reviewAnswer"},
        "not_category_reflex": {"$ref": "#/$defs/reviewAnswer"},
        "directions_structurally_distinct": {"$ref": "#/$defs/reviewAnswer"},
        "not_library_default": {"$ref": "#/$defs/reviewAnswer"},
        "signature_survives_states": {"$ref": "#/$defs/reviewAnswer"},
        "reference_transformed": {"$ref": "#/$defs/reviewAnswer"},
        "decoration_has_job": {"$ref": "#/$defs/reviewAnswer"}
      },
      "additionalProperties": false
    },
    "visual_findings": {"type": "array", "items": {"type": "object"}},
    "context_findings": {"type": "array", "items": {"type": "object"}},
    "project_context": {"type": "object"},
    "translation_fidelity": {
      "type": "object",
      "properties": {
        "primitive_media_substitution": {"type": "boolean"},
        "material_energy_preserved": {"type": "boolean"},
        "template_convergence": {"type": "boolean"},
        "declared_mechanics_visible": {"type": "boolean"},
        "generated_study_retained_or_translated": {"type": "boolean"},
        "approved_constraints_present": {"type": "boolean"},
        "primary_material_organizes": {"type": "boolean"},
        "typographic_grammar_preserved": {"type": "boolean"},
        "exact_single_source_baseline": {"type": "boolean"},
        "independent_review": {"type": "boolean"},
        "mobile_comparison_complete": {"type": "boolean"},
        "reference_lineage_visible": {"type": "boolean"},
        "variable_contrast_resolved": {"type": "boolean"},
        "editable_depth_preserved": {"type": "boolean"},
        "font_transfer_verified": {"type": "boolean"},
        "approved_layer_plan_present": {"type": "boolean"},
        "approved_typographic_character_present": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "portfolio_diversity": {
      "type": "object",
      "properties": {
        "portfolio_audit_current": {"type": "boolean"},
        "house_overlap_within_limit": {"type": "boolean"},
        "strongest_prior_challenged": {"type": "boolean"},
        "concept_forming_media_present": {"type": "boolean"},
        "close_far_distance_present": {"type": "boolean"},
        "reference_difficulty_passed": {"type": "boolean"},
        "journey_state_depth_passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "presentation_fidelity": {
      "type": "object",
      "properties": {
        "slide_role_count": {"type": "integer", "minimum": 0},
        "repeated_template_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "narrative_peak_present": {"type": "boolean"},
        "quiet_or_rest_present": {"type": "boolean"},
        "live_presentation_review_complete": {"type": "boolean"},
        "read_ahead_review_complete": {"type": "boolean"},
        "claims_provenance_complete": {"type": "boolean"},
        "capture_integrity_verified": {"type": "boolean"},
        "copy_readability_verified": {"type": "boolean"},
        "data_readability_verified": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}},
    "craft_findings": {"type": "array", "items": {"$ref": "#/$defs/craftFinding"}},
    "generated_claims": {"type": "array", "items": {"type": "object"}},
    "promoted_references": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "reviewAnswer": {
      "type": "object",
      "required": ["result", "finding", "rationale", "reviewer", "reviewed_at", "evidence"],
      "properties": {
        "result": {"enum": ["pass", "fail", "not-applicable"]},
        "finding": {"type": "string"}, "rationale": {"type": "string"},
        "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "region"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "region": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    },
    "disposition": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "pattern": "^CDS-[HDP][0-9]{3}$"},
        "status": {"enum": ["open", "resolved", "not-applicable", "accepted-intentional"]},
        "rationale": {"type": "string"},
        "contract_reference": {"type": "string"},
        "evidence": {"type": "string"}
      },
      "anyOf": [{"required": ["finding_id"]}, {"required": ["rule_id"]}],
      "additionalProperties": false
    },
    "craftFinding": {
      "type": "object",
      "required": ["rule_id", "status", "evidence"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^CDS-[HDP][0-9]{3}$"},
        "status": {"enum": ["open", "resolved", "not-applicable", "accepted-intentional"]},
        "evidence": {"type": "string"},
        "response": {"type": "string"},
        "override_rationale": {"type": "string"},
        "contract_reference": {"type": "string"},
        "artifact_ref": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
