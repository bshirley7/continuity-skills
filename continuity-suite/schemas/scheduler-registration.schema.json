{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity private scheduler registration receipt",
  "type": "object",
  "required": ["schema_version", "provider", "registered_at", "last_heartbeat_at", "last_sweep_id", "registered_by", "supervisor_task_id", "workspace_roots", "behavior_configuration_hash", "sweep_minutes", "supervisor_prompt"],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"enum": ["codex", "claude-code", "external"]},
    "registered_at": {"type": "string", "minLength": 1},
    "last_heartbeat_at": {"type": "string", "minLength": 1},
    "last_sweep_id": {"type": ["string", "null"]},
    "registered_by": {"type": "string", "minLength": 1},
    "supervisor_task_id": {"type": "string", "minLength": 1},
    "workspace_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "behavior_configuration_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sweep_minutes": {"type": "integer", "minimum": 5, "maximum": 60},
    "supervisor_prompt": {"const": ".agents/continuity/automation/portfolio-supervisor.md"}
  },
  "additionalProperties": false
}
