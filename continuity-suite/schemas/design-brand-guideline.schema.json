{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity concrete brand guideline",
  "type": "object",
  "required": ["identity", "color", "typography", "spatial", "form_assets", "motion", "voice", "application_modes", "governance"],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["premise", "primary_carrier", "carrier_rule", "recurring_carriers", "marks", "usage_constraints", "recognition_tests"],
      "properties": {
        "premise": {"type": "string", "minLength": 1},
        "primary_carrier": {"enum": ["imagery", "interaction", "typography", "material", "spatial-system", "motion", "narrative"]},
        "carrier_rule": {"type": "string", "minLength": 1},
        "recurring_carriers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "marks": {"type": "array", "items": {"$ref": "#/$defs/mark"}},
        "usage_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "recognition_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "color": {
      "type": "object",
      "required": ["roles", "semantic_mappings", "modes", "contrast_method"],
      "properties": {
        "roles": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/colorRole"}},
        "semantic_mappings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "contrast_method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "required": ["roles", "scale", "measure", "responsive_behavior"],
      "properties": {
        "roles": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/typeRole"}},
        "scale": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/token"}},
        "measure": {"type": "string", "minLength": 1},
        "responsive_behavior": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "spatial": {
      "type": "object",
      "required": ["base_unit", "spacing_tokens", "grid", "container", "transformations"],
      "properties": {
        "base_unit": {"type": "string", "minLength": 1},
        "spacing_tokens": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/token"}},
        "grid": {"type": "string", "minLength": 1},
        "container": {"type": "string", "minLength": 1},
        "transformations": {
          "type": "array", "minItems": 3,
          "items": {
            "type": "object", "required": ["context", "rule"],
            "properties": {"context": {"enum": ["desktop", "tablet", "mobile", "reflow", "export", "print", "crop"]}, "rule": {"type": "string", "minLength": 1}},
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "form_assets": {
      "type": "object",
      "required": ["shape_rules", "iconography_rules", "imagery_rules", "material_rules", "prohibited_uses"],
      "properties": {
        "shape_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "iconography_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "imagery_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "material_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "prohibited_uses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "required": ["status", "rationale", "tokens", "reduced_motion"],
      "properties": {
        "status": {"enum": ["specified", "not-applicable"]},
        "rationale": {"type": "string", "minLength": 1},
        "tokens": {"type": "array", "items": {"$ref": "#/$defs/motionToken"}},
        "reduced_motion": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "required": ["principles", "approved_examples", "avoid_examples"],
      "properties": {
        "principles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "approved_examples": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "avoid_examples": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "application_modes": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "required": ["mode", "rule"],
        "properties": {"mode": {"enum": ["primary", "recurring", "utility", "quiet", "campaign"]}, "rule": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "required": ["source_refs", "decision_rationale", "prohibited_substitutions", "acceptance_checks", "drift_checks"],
      "properties": {
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "decision_rationale": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "prohibited_substitutions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "drift_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "file": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "mark": {
      "type": "object", "required": ["mark_id", "status", "role", "clear_space", "minimum_size", "colorways", "prohibited_uses"],
      "properties": {
        "mark_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "status": {"enum": ["specified", "not-applicable"]},
        "role": {"type": "string", "minLength": 1},
        "asset": {"$ref": "#/$defs/file"},
        "clear_space": {"type": "string", "minLength": 1},
        "minimum_size": {"type": "string", "minLength": 1},
        "colorways": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prohibited_uses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "colorRole": {
      "type": "object", "required": ["token", "name", "value", "role", "usage"],
      "properties": {"token": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "value": {"type": "string", "pattern": "^(?:#(?:[0-9A-Fa-f]{3}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})|(?:rgb|rgba|hsl|hsla|oklch|lab|lch)\\([^{};]+\\)|[A-Za-z]+)$"}, "role": {"type": "string", "minLength": 1}, "usage": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "typeRole": {
      "type": "object", "required": ["role", "family", "source", "license_evidence", "fallback", "weight_style", "usage"],
      "properties": {"role": {"type": "string", "minLength": 1}, "family": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "license_evidence": {"type": "string", "minLength": 1}, "fallback": {"type": "string", "minLength": 1}, "weight_style": {"type": "string", "minLength": 1}, "usage": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "token": {"type": "object", "required": ["token", "value", "usage"], "properties": {"token": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "usage": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "motionToken": {"type": "object", "required": ["token", "duration", "easing", "usage"], "properties": {"token": {"type": "string", "minLength": 1}, "duration": {"type": "string", "minLength": 1}, "easing": {"type": "string", "minLength": 1}, "usage": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  }
}
