{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity capture",
  "type": "object",
  "required": ["schema_version", "capture_id", "captured_at", "project_id", "source_type", "execution_authorized", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "capture_id": {"type": "string"},
    "captured_at": {"type": "string"},
    "project_id": {"type": "string"},
    "source_type": {"enum": ["conversation", "meeting", "manual", "file", "notion", "linear", "goal-feedback", "shared-packet"]},
    "document_type": {"enum": ["prd", "feature-request"]},
    "document_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "document_title": {"type": "string", "minLength": 1},
    "document_version": {"type": ["string", "null"]},
    "document_revision": {"type": "integer", "minimum": 1},
    "source_authority": {"enum": ["project-intent", "supplied-reference"]},
    "source_ref": {"type": ["string", "null"]},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raw_snapshot_ref": {"type": "string", "minLength": 1},
    "previous_capture_id": {"type": ["string", "null"]},
    "document_memory_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "revision_counts": {
      "type": "object",
      "properties": {
        "added": {"type": "integer", "minimum": 0},
        "changed": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0},
        "removed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "capture_mode": {"enum": ["singular", "batch"]},
    "item_count": {"type": "integer", "minimum": 1, "maximum": 250},
    "execution_authorized": {"const": false},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "kind", "text", "created_at", "updated_at", "occurred_at", "routing_status", "work_status", "execution_authorized", "perspective", "sentiment", "occurrence_type", "impact", "confidence", "actionability", "stakeholders", "themes"],
        "properties": {
          "kind": {"enum": ["context", "insight", "decision", "question", "documentation-candidate", "backlog-candidate", "execution-candidate", "explicit-instruction"]},
          "text": {"type": "string", "minLength": 1},
          "created_at": {"type": "string"},
          "updated_at": {"type": "string"},
          "occurred_at": {"type": "string", "minLength": 1},
          "occurred_at_confidence": {"enum": ["exact", "approximate", "capture-time", "unknown"]},
          "perspective": {"enum": ["internal", "external", "mixed", "unknown"]},
          "sentiment": {"enum": ["positive", "negative", "mixed", "neutral", "unknown"]},
          "occurrence_type": {"enum": ["feedback", "behavior", "decision", "change", "need", "risk", "success", "failure", "constraint", "observation"]},
          "impact": {"enum": ["low", "medium", "high", "critical", "unknown"]},
          "confidence": {"enum": ["low", "medium", "high", "unknown"]},
          "actionability": {"enum": ["context", "monitor", "plan", "urgent-review"]},
          "stakeholders": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "themes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "pattern_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "source_anchor": {
            "type": "object",
            "required": ["source_item_key", "heading_path"],
            "properties": {
              "source_item_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
              "heading_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "section": {"type": "string", "minLength": 1},
              "requirement_id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "revision_status": {"enum": ["added", "changed", "unchanged", "removed"]},
          "same_as_item_id": {"type": "string", "minLength": 1},
          "supersedes_item_id": {"type": "string", "minLength": 1},
          "routing_status": {"enum": ["captured", "route", "defer", "archive", "promote"]},
          "work_status": {"enum": ["open", "deferred", "planned", "queued", "dispatched", "running", "validating", "review-ready", "completed", "partially-completed", "blocked", "cancelled", "not-applicable", "archived"]},
          "routing_work_status": {"enum": ["open", "deferred", "completed", "not-applicable", "archived"]},
          "related_goal_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "goal_links": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "state": {"type": ["string", "null"]},
                "previous_state": {"type": ["string", "null"]},
                "disposition": {"enum": ["current-goal", "later", "context-only", "duplicate"]},
                "reason": {"type": "string"},
                "plan_version": {"type": "integer", "minimum": 1},
                "decided_at": {"type": "string"},
                "updated_at": {"type": ["string", "null"]},
                "review_after": {"type": ["string", "null"]},
                "roadmap_id": {"type": ["string", "null"]},
                "canonical_note_id": {"type": ["string", "null"]},
                "delivery_slice_ids": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": true
            }
          },
          "goal_links_migrated_at": {"type": "string", "minLength": 1},
          "execution_authorized": {"const": false}
        }
      }
    }
  }
}
