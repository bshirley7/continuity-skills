{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity capture",
  "type": "object",
  "required": ["schema_version", "capture_id", "captured_at", "project_id", "source_type", "execution_authorized", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "capture_id": {"type": "string"},
    "captured_at": {"type": "string"},
    "project_id": {"type": "string"},
    "source_type": {"enum": ["conversation", "manual", "file", "notion", "linear"]},
    "execution_authorized": {"const": false},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "kind", "text", "created_at", "updated_at", "routing_status", "work_status", "execution_authorized"],
        "properties": {
          "kind": {"enum": ["context", "insight", "decision", "question", "documentation-candidate", "backlog-candidate", "execution-candidate", "explicit-instruction"]},
          "created_at": {"type": "string"},
          "updated_at": {"type": "string"},
          "routing_status": {"enum": ["captured", "route", "defer", "archive", "promote"]},
          "work_status": {"enum": ["open", "deferred", "planned", "queued", "dispatched", "running", "validating", "completed", "partially-completed", "blocked", "cancelled", "not-applicable", "archived"]},
          "execution_authorized": {"const": false}
        }
      }
    }
  }
}
