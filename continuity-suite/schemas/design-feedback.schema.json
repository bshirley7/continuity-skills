{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity numbered visual feedback",
  "type": "object",
  "required": ["reactions", "contract_changed", "ready_for_selection"],
  "properties": {
    "actor": {"type": "string"}, "contract_changed": {"type": "boolean"}, "ready_for_selection": {"type": "boolean"},
    "reactions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["element_id", "reaction", "why"], "properties": {"element_id": {"type": "string", "minLength": 1}, "reaction": {"enum": ["keep", "change", "avoid", "uncertain"]}, "why": {"type": "string", "minLength": 1}, "user_language": {"type": "string"}}, "additionalProperties": false}},
    "visual_delta": {"type": "object", "properties": {"changed": {"type": "array", "items": {"type": "string"}}, "stayed": {"type": "array", "items": {"type": "string"}}, "why": {"type": "array", "items": {"type": "string"}}, "path": {"type": "string"}, "sha256": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
