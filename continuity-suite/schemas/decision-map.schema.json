{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project decision map",
  "type": "object",
  "required": ["destination", "decisions", "unresolved_territory", "out_of_scope", "execution_authorized"],
  "properties": {
    "destination": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["decision_id", "title", "question", "status", "blocked_by"],
        "properties": {
          "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "title": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "status": {"enum": ["open", "resolved", "blocked", "human-required"]},
          "blocked_by": {"type": "array", "items": {"type": "string"}},
          "resolution": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "unresolved_territory": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "execution_authorized": {"const": false}
  },
  "additionalProperties": true
}
