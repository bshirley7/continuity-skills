{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project-local continuity enrollment manifest",
  "type": "object",
  "required": ["schema_version", "assurance_standard_version", "project_id", "continuity_enabled", "execution_enabled", "integration_branch", "timezone", "schedules", "roadmap", "agent_surfaces", "scheduler", "max_concurrency", "behavior_configuration_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "assurance_standard_version": {"const": 2},
    "project_id": {"type": "string", "minLength": 1},
    "continuity_enabled": {"type": "boolean"},
    "execution_enabled": {"type": "boolean"},
    "integration_branch": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "schedules": {
      "type": "object",
      "required": ["review", "dispatch", "report"],
      "properties": {
        "review": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "dispatch": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "report": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
      },
      "additionalProperties": false
    },
    "roadmap": {"$ref": "roadmap-settings.schema.json"},
    "agent_surfaces": {
      "type": "object",
      "required": ["primary", "enabled"],
      "properties": {
        "primary": {"enum": ["codex", "claude-code", "cursor", "windsurf", "generic"]},
        "enabled": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["codex", "claude-code", "cursor", "windsurf", "generic"]}}
      },
      "additionalProperties": false
    },
    "scheduler": {
      "type": "object",
      "required": ["provider"],
      "properties": {"provider": {"enum": ["codex", "claude-code", "external", "none"]}},
      "additionalProperties": false
    },
    "max_concurrency": {"type": "integer", "const": 1},
    "behavior_configuration_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
