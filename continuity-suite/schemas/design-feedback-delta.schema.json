{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity post-refinement visual delta",
  "type": "object",
  "required": ["status", "reviewer", "reviewed_at", "changed", "stayed", "why", "before", "after", "path", "sha256"],
  "properties": {
    "status": {"const": "passed"},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "changed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "stayed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "why": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "before": {"$ref": "#/$defs/file"},
    "after": {"$ref": "#/$defs/file"},
    "path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {"file": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
  "additionalProperties": false
}
