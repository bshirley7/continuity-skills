{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity morning decision report",
  "type": "object",
  "required": ["schema_version", "project_id", "generated_at", "decisions_needed", "completed_overnight", "blocked_or_at_risk", "prepared_next", "no_action_required", "scheduler"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "decisions_needed": {"type": "array", "items": {"type": "object"}},
    "completed_overnight": {"type": "array", "items": {"type": "object"}},
    "blocked_or_at_risk": {"type": "array", "items": {"type": "object"}},
    "prepared_next": {"type": "array", "items": {"type": "object"}},
    "no_action_required": {"type": "boolean"},
    "scheduler": {"type": "object"}
  },
  "additionalProperties": false
}
