{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dependency-aware delivery slice",
  "type": "object",
  "required": ["ticket_id", "title", "delivers", "acceptance_criteria", "blocked_by", "status", "execution_authorized"],
  "properties": {
    "ticket_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "title": {"type": "string", "minLength": 1},
    "delivers": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "blocked_by": {"type": "array", "items": {"type": "string"}},
    "status": {"const": "planning-candidate"},
    "execution_authorized": {"const": false}
  },
  "additionalProperties": true
}
