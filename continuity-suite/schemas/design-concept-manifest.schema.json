        "pairwise_distances": {"type": "array", "items": {"type": "object", "required": ["concept_ids", "differing_dimensions", "rationale"], "properties": {"concept_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}}, "differing_dimensions": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["organizing-idea", "primary-carrier", "emotional-register", "material-system", "typography-behavior", "imagery-behavior", "motion-model", "voice", "responsive-transformation"]}}, "rationale": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "house_tell_review": {"type": "object", "required": ["recurring_tells_checked", "project_identity_wins", "rationale"], "properties": {"recurring_tells_checked": {"type": "array", "items": {"type": "string", "minLength": 1}}, "project_identity_wins": {"type": "boolean"}, "rationale": {"type": "string", "minLength": 1}, "portfolio_report_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "concept_comparisons": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": false},
        "adversarial_pass": {"type": "array", "items": {"type": "object", "required": ["concept_id", "genericity_argument", "opposing_hypothesis", "resulting_change", "rejected_choice"], "properties": {"concept_id": {"type": "string"}, "genericity_argument": {"type": "string", "minLength": 1}, "opposing_hypothesis": {"type": "string", "minLength": 1}, "resulting_change": {"type": "string", "minLength": 1}, "rejected_choice": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "range_audit": {"type": "object", "required": ["status", "typography_strategy_count", "typography_family_count", "art_direction_family_count", "composition_family_count", "page_grammar_count", "interaction_motion_strategy_count", "minimum_journey_stage_count", "per_concept_runtime_probes", "comparison_depth_coverage", "generated_media_extraction_passed", "rationale"], "properties": {"status": {"const": "passed"}, "typography_strategy_count": {"type": "integer", "minimum": 1}, "typography_family_count": {"type": "integer", "minimum": 1}, "art_direction_family_count": {"type": "integer", "minimum": 1}, "composition_family_count": {"type": "integer", "minimum": 1}, "page_grammar_count": {"type": "integer", "minimum": 1}, "interaction_motion_strategy_count": {"type": "integer", "minimum": 1}, "minimum_journey_stage_count": {"type": "integer", "minimum": 5}, "concept_forming_media_count": {"type": "integer", "minimum": 1}, "per_concept_runtime_probes": {"const": true}, "comparison_depth_coverage": {"const": true}, "generated_media_extraction_passed": {"const": true}, "rationale": {"type": "string", "minLength": 1}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "impact_review": {
      "type": "object",
      "required": ["status", "reviewer_type", "reviewer", "reviewed_at", "at_least_one_compelling", "set_conclusion", "concepts"],
      "properties": {
        "status": {"const": "passed"},
        "reviewer_type": {"enum": ["agent-multimodal", "human"]},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 1},
        "at_least_one_compelling": {"const": true},
        "set_conclusion": {"type": "string", "minLength": 1},
        "concepts": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["concept_id", "outcome", "strength", "signature_stage_ids", "identity_specificity", "emotional_resonance", "craft_coherence", "rationale", "weakest_moment", "refinement_priority", "evidence"], "properties": {"concept_id": {"type": "string", "minLength": 1}, "outcome": {"const": "passed"}, "strength": {"enum": ["credible", "compelling"]}, "signature_stage_ids": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "identity_specificity": {"const": "pass"}, "emotional_resonance": {"const": "pass"}, "craft_coherence": {"const": "pass"}, "rationale": {"type": "string", "minLength": 1}, "weakest_moment": {"type": "string", "minLength": 1}, "refinement_priority": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/file"}}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    },
    "browser_snapshots": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["viewport", "path", "sha256"], "properties": {"viewport": {"enum": ["mobile", "tablet", "desktop"]}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "browser_probes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["viewport", "path", "sha256"], "properties": {"viewport": {"enum": ["mobile", "tablet", "desktop"]}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "research_links": {"type": "array", "items": {"type": "object", "required": ["tile", "disposition", "rationale", "concept_ids"], "properties": {"tile": {"type": "integer", "minimum": 1}, "disposition": {"enum": ["adopted", "transformed", "rejected", "reference-only"]}, "rationale": {"type": "string", "minLength": 1}, "concept_ids": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "visual_references": {"type": "array", "items": {"type": "object", "required": ["path", "sha256", "ownership", "publishable"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "ownership": {"enum": ["project-owned", "supplied-with-rights", "generated", "third-party"]}, "publishable": {"type": "boolean"}, "lesson": {"type": "string"}}, "additionalProperties": false}}
  },
  "$defs": {
    "file": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "probe": {"type": "object", "required": ["viewport", "path", "sha256"], "properties": {"viewport": {"enum": ["mobile", "tablet", "desktop"]}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "slopReport": {"type": "object", "required": ["path", "sha256", "report_hash", "ruleset_version", "counts_by_severity", "dispositions_hash", "status"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "report_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "ruleset_version": {"type": "string"}, "counts_by_severity": {"type": "object"}, "dispositions_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"const": "passed"}}, "additionalProperties": false}
    ,"portfolioReport": {"type": "object", "required": ["path", "sha256", "report_hash"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "report_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}
    ,"portfolioFingerprint": {"type": "object", "required": ["palette-family", "typography-family", "composition-family", "label-style", "status-mark-style", "signature-language", "material-system", "section-rhythm"], "properties": {"palette-family": {"type": "string", "minLength": 1}, "typography-family": {"type": "string", "minLength": 1}, "composition-family": {"type": "string", "minLength": 1}, "label-style": {"type": "string", "minLength": 1}, "status-mark-style": {"type": "string", "minLength": 1}, "signature-language": {"type": "string", "minLength": 1}, "material-system": {"type": "string", "minLength": 1}, "section-rhythm": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  },
