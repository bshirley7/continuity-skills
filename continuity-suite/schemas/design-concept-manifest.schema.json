          "tests_uncertainty": {"type": "string"},
          "reference_adaptation_id": {"type": "string", "minLength": 1},
          "recommended": {"type": "boolean"},
          "thesis": {"type": "string"}, "impact_thesis": {"type": "string"},
          "primary_carrier": {"enum": ["imagery", "interaction", "typography", "material", "spatial-system", "motion", "narrative"]},
          "emotional_register": {"type": "string", "minLength": 1},
          "seed_lineage": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "system_extractions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "signature_move": {"type": "string"},
          "palette": {"type": "array", "minItems": 3, "items": {"type": "string"}},
          "type_specimen": {"type": "object"},
          "typography_system": {"type": "object", "required": ["strategy_id", "family", "display_behavior", "text_behavior", "responsive_behavior", "rationale"], "properties": {"strategy_id": {"type": "string", "minLength": 1}, "family": {"enum": ["serif", "humanist-sans", "grotesk-sans", "neo-grotesk-sans", "condensed-display", "monospaced", "vernacular-display", "system-utility", "custom-letterform", "mixed"]}, "display_behavior": {"type": "string", "minLength": 1}, "text_behavior": {"type": "string", "minLength": 1}, "responsive_behavior": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}}, "additionalProperties": false},
          "typographic_transfer": {"type": "object", "required": ["transfer_id", "rendered_copy", "font_family", "source", "license_evidence", "source_character", "project_transformation", "type_media_relation", "narrow_behavior", "metric_tolerances", "reference_render_probe", "render_probe"], "properties": {"transfer_id": {"type": "string", "minLength": 1}, "rendered_copy": {"type": "string", "minLength": 1}, "font_family": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "license_evidence": {"type": "string", "minLength": 1}, "source_character": {"type": "string", "minLength": 1}, "project_transformation": {"type": "string", "minLength": 1}, "type_media_relation": {"enum": ["separate", "behind-subject", "interleaved", "foreground-over-type"]}, "narrow_behavior": {"type": "string", "minLength": 1}, "metric_tolerances": {"type": "object", "required": ["cap_height_ratio", "word_width_ratio"], "properties": {"cap_height_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.08}, "word_width_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1}}, "additionalProperties": false}, "reference_render_probe": {"$ref": "#/$defs/file"}, "render_probe": {"$ref": "#/$defs/file"}}, "additionalProperties": false},
          "media_system": {"type": "object", "required": ["art_direction_family", "primary_role", "asset_mix", "quiet_state", "fallback"], "properties": {"art_direction_family": {"enum": ["photographic", "documentary", "illustrative", "typographic", "material", "spatial", "diagrammatic", "cinematic", "interaction-led", "mixed"]}, "primary_role": {"type": "string", "minLength": 1}, "asset_mix": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["generated", "derived", "project-owned", "supplied", "code-native", "deliberately-omitted"]}}, "quiet_state": {"type": "string", "minLength": 1}, "fallback": {"type": "string", "minLength": 1}, "concept_role": {"enum": ["concept-forming", "supporting", "omitted"]}, "thesis_effect": {"type": "string", "minLength": 1}, "composition_effect": {"type": "string", "minLength": 1}, "interaction_effect": {"type": "string", "minLength": 1}}, "additionalProperties": false},
          "composition_asset_plan": {"type": "object", "required": ["plan_id", "type_media_relation", "registration_basis", "planes"], "properties": {"plan_id": {"type": "string", "minLength": 1}, "type_media_relation": {"enum": ["separate", "behind-subject", "interleaved", "foreground-over-type"]}, "registration_basis": {"type": "string", "minLength": 1}, "planes": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["plane_id", "role", "source_kind", "z_index", "crop_anchor", "responsive_behavior"], "properties": {"plane_id": {"type": "string", "minLength": 1}, "role": {"enum": ["background", "midground", "live-type", "foreground", "annotation"]}, "source_kind": {"enum": ["raster", "live-html", "svg", "video"]}, "z_index": {"type": "integer"}, "crop_anchor": {"type": "string", "minLength": 1}, "responsive_behavior": {"type": "string", "minLength": 1}, "selector": {"type": "string", "minLength": 1}, "asset": {"$ref": "#/$defs/file"}}, "additionalProperties": false}}}, "additionalProperties": false},
          "composition_family": {"enum": ["editorial-sequence", "spatial-field", "cinematic-chapters", "typographic-poster", "documentary-index", "interactive-instrument", "material-collage", "narrative-scroll", "modular-system"]},
          "page_grammar": {"type": "object", "required": ["grammar_id", "family", "core_behavior", "responsive_behavior", "depth_proof"], "properties": {"grammar_id": {"type": "string", "minLength": 1}, "family": {"enum": ["longform-narrative", "single-canvas-instrument", "navigable-artifact", "editorial-issue", "cinematic-sequence", "modular-system", "spatial-journey"]}, "core_behavior": {"type": "string", "minLength": 1}, "responsive_behavior": {"type": "string", "minLength": 1}, "depth_proof": {"type": "string", "minLength": 1}}, "additionalProperties": false},
          "grammar_congruence": {"type": "object", "required": ["status", "reviewer_type", "reviewer", "reviewed_at", "strongest_match", "weakest_mismatch", "behaviors"], "properties": {"status": {"const": "passed"}, "reviewer_type": {"enum": ["agent-multimodal", "human"]}, "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "minLength": 1}, "strongest_match": {"type": "string", "minLength": 1}, "weakest_mismatch": {"type": "string", "minLength": 1}, "behaviors": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["behavior_id", "journey_stage_ids", "artifact_note"], "properties": {"behavior_id": {"type": "string", "minLength": 1}, "journey_stage_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "artifact_note": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}, "additionalProperties": false},
          "journey_structure_review": {"type": "object", "required": ["status", "mode", "distinct_expression_count", "deepest_signature_change", "repeated_pattern_risk", "assignments"], "properties": {"status": {"const": "passed"}, "mode": {"enum": ["structural-variety", "persistent-state-variation"]}, "distinct_expression_count": {"type": "integer", "minimum": 4}, "deepest_signature_change": {"type": "string", "minLength": 1}, "repeated_pattern_risk": {"type": "string", "minLength": 1}, "assignments": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["stage_id", "expression_id", "artifact_note", "responsive_behavior"], "properties": {"stage_id": {"type": "string", "minLength": 1}, "expression_id": {"type": "string", "minLength": 1}, "artifact_note": {"type": "string", "minLength": 1}, "responsive_behavior": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}, "additionalProperties": false},
          "interaction_motion_system": {"type": "object", "required": ["strategy_id", "mode", "semantic_purpose", "reduced_motion", "static_fallback"], "properties": {"strategy_id": {"type": "string", "minLength": 1}, "mode": {"enum": ["static", "native-disclosure", "direct-manipulation", "spatial-transition", "cinematic", "mixed"]}, "semantic_purpose": {"type": "string", "minLength": 1}, "reduced_motion": {"type": "string", "minLength": 1}, "static_fallback": {"type": "string", "minLength": 1}, "decision": {"enum": ["purposeful-motion", "explicit-no-motion"]}, "storyboard": {"$ref": "#/$defs/file"}, "atmosphere_contribution": {"type": "string", "minLength": 1}, "state_transition": {"type": "string", "minLength": 1}}, "additionalProperties": false},
          "portfolio_fingerprint": {"$ref": "#/$defs/portfolioFingerprint"},
          "journey_stages": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["stage_id", "role", "purpose", "signature_expression"], "properties": {"stage_id": {"type": "string", "minLength": 1}, "role": {"enum": ["opening", "orientation", "proof", "system-model", "interaction", "quiet-state", "edge-state", "trust", "decision", "closure"]}, "purpose": {"type": "string", "minLength": 1}, "signature_expression": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
          "comparison_coverage": {"type": "object", "required": ["full_page_strip", "chapter_index", "deep_link"], "properties": {"full_page_strip": {"$ref": "#/$defs/file"}, "chapter_index": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}}, "deep_link": {"$ref": "#/$defs/file"}}, "additionalProperties": false},
          "generated_media_disposition": {"type": "object"},
          "runtime_source_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
          "runtime_probes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/probe"}},
          "signature_coverage": {"type": "object", "required": ["signature_id", "required_roles", "reduced_motion_probe"], "properties": {"signature_id": {"type": "string", "minLength": 1}, "required_roles": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["opening", "proof", "interaction", "quiet-state", "edge-state", "closure"]}}, "reduced_motion_probe": {"$ref": "#/$defs/file"}}, "additionalProperties": false},
          "interaction_invariants": {"type": "object", "required": ["required_ids", "states"], "properties": {"required_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "states": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["state_id", "probe"], "properties": {"state_id": {"type": "string", "minLength": 1}, "probe": {"$ref": "#/$defs/file"}}, "additionalProperties": false}}}, "additionalProperties": false},
          "wide_composition": {"$ref": "#/$defs/file"},
          "narrow_transformation": {"$ref": "#/$defs/file"},
          "imagery_treatment": {"type": "string"}, "motion_decision": {"type": "string"},
          "preservation_promise": {"type": "string"}, "tradeoff": {"type": "string"},
          "anti_reference": {"type": "string"}, "fidelity_level": {"type": "string"},
          "slop_report": {"$ref": "#/$defs/slopReport"}
