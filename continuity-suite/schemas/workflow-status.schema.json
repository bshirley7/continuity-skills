{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity workflow handoff status",
  "type": "object",
  "required": ["schema_version", "project_id", "generated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "next_skill": {"type": ["string", "null"]},
    "queue_counts": {"type": "object"},
    "legacy_goal_ids": {"type": "array", "items": {"type": "string"}},
    "goals": {"type": "array", "items": {"$ref": "#/$defs/goalStatus"}},
    "goal": {"$ref": "#/$defs/goalStatus"},
    "capture": {
      "type": "object",
      "required": ["capture_id", "current_stage", "next_skill", "blockers", "items", "execution_authorized", "handoff"],
      "properties": {
        "capture_id": {"type": "string", "minLength": 1},
        "current_stage": {"type": "string", "minLength": 1},
        "next_skill": {"type": ["string", "null"]},
        "next_skills": {"type": "array", "items": {"type": "string"}},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "items": {"type": "array", "items": {"type": "object"}},
        "document_id": {"type": "string"},
        "document_type": {"enum": ["prd", "feature-request"]},
        "document_revision": {"type": "integer", "minimum": 1},
        "source_authority": {"enum": ["project-intent", "supplied-reference"]},
        "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "execution_authorized": {"const": false},
        "handoff": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "anyOf": [
    {"required": ["goal"]},
    {"required": ["capture"]},
    {"required": ["next_skill", "queue_counts", "legacy_goal_ids", "goals"]}
  ],
  "$defs": {
    "goalStatus": {
      "type": "object",
      "required": ["goal_id", "state", "current_stage", "blockers", "allowed_actions", "blocked_actions", "human_requirements", "completed_prerequisites", "pending_compliance", "failed_compliance", "execution_attempt", "evidence"],
      "properties": {
        "goal_id": {"type": "string", "minLength": 1},
        "title": {"type": ["string", "null"]},
        "state": {"type": "string", "minLength": 1},
        "current_stage": {"type": "string", "minLength": 1},
        "next_skill": {"type": ["string", "null"]},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "allowed_actions": {"type": "array", "items": {"type": "object"}},
        "blocked_actions": {"type": "array", "items": {"type": "object"}},
        "human_requirements": {"type": "array", "items": {"type": "string"}},
        "completed_prerequisites": {"type": "array", "items": {"type": "string"}},
        "pending_compliance": {"type": "array", "items": {"type": "string"}},
        "failed_compliance": {"type": "array", "items": {"type": "string"}},
        "execution_attempt": {"type": "integer", "minimum": 1},
        "evidence": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
