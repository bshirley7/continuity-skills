{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Durable GitHub Projects connection",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "project_id",
    "connection_id",
    "connected_at",
    "credential_source",
    "authenticated_user",
    "destination",
    "capabilities",
    "sync_policy",
    "authorization"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provider": {"const": "github-projects"},
    "project_id": {"type": "string", "minLength": 1},
    "connection_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "connected_at": {"type": "string", "format": "date-time"},
    "credential_source": {"const": "gh-credential-store"},
    "authenticated_user": {
      "type": "object",
      "required": ["login", "database_id"],
      "properties": {
        "login": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"},
        "database_id": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "destination": {
      "type": "object",
      "required": ["owner_type", "owner", "project_number", "project_node_id", "project_url", "visibility"],
      "properties": {
        "host": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"},
        "owner_type": {"enum": ["organization", "user"]},
        "owner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"},
        "project_number": {"type": "integer", "minimum": 1},
        "project_node_id": {"type": "string", "minLength": 1},
        "project_url": {"type": "string", "pattern": "^https://[^/]+/.+$"},
        "visibility": {"enum": ["PRIVATE", "PUBLIC"]}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["read", "write", "create_project", "edit_project", "create_item", "edit_item", "delete_item"],
      "properties": {
        "read": {"const": true},
        "write": {"const": true},
        "create_project": {"const": true},
        "edit_project": {"const": true},
        "create_item": {"const": true},
        "edit_item": {"const": true},
        "delete_item": {"const": false}
      },
      "additionalProperties": false
    },
    "sync_policy": {
      "type": "object",
      "required": ["automatic", "projections", "remote_edits", "allow_delete"],
      "properties": {
        "automatic": {"const": true},
        "projections": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["roadmap", "goals"]}
        },
        "remote_edits": {"const": "proposals-only"},
        "allow_delete": {"const": false}
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["mode", "renew_only_for"],
      "properties": {
        "mode": {"const": "durable-connection"},
        "renew_only_for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
