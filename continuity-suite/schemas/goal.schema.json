{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity goal",
  "type": "object",
  "required": ["goal_id", "project_id", "title", "plan_version", "state", "scope", "acceptance_criteria", "runtime_limit_minutes", "roadmap_ids", "roadmap_impact", "roadmap_fingerprint"],
  "properties": {
    "goal_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "plan_version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["proposed-plan", "awaiting-feedback", "approved", "queued", "dispatched", "running", "validating", "review-ready", "completed", "partially-completed", "blocked", "cancelled", "held"]},
    "scope": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runtime_limit_minutes": {"type": "integer", "minimum": 1},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "source_note_ids": {"type": "array", "items": {"type": "string"}},
    "memory_ids": {"type": "array", "items": {"type": "string"}},
    "roadmap_ids": {"type": "array", "items": {"type": "string"}},
    "roadmap_impact": {"$ref": "roadmap-impact.schema.json"},
    "roadmap_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "documentation_updates": {"type": "array", "items": {"type": "string"}},
    "required_checks": {"type": "array", "items": {"type": "string"}},
    "triage_brief": {"oneOf": [{"$ref": "triage-brief.schema.json"}, {"type": "null"}]},
    "decision_map": {"oneOf": [{"$ref": "decision-map.schema.json"}, {"type": "null"}]},
    "delivery_slices": {
      "type": "array",
      "items": {"$ref": "delivery-slice.schema.json"}
    }
  },
  "additionalProperties": true
}
