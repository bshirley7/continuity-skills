{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity goal",
  "type": "object",
  "required": ["goal_id", "project_id", "title", "plan_version", "state", "source_note_ids", "note_dispositions", "scope", "acceptance_criteria", "runtime_limit_minutes", "roadmap_ids", "roadmap_impact", "roadmap_fingerprint"],
  "properties": {
    "goal_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "plan_version": {"type": "integer", "minimum": 1},
    "state": {"enum": ["proposed-plan", "awaiting-feedback", "approved", "queued", "dispatched", "running", "validating", "review-ready", "changes-requested", "completed", "partially-completed", "blocked", "cancelled", "held"]},
    "scope": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runtime_limit_minutes": {"type": "integer", "minimum": 1},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "source_note_ids": {"type": "array", "items": {"type": "string"}},
    "source_capture_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capture_id", "document_id", "document_type", "document_revision", "source_authority", "source_ref", "source_hash"],
        "properties": {
          "capture_id": {"type": "string", "minLength": 1},
          "document_id": {"type": "string", "minLength": 1},
          "document_type": {"enum": ["prd", "feature-request"]},
          "document_revision": {"type": "integer", "minimum": 1},
          "document_version": {"type": ["string", "null"]},
          "source_authority": {"enum": ["project-intent", "supplied-reference"]},
          "source_ref": {"type": "string", "minLength": 1},
          "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "note_dispositions": {"type": "array", "items": {"$ref": "note-disposition.schema.json"}},
    "memory_ids": {"type": "array", "items": {"type": "string"}},
    "design_ids": {"type": "array", "maxItems": 1, "items": {"type": "string"}},
    "design_refs": {"type": "array", "maxItems": 1, "items": {"type": "object", "required": ["design_id", "revision", "design_hash", "catalog_packs"], "properties": {"design_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "design_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "approval_bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "visual_reference_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "slop_ruleset_version": {"type": "string"}, "slop_ruleset_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "catalog_packs": {"type": "array", "items": {"type": "object"}}, "alignment_contract": {"type": "object"}}, "additionalProperties": false}},
    "roadmap_ids": {"type": "array", "items": {"type": "string"}},
    "roadmap_impact": {"$ref": "roadmap-impact.schema.json"},
    "roadmap_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "documentation_updates": {"type": "array", "items": {"type": "string"}},
    "required_checks": {"type": "array", "items": {"type": "string"}},
    "authorization_mode": {"enum": ["separate-approval", "goal-request"]},
    "risk_level": {"enum": ["routine", "elevated", "consequential"]},
    "restricted_side_effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "triage_brief": {"oneOf": [{"$ref": "triage-brief.schema.json"}, {"type": "null"}]},
    "decision_map": {"oneOf": [{"$ref": "decision-map.schema.json"}, {"type": "null"}]},
    "delivery_slices": {
      "type": "array",
      "items": {"$ref": "delivery-slice.schema.json"}
    }
  },
  "additionalProperties": true
}
