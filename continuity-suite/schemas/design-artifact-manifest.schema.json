{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity design artifact manifest",
  "type": "object",
  "required": ["schema_version", "artifact_id", "design_id", "revision", "design_hash", "maturity", "fixture_data", "files", "demonstrated_audiences", "demonstrated_surfaces", "demonstrated_states", "omitted_surfaces", "omitted_states", "design_claims", "validation_results", "execution_authorized"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3]},
    "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "design_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "design_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "approval_bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "slop_report": {"type": "object", "required": ["path", "sha256", "report_hash", "ruleset_version", "counts_by_severity", "dispositions_hash", "status"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "report_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "ruleset_version": {"type": "string"}, "counts_by_severity": {"type": "object", "required": ["critical", "error", "info", "warning"], "properties": {"critical": {"type": "integer"}, "error": {"type": "integer"}, "info": {"type": "integer"}, "warning": {"type": "integer"}}, "additionalProperties": false}, "dispositions_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"const": "passed"}}, "additionalProperties": false},
    "maturity": {"enum": ["directional", "behavioral", "implementation-facing"]},
    "fixture_data": {"enum": ["none", "present-labeled", "present-unlabeled"]},
    "files": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["path", "media_type", "role", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "media_type": {"enum": ["text/html", "image/png", "text/css", "text/javascript", "application/javascript", "application/typescript", "application/json", "image/svg+xml"]}, "role": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}
    },
    "implementation_context_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "component_map_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset_strategy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_critique_revision": {"type": "integer", "minimum": 1},
    "demonstrated_audiences": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "demonstrated_surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "demonstrated_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "omitted_surfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "omitted_states": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "design_claims": {
      "type": "array",
      "items": {"type": "object", "required": ["design_section", "claim", "coverage", "evidence_refs", "insight_ids"], "properties": {"design_section": {"type": "string", "minLength": 1}, "claim": {"type": "string", "minLength": 1}, "coverage": {"enum": ["demonstrated", "omitted"]}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "insight_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}
    },
    "content_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "presentation", "provenance_ids", "evidence_refs", "visible_qualification"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "presentation": {"enum": ["verified", "qualified", "illustrative"]},
          "provenance_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "visible_qualification": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "asset_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "status", "evidence_refs"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "status": {"enum": ["resolved", "deliberately-omitted", "blocked"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "validation_results": {
      "type": "array",
      "items": {"type": "object", "required": ["scenario", "status", "evidence"], "properties": {"scenario": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed", "not-applicable"]}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false}
    },
    "craft_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity", "status", "artifact_ref", "location", "evidence", "response", "override_rationale"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "severity": {"enum": ["info", "warning", "error", "critical"]},
          "status": {"enum": ["open", "resolved", "accepted-intentional", "not-applicable"]},
          "artifact_ref": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "response": {"type": "string"},
          "override_rationale": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "execution_authorized": {"const": false}
  },
  "additionalProperties": false
}
