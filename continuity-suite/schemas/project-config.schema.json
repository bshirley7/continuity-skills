{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuity configuration",
  "type": "object",
  "required": ["schema_version", "assurance_standard_version", "project_id", "integration_branch", "timezone", "default_start_time", "max_runtime_minutes", "memory_docs", "roadmap_docs", "private_dir", "memory_stale_after_days", "validation_commands", "security_commands", "documentation_map", "visual_evidence_mode", "branch_prefix", "project_instructions", "planning_patterns", "roadmap", "agent_surfaces", "scheduler", "behavior_config_path", "behavior_skill_path", "behavior_configuration_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "assurance_standard_version": {"const": 2},
    "project_id": {"type": "string", "minLength": 1},
    "integration_branch": {"type": "string", "minLength": 1},
    "timezone": {"type": "string"},
    "default_start_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
    "max_runtime_minutes": {"type": "integer", "minimum": 1},
    "memory_docs": {"type": "string"},
    "roadmap_docs": {"const": "docs/project-roadmap"},
    "private_dir": {"type": "string"},
    "memory_stale_after_days": {"type": "integer", "minimum": 1},
    "require_remote": {"type": "boolean"},
    "require_pr": {"type": "boolean"},
    "require_pr_auth": {"type": "boolean"},
    "require_execution_artifacts": {"type": "boolean"},
    "require_isolated_worktree": {"type": "boolean"},
    "refresh_base_on_preflight": {"type": "boolean"},
    "require_signed_approvals": {"type": "boolean"},
    "approval_allowed_signers": {"type": "string", "minLength": 1},
    "github_required_checks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "github_required_reviewers": {"type": "integer", "minimum": 0},
    "require_remote_lease": {"type": "boolean"},
    "validation_commands": {"type": "array", "items": {"type": "string"}},
    "security_commands": {"type": "array", "items": {"type": "string"}},
    "documentation_map": {"type": "object"},
    "visual_evidence_mode": {"enum": ["when-applicable", "always", "explanation-allowed"]},
    "branch_prefix": {"type": "string", "minLength": 1},
    "project_instructions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "planning_patterns": {
      "type": "object",
      "required": ["evidence_triage", "decision_mapping", "delivery_slicing", "tracker_provider"],
      "properties": {
        "evidence_triage": {"enum": ["disabled", "auto", "required"]},
        "decision_mapping": {"enum": ["disabled", "auto", "required"]},
        "delivery_slicing": {"enum": ["disabled", "auto", "required"]},
        "tracker_provider": {"enum": ["local", "github", "linear", "none"]}
      },
      "additionalProperties": false
    },
    "roadmap": {"$ref": "roadmap-settings.schema.json"},
    "agent_surfaces": {
      "type": "object",
      "required": ["primary", "enabled"],
      "properties": {
        "primary": {"enum": ["codex", "claude-code", "cursor", "windsurf", "generic"]},
        "enabled": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["codex", "claude-code", "cursor", "windsurf", "generic"]}}
      },
      "additionalProperties": false
    },
    "scheduler": {"$ref": "scheduler-settings.schema.json"},
    "behavior_config_path": {"const": ".continuity/project-behavior.json"},
    "behavior_skill_path": {"const": ".agents/skills/continuity-local/SKILL.md"},
    "behavior_configuration_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": true
}
