{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized shared-note packet",
  "type": "object",
  "required": ["packet_id", "version", "source_project_id", "target_project_id", "sender", "items", "content_hash", "execution_authorized"],
  "properties": {
    "packet_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "source_project_id": {"type": "string", "minLength": 1},
    "target_project_id": {"type": "string", "minLength": 1},
    "items": {"type": "array", "minItems": 1},
    "roadmap_ids": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_authorized": {"const": false}
  },
  "additionalProperties": true
}
