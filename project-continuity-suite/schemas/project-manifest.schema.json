{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project-local continuity enrollment manifest",
  "type": "object",
  "required": ["schema_version", "assurance_standard_version", "project_id", "continuity_enabled", "execution_enabled", "integration_branch", "timezone", "schedules", "max_concurrency"],
  "properties": {
    "schema_version": {"const": 1},
    "assurance_standard_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "continuity_enabled": {"type": "boolean"},
    "execution_enabled": {"type": "boolean"},
    "integration_branch": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "schedules": {
      "type": "object",
      "required": ["review", "dispatch", "report"],
      "properties": {
        "review": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "dispatch": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "report": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"}
      },
      "additionalProperties": false
    },
    "max_concurrency": {"type": "integer", "const": 1}
  },
  "additionalProperties": false
}
